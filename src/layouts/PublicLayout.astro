---
import '../styles/themes.css';

interface Props {
  title: string;
  description?: string;
  /** Canónica distinta de la ruta actual, para páginas que duplican contenido. */
  canonicalPath?: string;
  /** Deja la página fuera de los buscadores. */
  noindex?: boolean;
}

const { title, description, canonicalPath, noindex = false } = Astro.props;
const metaDesc =
  description ||
  'Forge OS — Kanban, knowledge base and dynamic databases in one self-hosted workspace. One Node process over a single SQLite file.';

// Igual que en MainLayout: la canónica se construye sobre `Astro.site`, no
// sobre `Astro.url`, para que no dependa de que la cadena de proxies esté bien
// montada. Ver la nota en MainLayout.astro.
const canonicalUrl = Astro.site
  ? new URL(canonicalPath ?? Astro.url.pathname, Astro.site).href
  : new URL(canonicalPath ?? Astro.url.pathname, Astro.url).href;
const ogImage = Astro.site
  ? new URL('/screenshots/board-dark.png', Astro.site).href
  : new URL('/screenshots/board-dark.png', Astro.url).href;

/**
 * Datos estructurados.
 *
 * Sin esto, un buscador ve una página de texto y tiene que adivinar qué es. Con
 * `SoftwareApplication` sabe que hay un producto, que es gratuito y con qué
 * licencia — y eso es lo que habilita los resultados enriquecidos.
 *
 * Todo lo que se declara aquí es comprobable en la propia página: precio cero,
 * licencia MIT, categoría. Inventar valoraciones o número de usuarios daría un
 * resultado más vistoso y es exactamente por lo que Google penaliza.
 */
const siteBase = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, '');
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Forge OS',
  url: siteBase,
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Project Management',
  operatingSystem: 'Linux, macOS, Windows',
  description: metaDesc,
  image: ogImage,
  license: 'https://opensource.org/licenses/MIT',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  softwareHelp: 'https://github.com/JoseSerpaCode/Forge-OS#readme',
  codeRepository: 'https://github.com/JoseSerpaCode/Forge-OS',
};
---

<!doctype html>
{/*
  `data-theme="light"` en el servidor.

  Antes esta página no lo llevaba: se servía siempre oscura porque quien llega
  sin sesión no tiene preferencia guardada. Ahora abre en claro, y el script de
  abajo la corrige **antes de pintar** si esa persona ya eligió otra cosa.

  El atributo va aquí, en el HTML del servidor, y no solo en el script: sin él,
  entre que llega el HTML y corre el script hay un fotograma con el tema
  equivocado, y eso se ve como un parpadeo blanco en cada carga.
*/}
<html lang={Astro.locals.lang || 'en'} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDesc} />
    {/* El color de la barra del navegador móvil. Lo ajusta el script junto con
        el tema; este es el valor de partida. */}
    <meta name="theme-color" content="#F8F6F0" />

    {/*
      Antes de pintar nada: si hay una elección guardada, mandarla.

      `is:inline` y en el `<head>` a propósito. La clave es la misma que usa la
      aplicación (`forge_theme`), así que quien puso la app en oscuro encuentra
      la portada en oscuro, y al revés. Sin esto, cada carga empezaría en claro
      y saltaría al tema elegido con el contenido ya dibujado.
    */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('forge_theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
            var m = document.querySelector('meta[name="theme-color"]');
            if (m) m.setAttribute('content', t === 'dark' ? '#0D0B0A' : '#F8F6F0');
          }
        } catch (e) {
          /* Navegador con el almacenamiento bloqueado: se queda el del servidor. */
        }
      })();
    </script>

    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href="/forge-icon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:site_name" content="Forge OS" />
    <meta property="og:locale" content={Astro.locals.lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:image:alt" content="Forge OS kanban board" />

    {/* `set:html` con JSON.stringify: el contenido es un objeto que construimos
        nosotros, no entrada del usuario, y Astro escaparía las comillas. */}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    background: var(--forge-bg);
    color: var(--forge-text);
    font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  /* Estos estilos los daba global.css, que resultó no estar importado por
     nadie y se movió a themes.css. Aquí se repite el foco por si el orden de
     capas de Tailwind lo pisara en una página sin las utilidades cargadas. */
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--forge-accent-secondary);
    outline-offset: 3px;
    border-radius: 4px;
  }
</style>
