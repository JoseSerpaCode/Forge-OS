---
import '../styles/themes.css';
import TopBar from '../components/layout/TopBar.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import Footer from '../components/layout/Footer.astro';
import GuestBanner from '../components/layout/GuestBanner.astro';
import { useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  workspaceId?: string;
  description?: string;
  ogImage?: string;
  hideFooter?: boolean;
}

const { title, workspaceId, description, ogImage, hideFooter = false } = Astro.props;

const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);
const user = Astro.locals.user!;

import db from '../lib/db';
let workspaceName = '';
if (workspaceId) {
  const ws = db.prepare('SELECT name FROM workspaces WHERE id = ?').get(workspaceId) as any;
  if (ws) workspaceName = ws.name;
}

const metaDesc = description || "Forge OS - Advanced workspace management and task tracking application for professional teams.";
const metaImg = ogImage || "/forge-icon.svg";

// La URL canónica se construye sobre `Astro.site` (configurada con
// PUBLIC_SITE_URL), no sobre `Astro.url`.
//
// Detrás de un proxy inverso, `Astro.url` toma el esquema de la conexión
// entrante, que es HTTP plano entre Caddy y Node aunque el visitante llegue por
// HTTPS. `trust proxy` en Express corrige el host pero no el esquema: el
// adaptador de Astro no lee X-Forwarded-Proto. El resultado sería
// `http://forge-os.online/...` en la canónica y en las tarjetas sociales.
//
// `Astro.site` es un valor declarado, no deducido de la petición, así que no
// depende de que la cadena de proxies esté bien montada.
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;
const absoluteImg = Astro.site ? new URL(metaImg, Astro.site).href : metaImg;

// Prevent BFCache and caching to ensure data is always fresh and 404s trigger correctly
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
---

<html lang={Astro.locals.lang || 'es'} data-theme={user?.theme_preference || 'light'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta name="description" content={metaDesc} />
    <meta name="keywords" content="workspace, kanban, knowledge base, forge os, team collaboration, productivity" />
    <meta name="author" content="Forge OS" />
    <meta name="theme-color" content="#FF5D00" />
    
    <!-- Open Graph / Social -->
    <meta property="og:title" content={`${title} | Forge OS`} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={absoluteImg} />}
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Forge OS`} />
    <meta name="twitter:description" content={metaDesc} />
    {ogImage && <meta name="twitter:image" content={absoluteImg} />}
    
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Preconnect & Preload for Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    
    <link rel="icon" type="image/svg+xml" href="/forge-icon.svg" />
    
    <title>{title} | Forge OS</title>
    <script is:inline>
      const savedTheme = localStorage.getItem('forge_theme');
      if (savedTheme) {
        document.documentElement.setAttribute('data-theme', savedTheme);
      }
    </script>
    {/*
      Socket.IO se carga **cuando la pestaña está a la vista**, no al abrirla.

      Se cargaba en todas las páginas con sesión y abría su conexión de
      inmediato. Eso cuesta en los dos extremos: en la `e2-micro` cada conexión
      abierta es memoria del proceso que no se recupera hasta que la pestaña se
      cierra, y en un móvil una conexión persistente mantiene la radio
      despierta, que es de las cosas que más batería gastan.

      Lo único que hace es recibir notificaciones. Retrasarlo al primer momento
      de inactividad no pierde ninguna —el servidor las guarda y la campana las
      lee al abrirse— y quita 19 KB y una conexión del camino crítico de cada
      carga.

      Con la pestaña en segundo plano no se conecta en absoluto: abrir diez
      pestañas para leer algo no debería costar diez conexiones.

      La variante minificada pesa 19 KB frente a los 37 de la normal. Medido con
      Lighthouse en su día: 18 KB y 150 ms.
    */}
    <script is:inline>
      (function () {
        var iniciado = false;

        function conectar() {
          if (iniciado || document.visibilityState !== 'visible') return;
          iniciado = true;

          var s = document.createElement('script');
          s.src = '/socket.io/socket.io.min.js';
          s.onload = function () {
            window.socket = io();
            window.socket.on('user_notification', function (data) {
              if (window.showToast) window.showToast(data.title + ': ' + data.message);
              // La campana escucha este evento para pintarlas sin recargar.
              window.dispatchEvent(new CustomEvent('forge_new_notif', { detail: data }));
            });
          };
          document.head.appendChild(s);
        }

        // `requestIdleCallback` espera a que el navegador no tenga nada mejor
        // que hacer. Safari no lo tiene, de ahí el respaldo por temporizador.
        if ('requestIdleCallback' in window) {
          requestIdleCallback(conectar, { timeout: 4000 });
        } else {
          setTimeout(conectar, 2500);
        }

        // Si la pestaña nace en segundo plano, se conecta al traerla delante.
        document.addEventListener('visibilitychange', conectar);
      })();
    </script>
  </head>
  <body tabindex="-1" class="bg-forge-bg text-forge-text flex h-screen overflow-hidden selection:bg-forge-primary selection:text-white" data-user-role={user?.is_sysadmin ? 'sysadmin' : 'user'} data-is-sysadmin={user?.is_sysadmin}>
    <Sidebar workspaceId={workspaceId} workspaceName={workspaceName} />
    <div id="sidebar-backdrop" class="fixed inset-0 bg-black/60 z-40 hidden md:hidden transition-opacity opacity-0 backdrop-blur-sm max-md:backdrop-blur-none cursor-pointer"></div>
    <div class="flex-1 flex flex-col min-w-0">
      <TopBar title={title} workspaceName={workspaceName} />
      <main class="flex-1 overflow-auto flex flex-col relative min-h-0">
        <div class="max-w-[1440px] w-full mx-auto px-6 py-6 flex-1 shrink-0">
          <GuestBanner />
          <slot />
        </div>
        {!hideFooter && <Footer />}
      </main>
    </div>
    
    <!-- Global UI Components -->
    <div id="forge-toast" role="status" aria-live="polite" aria-atomic="true" class="fixed bottom-6 right-6 bg-forge-panel/95 backdrop-blur-md max-md:backdrop-blur-none border border-forge-border/50 text-forge-text px-6 py-4 rounded-xl shadow-[0_10px_40px_rgba(0,0,0,0.3)] transform translate-y-20 opacity-0 transition-all duration-400 ease-out z-[100] flex items-center gap-4">
      <span id="forge-toast-icon" aria-hidden="true" class="text-forge-accent-text flex-shrink-0 bg-forge-secondary/10 p-1.5 rounded-full">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v4"></path><path d="M12 16h.01"></path></svg>
      </span>
      <span id="forge-toast-msg" class="text-sm font-semibold tracking-wide"></span>
    </div>


    <dialog id="forge-confirm-modal" class="bg-forge-panel/95 backdrop-blur-xl max-md:backdrop-blur-none border border-forge-border/50 rounded-2xl p-8 w-[420px] text-forge-text shadow-[0_20px_60px_rgba(0,0,0,0.5)] backdrop:bg-black/50 backdrop:backdrop-blur-sm max-md:backdrop-blur-none z-[100] open:animate-in open:fade-in open:zoom-in-95 transition-all">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-full bg-forge-secondary/20 text-forge-accent-text flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <h2 class="text-xl font-bold text-forge-text" id="forge-confirm-title" data-original={t('confirm.title')}>{t('confirm.title')}</h2>
      </div>
      <p class="text-sm text-forge-muted mb-8 leading-relaxed" id="forge-confirm-msg">{t('confirm.default')}</p>
      <div class="flex justify-end gap-3">
        <button id="btn-forge-confirm-cancel" class="px-5 py-2.5 text-sm font-semibold text-forge-muted hover:text-forge-text hover:bg-forge-text/5 rounded-lg transition-all cursor-pointer">{t('confirm.cancel')}</button>
        <button id="btn-forge-confirm-ok" class="bg-forge-primary text-forge-on-accent px-5 py-2.5 rounded-lg text-sm font-bold shadow-lg shadow-forge-primary/25 hover:shadow-forge-primary/40 hover:-translate-y-0.5 transition-all cursor-pointer">{t('confirm.ok')}</button>
      </div>
    </dialog>

    <!-- Command Palette (Cmd+K) -->
    <dialog id="cmd-k-palette" class="bg-forge-panel/95 backdrop-blur-md max-md:backdrop-blur-none border border-forge-border rounded-xl p-0 w-full max-w-[550px] text-forge-text shadow-[0_20px_50px_rgba(0,0,0,0.5)] z-[200] overflow-hidden m-auto mb-auto mt-[15vh] transition-all open:animate-in open:fade-in open:zoom-in-95 backdrop:bg-black/40 backdrop:backdrop-blur-sm max-md:backdrop-blur-none">
      <div class="flex items-center px-4 py-4 border-b border-forge-border/50 bg-forge-bg/30">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-forge-accent-text mr-3"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" id="cmd-k-input" aria-label={t('cmd.palette.label')} class="w-full bg-transparent border-none text-forge-text text-lg focus:outline-none placeholder-forge-muted/70 font-medium" placeholder={t('cmd.placeholder')} autocomplete="off" role="combobox" aria-expanded="false" aria-controls="cmd-k-results" aria-autocomplete="list">
        <span class="text-[10px] font-mono text-forge-muted bg-forge-bg px-2 py-1 rounded border border-forge-border ml-2 font-bold tracking-widest shadow-sm">ESC</span>
      </div>
      <div class="max-h-[350px] overflow-y-auto p-2" id="cmd-k-results" role="listbox">
        <div id="cmd-k-quick">
        <div class="px-3 py-2 text-[10px] font-bold text-forge-muted uppercase tracking-widest mt-1">{t('cmd.quick')}</div>
        <a href="/" class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-forge-secondary/15 hover:text-forge-accent-text transition-all cursor-pointer text-sm font-medium group">
          <div class="w-8 h-8 rounded bg-forge-bg border border-forge-border flex items-center justify-center group-hover:border-forge-secondary/50 group-hover:text-forge-accent-text text-forge-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          {t('cmd.go_hub')}
        </a>
        <a href="/settings" class="flex items-center gap-3 px-3 py-3 rounded-lg hover:bg-forge-secondary/15 hover:text-forge-accent-text transition-all cursor-pointer text-sm font-medium group mt-1">
          <div class="w-8 h-8 rounded bg-forge-bg border border-forge-border flex items-center justify-center group-hover:border-forge-secondary/50 group-hover:text-forge-accent-text text-forge-muted transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          {t('cmd.go_settings')}
        </a>
        </div>
        {/* Aquí se pintan los resultados de la búsqueda. La paleta tenía este
            hueco sin nada detrás: `#cmd-k-input` no llevaba ni un listener en
            todo el proyecto, solo un `.focus()`. Escribir no hacía nada. */}
        <div id="cmd-k-hits" class="hidden"
          data-t-searching={t('cmd.searching')}
          data-t-none={t('cmd.none')}
          data-t-error={t('cmd.error')}></div>
      </div>
    </dialog>

    {/*
      Los textos que necesitan los scripts, en un solo sitio.

      Los llamantes viven dentro de `<script>` sin `define:vars`, así que `t()`
      no les llega. La primera versión de esto repartía un `data-*` por cada
      componente que confirmaba o avisaba de algo; con dieciséis mensajes eso
      son dieciséis atributos sueltos que se desincronizan. Un objeto en
      `window` lo resuelve una vez para toda la aplicación.
    */}
    <script is:inline define:vars={{ mensajes: {
      confirmarBorrarPagina: t('confirm.delete_page'),
      confirmarQuitarMiembro: t('confirm.remove_member'),
      confirmarBorrarAutomatizacion: t('confirm.delete_automation'),
      confirmarBorrarRegistro: t('confirm.delete_worklog'),
      confirmarBorrarEspacio: t('confirm.delete_workspace'),
      confirmarSalirEspacio: t('confirm.leave_workspace'),
      errCrearPagina: t('err.create_page'),
      errBorrarPagina: t('err.delete_page'),
      errBorrarEspacio: t('err.delete_ws'),
      errSalirEspacio: t('err.leave_ws'),
      errGuardarRegistro: t('err.save_worklog'),
      errGuardarAjustes: t('err.save_settings'),
      errGenerico: t('err.generic'),
      errRed: t('err.network'),
    } }}>
      window.forgeMsg = mensajes;
    </script>

    {/*
      El subidor de imágenes, expuesto en `window`.

      Dos de los tres sitios que suben imágenes usan `<script is:inline
      define:vars>`, que **no admite imports**: es una restricción de Astro, no
      una elección. Sin este puente, la única forma de compartir el código sería
      no compartirlo, que es como acabaron existiendo tres implementaciones con
      tres comportamientos —una de ellas sin redimensionar nada.
    */}
    <script>
      import { subirImagen, ANCHOS } from '../lib/client/imagen';
      import { escaparHtml, hrefSeguro } from '../lib/texto';

      (window as any).forgeImagen = { subir: subirImagen, ANCHOS };

      /**
       * Escapado, para los scripts que no pueden importar.
       *
       * `<script is:inline define:vars>` no admite imports —restricción de
       * Astro—, y ahí es donde vivían dos de las cuatro copias de `esc`. Que
       * difirieran entre sí era lo peor: una escapaba `&<>"` y otra además `'`,
       * así que el mismo texto salía distinto según por dónde pasara.
       */
      (window as any).forgeTexto = { escapar: escaparHtml, href: hrefSeguro };
    </script>

    <script is:inline>
      window.showToast = function(msg, type = false) {
        const toast = document.getElementById('forge-toast');
        const text = document.getElementById('forge-toast-msg');
        if (toast && text) {
          text.textContent = msg;
          const isError = type === true || type === 'error';
          if (isError) {
             toast.classList.replace('border-forge-secondary', 'border-red-500');
          } else {
             toast.classList.replace('border-red-500', 'border-forge-secondary');
          }
          toast.classList.remove('translate-y-20', 'opacity-0');
          setTimeout(() => {
            toast.classList.add('translate-y-20', 'opacity-0');
          }, 4000);
        }
      };

      // Generic intercept for guest-restricted actions globally
      document.addEventListener('click', (e) => {
        const restrictedEl = e.target.closest('.guest-restricted-action');
        if (restrictedEl && restrictedEl.getAttribute('data-guest') === 'true') {
          e.preventDefault();
          e.stopPropagation();
          const msg = restrictedEl.getAttribute('data-guest-msg') || 'Please create an account to access this feature.';
          if (window.showToast) window.showToast(msg, true);
          setTimeout(() => window.location.href = '/register', 1500);
        }
      }, true); // Use capture phase to ensure we intercept before other listeners

      window.forgeConfirm = function(msg, callback, title) {
        // El título por defecto estaba escrito en inglés dentro de la firma, así
        // que el diálogo salía con la cabecera «Confirm», el mensaje en inglés y
        // los botones en español. El del marcado ya está traducido.
        if (!title) title = document.getElementById('forge-confirm-title')?.dataset.original || '';
        const modal = document.getElementById('forge-confirm-modal');
        const titleEl = document.getElementById('forge-confirm-title');
        const msgEl = document.getElementById('forge-confirm-msg');
        const btnCancel = document.getElementById('btn-forge-confirm-cancel');
        const btnOk = document.getElementById('btn-forge-confirm-ok');
        
        if (modal && titleEl && msgEl && btnCancel && btnOk) {
          titleEl.textContent = title;
          msgEl.textContent = msg;
          
          const handleCancel = () => {
             modal.close();
             cleanup();
          };
          const handleOk = () => {
             modal.close();
             cleanup();
             callback();
          };
          
          btnCancel.addEventListener('click', handleCancel);
          btnOk.addEventListener('click', handleOk);
          
          const cleanup = () => {
             btnCancel.removeEventListener('click', handleCancel);
             btnOk.removeEventListener('click', handleOk);
          };
          
          modal.showModal();
        } else {
          if (confirm(msg)) callback();
        }
      };

      // Global Keyboard Shortcuts
      document.addEventListener('keydown', (e) => {
        // Prevent shortcuts if typing in input, textarea, or contenteditable
        const tag = e.target.tagName;
        if (['INPUT', 'TEXTAREA', 'SELECT'].includes(tag) || e.target.isContentEditable) return;

        // Cmd+K or Ctrl+K for Palette
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          const palette = document.getElementById('cmd-k-palette');
          if (palette) {
            if (palette.hasAttribute('open')) {
              palette.close();
            } else {
              palette.showModal();
              document.getElementById('cmd-k-input').focus();
            }
          }
        }


        // 'c' to quickly create issue if button exists
        if (e.key === 'c' || e.key === 'C') {
          const newIssueBtn = document.getElementById('btn-new-issue');
          if (newIssueBtn) {
            e.preventDefault();
            newIssueBtn.click();
          }
        }
        
        // 'b' to toggle sidebar if button exists
        if (e.key === 'b' || e.key === 'B') {
          if (e.metaKey || e.ctrlKey) {
             const toggleBtn = document.getElementById('sidebar-toggle');
             if (toggleBtn) {
               e.preventDefault();
               toggleBtn.click();
             }
          }
        }
      });
      
      // Close on clicking backdrop
      document.getElementById('cmd-k-palette')?.addEventListener('click', function(e) {
        if (e.target === this) this.close();
      });
    
      /**
       * La paleta, conectada.
       *
       * Tenía un `<input>`, un contenedor de resultados y dos enlaces fijos en
       * inglés. `#cmd-k-input` no llevaba **ni un listener** en todo el
       * proyecto —solo un `.focus()` al abrirla—, así que escribir no hacía
       * absolutamente nada. La búsqueda global ya existía y la barra superior
       * ya la usaba; solo faltaba enchufarla aquí.
       *
       * Va contra `/api/sys/state`, la misma que la barra: una búsqueda con dos
       * implementaciones acaba dando resultados distintos en cada sitio.
       */
      // El botón de buscar de la barra, en móvil, abre esta misma paleta: es
      // la única forma de buscar por debajo de 768, donde la búsqueda de la
      // barra se esconde y el atajo de teclado no existe.
      document.getElementById('btn-search-mobile')?.addEventListener('click', function () {
        var p = document.getElementById('cmd-k-palette');
        if (p && !p.hasAttribute('open')) {
          p.showModal();
          document.getElementById('cmd-k-input').focus();
        }
      });

      (function () {
        var input = document.getElementById('cmd-k-input');
        var hits = document.getElementById('cmd-k-hits');
        var quick = document.getElementById('cmd-k-quick');
        var palette = document.getElementById('cmd-k-palette');
        if (!input || !hits || !quick || !palette) return;

        var espera, ultima = 0, seleccion = -1;

        function pinta(html, mostrar) {
          hits.innerHTML = html;
          hits.classList.toggle('hidden', !mostrar);
          quick.classList.toggle('hidden', mostrar);
          input.setAttribute('aria-expanded', String(!!mostrar));
          seleccion = -1;
        }

        function aviso(texto) {
          return '<p class="px-3 py-6 text-sm text-forge-muted text-center">' + texto + '</p>';
        }

        function opciones() {
          return Array.prototype.slice.call(hits.querySelectorAll('a[role="option"]'));
        }

        function resalta(i) {
          var lista = opciones();
          if (!lista.length) return;
          seleccion = (i + lista.length) % lista.length;
          lista.forEach(function (el, n) {
            var activo = n === seleccion;
            el.classList.toggle('bg-forge-secondary/15', activo);
            el.setAttribute('aria-selected', String(activo));
            if (activo) el.scrollIntoView({ block: 'nearest' });
          });
        }

        input.addEventListener('input', function () {
          clearTimeout(espera);
          var q = input.value.trim();
          if (q.length < 2) { pinta('', false); return; }

          pinta(aviso(hits.dataset.tSearching || ''), true);
          // Una consulta por tecla son ocho para escribir «informe».
          espera = setTimeout(function () {
            var mia = ++ultima;
            fetch('/api/sys/state?q=' + encodeURIComponent(q))
              .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
              .then(function (datos) {
                // Una consulta lenta de «inf» puede llegar después de la de
                // «informe» y pintar sus resultados encima de los buenos.
                if (mia !== ultima) return;
                if (!datos.length) { pinta(aviso(hits.dataset.tNone || ''), true); return; }

                var html = datos.map(function (item) {
                  // `textContent` no vale aquí porque se arma HTML, así que el
                  // título se escapa: lo escribe otra persona. Y la URL pasa por
                  // `href`, porque escapar no protege de un `javascript:`.
                  var titulo = window.forgeTexto.escapar(item.title);
                  var url = window.forgeTexto.href(item.url);
                  return '<a href="' + url + '" role="option" aria-selected="false" ' +
                    'class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-forge-secondary/15 transition-colors text-sm">' +
                    '<span class="text-[10px] font-mono uppercase tracking-wider text-forge-muted w-16 shrink-0">' + window.forgeTexto.escapar(item.type) + '</span>' +
                    '<span class="truncate">' + titulo + '</span></a>';
                }).join('');
                pinta(html, true);
              })
              .catch(function () {
                if (mia === ultima) pinta(aviso(hits.dataset.tError || ''), true);
              });
          }, 220);
        });

        // Flechas y Enter: una paleta que obliga a soltar el teclado para
        // elegir no es una paleta.
        input.addEventListener('keydown', function (e) {
          var lista = opciones();
          if (e.key === 'ArrowDown') { e.preventDefault(); resalta(seleccion + 1); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); resalta(seleccion - 1); }
          else if (e.key === 'Enter' && seleccion >= 0 && lista[seleccion]) {
            e.preventDefault();
            window.location.href = lista[seleccion].getAttribute('href');
          }
        });

        // Al cerrarla se limpia: reabrirla con la búsqueda de hace dos horas
        // dentro es confuso.
        palette.addEventListener('close', function () {
          input.value = '';
          pinta('', false);
          /**
           * Devolver el foco al documento.
           *
           * Al cerrar con Escape, el foco se quedaba dentro del diálogo ya
           * cerrado. Consecuencia: el atajo de teclado dejaba de funcionar
           * —el `keydown` no llegaba a `document`— y quien navega con teclado
           * se quedaba sin punto de partida. Reabrir la paleta requería
           * pulsar antes en cualquier sitio con el ratón.
           */
          if (document.body) document.body.focus();
        });
      })();
</script>
  </body>
</html>
