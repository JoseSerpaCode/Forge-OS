---
import MainLayout from '../../layouts/MainLayout.astro';
import WorkspaceIcon from '../../components/brand/WorkspaceIcon.astro';
import db from '../../lib/db';
import { useTranslations, defaultLang } from '../../i18n/ui';
import { canInteractSocially, socialBlockReason } from '../../lib/social';
import { fecha } from '../../lib/fechas';
import { tonoDe, esFotoReal } from '../../lib/tonos';
import { iniciales } from '../../lib/responsables';

const { username } = Astro.params;
const currentUser = Astro.locals.user;
// El idioma lo resuelve el middleware (cookie `forge_lang` o el navegador);
// esta página leía una cookie `lang` que no existe y salía siempre en el
// idioma por defecto.
const lang = Astro.locals.lang || defaultLang;
const t = useTranslations(lang as any);

// Get user profile
const profile = db.prepare('SELECT id, username, avatar_url, banner_url, bio, created_at, is_guest, social_enabled FROM users WHERE username = ?').get(username) as any;

let isBlockedByProfile = false;
let isProfileBlockedByMe = false;
let friendshipStatus = null;
let friendshipId = null;

if (profile && currentUser) {
    // Check blocks
    const blockCheck = db.prepare('SELECT blocker_id, blocked_id FROM user_blocks WHERE (blocker_id = ? AND blocked_id = ?) OR (blocker_id = ? AND blocked_id = ?)').all(currentUser.id, profile.id, profile.id, currentUser.id) as any[];
    
    for (const b of blockCheck) {
        if (b.blocker_id === profile.id) isBlockedByProfile = true;
        if (b.blocker_id === currentUser.id) isProfileBlockedByMe = true;
    }

    if (!isBlockedByProfile && !isProfileBlockedByMe) {
        const userA = currentUser.id < profile.id ? currentUser.id : profile.id;
        const userB = currentUser.id < profile.id ? profile.id : currentUser.id;
        const friendship = db.prepare('SELECT id, status, action_user_id FROM friendships WHERE user_a_id = ? AND user_b_id = ?').get(userA, userB) as any;
        if (friendship) {
            friendshipId = friendship.id;
            friendshipStatus = {
                status: friendship.status,
                isSender: friendship.action_user_id === currentUser.id
            };
        }
    }
}

// El perfil se ve siempre; lo que se cierra es la interacción. Y se decide
// aquí, en el servidor: antes los botones solo se atenuaban con una clase
// cuando el visitante era invitado —el propio botón seguía en el HTML, y la
// mitad viceversa ni se contemplaba: nada impedía mandarle una solicitud a un
// invitado desde su perfil.
const canInteract = canInteractSocially(currentUser, profile);
const noInteractReason = currentUser && profile ? socialBlockReason(currentUser, profile) : null;

// Anti-enumeration: if no profile OR I am blocked by them, show 404
if (!profile || isBlockedByProfile) {
    return new Response(null, {
        status: 404,
        statusText: 'Not Found'
    });
}

// Fetch public workspaces
const publicWorkspaces = db.prepare('SELECT id, name, description, icon, join_policy FROM workspaces WHERE created_by = ? AND is_public = 1').all(profile.id) as any[];

const isOwnProfile = currentUser?.id === profile.id;
const tono = tonoDe(profile.username);
const metaDescription = profile.bio ? profile.bio.substring(0, 160) : `View ${profile.username}'s public profile and workspaces on Forge OS.`;
---

<MainLayout 
    title={t('profile.page_title').replace('{user}', profile.username)}
    description={metaDescription}
    ogImage={profile.avatar_url || '/default-avatar.svg'}
>
    <main class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
        {/* Cabecera de «perfil.html»: una banda del tono de la persona con el
            arco de la fragua, y el avatar montado encima. Sin degradados. */}
        <div class="perfil-banda group/banner" style={`--c:${tono}`}>
            {profile.banner_url && (
                <img src={profile.banner_url} alt="" class="w-full h-full object-cover relative z-[1]" id="profile-banner-img" loading="lazy" decoding="async" />
            )}
            {isOwnProfile && (
                <label class="btn btn-secondary btn-sm absolute right-3 top-3 z-[2]">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                    {t('user.settings.banner_change')}
                    <input type="file" class="sr-only" id="banner-upload" accept="image/*" />
                </label>
            )}
        </div>

        <div class="perfil-cabeza">
            {isOwnProfile ? (
                <label class="avatar avatar-xl cursor-pointer" style={`--c:${tono}`} title={t('user.settings.upload_avatar')}>
                    {esFotoReal(profile.avatar_url)
                        ? <img src={profile.avatar_url} alt="" id="profile-avatar-img" />
                        : iniciales(profile.username)}
                    <input type="file" class="sr-only" id="avatar-upload" aria-label={t('user.settings.upload_avatar')} accept="image/*" />
                </label>
            ) : (
                <span class="avatar avatar-xl" style={`--c:${tono}`} aria-hidden="true">
                    {esFotoReal(profile.avatar_url)
                        ? <img src={profile.avatar_url} alt="" id="profile-avatar-img" />
                        : iniciales(profile.username)}
                </span>
            )}
            <div class="perfil-nombre pb-1.5">
                {/* `break-all`: un nombre de usuario no tiene espacios por
                    donde partir, y a 360 px se salía de la pantalla. */}
                <h1 class="page-title break-all">@{profile.username}</h1>
                <p class="page-sub">{t('profile.member_since')} {fecha(profile.created_at, lang)}</p>
            </div>

            <div class="flex flex-wrap items-center gap-2 pb-2">
                {!isOwnProfile && currentUser && !canInteract && (
                    <p class="hint max-w-xs">
                        {noInteractReason === 'actor_is_guest' ? (
                            <>
                                {t('profile.guest_self')}{' '}
                                <a href="/register" class="enlace">{t('profile.guest_self_cta')}</a>
                            </>
                        ) : (
                            t('profile.guest_target')
                        )}
                    </p>
                )}
                {!isOwnProfile && currentUser && canInteract && (
                    isProfileBlockedByMe ? (
                        <button id="unblock-btn" class="btn btn-danger">{t('profile.unblock_user')}</button>
                    ) : (
                        <>
                            {(!friendshipStatus || friendshipStatus.status === 'ended' || friendshipStatus.status === 'rejected') && (
                                <button id="add-friend-btn" class="btn btn-primary">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                                    {t('profile.add_friend')}
                                </button>
                            )}
                            {friendshipStatus?.status === 'pending' && friendshipStatus.isSender && (
                                <button id="cancel-request-btn" class="btn btn-secondary">{t('profile.cancel_request')}</button>
                            )}
                            {friendshipStatus?.status === 'pending' && !friendshipStatus.isSender && (
                                <>
                                    <button id="accept-btn" class="btn btn-primary">{t('profile.accept_request')}</button>
                                    <button id="reject-btn" class="btn btn-secondary">{t('profile.reject_request')}</button>
                                </>
                            )}
                            {friendshipStatus?.status === 'accepted' && (
                                <>
                                    <span class="hint flex items-center gap-1.5">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                                        {t('profile.friends')}
                                    </span>
                                    <button id="unfriend-btn" class="btn btn-secondary">{t('profile.unfriend')}</button>
                                </>
                            )}
                            <button id="block-btn" class="btn btn-ghost btn-icon" title={t('profile.block_user')} aria-label={t('profile.block_user')}>
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                            </button>
                        </>
                    )
                )}
                {!currentUser && (
                    <a href="/login" class="btn btn-primary">{t('profile.login_to_interact')}</a>
                )}
            </div>
        </div>

        <div class="mt-7 flex flex-col gap-8">
            {isOwnProfile ? (
                <div>
                    <textarea id="profile-bio-input" aria-label={t('a11y.bio')} rows="3" class="campo w-full resize-y" placeholder={t('profile.bio_placeholder') as string}>{profile.bio || ''}</textarea>
                    <div class="flex justify-end mt-2">
                        <button id="save-bio-btn" data-t-save={t('profile.save_bio')} class="btn btn-primary hidden">{t('profile.save_bio')}</button>
                    </div>
                </div>
            ) : profile.bio && (
                <p class="perfil-bio whitespace-pre-wrap">{profile.bio}</p>
            )}

            <section>
                <h2 class="section-title mb-3">{t('profile.public_workspaces')} <span class="wide text-forge-muted text-base font-semibold ml-1">{publicWorkspaces.length}</span></h2>
                {publicWorkspaces.length === 0 ? (
                    <p class="hint">{t('profile.no_workspaces')}</p>
                ) : (
                    <ul class="panel divide-y divide-forge-border">
                        {publicWorkspaces.map(ws => (
                            <li class="flex flex-wrap items-center gap-3 px-4 py-3 text-sm">
                                <span class="w-6 h-6 shrink-0 overflow-hidden rounded"><WorkspaceIcon icon={ws.icon} name={ws.name} /></span>
                                <div class="min-w-0">
                                    <b class="font-semibold text-forge-text">{ws.name}</b>
                                    {ws.description && <p class="hint line-clamp-1">{ws.description}</p>}
                                </div>
                                <span class="ml-auto flex items-center gap-3">
                                    <span class="hint">
                                        {ws.join_policy === 'open' ? t('ws.settings.policy_open') : ws.join_policy === 'friends_only' ? t('ws.settings.policy_friends') : t('ws.settings.policy_disabled')}
                                    </span>
                                    {!isOwnProfile && currentUser && !isProfileBlockedByMe && ws.join_policy !== 'disabled' && (
                                        <button data-ws-id={ws.id} class="join-ws-btn btn btn-secondary btn-sm">{t('profile.request_join')}</button>
                                    )}
                                </span>
                            </li>
                        ))}
                    </ul>
                )}
            </section>
        </div>
    </main>

    <script is:inline define:vars={{
        targetUsername: profile.username,
        friendshipId,
        // El id de la cuenta que se está mirando, para que la subida sepa a
        // quién pertenece la imagen.
        perfilUserId: profile.id,
        errFriend: t('err.friend.not_possible'),
        errGeneric: t('auth.error.generic'),
    }}>
        async function req(endpoint, method = 'POST', body = {}) {
            try {
                const res = await fetch(endpoint, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
                if (res.ok) { window.location.reload(); return; }

                // El servidor manda códigos; la frase la pone el cliente en el
                // idioma del usuario. Antes se hacía `alert(await res.text())`,
                // que escupía en pantalla lo que respondiera el servidor —en
                // español fijo para todo el mundo, en el caso de amistades—.
                const data = await res.json().catch(() => ({}));
                const messages = { friend_not_possible: errFriend };
                window.showToast?.(messages[data.error_code] || errGeneric, true);
            } catch (e) {
                window.showToast?.(errGeneric, true);
            }
        }

        document.getElementById('add-friend-btn')?.addEventListener('click', () => req('/api/friends/request', 'POST', { target_username: targetUsername }));
        document.getElementById('accept-btn')?.addEventListener('click', () => req(`/api/friends/accept/${friendshipId}`));
        document.getElementById('reject-btn')?.addEventListener('click', () => req(`/api/friends/reject/${friendshipId}`));
        document.getElementById('cancel-request-btn')?.addEventListener('click', () => req(`/api/friends/cancel/${friendshipId}`));
        document.getElementById('unfriend-btn')?.addEventListener('click', () => {
            if (confirm('Remove this friend?')) req(`/api/friends/${friendshipId}`, 'DELETE');
        });
        
        document.getElementById('block-btn')?.addEventListener('click', () => {
            if (confirm('Block this user? They will no longer be able to see your profile or workspaces.')) {
                req(`/api/users/${targetUsername}/block`);
            }
        });
        
        document.getElementById('unblock-btn')?.addEventListener('click', () => req(`/api/users/${targetUsername}/block`, 'DELETE'));

        document.querySelectorAll('.join-ws-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const wsId = e.currentTarget.dataset.wsId;
                req(`/api/workspaces/${wsId}/join`); // Assuming this endpoint will be created later
            });
        });

        // Inline Profile Edits
        async function updateProfile(data) {
            const res = await fetch('/api/users/profile', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            if (!res.ok) alert('Failed to update profile');
            return res.ok;
        }

        /**
         * La subida vive en `lib/client/imagen.ts`.
         *
         * Esta página tenía su propia versión que **no redimensionaba nada**:
         * mandaba el archivo tal cual, así que cambiar el avatar desde aquí
         * —en vez de desde Ajustes— subía la foto de cuatro megas del móvil
         * para servirla a 24×24 píxeles en cada tarjeta del tablero.
         */
        async function uploadFile(file, maxAncho) {
            const r = await window.forgeImagen.subir(file, {
                maxAncho: maxAncho || window.forgeImagen.ANCHOS.avatar,
                entidad: { tipo: 'user', id: perfilUserId },
            });
            if (r.ok) return r.url;
            window.showToast?.(window.forgeMsg?.errGenerico || '', true);
            return null;
        }

        document.getElementById('avatar-upload')?.addEventListener('change', async (e) => {
            const file = e.target.files?.[0];
            if (!file) return;
            const url = await uploadFile(file);
            if (url && await updateProfile({ avatar_url: url })) {
                // Sin foto previa lo que hay son iniciales: más simple recargar.
                const img = document.getElementById('profile-avatar-img');
                if (img) img.src = url; else window.location.reload();
            }
        });

        document.getElementById('banner-upload')?.addEventListener('change', async (e) => {
            const file = e.target.files?.[0];
            if (!file) return;
            // El banner ocupa el ancho de la tarjeta de perfil, no 96 píxeles.
            const url = await uploadFile(file, window.forgeImagen.ANCHOS.banner);
            if (url && await updateProfile({ banner_url: url })) {
                let img = document.getElementById('profile-banner-img');
                if (!img) {
                    img = document.createElement('img');
                    img.alt = '';
                    img.className = 'w-full h-full object-cover relative z-[1]';
                    img.id = 'profile-banner-img';
                    document.querySelector('.perfil-banda')?.prepend(img);
                }
                img.src = url;
            }
        });

        const bioInput = document.getElementById('profile-bio-input');
        const saveBioBtn = document.getElementById('save-bio-btn');
        if (bioInput && saveBioBtn) {
            const originalBio = bioInput.value;
            bioInput.addEventListener('input', () => {
                if (bioInput.value !== originalBio) saveBioBtn.classList.remove('hidden');
                else saveBioBtn.classList.add('hidden');
            });
            saveBioBtn.addEventListener('click', async () => {
                saveBioBtn.innerText = 'Saving...';
                saveBioBtn.disabled = true;
                if (await updateProfile({ bio: bioInput.value })) {
                    saveBioBtn.classList.add('hidden');
                }
                saveBioBtn.innerText = saveBioBtn.dataset.tSave || 'Save bio';
                saveBioBtn.disabled = false;
            });
        }
    </script>
</MainLayout>
