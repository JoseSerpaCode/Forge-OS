---
import MainLayout from '../layouts/MainLayout.astro';
import db from '../lib/db';
import { useTranslations } from '../i18n/ui';
import { colorDeNotificacion } from '../lib/notificaciones';
import { fecha, relativo } from '../lib/fechas';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/login');

const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);

// Fetch unread notifications
const notifications = db.prepare('SELECT * FROM notifications WHERE user_id = ? ORDER BY created_at DESC LIMIT 50').all(user.id) as any[];

// Fetch recent activity from audit logs (where user is the actor)
const recentActivity = db.prepare(`
  SELECT a.id, a.action, a.entity_type, a.entity_id, a.details_json, a.timestamp, w.name as workspace_name
  FROM audit_logs a
  LEFT JOIN workspaces w ON a.workspace_id = w.id
  WHERE a.user_id = ?
  ORDER BY a.timestamp DESC
  LIMIT 50
`).all(user.id) as any[];

// Fetch pending workspace join requests (where user is sender)
const sentRequests = db.prepare(`
  SELECT r.id, r.status, r.created_at, r.workspace_id, w.name as workspace_name, w.sys_tag
  FROM workspace_join_requests r
  JOIN workspaces w ON r.workspace_id = w.id
  WHERE r.user_id = ?
  ORDER BY r.created_at DESC
`).all(user.id) as any[];

const pendingRequests = sentRequests.filter(r => r.status === 'pending');
const historicalRequests = sentRequests.filter(r => r.status !== 'pending');

// Fetch pending invitations (where user is receiver)
const invites = db.prepare(`
  SELECT id, created_at, link_url
  FROM notifications
  WHERE user_id = ? AND type = 'invite'
  ORDER BY created_at DESC
`).all(user.id) as any[];

const parsedInvites = invites.map(inv => {
  let payload = {} as any;
  try { payload = JSON.parse(inv.link_url); } catch (e) {}
  return { ...inv, payload };
});

const unreadCount = notifications.filter(n => n.is_read === 0).length;
---

<MainLayout title={t('activity.title')}>
  <div class="max-w-4xl mx-auto pb-12">
    <div class="page-head">
      <div>
        <h1 class="page-title">{t('activity.title')}</h1>
        <p class="page-sub">{t('activity.desc')}</p>
      </div>
      {/* Pestañas: `.segmentado` con `aria-selected`, y el número va en tinta
          detrás del nombre, no en una píldora de color. */}
      <div class="segmentado" role="tablist" aria-label={t('activity.title')}>
        <button type="button" role="tab" class="activity-tab-btn" data-target="notifications" aria-selected="true">
          {t('activity.notifications')}
          {unreadCount > 0 && <span class="wide ml-1.5">{unreadCount}</span>}
        </button>
        <button type="button" role="tab" class="activity-tab-btn" data-target="invites" aria-selected="false">
          {t('activity.invitations')}
          {(parsedInvites.length > 0 || pendingRequests.length > 0) && <span class="wide ml-1.5">{parsedInvites.length + pendingRequests.length}</span>}
        </button>
      </div>
    </div>

    <div id="tab-notifications" class="activity-tab-content">
      <section class="panel">
        <div class="panel-cabeza">
          <h2 class="text-base font-bold">{t('activity.recent_notifications')}</h2>
          {unreadCount > 0 && (
            <button id="btn-activity-mark-read" class="btn btn-ghost btn-sm">{t('activity.mark_all_read')}</button>
          )}
        </div>
        {notifications.length === 0 ? (
          <p class="panel-cuerpo hint">{t('activity.caught_up')}</p>
        ) : (
          <ul class="divide-y divide-forge-border">
            {notifications.map((n) => (
              <li class="flex items-start gap-3 px-4 py-3.5 group">
                <span class={`sw mt-1.5 ${colorDeNotificacion(n.type, !!n.is_read)}`} aria-hidden="true"></span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-baseline justify-between gap-4">
                    <h3 class={`text-sm ${n.is_read ? 'font-medium text-forge-muted' : 'font-bold text-forge-text'}`}>{n.title}</h3>
                    <time class="text-xs text-forge-muted whitespace-nowrap shrink-0">{relativo(n.created_at, lang)}</time>
                  </div>
                  <p class="text-sm text-forge-muted leading-relaxed mt-0.5">{n.message}</p>
                  {n.link_url && !n.link_url.startsWith('{') && (
                    <a href={n.link_url} class="enlace text-sm inline-block mt-1.5">{t('activity.view_details')}</a>
                  )}
                </div>
                {!n.is_read && (
                  <button class="btn-mark-single-read btn btn-ghost btn-icon btn-sm shrink-0" data-id={n.id} title={t('activity.mark_read')} aria-label={t('activity.mark_read')}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  </button>
                )}
              </li>
            ))}
          </ul>
        )}
      </section>
    </div>

    <div id="tab-invites" class="activity-tab-content hidden flex flex-col gap-6">
      <section class="panel">
        <div class="panel-cabeza"><h2 class="text-base font-bold">{t('activity.invitations')}</h2></div>
        {parsedInvites.length === 0 ? (
          <p class="panel-cuerpo hint">{t('activity.no_invites')}</p>
        ) : (
          <ul class="divide-y divide-forge-border">
            {parsedInvites.map(inv => (
              <li class="flex flex-wrap items-center gap-3 px-4 py-3.5">
                <div class="min-w-0">
                  <b class="text-sm font-semibold text-forge-text">{t('activity.ws_invite')}</b>
                  <p class="hint">{t('activity.role')}: {t(`ws.settings.role_${inv.payload?.role || 'viewer'}` as any)}</p>
                </div>
                <span class="ml-auto flex gap-2">
                  <button class="btn-invite-accept btn btn-primary btn-sm" data-id={inv.id}>{t('ws.settings.accept')}</button>
                  <button class="btn-invite-reject btn btn-secondary btn-sm" data-id={inv.id}>{t('ws.settings.reject')}</button>
                </span>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="panel">
        <div class="panel-cabeza"><h2 class="text-base font-bold">{t('activity.my_requests')}</h2></div>
        {sentRequests.length === 0 ? (
          <p class="panel-cuerpo hint">{t('activity.no_requests')}</p>
        ) : (
          <ul class="divide-y divide-forge-border">
            {sentRequests.map(r => (
              <li class="flex flex-wrap items-center gap-3 px-4 py-3.5">
                <div class="min-w-0">
                  <a href={`/w/${r.sys_tag}`} class="text-sm font-semibold text-forge-text hover:underline">{r.workspace_name}</a>
                  <p class="hint">{fecha(r.created_at, lang)}</p>
                </div>
                <span class="ml-auto flex items-center gap-2">
                  <span class="estado-chip" style={`--c:var(${r.status === 'approved' ? '--forge-success' : r.status === 'rejected' ? '--forge-error' : r.status === 'pending' ? '--forge-warning' : '--forge-muted'})`}>
                    <span class="sw" aria-hidden="true"></span>{t(`activity.req.${r.status}` as any)}
                  </span>
                  {r.status === 'pending' && (
                    <button class="btn-cancel-request btn btn-ghost btn-icon btn-sm" data-req-id={r.id} data-ws-id={r.workspace_id} title={t('activity.cancel_request')} aria-label={t('activity.cancel_request')}>
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                  )}
                </span>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="panel">
        <div class="panel-cabeza"><h2 class="text-base font-bold">{t('activity.recent')}</h2></div>
        {recentActivity.length === 0 ? (
          <p class="panel-cuerpo hint">{t('activity.no_recent')}</p>
        ) : (
          <ul class="divide-y divide-forge-border">
            {recentActivity.slice(0, 10).map((act: any) => (
              <li class="flex items-baseline justify-between gap-4 px-4 py-3 text-sm">
                <span class="min-w-0"><b class="font-semibold text-forge-text">{act.action}</b> <span class="text-forge-muted">· {act.workspace_name || 'Forge OS'}</span></span>
                <time class="text-xs text-forge-muted whitespace-nowrap">{relativo(act.timestamp, lang)}</time>
              </li>
            ))}
          </ul>
        )}
      </section>
    </div>
  </div>
</MainLayout>

<script>
  // Tab switching logic
  document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const tabParam = urlParams.get('tab');
    
    const tabBtns = document.querySelectorAll('.activity-tab-btn') as NodeListOf<HTMLElement>;
    const tabContents = document.querySelectorAll('.activity-tab-content');
    
    function switchTab(targetId: string) {
      tabBtns.forEach(btn => {
        btn.setAttribute('aria-selected', String(btn.dataset.target === targetId));
      });
      
      tabContents.forEach(content => {
        if (content.id === `tab-${targetId}`) {
          content.classList.remove('hidden');
        } else {
          content.classList.add('hidden');
        }
      });
      
      const newUrl = new URL(window.location.href);
      newUrl.searchParams.set('tab', targetId);
      window.history.replaceState({}, '', newUrl);
    }
    
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        switchTab(btn.dataset.target!);
      });
    });
    
    if (tabParam === 'invites') {
      switchTab('invites');
    } else {
      switchTab('notifications');
    }
  });

  document.getElementById('btn-activity-mark-read')?.addEventListener('click', async () => {
    try {
      const res = await fetch('/api/user/notifications', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'mark_all_read' })
      });
      if (res.ok) {
        window.location.reload();
      }
    } catch (e) { console.error(e); }
  });

  document.querySelectorAll('.btn-mark-single-read').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
      try {
        const res = await fetch('/api/user/notifications', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'mark_read', id })
        });
        if (res.ok) {
          window.location.reload();
        }
      } catch (e) { console.error(e); }
    });
  });

  document.querySelectorAll('.btn-cancel-request').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const el = e.currentTarget as HTMLElement;
      const reqId = el.getAttribute('data-req-id');
      const wsId = el.getAttribute('data-ws-id');
      
      try {
        const res = await fetch(`/api/workspaces/${wsId}/requests/${reqId}`, {
          method: 'DELETE'
        });
        if (res.ok) {
          window.location.reload();
        } else {
          console.error(await res.text());
          window.showToast?.(window.forgeMsg?.errGenerico || '', true);
        }
      } catch (e) { console.error(e); }
    });
  });

  document.querySelectorAll('.btn-invite-accept').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
      try {
        const res = await fetch('/api/user/invites', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ notifId: id, action: 'accept' })
        });
        if (res.ok) {
          window.location.reload();
        } else {
          console.error(await res.text());
          window.showToast?.(window.forgeMsg?.errGenerico || '', true);
        }
      } catch (e) { console.error(e); }
    });
  });

  document.querySelectorAll('.btn-invite-reject').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
      try {
        const res = await fetch('/api/user/invites', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ notifId: id, action: 'reject' })
        });
        if (res.ok) {
          window.location.reload();
        } else {
          console.error(await res.text());
          window.showToast?.(window.forgeMsg?.errGenerico || '', true);
        }
      } catch (e) { console.error(e); }
    });
  });
</script>
