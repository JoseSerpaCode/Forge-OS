---
import MainLayout from '../../../layouts/MainLayout.astro';
import db from '../../../lib/db';
import { checkWorkspaceAccess } from '../../../lib/guard';
import { useTranslations } from '../../../i18n/ui';
import { conexionDe, driveDisponible } from '../../../lib/drive';
import { archivosDe, caminoDe, carpeta, carpetasDe } from '../../../lib/driveFiles';
import LabelPicker from '../../../components/labels/LabelPicker.astro';
import { deVarias as etiquetasDeVarias, listar as listarEtiquetas } from '../../../lib/labels';
import { abrirEspacioDePagina } from '../../../lib/paginaEspacio';

/**
 * Sección de archivos.
 *
 * Los archivos viven en el Drive de quien conectó la cuenta; aquí solo están
 * sus datos. Los bytes no pasan por esta máquina ni al subir ni al abrir: se
 * suben del navegador a Google, y se abren en Drive.
 */

const { sys_tag } = Astro.params;
const user = Astro.locals.user!;
const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);

if (!user) return Astro.redirect('/login');
if (user.is_guest) return Astro.redirect('/register');

const acceso = abrirEspacioDePagina(sys_tag, user, 'viewer');
if (!acceso.ok) return Astro.redirect(acceso.redirigir);
const workspace = acceso.ws;

const esPropietario = acceso.rol === 'owner';
const puedeEditar = acceso.rol !== 'viewer';
const conexion = conexionDe(workspace.id);
const disponible = driveDisponible();

// La carpeta que se está mirando. Se comprueba que sea de este espacio: con un
// id de otro, se enseña la raíz en vez de fingir una carpeta vacía.
const carpetaPedida = Astro.url.searchParams.get('folder');
const carpetaActual = carpetaPedida ? carpeta(carpetaPedida, workspace.id) : null;
const folderId = carpetaActual?.id ?? null;

const camino = caminoDe(folderId, workspace.id);
const carpetas = conexion ? carpetasDe(workspace.id, folderId) : [];
const archivos = conexion ? archivosDe(workspace.id, folderId) : [];

// Las etiquetas de todos los archivos en **una** consulta, no una por fila.
const etiquetasPorArchivo = etiquetasDeVarias('file', archivos.map((a) => a.id));
const catalogoEtiquetas = listarEtiquetas(workspace.id);

// El resultado de volver de Google. Se traduce aquí y no se enseña el código.
const codigo = Astro.url.searchParams.get('drive');
const RESULTADOS: Record<string, { clave: string; mal: boolean }> = {
  ok: { clave: 'drive.result_ok', mal: false },
  ok_not_shared: { clave: 'drive.result_ok_not_shared', mal: true },
  cancelled: { clave: 'drive.result_cancelled', mal: false },
  missing_scope: { clave: 'drive.result_missing_scope', mal: true },
  no_refresh_token: { clave: 'drive.result_no_refresh_token', mal: true },
  folder_failed: { clave: 'drive.result_folder_failed', mal: true },
  wrong_user: { clave: 'drive.result_wrong_user', mal: true },
  forbidden: { clave: 'drive.result_forbidden', mal: true },
  bad_state: { clave: 'drive.result_bad_state', mal: true },
  google_error: { clave: 'drive.result_google_error', mal: true },
};
// `hasOwn` y no un acceso directo: el código viene de la URL, y `?drive=constructor`
// devolvería algo del prototipo de Object —cierto, pero sin `clave` ni `mal`—, que
// aquí se traduce en un recuadro de aviso vacío.
const resultado = codigo && Object.hasOwn(RESULTADOS, codigo) ? RESULTADOS[codigo] : undefined;

const TXT = {
  connect: t('drive.connect'),
  uploading: t('drive.uploading'),
  upload: t('drive.upload'),
  folderName: t('drive.folder_name'),
  removeConfirm: t('drive.remove_confirm'),
  remove: t('drive.remove'),
  errTooLarge: t('drive.err_too_large'),
  errUpload: t('drive.err_upload'),
  errFolder: t('drive.err_folder'),
  errFolderDup: t('drive.err_folder_dup'),
  errRemove: t('drive.err_remove'),
  searchNone: t('drive.search_none'),
  searchRecent: t('drive.search_recent'),
  connecting: t('drive.connecting'),
  disconnectConfirm: t('drive.disconnect_confirm'),
  disconnect: t('drive.disconnect'),
  error: t('drive.result_google_error'),
};
---

<MainLayout hideFooter={true} title={`${t('drive.title')} — ${workspace.name}`} workspaceId={workspace.id}>
  <div class="max-w-[900px] mx-auto space-y-6">
    <header class="bg-gradient-to-r from-forge-panel to-forge-panel/50 p-6 rounded-2xl border border-forge-border/40 shadow-sm">
      <h1 class="text-2xl font-bold text-forge-text flex items-center gap-2.5">
        <span class="w-10 h-10 rounded-xl bg-forge-bg flex items-center justify-center border border-forge-border/60 shadow-sm text-forge-accent-text">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
        </span>
        {t('drive.title')}
      </h1>
      <p class="text-sm text-forge-muted mt-2 max-w-xl leading-relaxed">{t('drive.subtitle')}</p>
    </header>

    {resultado && (
      <div id="drive-result" class:list={[
        'rounded-2xl border px-5 py-4 text-sm',
        resultado.mal
          ? 'border-forge-error/40 bg-forge-error/10 text-forge-text'
          : 'border-forge-secondary/40 bg-forge-secondary/10 text-forge-text',
      ]}>
        {t(resultado.clave as any)}
      </div>
    )}

    {/* El aviso de «no configurado» es un aviso, no un muro.
        Antes ocupaba el sitio de todo lo demás: si a este servidor le faltaran
        las credenciales de Google —porque se rotaron y no se pusieron, por
        ejemplo—, un espacio con cien archivos subidos enseñaba esta frase y
        nada más. Una lista que desaparece parece pérdida de datos, y no lo es:
        los archivos siguen en su Drive y sus nombres siguen aquí. */}
    {!disponible && (
      <div class="rounded-2xl border border-forge-border bg-forge-panel px-5 py-4 text-sm text-forge-muted">
        {t('drive.unavailable')}
      </div>
    )}

    {!conexion ? (
      disponible ? (
      <div class="bg-forge-panel border border-dashed border-forge-border rounded-2xl p-8">
        <h2 class="text-lg font-bold text-forge-text">{t('drive.not_connected')}</h2>
        <p class="text-sm text-forge-muted mt-2 max-w-xl leading-relaxed">{t('drive.not_connected_desc')}</p>

        {/* Los dos avisos van **antes** del botón, no escondidos detrás. Quien
            conecta decide por todo el equipo y pone su propio almacenamiento. */}
        <ul class="mt-5 space-y-3 text-sm text-forge-muted max-w-xl">
          <li class="flex gap-3">
            <svg class="shrink-0 mt-0.5 text-forge-accent-text" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="m14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            <span>{t('drive.warn_link')}</span>
          </li>
          <li class="flex gap-3">
            <svg class="shrink-0 mt-0.5 text-forge-accent-text" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            <span>{t('drive.warn_owner')}</span>
          </li>
        </ul>

        {esPropietario ? (
          <button id="btn-drive-connect" class="mt-6 bg-forge-primary text-forge-on-accent px-6 py-2.5 rounded-xl font-bold hover:opacity-90 transition-all shadow-sm">
            {t('drive.connect')}
          </button>
        ) : (
          <p class="mt-6 text-sm text-forge-muted italic">{t('drive.only_owner')}</p>
        )}
      </div>
      ) : null
    ) : (
      <div class="space-y-6">
        {conexion.status === 'revoked' && (
          <div class="rounded-2xl border border-forge-error/40 bg-forge-error/10 px-5 py-4">
            <h2 class="text-sm font-bold text-forge-text">{t('drive.revoked')}</h2>
            <p class="text-sm text-forge-muted mt-1 leading-relaxed">{t('drive.revoked_desc')}</p>
            {esPropietario && (
              <button id="btn-drive-reconnect" class="mt-4 bg-forge-primary text-forge-on-accent px-5 py-2 rounded-xl text-sm font-bold hover:opacity-90 transition-all">
                {t('drive.reconnect')}
              </button>
            )}
          </div>
        )}

        <div class="bg-forge-panel border border-forge-border rounded-2xl p-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="min-w-0">
              <p class="text-[10px] font-bold uppercase tracking-widest text-forge-muted">{t('drive.connected_as')}</p>
              <p class="text-base font-bold text-forge-text truncate">{conexion.googleEmail || '—'}</p>
              {conexion.connectedAt && (
                <p class="text-xs text-forge-muted mt-1">{t('drive.connected_on')} {conexion.connectedAt.slice(0, 10)}</p>
              )}
            </div>
            <div class="flex items-center gap-3 shrink-0">
              {conexion.folderLink && (
                <a href={conexion.folderLink} target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-forge-accent-text hover:underline">
                  {t('drive.open_folder')}
                </a>
              )}
              {esPropietario && (
                <button id="btn-drive-disconnect" class="text-sm font-bold text-forge-muted hover:text-forge-error transition-colors px-3 py-2 rounded-xl">
                  {t('drive.disconnect')}
                </button>
              )}
            </div>
          </div>

          <p class="mt-5 pt-5 border-t border-forge-border/40 text-xs text-forge-muted leading-relaxed">{t('drive.warn_link')}</p>
        </div>

        {/* El explorador. Carpetas primero y archivos después, como en
            cualquier gestor de archivos: mezclarlos obliga a leer el icono de
            cada fila para saber en qué se puede entrar. */}
        <div class="bg-forge-panel border border-forge-border rounded-2xl overflow-hidden">
          <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 border-b border-forge-border/40">
            <nav class="flex items-center gap-1.5 text-sm min-w-0" aria-label={t('drive.files_title')}>
              <a href={`/w/${sys_tag}/files`} class:list={['truncate hover:underline', camino.length ? 'text-forge-muted' : 'text-forge-text font-bold']}>
                {t('drive.root')}
              </a>
              {camino.map((c, i) => (
                <>
                  <span class="text-forge-border">/</span>
                  <a
                    href={`/w/${sys_tag}/files?folder=${c.id}`}
                    class:list={['truncate hover:underline', i === camino.length - 1 ? 'text-forge-text font-bold' : 'text-forge-muted']}
                  >{c.name}</a>
                </>
              ))}
            </nav>

            {puedeEditar && disponible && conexion.status === 'ok' && (
              <div class="flex items-center gap-2 shrink-0">
                <button id="btn-nueva-carpeta" class="text-xs font-bold text-forge-muted hover:text-forge-text border border-forge-border rounded-lg px-3 py-2 transition-colors flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/><path d="M12 10v6"/><path d="M9 13h6"/></svg>
                  {t('drive.new_folder')}
                </button>
                <button id="btn-subir" class="bg-forge-primary text-forge-on-accent text-xs font-bold px-4 py-2 rounded-lg hover:opacity-90 transition-all flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>
                  {t('drive.upload')}
                </button>
                <input type="file" id="input-archivo" class="hidden" multiple aria-label={t('drive.upload')}>
              </div>
            )}
          </div>

          {/* Buscador. Busca en **todo el espacio**, no en la carpeta abierta:
              quien busca «laboratorio» no sabe en qué carpeta lo dejó, y por
              eso lo busca. */}
          <div class="px-5 py-3 border-b border-forge-border/40 relative">
            <div class="flex items-center gap-2">
              <svg class="text-forge-muted shrink-0" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
              <input type="search" id="buscador-archivos" autocomplete="off" placeholder={t('drive.search')} aria-label={t('drive.search')} class="flex-1 bg-transparent text-sm text-forge-text placeholder:text-forge-muted outline-none py-1">
              <a id="volver-archivos" href={`/w/${sys_tag}/files`} class="hidden text-xs font-bold text-forge-muted hover:text-forge-text shrink-0">{t('drive.back_to_files')}</a>
            </div>

            <div id="historial-busqueda" class="hidden absolute left-5 right-5 top-full z-20 bg-forge-panel border border-forge-border rounded-xl shadow-xl p-2 mt-1">
              <div class="flex items-center justify-between px-2 pb-1.5">
                <span class="text-[10px] font-bold uppercase tracking-widest text-forge-muted">{t('drive.search_recent')}</span>
                <button type="button" id="btn-olvidar-busquedas" class="text-[10px] font-bold text-forge-muted hover:text-forge-error transition-colors">{t('drive.search_clear')}</button>
              </div>
              <div id="lista-historial" class="space-y-0.5"></div>
            </div>
          </div>

          {/* Progreso. Aparece solo mientras hay algo subiendo. */}
          <div id="zona-progreso" class="hidden px-5 py-3 border-b border-forge-border/40 space-y-2"></div>

          {/* Nombre de la carpeta nueva, en línea.
              Con `prompt()` pasaría lo mismo que pasaba con `confirm()`: tras
              el primero, el navegador ofrece bloquear los diálogos y a partir
              de ahí el botón se queda mudo sin decir por qué. */}
          <form id="form-carpeta" class="hidden px-5 py-3 border-b border-forge-border/40 flex flex-wrap items-center gap-2">
            <input type="text" id="nombre-carpeta" maxlength="200" autocomplete="off" placeholder={t('drive.folder_name')} aria-label={t('drive.folder_name')} class="flex-1 min-w-[12rem] bg-forge-bg border border-forge-border rounded-lg px-3 py-2 text-sm text-forge-text focus:border-forge-secondary focus:ring-1 focus:ring-forge-secondary/30 outline-none">
            <button type="submit" class="bg-forge-primary text-forge-on-accent text-xs font-bold px-4 py-2 rounded-lg hover:opacity-90 transition-all">{t('drive.new_folder')}</button>
            <button type="button" id="btn-cancelar-carpeta" class="text-xs font-bold text-forge-muted hover:text-forge-text px-3 py-2">{t('labels.cancel')}</button>
          </form>

          <ul id="lista-archivos" class="divide-y divide-forge-border/40">
            {carpetas.map(c => (
              <li class="flex items-center gap-3 px-5 py-3 hover:bg-forge-bg/50 transition-colors">
                <span class="text-forge-accent-text shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
                </span>
                <a href={`/w/${sys_tag}/files?folder=${c.id}`} class="flex-1 min-w-0 text-sm font-bold text-forge-text truncate hover:underline">{c.name}</a>
                {!c.driveId && <span class="text-[10px] text-forge-muted italic shrink-0">{t('drive.folder_not_synced')}</span>}
              </li>
            ))}

            {archivos.map(f => (
              <li class="archivo-fila flex items-center gap-3 px-5 py-3 hover:bg-forge-bg/50 transition-colors" data-id={f.id}>
                <span class:list={['shrink-0', f.status === 'missing' ? 'text-forge-error' : 'text-forge-muted']}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v5h6"/></svg>
                </span>
                <div class="flex-1 min-w-0">
                  {f.webViewLink && f.status === 'ok' ? (
                    <a href={f.webViewLink} target="_blank" rel="noopener noreferrer" class="block text-sm font-bold text-forge-text truncate hover:underline">{f.name}</a>
                  ) : (
                    <span class="block text-sm font-bold text-forge-text truncate">{f.name}</span>
                  )}
                  <p class="text-[11px] text-forge-muted mt-0.5 truncate">
                    {f.status === 'missing' && <span class="text-forge-error font-bold">{t('drive.missing')} · </span>}
                    {f.sizeBytes ? `${(f.sizeBytes / 1024 / 1024).toFixed(1)} MB · ` : ''}
                    {f.uploaderName ? `${t('drive.uploaded_by')} ${f.uploaderName} · ` : ''}
                    {f.createdAt?.slice(0, 10)}
                  </p>
                  <LabelPicker
                    sysTag={sys_tag!}
                    entityType="file"
                    entityId={f.id}
                    initial={etiquetasPorArchivo.get(f.id) ?? []}
                    catalog={catalogoEtiquetas}
                    canEdit={puedeEditar}
                    class="mt-1.5"
                  />
                </div>
                {puedeEditar && (
                  <button class="btn-quitar-archivo text-forge-muted hover:text-forge-error p-2 rounded-lg hover:bg-red-500/10 transition-colors shrink-0" aria-label={t('drive.remove')} title={t('drive.remove')}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                  </button>
                )}
              </li>
            ))}
          </ul>

          {/* Los resultados van en su **propia** lista, y la de la carpeta se
              esconde. Antes se reescribía el contenido de la lista original al
              volver de una búsqueda, y eso dejaba sin escuchadores los
              selectores de etiqueta de cada fila: seguían pintados pero ya no
              respondían. */}
          <ul id="resultados-busqueda" class="hidden divide-y divide-forge-border/40"></ul>

          {carpetas.length === 0 && archivos.length === 0 && (
            <div class="px-5 py-16 text-center">
              <p class="text-sm font-bold text-forge-text">{t('drive.empty')}</p>
              <p class="text-xs text-forge-muted mt-1.5 max-w-sm mx-auto leading-relaxed">{t('drive.empty_desc')}</p>
            </div>
          )}
        </div>
      </div>
    )}
  </div>

  <script define:vars={{ sysTag: sys_tag, TXT }}>
    const apiDrive = `/api/w/${sysTag}/drive`;
    const api = `/api/w/${sysTag}/files`;

    async function conectar(boton) {
      boton.disabled = true;
      const original = boton.textContent;
      boton.textContent = TXT.connecting;
      try {
        const res = await fetch(apiDrive, { method: 'POST' });
        if (!res.ok) throw new Error('no');
        const { url } = await res.json();
        // La redirección la hace el navegador, no el `fetch`: si el endpoint
        // respondiera con un 302, `fetch` lo seguiría él solo y se traería el
        // HTML de Google a ninguna parte.
        window.location.href = url;
      } catch {
        window.showToast?.(TXT.error, true);
        boton.disabled = false;
        boton.textContent = original;
      }
    }

    document.getElementById('btn-drive-connect')?.addEventListener('click', (e) => conectar(e.currentTarget));
    document.getElementById('btn-drive-reconnect')?.addEventListener('click', (e) => conectar(e.currentTarget));

    // ── Subir ────────────────────────────────────────────────────────────────
    //
    // Tres pasos: el servidor abre una sesión en Drive, el navegador manda el
    // archivo **directamente a Google**, y el servidor comprueba lo subido y lo
    // da de alta. Los bytes no tocan nuestra máquina en ningún momento; con
    // 1 GB de salida al mes, hacer de intermediario no es una opción.
    const inputArchivo = document.getElementById('input-archivo');
    const zonaProgreso = document.getElementById('zona-progreso');
    const carpetaActualId = new URLSearchParams(location.search).get('folder');

    document.getElementById('btn-subir')?.addEventListener('click', () => inputArchivo?.click());

    function barraDe(nombre) {
      const fila = document.createElement('div');
      fila.className = 'text-xs';
      const texto = document.createElement('div');
      texto.className = 'flex justify-between gap-3 text-forge-muted mb-1';
      const izq = document.createElement('span');
      izq.className = 'truncate';
      izq.textContent = nombre;
      const der = document.createElement('span');
      der.className = 'shrink-0 font-mono';
      der.textContent = '0%';
      texto.append(izq, der);

      const canal = document.createElement('div');
      canal.className = 'h-1.5 bg-forge-bg rounded-full overflow-hidden border border-forge-border';
      const barra = document.createElement('div');
      barra.className = 'h-full bg-forge-secondary transition-all';
      barra.style.width = '0%';
      canal.appendChild(barra);

      fila.append(texto, canal);
      zonaProgreso.appendChild(fila);
      zonaProgreso.classList.remove('hidden');
      return { fila, barra, der };
    }

    /** El `PUT` a Drive, con progreso. `fetch` no lo da; XHR sí. */
    function subirADrive(url, archivo, alAvanzar) {
      return new Promise((resolve, reject) => {
        const xhr = new XMLHttpRequest();
        xhr.open('PUT', url, true);
        xhr.upload.onprogress = (e) => {
          if (e.lengthComputable) alAvanzar(Math.round((e.loaded / e.total) * 100));
        };
        xhr.onload = () => {
          if (xhr.status >= 200 && xhr.status < 300) {
            try { resolve(JSON.parse(xhr.responseText)); } catch { reject(new Error('respuesta rara')); }
          } else {
            reject(new Error(`drive ${xhr.status}`));
          }
        };
        xhr.onerror = () => reject(new Error('red'));
        xhr.send(archivo);
      });
    }

    async function subirUno(archivo) {
      const { fila, barra, der } = barraDe(archivo.name);
      try {
        const sesion = await fetch(`${api}/upload`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: archivo.name,
            size: archivo.size,
            mime_type: archivo.type,
            folder_id: carpetaActualId,
          }),
        });
        const datos = await sesion.json().catch(() => ({}));
        if (!sesion.ok) {
          throw new Error(datos.error_code === 'too_large' ? TXT.errTooLarge : TXT.errUpload);
        }

        const subido = await subirADrive(datos.upload_url, archivo, (pct) => {
          barra.style.width = `${pct}%`;
          der.textContent = `${pct}%`;
        });

        // El servidor comprueba con Drive que el archivo está donde decimos
        // antes de darlo de alta; lo que dice el navegador no basta.
        const alta = await fetch(`${api}/upload`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ drive_id: subido.id, folder_id: carpetaActualId }),
        });
        if (!alta.ok) throw new Error(TXT.errUpload);

        fila.remove();
        return true;
      } catch (e) {
        fila.remove();
        window.showToast?.(e instanceof Error && e.message !== 'red' ? e.message : TXT.errUpload, true);
        return false;
      }
    }

    inputArchivo?.addEventListener('change', async () => {
      const archivos = [...(inputArchivo.files || [])];
      inputArchivo.value = '';
      if (!archivos.length) return;

      let alguno = false;
      // De uno en uno: en paralelo, varias subidas grandes se pelean por el
      // ancho de banda y todas van lentas.
      for (const a of archivos) alguno = (await subirUno(a)) || alguno;

      zonaProgreso.classList.add('hidden');
      if (alguno) window.location.reload();
    });

    // ── Carpetas ─────────────────────────────────────────────────────────────
    const formCarpeta = document.getElementById('form-carpeta');
    const campoCarpeta = document.getElementById('nombre-carpeta');

    function mostrarFormCarpeta(si) {
      formCarpeta?.classList.toggle('hidden', !si);
      if (si) { campoCarpeta.value = ''; campoCarpeta.focus(); }
    }

    document.getElementById('btn-nueva-carpeta')?.addEventListener('click', () => mostrarFormCarpeta(true));
    document.getElementById('btn-cancelar-carpeta')?.addEventListener('click', () => mostrarFormCarpeta(false));
    campoCarpeta?.addEventListener('keydown', (e) => { if (e.key === 'Escape') mostrarFormCarpeta(false); });

    formCarpeta?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const nombre = campoCarpeta.value.trim();
      if (!nombre) return;

      const res = await fetch(api, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: nombre, parent_id: carpetaActualId }),
      });
      const datos = await res.json().catch(() => ({}));
      if (!res.ok) {
        return window.showToast?.(datos.error_code === 'duplicate' ? TXT.errFolderDup : TXT.errFolder, true);
      }
      window.location.reload();
    });

    // ── Buscar ───────────────────────────────────────────────────────────────
    //
    // Los resultados sustituyen a la lista mientras dura la búsqueda; al
    // vaciar el campo vuelve la carpeta. No se cambia la URL en cada tecla:
    // llenaría el historial del navegador de estados intermedios.
    const buscador = document.getElementById('buscador-archivos');
    const historial = document.getElementById('historial-busqueda');
    const listaHistorial = document.getElementById('lista-historial');
    const lista = document.getElementById('lista-archivos');
    const resultados = document.getElementById('resultados-busqueda');
    const volver = document.getElementById('volver-archivos');

    function pintarHistorial(consultas) {
      if (!listaHistorial) return;
      listaHistorial.innerHTML = '';
      for (const q of consultas) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'w-full text-left px-2 py-1.5 rounded-lg text-xs text-forge-text hover:bg-forge-bg transition-colors truncate';
        b.textContent = q;
        b.addEventListener('mousedown', (e) => {
          // `mousedown` y no `click`: el `blur` del campo esconde el panel
          // antes de que llegue el `click`, y el botón no llegaba a responder.
          e.preventDefault();
          buscador.value = q;
          buscar(q);
          historial.classList.add('hidden');
        });
        listaHistorial.appendChild(b);
      }
      historial?.classList.toggle('hidden', consultas.length === 0);
    }

    function filaDeResultado(f) {
      const li = document.createElement('li');
      li.className = 'archivo-fila flex items-center gap-3 px-5 py-3 hover:bg-forge-bg/50 transition-colors';
      li.dataset.id = f.id;

      const icono = document.createElement('span');
      icono.className = f.status === 'missing' ? 'shrink-0 text-forge-error' : 'shrink-0 text-forge-muted';
      icono.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v5h6"/></svg>';

      const centro = document.createElement('div');
      centro.className = 'flex-1 min-w-0';
      const titulo = f.webViewLink && f.status === 'ok' ? document.createElement('a') : document.createElement('span');
      titulo.className = 'block text-sm font-bold text-forge-text truncate';
      if (titulo instanceof HTMLAnchorElement) {
        titulo.href = f.webViewLink;
        titulo.target = '_blank';
        titulo.rel = 'noopener noreferrer';
        titulo.classList.add('hover:underline');
      }
      titulo.textContent = f.name;

      const meta = document.createElement('p');
      meta.className = 'text-[11px] text-forge-muted mt-0.5 truncate';
      const trozos = [];
      if (f.sizeBytes) trozos.push(`${(f.sizeBytes / 1024 / 1024).toFixed(1)} MB`);
      if (f.uploaderName) trozos.push(f.uploaderName);
      if (f.createdAt) trozos.push(f.createdAt.slice(0, 10));
      meta.textContent = trozos.join(' · ');

      centro.append(titulo, meta);

      if (f.labels?.length) {
        const chips = document.createElement('div');
        chips.className = 'flex flex-wrap gap-1 mt-1.5';
        for (const e of f.labels) {
          const chip = document.createElement('span');
          chip.className = 'inline-flex items-center gap-1.5 rounded-md border border-forge-border/60 bg-forge-bg text-forge-text px-2 py-1 text-xs max-w-full';
          const punto = document.createElement('span');
          punto.className = 'rounded-full shrink-0 w-2 h-2';
          punto.style.backgroundColor = e.color;
          const nombre = document.createElement('span');
          nombre.className = 'truncate';
          nombre.textContent = e.name;
          chip.append(punto, nombre);
          chips.appendChild(chip);
        }
        centro.appendChild(chips);
      }

      li.append(icono, centro);
      return li;
    }

    let ultimaBusqueda = 0;
    async function buscar(texto) {
      const mio = ++ultimaBusqueda;
      const limpio = texto.trim();

      if (!limpio) {
        // Vuelve la carpeta, que nunca se tocó.
        lista?.classList.remove('hidden');
        resultados?.classList.add('hidden');
        volver?.classList.add('hidden');
        return;
      }

      const res = await fetch(`${api}/search?q=${encodeURIComponent(limpio)}`);
      if (!res.ok || mio !== ultimaBusqueda) return; // llegó tarde: manda la última
      const datos = await res.json();

      if (!resultados) return;
      resultados.innerHTML = '';
      if (datos.files.length === 0) {
        const vacio = document.createElement('li');
        vacio.className = 'px-5 py-10 text-center text-sm text-forge-muted';
        vacio.textContent = TXT.searchNone;
        resultados.appendChild(vacio);
      } else {
        for (const f of datos.files) resultados.appendChild(filaDeResultado(f));
      }
      lista?.classList.add('hidden');
      resultados.classList.remove('hidden');
      volver?.classList.remove('hidden');
    }

    let temporizador;
    buscador?.addEventListener('input', () => {
      clearTimeout(temporizador);
      historial?.classList.add('hidden');
      // Un respiro antes de preguntar: si no, se lanza una búsqueda por tecla.
      temporizador = setTimeout(() => buscar(buscador.value), 250);
    });

    buscador?.addEventListener('focus', async () => {
      if (buscador.value.trim()) return;
      const res = await fetch(`${api}/search`);
      if (res.ok) pintarHistorial((await res.json()).history || []);
    });
    buscador?.addEventListener('blur', () => setTimeout(() => historial?.classList.add('hidden'), 150));

    document.getElementById('btn-olvidar-busquedas')?.addEventListener('mousedown', async (e) => {
      e.preventDefault();
      await fetch(`${api}/search`, { method: 'DELETE' });
      pintarHistorial([]);
    });

    // ── Quitar ───────────────────────────────────────────────────────────────
    document.getElementById('lista-archivos')?.addEventListener('click', (e) => {
      const boton = e.target.closest('.btn-quitar-archivo');
      if (!boton) return;
      const fila = boton.closest('.archivo-fila');

      window.forgeConfirm?.(TXT.removeConfirm, async () => {
        const res = await fetch(api, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: fila.dataset.id }),
        });
        if (!res.ok) return window.showToast?.(TXT.errRemove, true);
        fila.remove();
      }, TXT.remove);
    });

    document.getElementById('btn-drive-disconnect')?.addEventListener('click', () => {
      window.forgeConfirm?.(TXT.disconnectConfirm, async () => {
        try {
          const res = await fetch(apiDrive, { method: 'DELETE' });
          if (res.ok) window.location.href = `/w/${sysTag}/files`;
          else window.showToast?.(TXT.error, true);
        } catch {
          window.showToast?.(TXT.error, true);
        }
      }, TXT.disconnect);
    });
  </script>
</MainLayout>
