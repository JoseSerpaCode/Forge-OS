---
// src/pages/w/[sys_tag]/index.astro — Redesigned Dashboard
import MainLayout from '../../../layouts/MainLayout.astro';
import db from '../../../lib/db';
import { checkWorkspaceAccess } from '../../../lib/guard';

const { sys_tag } = Astro.params;
const user = Astro.locals.user!;

if (!user) return Astro.redirect('/login');

import { useTranslations } from '../../../i18n/ui';
import { fecha, relativo, deSQLite, diasHasta } from '../../../lib/fechas';
import { mapaPorClave } from '../../../lib/issueTypes';
import TaskTable from '../../../components/dashboard/TaskTable.astro';
import { abrirEspacioDePagina } from '../../../lib/paginaEspacio';
import { funciones } from '../../../lib/funcionesEspacio';
import { hoyEn } from '../../../lib/fechas';
const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);

const acceso = abrirEspacioDePagina(sys_tag, user, 'viewer');
if (!acceso.ok) return Astro.redirect(acceso.redirigir);
const workspace = acceso.ws;

// ──── Stats ────
// Sin sprints, ni sprint activo ni roadmap: el resumen enseña la semana y las
// próximas entregas. Las subtareas no cuentan en ningún total.
const funcs = funciones(workspace.id);
const activeSprints = funcs.sprints ? db.prepare(`
  SELECT id, name, start_date, end_date, goal 
  FROM sprints WHERE workspace_id = ? AND status = 'active' 
  ORDER BY start_date ASC
`).all(workspace.id) as any[] : [];

const urlSprintId = Astro.url.searchParams.get('sprint');
let activeSprint = activeSprints.find(s => s.id === urlSprintId);
if (!activeSprint && activeSprints.length > 0) {
  activeSprint = activeSprints[0];
}

let pendingIssues = { count: 0 };
let blockedIssues = { count: 0 };
let sprintProgress = 0;
let sprintDaysLeft = 0;

if (activeSprint) {
  pendingIssues = db.prepare(`
    SELECT COUNT(*) as count FROM issues 
    WHERE workspace_id = ? AND sprint_id = ? AND status != 'done'
  `).get(workspace.id, activeSprint.id) as any;

  blockedIssues = db.prepare(`
    SELECT COUNT(*) as count FROM issues 
    WHERE workspace_id = ? AND sprint_id = ? AND status = 'blocked'
  `).get(workspace.id, activeSprint.id) as any;

  const doneInSprint = db.prepare(`
    SELECT COUNT(*) as count FROM issues WHERE sprint_id = ? AND status = 'done'
  `).get(activeSprint.id) as any;
  const totalInSprint = db.prepare(`
    SELECT COUNT(*) as count FROM issues WHERE sprint_id = ?
  `).get(activeSprint.id) as any;
  
  sprintProgress = totalInSprint.count > 0 
    ? Math.round((doneInSprint.count / totalInSprint.count) * 100) 
    : 0;
  
  // Días del calendario, no horas: con `new Date(end_date)` una fecha
  // solo-día era la medianoche UTC y el «termina hoy» llegaba un día antes en
  // Bogotá. Ver `diasHasta()`.
  const faltan = diasHasta(activeSprint.end_date);
  if (faltan !== null) sprintDaysLeft = Math.max(0, faltan);
} else {
  pendingIssues = db.prepare(`
    SELECT COUNT(*) as count FROM issues 
    WHERE workspace_id = ? AND status != 'done' AND parent_issue_id IS NULL
  `).get(workspace.id) as any;

  blockedIssues = db.prepare(`
    SELECT COUNT(*) as count FROM issues 
    WHERE workspace_id = ? AND status = 'blocked' AND parent_issue_id IS NULL
  `).get(workspace.id) as any;
}

// La semana, para quien no planifica por sprints. «Hoy» es el de quien mira.
const hoy = hoyEn(user.timezone);
const hechasSemana = (db.prepare(`
  SELECT COUNT(*) AS n FROM issues
  WHERE workspace_id = ? AND parent_issue_id IS NULL AND status = 'done' AND done_at >= datetime('now', '-7 days')
`).get(workspace.id) as any).n as number;
const vencidasTotal = (db.prepare(`
  SELECT COUNT(*) AS n FROM issues
  WHERE workspace_id = ? AND parent_issue_id IS NULL AND status != 'done' AND due_date IS NOT NULL AND substr(due_date, 1, 10) < ?
`).get(workspace.id, hoy) as any).n as number;
const proximasEntregas = funcs.sprints ? [] : db.prepare(`
  SELECT id, title, due_date, due_time FROM issues
  WHERE workspace_id = ? AND parent_issue_id IS NULL AND status != 'done' AND due_date IS NOT NULL AND substr(due_date, 1, 10) >= ?
  ORDER BY substr(due_date, 1, 10) ASC, due_time IS NULL ASC, due_time ASC
  LIMIT 6
`).all(workspace.id, hoy) as Array<{ id: string; title: string; due_date: string; due_time: string | null }>;

const totalPages = db.prepare(`
  SELECT COUNT(*) as count FROM pages WHERE workspace_id = ?
`).get(workspace.id) as any;

// ──── Roadmap (All sprints) ────
const allSprints = funcs.sprints ? db.prepare(`
  SELECT id, name, start_date, end_date, status, goal
  FROM sprints WHERE workspace_id = ?
  ORDER BY COALESCE(start_date, '9999') ASC
  LIMIT 6
`).all(workspace.id) as any[] : [];

// ──── Milestones ────
const milestones = db.prepare(`
  SELECT id, name, target_date, status 
  FROM milestones WHERE workspace_id = ? AND status = 'planned'
  ORDER BY target_date ASC LIMIT 3
`).all(workspace.id) as any[];

// ──── Recent activity (audit log) ────
const recentActivity = db.prepare(`
  SELECT al.action, al.entity_type, al.entity_id, al.details_json, al.timestamp,
         u.username, u.avatar_url
  FROM audit_logs al
  LEFT JOIN users u ON al.user_id = u.id
  WHERE al.entity_id IN (
    SELECT id FROM issues WHERE workspace_id = ?
    UNION SELECT id FROM pages WHERE workspace_id = ?
  )
  ORDER BY al.timestamp DESC LIMIT 8
`).all(workspace.id, workspace.id) as any[];

// ──── Workload per member ────
const members = db.prepare(`
  SELECT u.id, u.username, u.avatar_url
  FROM workspace_members wm JOIN users u ON wm.user_id = u.id
  WHERE wm.workspace_id = ?
  ORDER BY u.username ASC LIMIT 6
`).all(workspace.id) as any[];

for (const member of members) {
  const openIssues = db.prepare(`
    SELECT COUNT(*) as count FROM issues 
    WHERE workspace_id = ? AND assignee_id = ? AND status != 'done' AND parent_issue_id IS NULL
  `).get(workspace.id, member.id) as any;
  member.openCount = openIssues.count;
}
const maxWorkload = Math.max(...members.map((m: any) => m.openCount), 1);

// ──── My tasks in this workspace ────
const myTasks = db.prepare(`
  SELECT i.id, i.title, i.status, i.priority, i.sprint_id, i.type, i.due_date 
  FROM issues i
  WHERE i.workspace_id = ? AND i.status != 'done' AND i.assignee_id = ? AND i.parent_issue_id IS NULL
  ORDER BY 
    CASE i.priority WHEN 'highest' THEN 1 WHEN 'high' THEN 2 WHEN 'medium' THEN 3 WHEN 'low' THEN 4 ELSE 5 END ASC
  LIMIT 5
`).all(workspace.id, user.id) as any[];

/**
 * Las fechas y los relativos salen de `lib/fechas`.
 *
 * Aquí había tres funciones propias: una que leía la fecha bien pero formateaba
 * clavado a `'en-US'`, otra que devolvía `"5m ago"` en inglés fijo aunque la
 * interfaz estuviera en español, y un mapa de acciones —`'moved issue'`,
 * `'created issue'`— también en inglés a mano.
 */
const formatDate = (dateStr: string | null) => fecha(dateStr, lang);
const formatRelative = (dateStr: string) => relativo(dateStr, lang);

/**
 * Qué hizo cada quien, traducido.
 *
 * El respaldo deja de ser `action.toLowerCase().replace('_',' ')` —que enseñaba
 * `issue moved` a la cara— y pasa a ser la propia acción en crudo solo si no
 * hay clave, que es visible como error en vez de parecer una frase.
 */
const actionLabel = (action: string) => {
  const clave = `activity.${action.toLowerCase()}` as any;
  const texto = t(clave);
  return texto === clave ? action : texto;
};

// Los tipos de este espacio, para que la tabla pinte el nombre y el color en
// vez de la clave interna.
const tiposDelEspacio = mapaPorClave(workspace.id);

const priorityColor: Record<string, string> = {
  highest: 'text-forge-error',
  high: 'text-forge-warning',
  medium: 'text-forge-warning',
  low: 'text-forge-info',
  lowest: 'text-forge-muted',
};

// ──── Rediseño «Taller» (docs/rediseno/panel.html) ────
// Cuántas hay en cada estado: en el sprint activo si lo hay; si no, todas
// las del espacio menos las hechas hace más de una semana (las de siempre
// harían la barra eterna).
import { ESTADOS, INFO as INFO_ESTADO } from '../../../lib/status';
const filasEstado = (activeSprint
  ? db.prepare(`SELECT status, COUNT(*) AS n FROM issues WHERE workspace_id = ? AND sprint_id = ? AND parent_issue_id IS NULL GROUP BY status`).all(workspace.id, activeSprint.id)
  : db.prepare(`SELECT status, COUNT(*) AS n FROM issues WHERE workspace_id = ? AND parent_issue_id IS NULL AND (status != 'done' OR done_at >= datetime('now', '-7 days')) GROUP BY status`).all(workspace.id)
) as Array<{ status: string; n: number }>;
const porEstado = Object.fromEntries(ESTADOS.map((e) => [e, filasEstado.find((f) => f.status === e)?.n ?? 0])) as Record<string, number>;
const totalEstados = ESTADOS.reduce((n, e) => n + porEstado[e], 0);
const numMiembros = (db.prepare('SELECT COUNT(*) AS n FROM workspace_members WHERE workspace_id = ?').get(workspace.id) as any).n as number;

// La carga de cada persona, por estado y solo de lo abierto. En neutro: una
// barra roja culpa a alguien de algo que el gráfico no sabe.
const cargaFilas = db.prepare(`
  SELECT assignee_id, status, COUNT(*) AS n FROM issues
  WHERE workspace_id = ? AND parent_issue_id IS NULL AND status != 'done'
  GROUP BY assignee_id, status
`).all(workspace.id) as Array<{ assignee_id: string | null; status: string; n: number }>;
const carga = members.map((m: any) => ({
  ...m,
  estados: ESTADOS.filter((e) => e !== 'done').map((e) => ({ e, n: cargaFilas.find((f) => f.assignee_id === m.id && f.status === e)?.n ?? 0 })),
}));
const maxCarga = Math.max(1, ...carga.map((m: any) => m.openCount));
import { tonoDe, esFotoReal } from '../../../lib/tonos';
import { iniciales } from '../../../lib/responsables';

---

<MainLayout hideFooter={true} title={`${t('sidebar.dashboard')} — ${workspace.name}`} workspaceId={workspace.id}>
  <div class="pb-12">
    {/* Panel del espacio (fase 3 del rediseño). Sin «Bienvenido», sin tarjetas
        de cifras genéricas: el estado del trabajo, lo tuyo, y quién lleva qué. */}
    <header class="page-head">
      <div class="min-w-0">
        <h1 class="page-title">{workspace.name}</h1>
        <p class="page-sub">#{sys_tag} · {numMiembros === 1 ? t('dashboard.people_one') : t('dashboard.people_count').replace('{n}', String(numMiembros))} · {pendingIssues.count === 1 ? t('dashboard.open_one') : t('dashboard.open_count').replace('{n}', String(pendingIssues.count))}</p>
      </div>
      <div class="flex gap-2 shrink-0">
        <a href={`/w/${sys_tag}/p`} class="btn btn-secondary">{t('sidebar.knowledge')}</a>
        <a href={`/w/${sys_tag}/board`} class="btn btn-primary">{t('dashboard.open_board')}</a>
      </div>
    </header>

    <div class="grid gap-4 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] items-start">
      <div class="flex flex-col gap-4 min-w-0">
        {/* El estado del trabajo: del sprint si se usan sprints; si no, de la
            semana. Tres cifras que sirven para decidir y una barra por estado. */}
        <section class="panel">
          <div class="panel-cabeza">
            {activeSprint ? (
              <>
                <h2>{activeSprint.name}</h2>
                <span class="text-sm text-forge-muted">{activeSprint.end_date ? t('dashboard.sprint_ends').replace('{fecha}', formatDate(activeSprint.end_date)) : ''}</span>
              </>
            ) : (
              <>
                <h2>{funcs.sprints ? t('dashboard.no_active_sprint') : t('dashboard.this_week')}</h2>
                <a class="enlace" href={`/w/${sys_tag}/board?vista=hoy`}>{t('view.today')}</a>
              </>
            )}
          </div>
          <div class="panel-cuerpo">
            <div class="grid grid-cols-3 gap-4 mb-4">
              {activeSprint ? (
                <>
                  <div><b class="cifra">{sprintProgress} %</b><span class="hint">{t('dashboard.fig_done_pct')}</span></div>
                  <div><b class="cifra">{sprintDaysLeft}</b><span class="hint">{t('dashboard.fig_days_left')}</span></div>
                  <div><b class="cifra">{pendingIssues.count}</b><span class="hint">{t('dashboard.fig_open')}</span></div>
                </>
              ) : (
                <>
                  <div><b class="cifra">{hechasSemana}</b><span class="hint">{t('dashboard.fig_done_week')}</span></div>
                  <div><b class:list={['cifra', vencidasTotal > 0 && '!text-forge-error']}>{vencidasTotal}</b><span class="hint">{t('dashboard.fig_overdue')}</span></div>
                  <div><b class="cifra">{pendingIssues.count}</b><span class="hint">{t('dashboard.fig_open')}</span></div>
                </>
              )}
            </div>
            {totalEstados > 0 && (
              <>
                <div class="barra !h-3.5 !bg-transparent" aria-hidden="true">
                  {ESTADOS.filter((e) => porEstado[e] > 0).map((e) => (
                    <span style={`width:${(porEstado[e] / totalEstados) * 100}%;--c:${INFO_ESTADO[e].color}`}></span>
                  ))}
                </div>
                <ul class="flex gap-x-5 gap-y-2 flex-wrap mt-3">
                  {ESTADOS.map((e) => (
                    <li class="flex items-center gap-2 text-sm">
                      <span class="estado-chip" style={`--c:${INFO_ESTADO[e].color}`}>{t(INFO_ESTADO[e].i18n)}</span>
                      <b class="wide">{porEstado[e]}</b>
                    </li>
                  ))}
                </ul>
              </>
            )}
            {blockedIssues.count > 0 && (
              <p class="hint mt-3 !text-forge-error">{t('dashboard.blocked').replace('{count}', String(blockedIssues.count))}</p>
            )}
          </div>
        </section>

        <section class="panel">
          <div class="panel-cabeza">
            <h2>{t('dashboard.my_tasks')}</h2>
            <a class="enlace" href={`/w/${sys_tag}/board?responsable=yo`}>{t('dashboard.view_all_board')}</a>
          </div>
          <div class="overflow-x-auto">
            <TaskTable tasks={myTasks} sys_tag={sys_tag} tipos={tiposDelEspacio} />
          </div>
        </section>

        {funcs.sprints ? (
          <section class="panel">
            <div class="panel-cabeza">
              <h2>{t('dashboard.roadmap')}</h2>
              <a class="enlace" href={`/w/${sys_tag}/metrics`}>{t('sidebar.metrics')}</a>
            </div>
            {allSprints.length === 0 ? (
              <p class="panel-cuerpo text-sm text-forge-muted">{t('dashboard.no_sprints')}</p>
            ) : (
              <div class="overflow-x-auto">
                <table class="tabla">
                  <thead><tr><th>{t('dashboard.col_sprint')}</th><th>{t('dashboard.col_dates')}</th><th>{t('dashboard.col_status')}</th></tr></thead>
                  <tbody>
                    {allSprints.map((sprint) => (
                      <tr>
                        <td class="titulo"><a href={`/w/${sys_tag}/board?sprint=${sprint.id}`} class="hover:underline underline-offset-2">{sprint.name}</a></td>
                        <td class="text-forge-muted whitespace-nowrap">{sprint.start_date ? formatDate(sprint.start_date) : '—'} – {sprint.end_date ? formatDate(sprint.end_date) : '—'}</td>
                        <td class="text-forge-muted">{t(`sprint.status_${sprint.status}` as any)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {milestones.length > 0 && (
              <ul class="panel-cuerpo border-t border-forge-border pt-3 space-y-1.5">
                {milestones.map((m) => (
                  <li class="flex justify-between gap-3 text-sm"><span>{m.name}</span><span class="due">{formatDate(m.target_date)}</span></li>
                ))}
              </ul>
            )}
          </section>
        ) : (
          <section class="panel">
            <div class="panel-cabeza">
              <h2>{t('dashboard.upcoming')}</h2>
              <a class="enlace" href={`/w/${sys_tag}/board?vista=proximos`}>{t('view.upcoming')}</a>
            </div>
            {proximasEntregas.length === 0 ? (
              <p class="panel-cuerpo text-sm text-forge-muted">{t('dashboard.no_upcoming')}</p>
            ) : (
              <ul class="px-2 pb-2">
                {proximasEntregas.map((tarea) => (
                  <li>
                    <a href={`/w/${sys_tag}/board?issue=${tarea.id}`} class="flex items-center justify-between gap-3 rounded-[10px] px-2 py-2 hover:bg-forge-surface-2">
                      <span class="text-sm font-semibold text-forge-text truncate">{tarea.title}</span>
                      <span class="due shrink-0">{fecha(tarea.due_date, lang)}{tarea.due_time ? ` · ${tarea.due_time}` : ''}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        )}
      </div>

      <div class="flex flex-col gap-4 min-w-0">
        {/* La carga, solo si hay a quién comparar: en un espacio de una
            persona es una barra sola que no dice nada. */}
        {carga.length > 1 && (
          <section class="panel">
            <div class="panel-cabeza"><h2>{t('dashboard.workload')}</h2></div>
            <ul class="panel-cuerpo">
              {carga.map((m: any) => (
                <li class="grid grid-cols-[8.5rem_1fr_1.75rem] gap-2.5 items-center py-1.5">
                  <span class="flex gap-2 items-center min-w-0">
                    <span class="avatar" style={`--c:${tonoDe(m.username)}`} aria-hidden="true">
                      {esFotoReal(m.avatar_url) ? <img src={m.avatar_url} alt="" loading="lazy" decoding="async" /> : iniciales(m.username)}
                    </span>
                    <span class="text-sm truncate">{m.username}</span>
                  </span>
                  <span class="barra !h-3 !bg-transparent" aria-hidden="true" style={`width:${Math.max(4, (m.openCount / maxCarga) * 100)}%`}>
                    {m.estados.filter((x: any) => x.n > 0).map((x: any) => <span style={`flex:${x.n};--c:${INFO_ESTADO[x.e as 'todo'].color}`}></span>)}
                    {m.openCount === 0 && <span style="flex:1;--c:var(--forge-surface-2)"></span>}
                  </span>
                  <span class="text-sm text-forge-muted text-right">{m.openCount}</span>
                </li>
              ))}
            </ul>
            <p class="hint px-4 pb-4 -mt-2">{t('dashboard.workload_hint')}</p>
          </section>
        )}

        <section class="panel">
          <div class="panel-cabeza">
            <h2>{t('dashboard.recent_activity')}</h2>
            <a class="enlace" href="/activity">{t('activity.view_all_short')}</a>
          </div>
          {recentActivity.length === 0 ? (
            <p class="panel-cuerpo text-sm text-forge-muted">{t('dashboard.no_activity')}</p>
          ) : (
            <ul class="panel-cuerpo">
              {recentActivity.map((act) => (
                <li class="py-2 border-b border-forge-border last:border-b-0 text-sm">
                  <b>{act.username || t('activity.system')}</b> <span class="text-forge-muted">{actionLabel(act.action)}</span>
                  <span class="hint block">{formatRelative(act.timestamp)}</span>
                </li>
              ))}
            </ul>
          )}
        </section>
      </div>
    </div>
  </div>
</MainLayout>
