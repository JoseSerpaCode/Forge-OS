---
import MainLayout from '../../../../layouts/MainLayout.astro';
import db from '../../../../lib/db';
import { abrirEspacioDePagina } from '../../../../lib/paginaEspacio';

const { sys_tag } = Astro.params;
const user = Astro.locals.user!;
import { useTranslations } from '../../../../i18n/ui';
const t = useTranslations(Astro.locals.lang || 'en');

if (!user) return Astro.redirect('/login');

const acceso = abrirEspacioDePagina(sys_tag, user, 'viewer');
if (!acceso.ok) return Astro.redirect(acceso.redirigir);
const workspace = acceso.ws;

// Un invitado no ve métricas: se le manda al tablero, que sí puede usar.
if (user.is_guest) return Astro.redirect(`/w/${sys_tag}/board`);

// Fetch sprints for the scope selector
import { funciones } from '../../../../lib/funcionesEspacio';
import { ESTADOS, INFO as INFO_ESTADO } from '../../../../lib/status';
const funcs = funciones(workspace.id);
const sprints = db.prepare('SELECT id, name, status FROM sprints WHERE workspace_id = ? ORDER BY start_date DESC, rowid DESC').all(workspace.id) as any[];

---

<MainLayout hideFooter={true} title={`${t('metrics.title')} — ${workspace.name}`} workspaceId={workspace.id}>
  {/* Métricas (docs/rediseno/metricas.html): cada gráfica con su tabla —los
      mismos datos, para lector de pantalla o para copiar— y los colores de
      estado de `status.ts`. Solo las gráficas que el espacio puede llenar: sin
      sprints no hay avance ni velocidad, y sin medición de tiempo no hay
      estimado y registrado. */}
  <div class="pb-12" id="metricas"
    data-sprints={funcs.sprints ? 'true' : 'false'}
    data-tiempo={funcs.tiempo ? 'true' : 'false'}
    data-puntos={funcs.puntos ? 'true' : 'false'}>
    <header class="page-head">
      <div class="min-w-0">
        <h1 class="page-title">{t('metrics.title')}</h1>
        <p class="page-sub max-w-2xl">{t('metrics.desc')}</p>
      </div>
      {funcs.sprints && (
        <label class="field">
          <span class="sr-only">{t('a11y.sprint_selector')}</span>
          <select id="global-sprint-selector" class="campo campo-inline max-w-[18rem]">
            <option value="all">{t('metrics.global_hist')}</option>
            {sprints.map((s) => (
              <option value={s.id}>{s.name} {s.status === 'active' ? t('board.sprint_active_suffix') : s.status === 'completed' ? t('board.sprint_completed_suffix') : ''}</option>
            ))}
          </select>
        </label>
      )}
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4" id="metrics-grid">
      <section class="panel flex flex-col min-h-[22rem]" data-grafica="dist">
        <div class="panel-cabeza !items-start">
          <div class="min-w-0">
            <h2>{t('metrics.workload_dist')}</h2>
            <p class="hint mt-0.5" id="dist-scope-label">{t('metrics.scope_hist')}</p>
          </div>
          <div class="segmentado shrink-0" role="group" aria-label={t('metrics.view_label')}>
            <button type="button" class="!h-7 !px-3" data-vista="grafica" aria-pressed="true">{t('metrics.view_chart')}</button>
            <button type="button" class="!h-7 !px-3" data-vista="tabla" aria-pressed="false">{t('metrics.view_table')}</button>
          </div>
        </div>
        <div class="panel-cuerpo flex-1 flex flex-col">
          <p id="dist-empty-state" class="hidden flex-1 grid place-items-center text-center text-sm text-forge-muted py-8"></p>
          <div class="relative flex-1 w-full min-h-[16rem]" id="dist-chart-container"><canvas id="dist-canvas"></canvas></div>
          <div class="hidden overflow-x-auto" id="dist-table-container"></div>
        </div>
      </section>
      {funcs.sprints && (
      <section class="panel flex flex-col min-h-[22rem]" data-grafica="burn">
        <div class="panel-cabeza !items-start">
          <div class="min-w-0">
            <h2>{t('metrics.sprint_burndown')}</h2>
            <p class="hint mt-0.5" id="burn-scope-label">{t('metrics.scope_sprint')}</p>
          </div>
          <div class="segmentado shrink-0" role="group" aria-label={t('metrics.view_label')}>
            <button type="button" class="!h-7 !px-3" data-vista="grafica" aria-pressed="true">{t('metrics.view_chart')}</button>
            <button type="button" class="!h-7 !px-3" data-vista="tabla" aria-pressed="false">{t('metrics.view_table')}</button>
          </div>
        </div>
        <div class="panel-cuerpo flex-1 flex flex-col">
          <p id="burn-empty-state" class="hidden flex-1 grid place-items-center text-center text-sm text-forge-muted py-8"></p>
          <div class="relative flex-1 w-full min-h-[16rem]" id="burn-chart-container"><canvas id="burn-canvas"></canvas></div>
          <div class="hidden overflow-x-auto" id="burn-table-container"></div>
        </div>
      </section>
      )}
      {funcs.sprints && (
      <section class="panel flex flex-col min-h-[22rem]" data-grafica="vel">
        <div class="panel-cabeza !items-start">
          <div class="min-w-0">
            {/* Con puntos encendidos, la velocidad se mide en puntos: es para
                lo que existen. Sin ellos, en tareas cerradas. */}
            <h2>{funcs.puntos ? t('metrics.velocity_points') : t('metrics.velocity_trend')}</h2>
            <p class="hint mt-0.5" id="vel-scope-label">{t('metrics.scope_5sprints')}</p>
          </div>
          <div class="segmentado shrink-0" role="group" aria-label={t('metrics.view_label')}>
            <button type="button" class="!h-7 !px-3" data-vista="grafica" aria-pressed="true">{t('metrics.view_chart')}</button>
            <button type="button" class="!h-7 !px-3" data-vista="tabla" aria-pressed="false">{t('metrics.view_table')}</button>
          </div>
        </div>
        <div class="panel-cuerpo flex-1 flex flex-col">
          <p id="vel-empty-state" class="hidden flex-1 grid place-items-center text-center text-sm text-forge-muted py-8"></p>
          <div class="relative flex-1 w-full min-h-[16rem]" id="vel-chart-container"><canvas id="vel-canvas"></canvas></div>
          <div class="hidden overflow-x-auto" id="vel-table-container"></div>
        </div>
      </section>
      )}
      {funcs.tiempo && (
      <section class="panel flex flex-col min-h-[22rem]" data-grafica="prec">
        <div class="panel-cabeza !items-start">
          <div class="min-w-0">
            <h2>{t('metrics.estimation_precision')}</h2>
            <p class="hint mt-0.5" id="prec-scope-label">{t('metrics.scope_hist')}</p>
          </div>
          <div class="segmentado shrink-0" role="group" aria-label={t('metrics.view_label')}>
            <button type="button" class="!h-7 !px-3" data-vista="grafica" aria-pressed="true">{t('metrics.view_chart')}</button>
            <button type="button" class="!h-7 !px-3" data-vista="tabla" aria-pressed="false">{t('metrics.view_table')}</button>
          </div>
        </div>
        <div class="panel-cuerpo flex-1 flex flex-col">
          <p id="prec-empty-state" class="hidden flex-1 grid place-items-center text-center text-sm text-forge-muted py-8"></p>
          <div class="relative flex-1 w-full min-h-[16rem]" id="prec-chart-container"><canvas id="prec-canvas"></canvas></div>
          <div class="hidden overflow-x-auto" id="prec-table-container"></div>
        </div>
      </section>
      )}
    </div>
    {!funcs.sprints && !funcs.tiempo && <p class="hint mt-4 max-w-2xl">{t('metrics.no_charts')}</p>}
  </div>

  <script define:vars={{
    T: {
      estados: Object.fromEntries(ESTADOS.map((e) => [e, t(INFO_ESTADO[e].i18n)])),
      estimated: t('metrics.estimated_h'),
      logged: t('metrics.logged_h'),
      unassigned: t('modal.unassigned'),
      scopeHist: t('metrics.scope_hist'),
      scopeSprint: t('metrics.scope_one_sprint'),
      selectSprint: t('metrics.select_sprint'),
      loadError: t('metrics.load_error'),
      noIssues: t('metrics.no_issues'),
      noSprintIssues: t('metrics.no_sprint_issues'),
      notEnough: t('metrics.not_enough_sprints'),
      noTime: t('metrics.no_time'),
      completed: t('metrics.completed'),
      remaining: t('metrics.remaining'),
      doneOf: t('metrics.done_of'),
      pointsOf: t('metrics.points_of'),
      velocityPoints: t('metrics.velocity_points_series'),
      colPoints: t('metrics.col_points'),
      velocity: t('metrics.velocity_series'),
      colPerson: t('metrics.col_person'),
      colSprint: t('metrics.col_sprint'),
      colDone: t('metrics.col_done'),
      colCount: t('metrics.col_count'),
      tableHint: t('metrics.table_hint'),
    },
  }}>
    window.metricsT = T;
  </script>

  <script>
    import Chart from 'chart.js/auto';
    import { aplicarDefectos, alCambiarTema } from '../../../../lib/client/temaGraficas';
    import { escaparHtml } from '../../../../lib/texto';

    const T: any = (window as any).metricsT;
    const raiz = document.getElementById('metricas')!;
    const sysTag = window.location.pathname.split('/')[2];
    const ESTADOS = ['todo', 'in_progress', 'review', 'done'];
    let tema = aplicarDefectos(Chart);
    const graficas: Record<string, any> = {};

    // ── Gráfica | Tabla ───────────────────────────────────────────────────
    document.querySelectorAll<HTMLElement>('[data-grafica]').forEach((panel) => {
      panel.querySelectorAll<HTMLButtonElement>('[data-vista]').forEach((b) => {
        b.addEventListener('click', () => {
          const tabla = b.dataset.vista === 'tabla';
          panel.querySelectorAll<HTMLButtonElement>('[data-vista]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
          const clave = panel.dataset.grafica;
          document.getElementById(`${clave}-table-container`)?.classList.toggle('hidden', !tabla);
          const vacio = !document.getElementById(`${clave}-empty-state`)?.classList.contains('hidden');
          document.getElementById(`${clave}-chart-container`)?.classList.toggle('hidden', tabla || vacio);
        });
      });
    });

    const enTabla = (clave: string) =>
      document.querySelector(`[data-grafica="${clave}"] [data-vista="tabla"]`)?.getAttribute('aria-pressed') === 'true';

    function vacio(clave: string, texto: string) {
      const p = document.getElementById(`${clave}-empty-state`);
      if (p) { p.textContent = texto; p.classList.remove('hidden'); }
      document.getElementById(`${clave}-chart-container`)?.classList.add('hidden');
      const tabla = document.getElementById(`${clave}-table-container`);
      if (tabla) tabla.innerHTML = '';
    }

    function lleno(clave: string) {
      document.getElementById(`${clave}-empty-state`)?.classList.add('hidden');
      document.getElementById(`${clave}-chart-container`)?.classList.toggle('hidden', enTabla(clave));
      document.getElementById(`${clave}-table-container`)?.classList.toggle('hidden', !enTabla(clave));
    }

    /** La tabla de una gráfica: mismas cifras, en texto. */
    function pintarTabla(clave: string, titulo: string, cabecera: string[], filas: Array<Array<string | number>>) {
      const cont = document.getElementById(`${clave}-table-container`);
      if (!cont) return;
      const th = cabecera.map((c, i) => `<th${i > 0 ? ' class="num"' : ''}>${escaparHtml(c)}</th>`).join('');
      const tr = filas.map((f) => `<tr>${f.map((c, i) => `<td${i > 0 ? ' class="num"' : ' class="titulo"'}>${escaparHtml(String(c))}</td>`).join('')}</tr>`).join('');
      cont.innerHTML = `<table class="tabla"><caption class="sr-only">${escaparHtml(titulo)}</caption><thead><tr>${th}</tr></thead><tbody>${tr}</tbody></table><p class="hint mt-2">${escaparHtml(T.tableHint)}</p>`;
    }

    const titulo = (clave: string) => document.querySelector(`[data-grafica="${clave}"] h2`)?.textContent || '';
    const alcance = (clave: string, sprintId: string) => {
      const l = document.getElementById(`${clave}-scope-label`);
      if (l) l.textContent = sprintId === 'all' ? T.scopeHist : T.scopeSprint;
    };
    const opciones = (extra: any = {}) => ({ responsive: true, maintainAspectRatio: false, ...extra });

    // ── Carga por persona ─────────────────────────────────────────────────
    async function cargarDistribucion(sprintId: string) {
      alcance('dist', sprintId);
      const res = await fetch(`/api/w/${sysTag}/metrics/distribution${sprintId === 'all' ? '' : `?sprint_id=${encodeURIComponent(sprintId)}`}`).catch(() => null);
      if (!res?.ok) return vacio('dist', T.loadError);
      const datos = await res.json();
      if (!datos?.length) return vacio('dist', T.noIssues);
      const personas = [...new Set(datos.map((d: any) => d.assignee ?? T.unassigned))] as string[];
      const cuenta = (p: string, e: string) => datos.find((d: any) => (d.assignee ?? T.unassigned) === p && d.status === e)?.count ?? 0;
      lleno('dist');
      graficas.dist?.destroy();
      graficas.dist = new Chart(document.getElementById('dist-canvas') as HTMLCanvasElement, {
        type: 'bar',
        data: { labels: personas, datasets: ESTADOS.map((e) => ({ label: T.estados[e], data: personas.map((p) => cuenta(p, e)), backgroundColor: tema.estado[e], borderRadius: 4 })) },
        options: opciones({ scales: { x: { stacked: true, grid: { display: false } }, y: { stacked: true, beginAtZero: true, ticks: { precision: 0 } } } }),
      });
      pintarTabla('dist', titulo('dist'), [T.colPerson, ...ESTADOS.map((e) => T.estados[e])], personas.map((p) => [p, ...ESTADOS.map((e) => cuenta(p, e))]));
    }

    // ── Avance del sprint ─────────────────────────────────────────────────
    async function cargarAvance(sprintId: string) {
      if (!document.getElementById('burn-canvas')) return;
      if (sprintId === 'all') return vacio('burn', T.selectSprint);
      alcance('burn', sprintId);
      const res = await fetch(`/api/w/${sysTag}/metrics/burndown?sprint_id=${encodeURIComponent(sprintId)}`).catch(() => null);
      if (!res?.ok) return vacio('burn', T.loadError);
      const d = await res.json();
      if (!d || d.total_issues === 0) return vacio('burn', T.noSprintIssues);
      // En puntos si el espacio los usa y el sprint tiene alguno; si no, en tareas.
      const enPuntos = raiz.dataset.puntos === 'true' && d.total_points > 0;
      const hechas = enPuntos ? d.completed_points : d.completed_issues;
      const total = enPuntos ? d.total_points : d.total_issues;
      const quedan = total - hechas;
      lleno('burn');
      graficas.burn?.destroy();
      graficas.burn = new Chart(document.getElementById('burn-canvas') as HTMLCanvasElement, {
        type: 'doughnut',
        data: { labels: [T.completed, T.remaining], datasets: [{ data: [hechas, quedan], backgroundColor: [tema.estado.done, tema.borde], borderWidth: 0 }] },
        options: opciones({ cutout: '72%', plugins: { title: { display: true, text: (enPuntos ? T.pointsOf : T.doneOf).replace('{n}', hechas).replace('{total}', total), color: tema.texto, font: { size: 16, weight: 700 } } } }),
      });
      pintarTabla('burn', titulo('burn'), ['', enPuntos ? T.colPoints : T.colCount], [[T.completed, hechas], [T.remaining, quedan]]);
    }

    // ── Tareas cerradas por sprint ────────────────────────────────────────
    async function cargarVelocidad() {
      if (!document.getElementById('vel-canvas')) return;
      const res = await fetch(`/api/w/${sysTag}/metrics/velocity`).catch(() => null);
      if (!res?.ok) return vacio('vel', T.loadError);
      const datos = await res.json();
      if (!datos?.length) return vacio('vel', T.notEnough);
      lleno('vel');
      const enPuntos = raiz.dataset.puntos === 'true';
      const valor = (d: any) => (enPuntos ? d.points : d.velocity);
      graficas.vel?.destroy();
      graficas.vel = new Chart(document.getElementById('vel-canvas') as HTMLCanvasElement, {
        type: 'line',
        data: { labels: datos.map((d: any) => d.sprint_name), datasets: [{ label: enPuntos ? T.velocityPoints : T.velocity, data: datos.map(valor), borderColor: tema.texto, backgroundColor: tema.texto, borderWidth: 2, tension: 0.25 }] },
        options: opciones({ scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }),
      });
      pintarTabla('vel', titulo('vel'), [T.colSprint, enPuntos ? T.colPoints : T.colDone], datos.map((d: any) => [d.sprint_name, valor(d)]));
    }

    // ── Estimado y registrado ─────────────────────────────────────────────
    async function cargarPrecision(sprintId: string) {
      if (!document.getElementById('prec-canvas')) return;
      alcance('prec', sprintId);
      const res = await fetch(`/api/w/${sysTag}/metrics/precision${sprintId === 'all' ? '' : `?sprint_id=${encodeURIComponent(sprintId)}`}`).catch(() => null);
      if (!res?.ok) return vacio('prec', T.loadError);
      const datos = await res.json();
      if (!datos?.length || datos.every((d: any) => !d.estimated_hours && !d.logged_hours)) return vacio('prec', T.noTime);
      const nombres = datos.map((d: any) => d.assignee ?? T.unassigned);
      const h = (v: number) => Math.round((v || 0) * 10) / 10;
      lleno('prec');
      graficas.prec?.destroy();
      graficas.prec = new Chart(document.getElementById('prec-canvas') as HTMLCanvasElement, {
        type: 'bar',
        data: { labels: nombres, datasets: [
          { label: T.estimated, data: datos.map((d: any) => h(d.estimated_hours)), backgroundColor: tema.borde, borderRadius: 4 },
          { label: T.logged, data: datos.map((d: any) => h(d.logged_hours)), backgroundColor: tema.texto, borderRadius: 4 },
        ] },
        options: opciones({ scales: { x: { grid: { display: false } }, y: { beginAtZero: true } } }),
      });
      pintarTabla('prec', titulo('prec'), [T.colPerson, T.estimated, T.logged], datos.map((d: any, i: number) => [nombres[i], h(d.estimated_hours), h(d.logged_hours)]));
    }

    const selector = document.getElementById('global-sprint-selector') as HTMLSelectElement | null;
    const todo = () => {
      const sprint = selector?.value || 'all';
      cargarDistribucion(sprint);
      cargarAvance(sprint);
      cargarVelocidad();
      cargarPrecision(sprint);
    };
    selector?.addEventListener('change', todo);
    todo();

    // Al cambiar de tema, las gráficas se repintan con los colores nuevos.
    alCambiarTema(() => { tema = aplicarDefectos(Chart); todo(); });
  </script>
</MainLayout>
