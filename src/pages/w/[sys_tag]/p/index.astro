---
import MainLayout from '../../../../layouts/MainLayout.astro';
import PageTree from '../../../../components/notion/PageTree.astro';
import db from '../../../../lib/db';
import { checkWorkspaceAccess } from '../../../../lib/guard';
import { useTranslations } from '../../../../i18n/ui';
import { abrirEspacioDePagina } from '../../../../lib/paginaEspacio';

const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/login');

const { sys_tag } = Astro.params;
const acceso = abrirEspacioDePagina(sys_tag, user, 'viewer');
if (!acceso.ok) return Astro.redirect(acceso.redirigir);
const ws = acceso.ws;

let targetPageId = null;

// Intentar usar la última página visitada por el usuario
if (user.last_page_id) {
  const lastPage = db.prepare('SELECT id FROM pages WHERE id = ? AND workspace_id = ?').get(user.last_page_id, ws.id) as any;
  if (lastPage) targetPageId = lastPage.id;
}

// Fallback a la primera página si no hay historial
if (!targetPageId) {
  const firstPage = db.prepare('SELECT id FROM pages WHERE workspace_id = ? ORDER BY created_at ASC LIMIT 1').get(ws.id) as any;
  if (firstPage) targetPageId = firstPage.id;
}

if (targetPageId) {
  return Astro.redirect(`/w/${sys_tag}/p/${targetPageId}`);
}
---

<MainLayout hideFooter={true} title={t('sidebar.knowledge')}>
  <div class="flex h-full overflow-hidden">
    <PageTree workspaceId={ws.id} sysTag={sys_tag!} />
    
    <div class="flex-1 flex flex-col min-w-0">
      {/* La puerta al índice, para la página que no tiene editor.

          El botón que lo abre vive en la fila del título del editor, y aquí no
          hay editor: al moverlo allí, esta pantalla se quedó **sin ninguna
          forma de abrir el árbol**, y con ella sin forma de crear la primera
          página desde un teléfono. El texto de abajo seguía señalando un botón
          que ya no existía. */}
      <div class="md:hidden p-4 pb-0">
        <button
          type="button"
          id="btn-open-tree"
          aria-controls="page-tree-aside"
          aria-expanded="false"
          class="w-full h-11 flex items-center justify-center gap-2 rounded-lg border border-forge-border text-forge-text text-sm font-semibold"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          {t('kb.open_tree')}
        </button>
      </div>

    <div class="flex-1 flex flex-col items-center justify-center text-forge-muted">
      <div class="w-16 h-16 border border-dashed border-forge-border rounded-lg flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
      </div>
      <div class="text-forge-text font-bold text-lg mb-2">{t('kb.empty_desc')}</div>
      {/* Dos textos porque son dos sitios distintos.

          El original mandaba a «Nueva Página» en la barra lateral. En un
          teléfono no hay barra lateral: el árbol vive en un cajón que se abre
          con el botón redondo de abajo a la izquierda. Mandar a alguien a un
          sitio que no existe en su pantalla es peor que no decirle nada, porque
          se pone a buscarlo. */}
      <div class="text-forge-muted text-sm md:hidden">{t('kb.empty_cta_movil')}</div>
      <div class="text-forge-muted text-sm hidden md:block">{t('kb.empty_cta')}</div>
    </div>
    </div>
  </div>
</MainLayout>
