---
import MainLayout from '../../../../layouts/MainLayout.astro';
import db from '../../../../lib/db';
import { checkWorkspaceAccess } from '../../../../lib/guard';
import { useTranslations } from '../../../../i18n/ui';
import DbIcon from '../../../../components/icons/DbIcon.astro';
import { porIds as archivosPorIds } from '../../../../lib/driveFiles';

const { sys_tag, id } = Astro.params;
const user = Astro.locals.user!;
const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);

// Los textos que necesita el script. Dentro de un `<script>` no llega `t()`:
// lo que se ponga ahí entre llaves se imprime tal cual.
const TXT = {
  savingRow: t('db.saving_row'),
  saveRow: t('db.save_row'),
  deleteTable: t('db.delete_table'),
  confirmDeleteTable: t('db.confirm_delete_table'),
  confirmDeleteRow: t('db.confirm_delete_row'),
  errDeleteTable: t('db.err_delete_table'),
  errDeleteRow: t('db.err_delete_row'),
  errSaveRow: t('db.err_save_row'),
};

if (!user) return Astro.redirect('/login');
if (user.is_guest) return Astro.redirect('/register');

const acceso = abrirEspacioDePagina(sys_tag, user, 'viewer');
if (!acceso.ok) return Astro.redirect(acceso.redirigir);
const workspace = acceso.ws;
const canEdit = acceso.rol !== 'viewer';

import { orm } from '../../../../lib/db/drizzle';
import { dynamicDatabases, dynamicEntries, dynamicViews } from '../../../../lib/db/schema';
import { eq, and, desc } from 'drizzle-orm';
import { abrirEspacioDePagina } from '../../../../lib/paginaEspacio';

const database = orm.select().from(dynamicDatabases)
  .where(and(eq(dynamicDatabases.id, id as string), eq(dynamicDatabases.workspaceId, workspace.id)))
  .get() as any;
if (!database) return Astro.redirect('/404');

const schema = JSON.parse(database.schemaJson);
const columns = schema.columns || [];

// Fetch entries for table
const entries = orm.select().from(dynamicEntries)
  .where(eq(dynamicEntries.databaseId, database.id))
  .orderBy(desc(dynamicEntries.createdAt))
  .limit(500)
  .all() as any[];

// Las columnas de tipo archivo guardan un id; para pintar la tabla hace falta
// el nombre y el enlace. Se resuelven todas de una vez: una consulta por celda
// serían decenas por carga.
const columnasArchivo = columns.filter((c: any) => c.type === 'file').map((c: any) => c.id);
const idsDeArchivo = new Set<string>();
if (columnasArchivo.length) {
  for (const entry of entries) {
    try {
      const payload = JSON.parse(entry.payloadJson);
      for (const colId of columnasArchivo) if (payload[colId]) idsDeArchivo.add(payload[colId]);
    } catch { /* una fila con JSON roto no debe tumbar la tabla entera */ }
  }
}
const archivos = archivosPorIds([...idsDeArchivo], workspace.id);

const view = orm.select().from(dynamicViews)
  .where(eq(dynamicViews.databaseId, database.id))
  .get() as any;
let visibleColumns = columns.map((c: any) => c.id);
// `visibleColumnsJson`, no `visible_columns_json`: la fila viene de Drizzle,
// cuyas claves son las del esquema en camelCase, no las de la columna SQL. La
// condición era siempre falsa, así que la configuración de columnas visibles
// que el usuario guardaba no se aplicaba nunca.
if (view?.visibleColumnsJson) {
  try { visibleColumns = JSON.parse(view.visibleColumnsJson); } catch(e){}
}
import CeldaValor from '../../../../components/db/CeldaValor.astro';
---

<MainLayout hideFooter={true} title={`${database.name} — ${workspace.name}`} workspaceId={workspace.id}>
  <div class="h-full flex flex-col -mx-4 -mt-4 p-4 lg:p-6 lg:-m-6 lg:h-[calc(100vh-2rem)]">
    
    <header class="page-head shrink-0">
      <div class="min-w-0">
        <nav class="text-sm text-forge-muted mb-1.5" aria-label={t('a11y.breadcrumbs')}>
          <a href={`/w/${sys_tag}/db`} class="hover:text-forge-text hover:underline underline-offset-2">{t('sidebar.databases')}</a>
          <span class="text-forge-border-strong mx-1.5" aria-hidden="true">/</span>
        </nav>
        <h1 class="page-title flex items-center gap-3">
          <span class="text-forge-muted shrink-0" aria-hidden="true"><DbIcon value={database.icon} size={26} /></span>
          {database.name}
        </h1>
        {database.description && <p class="page-sub">{database.description}</p>}
      </div>
      {canEdit && (
        <div class="flex gap-2 items-center">
          <button id="btn-delete-db" class="btn btn-ghost btn-icon hover:!text-forge-error" title={t('db.delete_table')} aria-label={t('db.delete_table')}>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
          </button>
          <button id="btn-add-row" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            {t('db.new_row')}
          </button>
        </div>
      )}
    </header>

    {/*
      Una tabla no cabe en 393 px.

      Estaba dentro de un `overflow-auto`, así que técnicamente se podía leer:
      desplazando en horizontal, columna a columna, perdiendo de vista de qué
      fila era cada valor en cuanto la primera columna salía por la izquierda.
      Se puede usar y aun así no sirve.

      En móvil cada fila pasa a ficha: la primera columna hace de título —que es
      lo que identifica la fila— y el resto van como pares etiqueta/valor. A
      partir del cuarto campo se pliegan, porque una ficha de doce filas vuelve
      a ser una tabla, solo que en vertical.

      El `<details>` es de serie: se abre con el dedo y con el teclado, sale en
      la búsqueda de la página y no cuesta una línea de JavaScript.
    */}
    <div class="md:hidden flex-1 flex flex-col gap-3 overflow-y-auto pb-2">
      {entries.length === 0 ? (
        <p class="panel px-4 py-10 text-center text-forge-muted text-sm">{t('db.view_empty')}</p>
      ) : (
        entries.map(entry => {
          const payload = JSON.parse(entry.payloadJson);
          const cols = columns.filter((c: any) => visibleColumns.includes(c.id));
          const principal = cols[0];
          const resto = cols.slice(1);
          const alaVista = resto.slice(0, 3);
          const plegados = resto.slice(3);
          return (
            <article class="panel overflow-hidden">
              <div class="flex items-center justify-between gap-2 px-4 py-3 border-b border-forge-border">
                <h3 class="text-base font-semibold truncate min-w-0">
                  {principal ? <CeldaValor tipo={principal.type} valor={payload[principal.id]} archivos={archivos} /> : null}
                </h3>
                {canEdit && (
                  <button class="btn-delete-row shrink-0 text-forge-muted hover:text-forge-error p-2 -mr-2 transition-colors" data-id={entry.id} aria-label={t('db.delete_row')}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                  </button>
                )}
              </div>
              <dl class="px-4 py-3 flex flex-col gap-2.5 m-0">
                {alaVista.map((col: any) => (
                  <div class="flex items-start justify-between gap-3">
                    <dt class="text-xs text-forge-muted shrink-0">{col.name}</dt>
                    <dd class="text-sm text-right m-0 min-w-0 break-words">
                      <CeldaValor tipo={col.type} valor={payload[col.id]} archivos={archivos} />
                    </dd>
                  </div>
                ))}
              </dl>
              {plegados.length > 0 && (
                <details class="px-4 pb-3">
                  <summary class="text-sm font-semibold text-forge-accent-text cursor-pointer py-1.5 list-none">
                    {plegados.length === 1
                      ? t('db.more_fields_one')
                      : (t('db.more_fields') as string).replace('{n}', String(plegados.length))}
                  </summary>
                  <dl class="pt-2 flex flex-col gap-2.5 m-0">
                    {plegados.map((col: any) => (
                      <div class="flex items-start justify-between gap-3">
                        <dt class="text-xs text-forge-muted shrink-0">{col.name}</dt>
                        <dd class="text-sm text-right m-0 min-w-0 break-words">
                          <CeldaValor tipo={col.type} valor={payload[col.id]} archivos={archivos} />
                        </dd>
                      </div>
                    ))}
                  </dl>
                </details>
              )}
            </article>
          );
        })
      )}
    </div>

    <div class="hidden md:flex flex-1 panel overflow-hidden flex-col">
      <div class="overflow-auto flex-1 custom-scrollbar">
        <table class="tabla">
          <thead class="sticky top-0 bg-forge-panel z-10">
            <tr>
              {columns.filter((c: any) => visibleColumns.includes(c.id)).map((col: any) => (
                <th class="whitespace-nowrap bg-forge-panel">
                  {/* El nombre y, debajo, su tipo: en una hoja de cálculo propia
                      el tipo decide qué se puede escribir en la celda. */}
                  <span class="block text-forge-text font-semibold text-[0.8125rem]">{col.name}</span>
                  <small class="block font-normal text-forge-muted">{t(`db.badge_${col.type}` as any)}</small>
                </th>
              ))}
              <th class="w-10 bg-forge-panel"></th> <!-- Actions -->
            </tr>
          </thead>
          <tbody class="text-forge-text">
            {entries.length === 0 ? (
              <tr>
                <td colspan={visibleColumns.length + 1} class="!py-10 text-center text-forge-muted text-sm">
                  {t('db.view_empty')}
                </td>
              </tr>
            ) : (
              entries.map(entry => {
                const payload = JSON.parse(entry.payloadJson);
                return (
                  <tr class="group">
                    {columns.filter((c: any) => visibleColumns.includes(c.id)).map((col: any) => {
                      const val = payload[col.id];
                      return (
                        <td class="truncate max-w-[16rem]">
                          <CeldaValor tipo={col.type} valor={val} archivos={archivos} />
                        </td>
                      );
                    })}
                    <td class="text-right w-0">
                      {canEdit && (
                        <button class="btn-delete-row btn btn-ghost btn-icon btn-sm hover:!text-forge-error opacity-0 group-hover:opacity-100 focus:opacity-100" data-id={entry.id} title={t('db.delete_row')} aria-label={t('db.delete_row')}>
                          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        </button>
                      )}
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Add Row Modal -->
  {canEdit && (
    <dialog id="new-row-modal" class="ventana">
      <div class="px-6 py-5 border-b border-forge-border/40 flex justify-between items-center bg-forge-panel rounded-t-2xl">
        <h2 class="text-lg font-bold flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-forge-bg flex items-center justify-center border border-forge-border shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-forge-accent-text"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </div>
          {t('db.add_row')}
        </h2>
        <button type="button" aria-label={t('common.close')} class="text-forge-muted hover:text-forge-text p-2 hover:bg-forge-bg rounded-lg transition-colors" onclick="document.getElementById('new-row-modal').close()">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      
      <form id="new-row-form" class="p-6 space-y-5 max-h-[60vh] overflow-y-auto custom-scrollbar">
        {columns.map((col: any) => (
          <div>
            <label for={`row-field-${col.id}`} class="block field-label mb-2 flex items-center gap-1.5">
              {col.name}
              {col.type === 'number' && <span class="bg-forge-bg border border-forge-border px-1.5 py-0.5 rounded text-[8px] font-mono text-forge-accent-text">{t('db.badge_number')}</span>}
              {col.type === 'select' && <span class="bg-forge-bg border border-forge-border px-1.5 py-0.5 rounded text-[8px] font-mono text-forge-accent-text">{t('db.badge_select')}</span>}
              {col.type === 'file' && <span class="bg-forge-bg border border-forge-border px-1.5 py-0.5 rounded text-[8px] font-mono text-forge-accent-text">{t('db.badge_file')}</span>}
            </label>
            
            {col.type === 'file' ? (
              /* Se elige de los que ya están en Archivos, no se sube aquí: los
                 archivos viven en un solo sitio y la tabla los referencia. */
              <div class="campo-archivo relative" data-col={col.id}>
                <input type="hidden" id={`row-field-${col.id}`} name={col.id}>
                <button type="button" class="archivo-abrir w-full text-left bg-forge-bg border border-forge-border rounded-xl p-3 text-sm text-forge-muted hover:border-forge-secondary transition-colors">
                  {t('db.pick_file')}
                </button>
                <div class="archivo-panel hidden absolute z-30 mt-2 w-full bg-forge-panel border border-forge-border rounded-xl shadow-xl p-2">
                  <input type="text" class="archivo-buscar campo mb-2" autocomplete="off" placeholder={t('db.file_search')} aria-label={t('db.file_search')}>
                  <div class="archivo-resultados max-h-48 overflow-y-auto custom-scrollbar space-y-0.5"></div>
                </div>
              </div>
            ) : col.type === 'select' ? (
              <select id={`row-field-${col.id}`} name={col.id} class="campo">
                <option value="">{t('db.leave_empty')}</option>
                {(col.options || []).map((opt: any) => <option value={opt}>{opt}</option>)}
              </select>
            ) : col.type === 'number' ? (
              <input type="number" step="any" id={`row-field-${col.id}`} name={col.id} class="campo" placeholder={t('db.enter_number')}>
            ) : (
              <input type="text" id={`row-field-${col.id}`} name={col.id} class="campo" placeholder={t('db.enter_text')}>
            )}
          </div>
        ))}
      </form>
      
      <div class="px-6 py-5 border-t border-forge-border/40 bg-forge-panel flex justify-end gap-3 rounded-b-2xl">
        <button type="button" class="px-5 py-2.5 text-sm font-bold text-forge-muted hover:text-forge-text hover:bg-forge-bg rounded-xl transition-colors" onclick="document.getElementById('new-row-modal').close()">{t('ws.settings.modal_cancel')}</button>
        <button type="button" id="btn-save-row" class="btn btn-primary">{t('db.save_row')}</button>
      </div>
    </dialog>
  )}

  <script define:vars={{ sysTag: sys_tag, dbId: id, dbName: database.name, TXT }}>
    const newRowBtn = document.getElementById('btn-add-row');
    const modal = document.getElementById('new-row-modal');
    const saveBtn = document.getElementById('btn-save-row');
    const form = document.getElementById('new-row-form');

    newRowBtn?.addEventListener('click', () => modal?.showModal());

    // ── Elegir archivo ───────────────────────────────────────────────────────
    document.querySelectorAll('.campo-archivo').forEach((campo) => {
      const oculto = campo.querySelector('input[type="hidden"]');
      const boton = campo.querySelector('.archivo-abrir');
      const panel = campo.querySelector('.archivo-panel');
      const buscar = campo.querySelector('.archivo-buscar');
      const resultados = campo.querySelector('.archivo-resultados');

      const abrir = (si) => {
        panel.classList.toggle('hidden', !si);
        if (si) { buscar.value = ''; resultados.innerHTML = ''; buscar.focus(); }
      };
      boton.addEventListener('click', () => abrir(panel.classList.contains('hidden')));

      let espera;
      buscar.addEventListener('input', () => {
        clearTimeout(espera);
        espera = setTimeout(async () => {
          const texto = buscar.value.trim();
          resultados.innerHTML = '';
          if (!texto) return;

          const res = await fetch(`/api/w/${sysTag}/files/search?q=${encodeURIComponent(texto)}`);
          if (!res.ok) return;
          for (const f of (await res.json()).files || []) {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'w-full text-left px-2 py-1.5 rounded-lg text-xs text-forge-text hover:bg-forge-bg transition-colors truncate';
            b.textContent = f.name;
            b.addEventListener('click', () => {
              // El id es lo que se guarda; el nombre solo se enseña.
              oculto.value = f.id;
              boton.textContent = f.name;
              boton.classList.remove('text-forge-muted');
              boton.classList.add('text-forge-text');
              abrir(false);
            });
            resultados.appendChild(b);
          }
        }, 250);
      });

      document.addEventListener('click', (e) => {
        if (!campo.contains(e.target)) abrir(false);
      });
    });

    saveBtn?.addEventListener('click', async () => {
      const formData = new FormData(form);
      const payload = {};
      formData.forEach((value, key) => {
        if (value.trim() !== '') {
          payload[key] = value.trim();
        }
      });

      saveBtn.textContent = TXT.savingRow;
      saveBtn.disabled = true;

      try {
        const res = await fetch(`/api/w/${sysTag}/db/${dbId}/entries`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          window.location.reload();
        } else {
          // El cuerpo del error es interno y viene en inglés; no se enseña.
          window.showToast?.(TXT.errSaveRow, true);
          saveBtn.textContent = TXT.saveRow;
          saveBtn.disabled = false;
        }
      } catch (e) {
        console.error(e);
      }
    });

    // Delete Database Logic
    const btnDeleteDb = document.getElementById('btn-delete-db');
    btnDeleteDb?.addEventListener('click', () => {
      window.forgeConfirm?.(TXT.confirmDeleteTable.replace('{name}', dbName), async () => {
        try {
          btnDeleteDb.disabled = true;
          const res = await fetch(`/api/w/${sysTag}/db/${dbId}`, { method: 'DELETE' });
          if (res.ok) window.location.href = `/w/${sysTag}/db`;
          else window.showToast?.(TXT.errDeleteTable, true);
        } catch(err) {
          console.error(err);
        }
      }, TXT.deleteTable);
    });

    // Delete Row Logic
    document.querySelectorAll('.btn-delete-row').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = e.currentTarget.getAttribute('data-id');
        window.forgeConfirm?.(TXT.confirmDeleteRow, async () => {
          try {
            const res = await fetch(`/api/w/${sysTag}/db/${dbId}/entries/${id}`, { method: 'DELETE' });
            if (res.ok) window.location.reload();
            else window.showToast?.(TXT.errDeleteRow, true);
          } catch(err) {
            console.error(err);
          }
        });
      });
    });
  </script>
</MainLayout>

<style>
  .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: var(--forge-border); border-radius: 4px; }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: var(--forge-muted); }
</style>
