---
import MainLayout from '../../../../layouts/MainLayout.astro';
import db from '../../../../lib/db';
import { checkWorkspaceAccess } from '../../../../lib/guard';
import { useTranslations } from '../../../../i18n/ui';

const { sys_tag } = Astro.params;
const user = Astro.locals.user!;
const t = useTranslations(Astro.locals.lang || 'en');

if (!user) return Astro.redirect('/login');
if (user.is_guest) return Astro.redirect('/register');

const acceso = abrirEspacioDePagina(sys_tag, user, 'viewer');
if (!acceso.ok) return Astro.redirect(acceso.redirigir);
const workspace = acceso.ws;

import { orm } from '../../../../lib/db/drizzle';
import { dynamicDatabases } from '../../../../lib/db/schema';
import { desc, eq } from 'drizzle-orm';
import { plantillasTraducidas } from '../../../../lib/dbTemplates';
import Icon from '../../../../components/icons/Icon.astro';
import DbIcon from '../../../../components/icons/DbIcon.astro';
import { ICONOS_ELEGIBLES, ICONO_POR_DEFECTO } from '../../../../lib/icons';
import { abrirEspacioDePagina } from '../../../../lib/paginaEspacio';
import { MAX_COLUMNAS, MAX_FILAS } from '../../../../lib/importarTabla';

const databases = orm.select().from(dynamicDatabases)
  .where(eq(dynamicDatabases.workspaceId, workspace.id))
  .orderBy(desc(dynamicDatabases.createdAt))
  .all() as any[];

const canEdit = acceso.rol !== 'viewer';

// Las plantillas se traducen aquí y viajan ya en texto: el script del modal solo
// rellena campos. Los nombres de columna se convierten en datos al crear la
// tabla, así que se fijan en el idioma de quien la crea y ahí se quedan.
const plantillas = plantillasTraducidas(t);

// Los textos que el script necesita. Van por `define:vars` porque dentro de un
// `<script>` no llega `t()`: lo que se escriba ahí entre llaves sale tal cual.
const TXT = {
  saving: t('db.saving'),
  create: t('db.create'),
  errName: t('db.err_name_required'),
  errNoCols: t('db.err_no_columns'),
  errUnnamed: t('db.err_col_unnamed'),
  errNoOptions: t('db.err_col_no_options'),
  errCreate: t('db.err_create'),
  colName: t('db.col_name'),
  colNamePh: t('db.col_name_ph2'),
  colType: t('db.col_type'),
  colOptions: t('db.col_options'),
  colOptionsLabel: t('db.col_options_label'),
  colOptionsPh: t('db.col_options_ph'),
  removeCol: t('db.remove_col'),
  typeText: t('db.type_text'),
  typeNumber: t('db.type_number'),
  typeSelect: t('db.type_select'),
  typeFile: t('db.type_file'),
  nameDefault: t('db.col_name_default'),
};

// Filas de cada tabla, en una consulta, para la columna «Filas».
const filasPorTabla = new Map(
  (db.prepare(`SELECT database_id AS id, COUNT(*) AS n FROM dynamic_entries WHERE database_id IN (SELECT id FROM dynamic_databases WHERE workspace_id = ?) GROUP BY database_id`).all(workspace.id) as Array<{ id: string; n: number }>).map((r) => [r.id, r.n])
);
---

<MainLayout hideFooter={true} title={`${t('sidebar.databases')} — ${workspace.name}`} workspaceId={workspace.id}>
  {/* Tablas (docs/rediseno/tablas.html): título, una frase que dice para qué
      sirven —sin compararse con otro producto— y la lista, sin tarjetas que
      se levantan ni gradientes. */}
  <div class="max-w-[70rem] pb-12">
    <header class="page-head">
      <div class="min-w-0">
        <h1 class="page-title">{t('db.title')}</h1>
        <p class="page-sub max-w-2xl">{t('db.subtitle')}</p>
      </div>
      {canEdit && (
        <div class="flex gap-2 items-center">
          <button id="btn-importar-db" type="button" class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"/><path d="m7 8 5-5 5 5"/><path d="M5 15v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4"/></svg>
            {t('db.import')}
          </button>
          <button id="btn-new-db" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            {t('db.create')}
          </button>
        </div>
      )}
    </header>

    {databases.length === 0 ? (
      <div class="panel px-5 py-8 max-w-xl">
        <h3 class="font-semibold text-forge-text mb-1">{t('db.empty_title')}</h3>
        <p class="text-sm text-forge-muted">{t('db.empty_desc')}</p>
      </div>
    ) : (
      <div class="panel overflow-x-auto">
        <table class="tabla">
          <thead><tr><th>{t('db.col_table')}</th><th class="max-sm:hidden">{t('db.col_desc')}</th><th class="num max-sm:hidden">{t('db.col_columns')}</th><th class="num">{t('db.col_rows')}</th>{canEdit && <th><span class="sr-only">{t('db.col_actions')}</span></th>}</tr></thead>
          <tbody>
            {databases.map((database) => (
              <tr>
                <td class="titulo">
                  <a href={`/w/${sys_tag}/db/${database.id}`} class="flex items-center gap-2.5 hover:underline underline-offset-2">
                    <span class="text-forge-muted shrink-0" aria-hidden="true"><DbIcon value={database.icon} size={18} /></span>
                    <span class="truncate max-w-[20rem] max-sm:max-w-[11rem]">{database.name}</span>
                  </a>
                </td>
                {/* En el teléfono, nombre, filas y borrar: con las cinco columnas
                    la papelera quedaba fuera de la pantalla. */}
                <td class="text-forge-muted max-w-[28rem] truncate max-sm:hidden">{database.description || '—'}</td>
                {/* `schemaJson` en camelCase: en snake_case daba undefined y el
                    contador marcaba 0 columnas en todas las tablas. */}
                <td class="num max-sm:hidden">{(() => { try { return JSON.parse(database.schemaJson || '{}').columns?.length || 0; } catch { return 0; } })()}</td>
                <td class="num">{filasPorTabla.get(database.id) ?? 0}</td>
                {/* Borrar desde la lista: antes solo había una papelera sin
                    texto dentro de cada tabla, y no se encontraba. */}
                {canEdit && (
                  <td class="w-0 !py-1">
                    <button type="button" class="btn-borrar-tabla btn btn-ghost btn-icon btn-sm hover:!text-forge-error" data-id={database.id} data-nombre={database.name}
                      title={t('db.delete_table')} aria-label={t('db.delete_named').replace('{name}', database.name)}>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    </button>
                  </td>
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

  <!-- New DB Modal -->
  {canEdit && (
    <dialog id="new-db-modal" class="ventana !max-w-[44rem] !p-0">
      <div class="px-6 py-5 border-b border-forge-border flex justify-between items-start sticky top-0 bg-forge-panel z-20">
        <div>
          <h2 class="ventana-titulo !mb-0">
            {t('db.new_db')}
          </h2>
          {/* Describe el formulario, no la galería: se oculta en el primer paso.
              En móvil, además, cuatro líneas de subtítulo empujaban las
              plantillas fuera de la pantalla. */}
          <p id="modal-sub" class="hidden text-sm text-forge-muted mt-2">{t('db.new_db_desc')}</p>
        </div>
        <button type="button" aria-label={t('common.close')} class="text-forge-muted hover:text-forge-text p-2 hover:bg-forge-border/50 rounded-full transition-all" onclick="document.getElementById('new-db-modal').close()">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      
      {/* Paso 1: la galería. Se abre siempre aquí, porque elegir una plantilla
          es más rápido que escribir cinco columnas, y quien no la quiera tiene
          la tabla en blanco a un clic. */}
      <div id="step-tpl" class="p-8 max-h-[65vh] overflow-y-auto custom-scrollbar bg-forge-bg/30">
        {/* La tabla en blanco va arriba y a todo lo ancho. Al final de la
            rejilla quedaba por debajo del borde y había que adivinar que
            estaba: quien ya sabe qué columnas quiere no debería tener que
            buscar la salida. */}
        <button type="button" data-tpl="__blank__" class="tpl-card w-full text-left flex items-center gap-4 bg-forge-panel border border-dashed border-forge-border rounded-2xl px-4 py-3 mb-6 hover:border-forge-text transition-all focus:outline-none focus:ring-2 focus:ring-forge-focus">
          <span class="w-9 h-9 shrink-0 rounded-lg bg-forge-bg border border-forge-border/60 flex items-center justify-center text-forge-muted">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </span>
          <span class="min-w-0">
            <span class="block text-sm font-bold text-forge-text">{t('db.tpl_blank')}</span>
            <span class="block text-xs text-forge-muted">{t('db.tpl_blank_desc')}</span>
          </span>
        </button>

        <button type="button" id="btn-tpl-importar" class="w-full text-left flex items-center gap-4 bg-forge-panel border border-dashed border-forge-border rounded-2xl px-4 py-3 -mt-3 mb-6 hover:border-forge-text transition-all focus:outline-none focus:ring-2 focus:ring-forge-focus">
          <span class="w-9 h-9 shrink-0 rounded-lg bg-forge-bg border border-forge-border/60 flex items-center justify-center text-forge-muted">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"/><path d="m7 8 5-5 5 5"/><path d="M5 15v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4"/></svg>
          </span>
          <span class="min-w-0">
            <span class="block text-sm font-bold text-forge-text">{t('db.tpl_import')}</span>
            <span class="block text-xs text-forge-muted">{t('db.tpl_import_desc')}</span>
          </span>
        </button>

        <h3 class="text-base font-bold text-forge-text">{t('db.tpl_heading')}</h3>
        <p class="text-xs text-forge-muted mt-1 mb-5">{t('db.tpl_desc')}</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {plantillas.map(p => (
            <button type="button" data-tpl={p.id} class="tpl-card text-left flex gap-4 bg-forge-panel border border-forge-border rounded-2xl p-4 hover:border-forge-text hover:shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-forge-focus">
              <span class="w-11 h-11 shrink-0 rounded-xl bg-forge-bg border border-forge-border/60 flex items-center justify-center text-forge-accent-text">
                <Icon name={p.icono} size={20} />
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-bold text-forge-text">{p.nombre}</span>
                <span class="block text-xs text-forge-muted mt-1 leading-relaxed">{p.descripcion}</span>
                <span class="inline-block text-xs text-forge-muted mt-2">
                  {p.columnas.length} {t('db.columns')}
                </span>
              </span>
            </button>
          ))}
        </div>
      </div>

      {/* Paso 2: el formulario de siempre, ya relleno si venía de una plantilla. */}
      <div id="step-form" class="hidden">
      <div class="p-8 max-h-[65vh] overflow-y-auto space-y-8 custom-scrollbar bg-forge-bg/30">
        <button type="button" id="btn-tpl-back" class="inline-flex items-center gap-1.5 text-xs font-bold text-forge-muted hover:text-forge-text transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          {t('db.tpl_back')}
        </button>

        <div class="flex flex-col gap-6">
          <div class="flex-1 space-y-5">
            <div>
              <label class="block field-label mb-2" for="db-name">{t('db.table_name')} <span class="text-forge-error">*</span></label>
              <input type="text" id="db-name" class="campo text-base" placeholder={t('db.table_name_ph')}>
            </div>
            <div>
              <label class="block field-label mb-2" for="db-desc">{t('db.desc')} <span class="normal-case font-normal text-forge-muted">({t('db.optional')})</span></label>
              <textarea id="db-desc" rows="2" class="campo custom-scrollbar" placeholder={t('db.desc_ph')}></textarea>
            </div>

            {/* El icono se elige de una lista, no se escribe. Antes era una caja
                de texto donde pegar un emoji: no hereda el color del tema, se
                dibuja distinto en cada sistema y no pega con los iconos de línea
                del resto de la aplicación. */}
            <fieldset>
              <legend class="block field-label mb-2">{t('db.icon')}</legend>
              <input type="hidden" id="db-icon" value={ICONO_POR_DEFECTO}>
              {/* Rejilla fija de siete, no `flex-wrap`: al ajustarse al ancho
                  quedaban trece en una fila y uno solo colgando debajo. */}
              <div id="icon-picker" class="grid grid-cols-7 gap-2 w-max max-w-full">
                {ICONOS_ELEGIBLES.map(nombre => (
                  <button
                    type="button"
                    class="icon-opt w-10 h-10 rounded-xl border border-forge-border bg-forge-panel text-forge-muted flex items-center justify-center transition-all hover:text-forge-text hover:border-forge-muted focus:outline-none focus:ring-2 focus:ring-forge-focus aria-pressed:border-forge-primary aria-pressed:text-forge-accent-text aria-pressed:bg-forge-primary/10"
                    data-icon={nombre}
                    aria-pressed={nombre === ICONO_POR_DEFECTO ? 'true' : 'false'}
                    aria-label={nombre}
                  >
                    <Icon name={nombre} size={18} />
                  </button>
                ))}
              </div>
            </fieldset>
          </div>
        </div>

        <div class="pt-8 border-t border-forge-border/50">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-5 gap-4">
            <div>
              <h3 class="text-base font-bold text-forge-text">{t('db.columns_schema')}</h3>
              <p class="text-xs text-forge-muted mt-1">{t('db.columns_schema_desc')}</p>
            </div>
            <button type="button" id="btn-add-col" class="text-xs font-bold text-forge-accent-text bg-forge-primary/10 hover:bg-forge-primary hover:text-forge-bg px-4 py-2 rounded-xl transition-all border border-forge-primary/20 flex items-center gap-2 shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              {t('db.add_column')}
            </button>
          </div>
          
          {/* Vacío a propósito: las filas las construye el script, todas con el
              mismo molde. Antes la primera venía del servidor y las demás de
              una plantilla de JavaScript, y las dos se fueron separando —las
              creadas a mano acabaron con `aria-label` literales sin traducir. */}
          <div id="columns-container" class="space-y-4"></div>
        </div>
      </div>

      <div class="pt-6 border-t border-forge-border/40 flex justify-end gap-3 mt-8 p-8">
        {/* «Cancelar» vuelve al paso anterior; la equis cierra.

            Hacía `close()`, o sea exactamente lo mismo que la equis, y en un
            alta de dos pasos eso convierte «me he equivocado de plantilla» en
            «empieza de cero». Dos controles distintos que hacen lo mismo son
            uno de más. */}
        <button type="button" id="btn-cancel-db" class="px-6 py-2.5 text-sm font-bold text-forge-muted hover:text-forge-text transition-colors">
          {t('ws.settings.modal_cancel')}
        </button>
        <button type="button" id="btn-save-db" class="btn btn-primary">
          {t('db.create')}
        </button>
      </div>
      </div>
    </dialog>
  )}

  {/* Importar una tabla que ya existe en Excel o en CSV. El archivo se lee en
      el navegador —la hoja, los tipos y la vista previa se deciden aquí— y al
      servidor llegan columnas y filas (`api/w/[sys_tag]/db/importar.ts`). */}
  {canEdit && (
    <dialog id="importar-db" class="ventana !max-w-[48rem]" aria-labelledby="importar-db-titulo"
      data-sys-tag={sys_tag}
      data-t-col={t('db.import_col_default')} data-t-yes={t('db.import_yes')} data-t-no={t('db.import_no')}
      data-t-summary={t('db.import_summary')} data-t-more-rows={t('db.import_more_rows')} data-t-more-cols={t('db.import_more_cols')}
      data-t-empty={t('db.import_empty')} data-t-unreadable={t('db.import_unreadable')}
      data-t-err-number={t('db.import_err_number')} data-t-err-options={t('db.import_err_options')}
      data-t-err-large={t('db.import_err_large')} data-t-err={t('db.import_err')}
      data-t-done={t('db.import_done')} data-t-working={t('db.import_working')} data-t-action={t('db.import_action')}
      data-t-type-text={t('db.type_text')} data-t-type-number={t('db.type_number')} data-t-type-select={t('db.type_select')}
      data-t-col-name={t('db.col_name')} data-t-col-type={t('db.col_type')}
      data-t-deleted={t('db.deleted')} data-t-confirm-delete={t('db.confirm_delete_table')} data-t-delete={t('db.delete_table')} data-t-err-delete={t('db.err_delete_table')}>
      <h2 id="importar-db-titulo" class="ventana-titulo">{t('db.import_title')}</h2>
      <p class="text-sm text-forge-muted mb-4">{t('db.import_desc').replace('{filas}', String(MAX_FILAS)).replace('{columnas}', String(MAX_COLUMNAS))}</p>
      <label class="btn btn-secondary cursor-pointer max-w-full">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"/><path d="m7 8 5-5 5 5"/><path d="M5 15v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4"/></svg>
        <span id="importar-archivo-nombre" class="truncate">{t('db.import_choose')}</span>
        <input type="file" id="importar-archivo" class="sr-only"
          accept=".csv,.tsv,.txt,.xlsx,text/csv,text/tab-separated-values,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
      </label>
      {/* Fuera de la vista previa: si la hoja elegida está vacía, la vista se
          esconde y hay que poder pasar a otra. */}
      <div id="importar-hoja-campo" class="hidden mt-4 max-w-xs">
        <label class="block field-label mb-1.5" for="importar-hoja">{t('db.import_sheet')}</label>
        <select id="importar-hoja" class="campo"></select>
      </div>
      <p id="importar-error" class="hidden mt-3 text-sm text-forge-error" role="alert"></p>

      <div id="importar-vista" class="hidden mt-5 space-y-4">
        <div class="max-w-md">
          <label class="block field-label mb-1.5" for="importar-nombre">{t('db.table_name')}</label>
          <input type="text" id="importar-nombre" class="campo" maxlength="120" autocomplete="off" />
        </div>
        <div>
          <p id="importar-resumen" class="text-sm font-semibold" aria-live="polite"></p>
          <p id="importar-avisos" class="text-sm text-forge-muted"></p>
        </div>
        <div class="overflow-x-auto border border-forge-border rounded-xl max-h-[45vh] overflow-y-auto">
          <table id="importar-tabla" class="tabla"></table>
        </div>
        <p class="hint">{t('db.import_preview_hint')}</p>
      </div>

      <div class="ventana-pie">
        <button type="button" id="importar-cancelar" class="btn btn-ghost">{t('modal.cancel')}</button>
        <button type="button" id="importar-confirmar" class="btn btn-primary" disabled>{t('db.import_action')}</button>
      </div>
    </dialog>
  )}

  <script>
    import { leerCsv, MAX_FILAS, prepararTabla, type Celda, type TablaImportada, type TipoImportado } from '../../../../lib/importarTabla';

    const dlg = document.getElementById('importar-db') as HTMLDialogElement | null;
    if (dlg) montarImportar(dlg);

    function montarImportar(dlg: HTMLDialogElement) {
      const d = dlg.dataset;
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const archivo = $<HTMLInputElement>('importar-archivo');
      const rotuloArchivo = $('importar-archivo-nombre');
      const error = $('importar-error');
      const vista = $('importar-vista');
      const nombre = $<HTMLInputElement>('importar-nombre');
      const campoHoja = $('importar-hoja-campo');
      const selHoja = $<HTMLSelectElement>('importar-hoja');
      const resumen = $('importar-resumen');
      const avisos = $('importar-avisos');
      const tablaVista = $<HTMLTableElement>('importar-tabla');
      const confirmar = $<HTMLButtonElement>('importar-confirmar');
      const rotuloInicial = rotuloArchivo.textContent || '';

      let hojas: Array<{ nombre: string; filas: Celda[][] }> = [];
      let tabla: TablaImportada | null = null;

      const decir = (texto: string) => { error.textContent = texto; error.classList.toggle('hidden', !texto); };
      function reiniciar() {
        archivo.value = '';
        rotuloArchivo.textContent = rotuloInicial;
        hojas = [];
        tabla = null;
        decir('');
        vista.classList.add('hidden');
        campoHoja.classList.add('hidden');
        confirmar.disabled = true;
        confirmar.textContent = d.tAction || '';
      }
      function abrir() { reiniciar(); dlg.showModal(); }

      document.getElementById('btn-importar-db')?.addEventListener('click', abrir);
      // Desde la galería de «Nueva tabla»: se cierra esa y se abre esta.
      document.getElementById('btn-tpl-importar')?.addEventListener('click', () => {
        (document.getElementById('new-db-modal') as HTMLDialogElement | null)?.close();
        abrir();
      });
      $('importar-cancelar').addEventListener('click', () => dlg.close());

      /**
       * El texto de un CSV. Excel en Windows lo guarda en Windows-1252 si no se
       * elige «CSV UTF-8», y leído como UTF-8 cada tilde sale como «�».
       */
      async function textoDe(f: File) {
        const bytes = await f.arrayBuffer();
        try { return new TextDecoder('utf-8', { fatal: true }).decode(bytes); }
        catch { return new TextDecoder('windows-1252').decode(bytes); }
      }

      archivo.addEventListener('change', async () => {
        const f = archivo.files?.[0];
        if (!f) return;
        rotuloArchivo.textContent = f.name;
        decir('');
        vista.classList.add('hidden');
        confirmar.disabled = true;
        try {
          if (/\.xlsx$/i.test(f.name)) {
            const { leerXlsx } = await import('../../../../lib/xlsx');
            // Unas cuantas de margen: la cabecera y alguna fila vacía arriba.
            hojas = leerXlsx(new Uint8Array(await f.arrayBuffer()), MAX_FILAS + 50);
          } else {
            hojas = [{ nombre: '', filas: leerCsv(await textoDe(f)) }];
          }
        } catch (err) {
          console.error('importar:', err);
          decir(d.tUnreadable || '');
          return;
        }
        nombre.value = f.name.replace(/\.[^.]+$/, '').trim().slice(0, 120);
        // Si se borra el nombre, se usa el del archivo.
        nombre.placeholder = nombre.value;
        // La primera hoja con datos: un libro suele abrir con una portada o un
        // resumen vacío.
        const primera = Math.max(0, hojas.findIndex((h) => prepararTabla(h.filas)?.filas.length));
        selHoja.replaceChildren(...hojas.map((h, i) => new Option(h.nombre || String(i + 1), String(i), false, i === primera)));
        campoHoja.classList.toggle('hidden', hojas.length < 2);
        preparar(primera);
      });
      selHoja.addEventListener('change', () => preparar(Number(selHoja.value)));

      function preparar(i: number) {
        tabla = prepararTabla(hojas[i]?.filas ?? [], {
          nombreColumna: (n) => (d.tCol || '').replace('{n}', String(n)),
          si: d.tYes,
          no: d.tNo,
        });
        if (!tabla || !tabla.filas.length) {
          tabla = null;
          vista.classList.add('hidden');
          decir(d.tEmpty || '');
          confirmar.disabled = true;
          return;
        }
        decir('');
        pintar(tabla);
        vista.classList.remove('hidden');
        confirmar.disabled = false;
      }

      const nombreTipo: Record<TipoImportado, string> = { text: d.tTypeText || '', number: d.tTypeNumber || '', select: d.tTypeSelect || '' };

      /** Cabecera con el nombre y el tipo de cada columna, y las cinco primeras filas. */
      function pintar(t: TablaImportada) {
        resumen.textContent = (d.tSummary || '').replace('{filas}', String(t.filas.length)).replace('{columnas}', String(t.columnas.length));
        avisos.textContent = [
          t.sobranFilas ? (d.tMoreRows || '').replaceAll('{n}', String(t.filas.length)) : '',
          t.sobranColumnas ? (d.tMoreCols || '').replaceAll('{n}', String(t.columnas.length)) : '',
        ].filter(Boolean).join(' ');

        const cabecera = document.createElement('tr');
        t.columnas.forEach((c, i) => {
          const th = document.createElement('th');
          th.className = 'min-w-[11rem] align-top !normal-case !tracking-normal';
          const pila = document.createElement('div');
          pila.className = 'grid gap-1.5';
          const campo = document.createElement('input');
          campo.type = 'text';
          campo.className = 'imp-nombre campo !py-1.5 !text-sm';
          campo.value = c.name;
          campo.maxLength = 120;
          campo.setAttribute('aria-label', `${d.tColName} ${i + 1}`);
          const tipo = document.createElement('select');
          tipo.className = 'imp-tipo campo !py-1.5 !text-sm';
          tipo.setAttribute('aria-label', `${d.tColType} ${i + 1}`);
          for (const p of c.posibles) tipo.append(new Option(nombreTipo[p], p, false, p === c.type));
          pila.append(campo, tipo);
          th.append(pila);
          cabecera.append(th);
        });
        const cuerpo = document.createElement('tbody');
        for (const fila of t.filas.slice(0, 5)) {
          const tr = document.createElement('tr');
          for (const v of fila) {
            const td = document.createElement('td');
            td.className = 'max-w-[16rem] truncate';
            td.textContent = v === null ? '' : String(v);
            tr.append(td);
          }
          cuerpo.append(tr);
        }
        const thead = document.createElement('thead');
        thead.append(cabecera);
        tablaVista.replaceChildren(thead, cuerpo);
      }

      confirmar.addEventListener('click', async () => {
        if (!tabla) return;
        const nombres = Array.from(tablaVista.querySelectorAll<HTMLInputElement>('.imp-nombre'));
        const tipos = Array.from(tablaVista.querySelectorAll<HTMLSelectElement>('.imp-tipo'));
        const columns = tabla.columnas.map((c, i) => ({ name: nombres[i]?.value.trim() || c.name, type: tipos[i]?.value || c.type }));
        confirmar.disabled = true;
        confirmar.textContent = d.tWorking || '';
        decir('');
        try {
          const res = await fetch(`/api/w/${d.sysTag}/db/importar`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: nombre.value.trim() || nombre.placeholder, columns, rows: tabla.filas }),
          });
          const datos = await res.json().catch(() => ({}));
          if (!res.ok) throw datos;
          try { sessionStorage.setItem('forge_aviso', (d.tDone || '').replace('{n}', String(datos.filas))); } catch { /* sin almacenamiento */ }
          window.location.href = `/w/${d.sysTag}/db/${datos.id}`;
        } catch (e: any) {
          const codigo = e?.error_code;
          decir(
            codigo === 'bad_number' ? (d.tErrNumber || '').replace('{columna}', e.columna).replace('{fila}', String(e.fila))
            : codigo === 'too_many_options' ? (d.tErrOptions || '').replace('{columna}', e.columna)
            : codigo === 'too_large' ? (d.tErrLarge || '')
            : (d.tErr || ''),
          );
          confirmar.disabled = false;
          confirmar.textContent = d.tAction || '';
        }
      });

      // Borrar una tabla desde la lista, con la misma confirmación que dentro.
      // Sus textos viajan en este diálogo: los dos existen solo para quien edita.
      document.querySelectorAll<HTMLButtonElement>('.btn-borrar-tabla').forEach((b) => b.addEventListener('click', () => {
        const pregunta = (d.tConfirmDelete || '').replace('{name}', b.dataset.nombre || '');
        window.forgeConfirm?.(pregunta, async () => {
          b.disabled = true;
          const res = await fetch(`/api/w/${d.sysTag}/db/${b.dataset.id}`, { method: 'DELETE' }).catch(() => null);
          if (!res?.ok) { b.disabled = false; window.showToast?.(d.tErrDelete || '', true); return; }
          const fila = b.closest('tr');
          const quedan = fila?.parentElement?.querySelectorAll('tr').length ?? 0;
          // La última: se recarga para enseñar el «todavía no hay tablas».
          if (quedan <= 1) {
            try { sessionStorage.setItem('forge_aviso', d.tDeleted || ''); } catch { /* sin almacenamiento */ }
            window.location.reload();
            return;
          }
          fila?.remove();
          window.showToast?.(d.tDeleted || '');
        }, d.tDelete);
      }));
    }
  </script>

  <script define:vars={{ sysTag: sys_tag, plantillas, TXT }}>
    class DatabaseManager {
      constructor() {
        this.elements = {
          newDbBtn: document.getElementById('btn-new-db'),
          modal: document.getElementById('new-db-modal'),
          stepTpl: document.getElementById('step-tpl'),
          stepForm: document.getElementById('step-form'),
          backBtn: document.getElementById('btn-tpl-back'),
          cancelBtn: document.getElementById('btn-cancel-db'),
          subtitulo: document.getElementById('modal-sub'),
          addColBtn: document.getElementById('btn-add-col'),
          colsContainer: document.getElementById('columns-container'),
          saveBtn: document.getElementById('btn-save-db'),
          nameInput: document.getElementById('db-name'),
          iconInput: document.getElementById('db-icon'),
          iconPicker: document.getElementById('icon-picker'),
          descInput: document.getElementById('db-desc')
        };

        this.init();
      }

      init() {
        if (!this.elements.modal) return;

        this.elements.newDbBtn?.addEventListener('click', () => this.abrir());
        this.elements.backBtn?.addEventListener('click', () => this.mostrarPaso('tpl'));

        /*
         * «Cancelar» deshace un paso; no cierra el diálogo entero.
         *
         * Estando en el formulario, cancelar quiere decir «esta plantilla no
         * era»: se vuelve a la galería. Solo cierra si ya estás en la galería,
         * que es donde no hay nada que deshacer.
         */
        this.elements.cancelBtn?.addEventListener('click', () => {
          const enFormulario = !this.elements.stepForm?.classList.contains('hidden');
          if (enFormulario) this.mostrarPaso('tpl');
          else this.elements.modal?.close();
        });
        this.elements.addColBtn?.addEventListener('click', () => this.addColumnRow());
        this.elements.saveBtn?.addEventListener('click', () => this.handleSave());

        this.elements.modal.querySelectorAll('[data-tpl]').forEach(card => {
          card.addEventListener('click', () => this.aplicarPlantilla(card.dataset.tpl));
        });

        this.elements.iconPicker?.querySelectorAll('.icon-opt').forEach(btn => {
          btn.addEventListener('click', () => this.seleccionarIcono(btn.dataset.icon));
        });
      }

      /**
       * Marca un icono como elegido.
       *
       * El valor vive en el campo oculto —es lo que se manda— y `aria-pressed`
       * lleva a la vez el aspecto y lo que anuncia un lector de pantalla, para
       * que no se puedan desincronizar.
       */
      seleccionarIcono(nombre) {
        if (!nombre) return;
        this.elements.iconInput.value = nombre;
        this.elements.iconPicker?.querySelectorAll('.icon-opt').forEach(btn => {
          btn.setAttribute('aria-pressed', String(btn.dataset.icon === nombre));
        });
      }

      /** Abre siempre por la galería, también la segunda vez. */
      abrir() {
        this.mostrarPaso('tpl');
        this.elements.modal.showModal();
      }

      mostrarPaso(paso) {
        this.elements.stepTpl?.classList.toggle('hidden', paso !== 'tpl');
        this.elements.stepForm?.classList.toggle('hidden', paso === 'tpl');
        this.elements.subtitulo?.classList.toggle('hidden', paso === 'tpl');
      }

      /**
       * Vuelca una plantilla en el formulario y pasa al paso 2.
       *
       * Deja todo editable: la plantilla es un punto de partida, no un molde
       * cerrado. El nombre se puede cambiar antes de crear, y las columnas
       * también.
       */
      aplicarPlantilla(id) {
        const p = id === '__blank__' ? null : plantillas.find(x => x.id === id);

        this.elements.nameInput.value = p ? p.nombre : '';
        this.elements.descInput.value = p ? p.descripcion : '';
        this.seleccionarIcono(p ? p.icono : 'database');

        this.elements.colsContainer.innerHTML = '';
        const columnas = p ? p.columnas : [{ name: TXT.nameDefault, type: 'text' }];
        columnas.forEach(c => this.addColumnRow(c));

        this.mostrarPaso('form');
        this.elements.nameInput.focus();
      }

      /**
       * Añade una fila de columna, opcionalmente con valores ya puestos.
       *
       * Los valores se asignan por propiedad y no dentro del HTML: así un
       * nombre con comillas o con `<` no puede romper el marcado ni inyectar
       * nada, venga de una plantilla o de lo que se haya escrito antes.
       */
      addColumnRow(valores = null) {
        const div = document.createElement('div');
        div.className = 'col-def flex flex-wrap gap-4 items-start bg-forge-panel border border-forge-border p-4 rounded-2xl shadow-sm relative overflow-hidden group hover:border-forge-border/80 transition-colors';

        div.innerHTML = `
          <div class="absolute left-0 top-0 bottom-0 w-1 bg-forge-border/40 group-hover:bg-forge-primary/50 transition-colors"></div>
          <div class="flex-1 min-w-[200px]">
            <span class="block field-label mb-1.5 ml-1"></span>
            <input type="text" class="col-name campo">
          </div>
          <div class="w-36 shrink-0">
            <span class="block field-label mb-1.5 ml-1"></span>
            <select class="col-type campo">
              <option value="text"></option>
              <option value="number"></option>
              <option value="select"></option>
              <option value="file"></option>
            </select>
          </div>
          <div class="shrink-0 pt-6">
            <button type="button" class="btn-rm-col btn btn-ghost btn-icon hover:!text-forge-error">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
          <div class="col-options-container hidden w-full mt-2 basis-full p-3 bg-forge-bg/50 rounded-xl border border-forge-border/40">
            <span class="block field-label mb-1.5"></span>
            <input type="text" class="col-options campo">
          </div>
        `;

        const etiquetas = div.querySelectorAll('span');
        etiquetas[0].textContent = TXT.colName;
        etiquetas[1].textContent = TXT.colType;
        etiquetas[2].textContent = TXT.colOptionsLabel;

        const nombre = div.querySelector('.col-name');
        nombre.placeholder = TXT.colNamePh;
        nombre.setAttribute('aria-label', TXT.colName);

        const tipo = div.querySelector('.col-type');
        tipo.setAttribute('aria-label', TXT.colType);
        const opciones = tipo.querySelectorAll('option');
        opciones[0].textContent = TXT.typeText;
        opciones[1].textContent = TXT.typeNumber;
        opciones[2].textContent = TXT.typeSelect;
        opciones[3].textContent = TXT.typeFile;

        const listaOpciones = div.querySelector('.col-options');
        listaOpciones.placeholder = TXT.colOptionsPh;
        listaOpciones.setAttribute('aria-label', TXT.colOptions);

        div.querySelector('.btn-rm-col').setAttribute('aria-label', TXT.removeCol);

        if (valores) {
          nombre.value = valores.name || '';
          tipo.value = valores.type || 'text';
          if (valores.options?.length) listaOpciones.value = valores.options.join(', ');
        }

        this.elements.colsContainer?.appendChild(div);
        this.bindTypeSelect(div);

        div.querySelector('.btn-rm-col')?.addEventListener('click', () => {
          div.remove();
          // Quedarse con cero columnas es un callejón sin salida: no hay dónde
          // escribir y el botón de crear solo devuelve un error. Se repone una
          // fila en blanco.
          if (!this.elements.colsContainer.querySelector('.col-def')) this.addColumnRow();
        });

        return div;
      }

      bindTypeSelect(row) {
        const typeSelect = row.querySelector('.col-type');
        const optContainer = row.querySelector('.col-options-container');

        if (!typeSelect || !optContainer) return;

        const sincronizar = () => optContainer.classList.toggle('hidden', typeSelect.value !== 'select');
        typeSelect.addEventListener('change', sincronizar);
        // También al construir la fila: una plantilla puede traer ya un
        // desplegable, y su lista de opciones tiene que verse desde el principio.
        sincronizar();
      }

      extractColumns() {
        const columns = [];
        const colDefs = this.elements.colsContainer.querySelectorAll('.col-def');

        if (colDefs.length === 0) {
          return { error: TXT.errNoCols };
        }

        for (let i = 0; i < colDefs.length; i++) {
          const def = colDefs[i];
          const name = def.querySelector('.col-name').value.trim();
          const type = def.querySelector('.col-type').value;
          const optionsText = def.querySelector('.col-options').value.trim();

          if (!name) return { error: TXT.errUnnamed.replace('{n}', String(i + 1)) };
          if (type === 'select' && !optionsText) return { error: TXT.errNoOptions.replace('{name}', name) };

          const col = { name, type };
          if (type === 'select' && optionsText) {
            col.options = optionsText.split(',').map(o => o.trim()).filter(Boolean);
          }

          columns.push(col);
        }

        return { columns };
      }

      async handleSave() {
        const name = this.elements.nameInput?.value.trim();
        const icon = this.elements.iconInput?.value.trim();
        const description = this.elements.descInput?.value.trim();

        if (!name) return window.showToast?.(TXT.errName, true);

        const { error, columns } = this.extractColumns();
        if (error) return window.showToast?.(error, true);

        this.setLoading(true);

        try {
          const res = await fetch(`/api/w/${sysTag}/db`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, description, icon, columns })
          });

          if (!res.ok) throw new Error(TXT.errCreate);

          const data = await res.json();
          window.location.href = `/w/${sysTag}/db/${data.id}`;

        } catch (err) {
          // El texto del servidor no se enseña: son mensajes internos, en
          // inglés y a veces con detalles que al usuario no le dicen nada.
          window.showToast?.(TXT.errCreate, true);
          this.setLoading(false);
        }
      }

      setLoading(isLoading) {
        if (!this.elements.saveBtn) return;
        this.elements.saveBtn.disabled = isLoading;
        this.elements.saveBtn.textContent = isLoading ? TXT.saving : TXT.create;
      }
    }

    // Initialize module
    document.addEventListener('DOMContentLoaded', () => new DatabaseManager());
  </script>
</MainLayout>
