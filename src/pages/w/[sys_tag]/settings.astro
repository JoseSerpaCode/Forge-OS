---
import MainLayout from '../../../layouts/MainLayout.astro';
import db from '../../../lib/db';
import { checkWorkspaceAccess } from '../../../lib/guard';
import { useTranslations } from '../../../i18n/ui';
import LabelChip from '../../../components/labels/LabelChip.astro';
import WorkspaceIcon from '../../../components/brand/WorkspaceIcon.astro';
import { COLORES, listar as listarEtiquetas } from '../../../lib/labels';
import { listar as listarTipos, nombreVisible } from '../../../lib/issueTypes';
import { abrirEspacioDePagina } from '../../../lib/paginaEspacio';
import { funciones as funcionesDe } from '../../../lib/funcionesEspacio';
import { listar as listarPlantillas } from '../../../lib/plantillas';
import PlantillasTareas from '../../../components/workspace/PlantillasTareas.astro';

const user = Astro.locals.user!;
const t = useTranslations(Astro.locals.lang || 'en');
if (!user) return Astro.redirect('/login');

const { sys_tag } = Astro.params;

const acceso = abrirEspacioDePagina(sys_tag, user, 'owner');
if (!acceso.ok) return Astro.redirect(acceso.redirigir);
const ws = acceso.ws;

const etiquetas = listarEtiquetas(ws.id);
const funcionesEspacio = funcionesDe(ws.id);
const plantillas = listarPlantillas(ws.id);

// Cuántos tickets usa cada tipo: es el dato que decide si borrarlo es una
// limpieza o una reorganización.
const tiposTicket = listarTipos(ws.id).map((ti) => ({
  ...ti,
  usos: (db.prepare('SELECT COUNT(*) AS n FROM issues WHERE workspace_id = ? AND type = ?')
    .get(ws.id, ti.key) as any).n as number,
}));

const members = db.prepare(`
  SELECT u.id, u.username, u.avatar_url, wm.ws_role, wm.joined_at
  FROM workspace_members wm
  JOIN users u ON wm.user_id = u.id
  WHERE wm.workspace_id = ?
  ORDER BY wm.joined_at ASC
`).all(ws.id) as any[];

const joinRequests = db.prepare(`
  SELECT r.id, r.status, r.created_at, u.username, u.avatar_url
  FROM workspace_join_requests r
  JOIN users u ON r.user_id = u.id
  WHERE r.workspace_id = ? AND r.status = 'pending'
  ORDER BY r.created_at DESC
`).all(ws.id) as any[];

const auditLogs = db.prepare(`
  SELECT a.id, a.action, a.entity_type, a.entity_id, a.details_json, a.timestamp, u.username, u.avatar_url
  FROM audit_logs a
  LEFT JOIN users u ON a.user_id = u.id
  WHERE a.workspace_id = ?
  ORDER BY a.timestamp DESC
  LIMIT 50
`).all(ws.id) as any[];

const automations = db.prepare(`
  SELECT id, name, trigger_type, trigger_condition, action_type, action_payload, is_active
  FROM automations
  WHERE workspace_id = ?
`).all(ws.id) as any[];

// El filtro por espacio va **en el SQL**, no en JavaScript.
//
// Antes esta consulta se traía *todas* las invitaciones pendientes de la
// instancia entera —de cualquier espacio y de cualquier persona— para quedarse
// con las de este espacio parseando el JSON de cada fila en el servidor. El
// coste de abrir los ajustes de un espacio crecía con el uso global del
// producto: con mil espacios activos, mirar los tuyos leía las invitaciones de
// los novecientos noventa y nueve restantes.
//
// `json_valid` va antes que `json_extract` a propósito: `link_url` es una
// columna de texto libre y `json_extract` sobre algo que no es JSON aborta la
// consulta entera. SQLite evalúa el AND en orden, así que una fila con basura
// se descarta en vez de tumbar la página.
const wsPendingInvites = (db.prepare(`
  SELECT n.id, n.link_url, n.created_at, u.username, u.avatar_url,
         COALESCE(json_extract(n.link_url, '$.role'), 'viewer') AS role
  FROM notifications n
  JOIN users u ON n.user_id = u.id
  WHERE n.type = 'invite'
    AND json_valid(n.link_url)
    AND json_extract(n.link_url, '$.ws_id') = ?
  ORDER BY n.created_at DESC
`).all(ws.id) as any[]).map(n => {
  const SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;
  const isExpired = (Date.now() - new Date(n.created_at + 'Z').getTime()) > SEVEN_DAYS_MS;

  return { ...n, isExpired };
});
---

<MainLayout hideFooter={true} title={`${t('sidebar.settings')} - ${ws.name}`} workspaceId={ws.id}>
  <div class="max-w-4xl mx-auto mt-4 sm:mt-10 p-0 sm:p-6 space-y-6 sm:space-y-8 relative">
    {/* Mismo caso que la cabecera del panel: en una fila, el enlace de vuelta
        se lleva su ancho y el título se parte en dos líneas de dos palabras. */}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-3">
      <h1 class="page-title">{t('ws.settings.title')}</h1>
      <a href={`/w/${sys_tag}`} class="text-forge-muted hover:text-forge-text text-sm hover:underline shrink-0">{t('ws.settings.back')}</a>
    </div>

    <!-- General Settings -->
    <div class="panel p-6">
      <h2 class="text-lg font-bold text-forge-text mb-6">{t('ws.settings.general')}</h2>
      <div class="flex flex-col md:flex-row items-start gap-6">
        <div class="relative w-32 h-32 rounded-xl border-2 border-dashed border-forge-border hover:border-forge-text flex items-center justify-center bg-forge-bg overflow-hidden group cursor-pointer shrink-0" id="ws-icon-preview-container">
          <WorkspaceIcon icon={ws.icon} name={ws.name} class="text-4xl" imgId="ws-icon-preview-img" textId="ws-icon-preview-text" />
          <div class="absolute inset-0 bg-forge-text/80 hidden group-hover:flex items-center justify-center z-10 flex-col">
            <span class="text-xs font-bold text-forge-bg text-center px-2">{t('ws.settings.upload')}</span>
          </div>
          <input type="file" id="ws-icon-file-input" aria-label={t('a11y.ws_icon')} accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer z-20" title={t('ws.settings.upload')} />
        </div>
        
        <div class="flex-1 space-y-4">
          <div>
            <label class="block field-label mb-1" for="ws-name-input">{t('ws.settings.name')}</label>
            <input type="text" id="ws-name-input" value={ws.name} class="campo w-full" />
          </div>
          <div>
            <label class="block field-label mb-1" for="ws-tag-input">{t('ws.settings.tag')}</label>
            <input type="text" id="ws-tag-input" value={ws.sys_tag} class="campo w-full" />
          </div>
          <div>
            <label class="block field-label mb-1" for="ws-desc-input">{t('ws.settings.desc')}</label>
            <textarea id="ws-desc-input" rows="2" class="campo w-full">{ws.description || ''}</textarea>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block field-label mb-1" for="ws-public-input">{t('ws.settings.visibility')}</label>
              <select id="ws-public-input" class={`w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:outline-none focus:border-forge-focus ${user.is_guest ? 'guest-restricted-action opacity-50' : ''}`} data-guest={user.is_guest ? 'true' : 'false'} data-guest-msg={t('ws.settings.guest_visibility')}>
                <option value="0" selected={ws.is_public === 0}>{t('ws.settings.private')}</option>
                <option value="1" selected={ws.is_public === 1}>{t('ws.settings.public')}</option>
              </select>
            </div>
            <div>
              <label class="block field-label mb-1" for="ws-join-policy-input">{t('ws.settings.join_policy')}</label>
              <select id="ws-join-policy-input" class={`w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:outline-none focus:border-forge-focus ${user.is_guest ? 'guest-restricted-action opacity-50' : ''}`} data-guest={user.is_guest ? 'true' : 'false'} data-guest-msg={t('ws.settings.guest_join')}>
                <option value="disabled" selected={ws.join_policy === 'disabled'}>{t('ws.settings.policy_disabled')}</option>
                <option value="friends_only" selected={ws.join_policy === 'friends_only'}>{t('ws.settings.policy_friends')}</option>
                <option value="open" selected={ws.join_policy === 'open'}>{t('ws.settings.policy_open')}</option>
              </select>
            </div>
          </div>
          <button id="btn-save-general" class={`bg-forge-primary text-forge-on-accent font-bold py-2 px-6 rounded hover:bg-forge-primary/90 transition-colors mt-2 ${user.is_guest ? 'guest-restricted-action opacity-50' : ''}`} data-ws-id={ws.id} data-guest={user.is_guest ? 'true' : 'false'} data-guest-msg={t('ws.settings.guest_save')}>
            {t('ws.settings.save')}
          </button>
        </div>
      </div>
    </div>

    <!-- Members -->
    <div class="panel p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-lg font-bold text-forge-text">{t('ws.settings.members')}</h2>
        <button id="btn-add-member" class={`btn btn-secondary btn-sm ${user.is_guest ? 'guest-restricted-action opacity-50' : ''}`} data-guest={user.is_guest ? 'true' : 'false'} data-guest-msg={t('ws.settings.guest_invite')}>
          {t('ws.settings.invite')}
        </button>
      </div>

      <div class="space-y-3">
        {members.map((m) => (
          <div class="flex items-center justify-between bg-forge-bg border border-forge-border p-3 rounded">
            <div class="flex items-center gap-3">
              {m.avatar_url ? (
                <img src={m.avatar_url} class="w-8 h-8 rounded-full border border-forge-border object-cover" alt={`${m.username} avatar`} loading="lazy" />
              ) : (
                <div class="w-8 h-8 rounded-full border border-forge-border flex items-center justify-center text-forge-accent-text shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
              )}
              <span class="font-bold text-forge-text">{m.username}</span>
            </div>
            
            <div class="flex items-center gap-3">
              <select aria-label={t('a11y.member_role')} class="campo role-select" data-user-id={m.id} data-ws-id={ws.id}>
                <option value="owner" selected={m.ws_role === 'owner'}>{t('ws.settings.role_owner')}</option>
                <option value="editor" selected={m.ws_role === 'editor'}>{t('ws.settings.role_editor')}</option>

                <option value="viewer" selected={m.ws_role === 'viewer'}>{t('ws.settings.role_viewer')}</option>
              </select>
              
              <button class="btn-remove-member text-forge-muted hover:text-forge-error p-1 rounded hover:bg-forge-error/10 transition-colors" data-user-id={m.id} data-ws-id={ws.id} title={t('ws.settings.remove_member')} aria-label={t('ws.settings.remove_member')}>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
              </button>
            </div>
          </div>
        ))}
        {wsPendingInvites.map((m: any) => (
          <div class="flex items-center justify-between bg-forge-bg/50 border border-forge-border border-dashed p-3 rounded opacity-75">
            <div class="flex items-center gap-3">
              {m.avatar_url ? (
                <img src={m.avatar_url} class="w-8 h-8 rounded-full border border-forge-border object-cover" alt={`${m.username} avatar`} loading="lazy" />
              ) : (
                <div class="w-8 h-8 rounded-full border border-forge-border flex items-center justify-center text-forge-accent-text shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
              )}
              <span class="font-bold text-forge-text">{m.username}</span>
              {m.isExpired ? (
                <span class="text-xs font-bold text-forge-error bg-forge-error/10 px-2 py-0.5 rounded" title={t('ws.settings.expired_title')}>{t('ws.settings.expired')}</span>
              ) : (
                <span class="text-xs font-semibold text-forge-muted">{t('activity.req.pending')}</span>
              )}
            </div>
            
            <div class="flex items-center gap-3">
              <span class="text-xs text-forge-muted capitalize">{m.role}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
    
    <!-- Join Requests -->
    <div class="panel p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-lg font-bold text-forge-text">{t('ws.settings.join_requests')}</h2>
        <span class="hint">{t('ws.settings.pending_n').replace('{n}', String(joinRequests.length))}</span>
      </div>

      <div class="space-y-3">
        {joinRequests.length === 0 ? (
          <div class="text-forge-muted text-sm italic">{t('ws.settings.no_requests')}</div>
        ) : (
          joinRequests.map((req) => (
            <div class="flex items-center justify-between bg-forge-bg border border-forge-border p-3 rounded">
              <div class="flex items-center gap-3">
                {req.avatar_url ? (
                  <img src={req.avatar_url} class="w-8 h-8 rounded-full border border-forge-border object-cover" alt={`${req.username} avatar`} loading="lazy" />
                ) : (
                  <div class="w-8 h-8 rounded-full border border-forge-border flex items-center justify-center text-forge-accent-text shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  </div>
                )}
                <div>
                  <span class="font-bold text-forge-text block">@{req.username}</span>
                  <span class="text-xs text-forge-muted">{new Date(req.created_at).toLocaleDateString()}</span>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <button class="btn-req-accept px-3 py-1 bg-forge-success/20 text-forge-success hover:bg-forge-success/30 rounded border border-forge-success/30 transition-colors text-sm font-medium" data-req-id={req.id}>{t('ws.settings.accept')}</button>
                <button class="btn-req-reject px-3 py-1 bg-forge-error/20 text-forge-error hover:bg-forge-error/30 rounded border border-forge-error/30 transition-colors text-sm font-medium" data-req-id={req.id}>{t('ws.settings.reject')}</button>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
    
    <!-- Etiquetas del espacio -->
    <div class="panel p-6">
      <div class="flex items-center justify-between mb-2 gap-4">
        <h2 class="text-lg font-bold text-forge-text">{t('labels.title')}
        </h2>
      </div>
      <p class="text-sm text-forge-muted mb-6 max-w-2xl leading-relaxed">{t('labels.desc')}</p>

      <form id="form-nueva-etiqueta" class="flex flex-col sm:flex-row gap-3 sm:items-end mb-6">
        <div class="flex-1 min-w-0">
          <label class="block field-label mb-1.5" for="etiqueta-nombre">{t('labels.name')}</label>
          <input type="text" id="etiqueta-nombre" maxlength="40" autocomplete="off" placeholder={t('labels.name_ph')} class="campo w-full">
        </div>
        <fieldset class="shrink-0">
          <legend class="block field-label mb-1.5">{t('labels.color')}</legend>
          <div id="etiqueta-colores" class="flex flex-wrap gap-1.5">
            {COLORES.map((c, i) => (
              <button
                type="button"
                class="color-opt w-7 h-7 rounded-lg border-2 border-transparent transition-all focus:outline-none focus:ring-2 focus:ring-forge-focus aria-pressed:border-forge-text"
                style={`background-color:${c}`}
                data-color={c}
                aria-pressed={i === 1 ? 'true' : 'false'}
                aria-label={c}
              ></button>
            ))}
          </div>
        </fieldset>
        <button type="submit" class="btn btn-primary shrink-0">
          {t('labels.create')}
        </button>
      </form>

      <ul id="lista-etiquetas" class="space-y-2">
        {etiquetas.map((e: any) => (
          <li class="fila-etiqueta flex items-center justify-between gap-3 bg-forge-bg/50 border border-forge-border p-3 rounded-lg" data-id={e.id} data-name={e.name} data-color={e.color}>
            <div class="flex items-center gap-3 min-w-0">
              <LabelChip name={e.name} color={e.color} />
              <span class="chip-uso text-xs text-forge-muted truncate">
                {e.usos === 0 ? t('labels.unused') : e.usos === 1 ? t('labels.used_in_one') : t('labels.used_in').replace('{n}', String(e.usos))}
              </span>
            </div>
            <div class="flex items-center gap-1 shrink-0">
              <button type="button" class="btn-editar-etiqueta btn btn-ghost btn-sm" aria-label={t('labels.edit_named').replace('{nombre}', e.name)}>{t('labels.edit')}</button>
              <button type="button" class="btn-borrar-etiqueta btn btn-ghost btn-icon btn-sm !text-forge-error" aria-label={t('labels.delete')} title={t('labels.delete')}>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
              </button>
            </div>
          </li>
        ))}
      </ul>
      <div id="etiquetas-vacio" class:list={['py-6 text-center text-forge-muted text-sm border border-dashed border-forge-border rounded-lg bg-forge-bg/30', etiquetas.length > 0 && 'hidden']}>
        {t('labels.none')}
      </div>
    </div>

    <!-- Tipos de ticket -->
    <div id="tipos-ticket" class="panel p-6"
      data-sys-tag={sys_tag}
      data-t-error={t('types.error')}
      data-t-in-use={t('types.in_use_confirm')}
      data-t-in-use-one={t('types.in_use_confirm_one')}
      data-t-last={t('types.err_last')}
      data-t-delete={t('types.delete')}
      data-t-edit-title={t('types.edit_title')}
      data-t-name={t('types.name')}
      data-t-errrepetido={t('types.err_repetido')}
      data-t-errnombre_vacio={t('types.err_nombre_vacio')}
      data-t-errnombre_largo={t('types.err_nombre_largo')}
      data-t-errdemasiados={t('types.err_demasiados')}
      data-t-errcolor_invalido={t('labels.err_bad_color')}>
      <div class="flex items-center justify-between mb-2 gap-4">
        <h2 class="text-lg font-bold text-forge-text">{t('types.title')}
        </h2>
      </div>
      <p class="text-sm text-forge-muted mb-6 max-w-2xl leading-relaxed">{t('types.desc')}</p>

      <form id="form-nuevo-tipo" class="flex flex-col sm:flex-row gap-3 sm:items-end mb-6">
        <div class="flex-1 min-w-0">
          <label class="block field-label mb-1.5" for="tipo-nombre">{t('types.name')}</label>
          <input type="text" id="tipo-nombre" maxlength="30" autocomplete="off" placeholder={t('types.name_ph')} class="campo w-full">
        </div>
        <fieldset class="shrink-0">
          <legend class="block field-label mb-1.5">{t('types.color')}</legend>
          <div id="tipo-colores" class="flex flex-wrap gap-1.5">
            {COLORES.map((c, i) => (
              <button
                type="button"
                class="tipo-color-opt w-7 h-7 rounded-lg border-2 border-transparent transition-all focus:outline-none focus:ring-2 focus:ring-forge-focus aria-pressed:border-forge-text"
                style={`background-color:${c}`}
                data-color={c}
                aria-pressed={i === 5 ? 'true' : 'false'}
                aria-label={c}
              ></button>
            ))}
          </div>
        </fieldset>
        <button type="submit" class="btn btn-primary shrink-0">
          {t('types.create')}
        </button>
      </form>

      {/* Cada tipo, en dos filas cuando la pantalla es estrecha.

          En una sola, «Renombrar» más la papelera se llevan 120 px fijos de los
          290 que hay, y los dos textos de la izquierda —el nombre del tipo y su
          uso— se reparten lo que queda encogiéndose a la vez. El resultado era
          «T… en 1… Renombrar», con el nombre recortado a una letra: la lista
          dejaba de decir qué tipos existen, que es lo único que hace. */}
      <ul id="lista-tipos" class="space-y-2">
        {tiposTicket.map((ti: any) => (
          <li class="fila-tipo flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-3 bg-forge-bg/50 border border-forge-border p-3 rounded-lg"
            data-id={ti.id} data-key={ti.key} data-name={ti.name} data-visible={nombreVisible(ti, t)} data-color={ti.color} data-builtin={ti.isBuiltin ? '1' : '0'}>
            <div class="flex items-center gap-3 min-w-0 flex-wrap">
              <span class="w-3 h-3 rounded-full shrink-0" style={`background:${ti.color}`} aria-hidden="true"></span>
              <span class="text-sm font-semibold text-forge-text truncate">
                {nombreVisible(ti, t)}
              </span>
              <span class="text-xs text-forge-muted truncate">
                {ti.usos === 0 ? t('types.unused') : ti.usos === 1 ? t('types.used_in_one') : t('types.used_in').replace('{n}', String(ti.usos))}
              </span>
            </div>
            <div class="flex items-center gap-1 shrink-0 self-end sm:self-auto">
              <button type="button" class="btn-editar-tipo btn btn-ghost btn-sm" aria-label={t('types.edit_named').replace('{nombre}', nombreVisible(ti, t))}>{t('labels.edit')}</button>
              <button type="button" class="btn-borrar-tipo btn btn-ghost btn-icon btn-sm !text-forge-error" aria-label={t('types.delete')} title={t('types.delete')}>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
              </button>
            </div>
          </li>
        ))}
      </ul>
    </div>

    {/*
      Borrar un tipo que está en uso.
      El servidor se niega y devuelve cuántos tickets lo llevan y a qué tipos
      pueden pasar. Esto es esa pregunta, con el número delante: «afecta a
      algunos tickets» no permite decidir nada.
    */}
    <dialog id="tipo-borrar-modal" class="ventana">
      <h2 class="text-lg font-bold mb-1">{t('types.delete')}</h2>
      <p id="tipo-borrar-lead" class="text-sm text-forge-muted mb-5"></p>
      <label class="block field-label mb-1.5" for="tipo-sustituto">{t('types.replacement')}</label>
      <select id="tipo-sustituto" class="campo w-full"></select>
      <div class="flex justify-end gap-3 mt-6">
        <button type="button" id="tipo-borrar-cancelar" class="px-4 py-2 text-sm font-bold text-forge-muted hover:text-forge-text">{t('modal.cancel')}</button>
        <button type="button" id="tipo-borrar-confirmar" class="btn btn-primary">{t('types.delete_move')}</button>
      </div>
    </dialog>

    {/* Editar una etiqueta o un tipo: nombre y color en la misma ventana.
        Antes la etiqueta se editaba en la propia fila con un botón que decía
        «Renombrar» —y cambiaba también el color, sin que se adivinara— y el
        tipo solo se renombraba, con el `prompt()` del navegador. */}
    <dialog id="editar-catalogo" class="ventana" aria-labelledby="editar-catalogo-titulo">
      <h2 id="editar-catalogo-titulo" class="ventana-titulo"></h2>
      <form id="editar-catalogo-form" novalidate>
        <label id="editar-catalogo-rotulo" class="block field-label mb-1.5" for="editar-catalogo-nombre"></label>
        <input type="text" id="editar-catalogo-nombre" class="campo" autocomplete="off" />
        <fieldset class="mt-4">
          <legend class="block field-label mb-1.5">{t('labels.color')}</legend>
          <div id="editar-catalogo-colores" class="flex flex-wrap gap-1.5">
            {COLORES.map((c) => (
              <button type="button" class="color-opt w-8 h-8 rounded-lg border-2 border-transparent transition-all focus:outline-none focus:ring-2 focus:ring-forge-focus aria-pressed:border-forge-text"
                style={`background-color:${c}`} data-color={c} aria-label={c} aria-pressed="false"></button>
            ))}
          </div>
        </fieldset>
        <p id="editar-catalogo-error" class="hidden mt-3 text-sm text-forge-error" role="alert"></p>
        <div class="ventana-pie">
          <button type="button" id="editar-catalogo-cancelar" class="btn btn-ghost">{t('modal.cancel')}</button>
          <button type="submit" class="btn btn-primary">{t('labels.save')}</button>
        </div>
      </form>
    </dialog>

    {/* Funciones del tablero.
        Un `<label>` que **envuelve** cada casilla y sin `for`: envolver ya la
        asocia, y un `for` que apuntara a otro sitio haría que el navegador
        ignorara la que envuelve (docs/desarrollo.md, «Accesibilidad»). */}
    <div id="funciones-tablero" class="panel p-6"
      data-sys-tag={sys_tag}
      data-t-saved={t('ws.settings.feat_saved')}
      data-t-error={t('ws.settings.feat_error')}>
      <h2 class="text-lg font-bold text-forge-text mb-1">{t('ws.settings.board')}</h2>
      <p class="text-sm text-forge-muted mb-5">{t('ws.settings.board_desc')}</p>
      <div class="space-y-4">
        {([
          ['sprints', 'feat_sprints'],
          ['tiempo', 'feat_time'],
          ['puntos', 'feat_points'],
        ] as const).map(([clave, texto]) => (
          <label class="flex items-center justify-between gap-6 cursor-pointer group">
            <span>
              <span id={`funcion-${clave}-nombre`} class="text-sm font-medium text-forge-text block mb-0.5">{t(`ws.settings.${texto}`)}</span>
              <span id={`funcion-${clave}-desc`} class="text-xs text-forge-muted block">{t(`ws.settings.${texto}_desc`)}</span>
            </span>
            <span class="relative inline-flex items-center shrink-0">
              <input type="checkbox" class="sr-only peer funcion-tablero" data-funcion={clave} checked={funcionesEspacio[clave]}
                aria-labelledby={`funcion-${clave}-nombre`} aria-describedby={`funcion-${clave}-desc`} />
              <span class="w-9 h-5 bg-forge-bg rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-forge-muted after:border-forge-border after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-forge-primary peer-checked:after:bg-white border border-forge-border/60 group-hover:border-forge-border peer-focus-visible:ring-2 peer-focus-visible:ring-forge-focus transition-colors"></span>
            </span>
          </label>
        ))}
      </div>
      <h3 class="text-sm font-bold text-forge-text mt-8 mb-1">{t('ws.settings.team')}</h3>
      <p class="text-sm text-forge-muted mb-5">{t('ws.settings.team_desc')}</p>
      <div class="space-y-4">
        {([
          ['automatizaciones', 'feat_automations'],
          ['auditoria', 'feat_audit'],
        ] as const).map(([clave, texto]) => (
          <label class="flex items-center justify-between gap-6 cursor-pointer group">
            <span>
              <span id={`funcion-${clave}-nombre`} class="text-sm font-medium text-forge-text block mb-0.5">{t(`ws.settings.${texto}`)}</span>
              <span id={`funcion-${clave}-desc`} class="text-xs text-forge-muted block">{t(`ws.settings.${texto}_desc`)}</span>
            </span>
            <span class="relative inline-flex items-center shrink-0">
              <input type="checkbox" class="sr-only peer funcion-tablero" data-funcion={clave} data-recargar="true" checked={funcionesEspacio[clave]}
                aria-labelledby={`funcion-${clave}-nombre`} aria-describedby={`funcion-${clave}-desc`} />
              <span class="w-9 h-5 bg-forge-bg rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-forge-muted after:border-forge-border after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-forge-primary peer-checked:after:bg-white border border-forge-border/60 group-hover:border-forge-border peer-focus-visible:ring-2 peer-focus-visible:ring-forge-focus transition-colors"></span>
            </span>
          </label>
        ))}
      </div>
    </div>

    <PlantillasTareas sysTag={sys_tag!} plantillas={plantillas} etiquetas={etiquetas}
      tipos={tiposTicket.map((ti) => ({ key: ti.key, nombre: nombreVisible(ti, t) }))} />

    {/* Solo con las automatizaciones encendidas (funciones del espacio). */}
    {funcionesEspacio.automatizaciones && (
    <div class="panel p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-lg font-bold text-forge-text">{t('ws.settings.automations')}
        </h2>
        <button id="btn-add-automation" class="btn btn-primary">
          {t('ws.settings.new_rule')}
        </button>
      </div>

      <div class="space-y-4">
        {automations.map((auto: any) => (
          <div class="flex items-center justify-between bg-forge-bg/50 border border-forge-border p-4 rounded-lg">
            <div class="flex flex-col">
              <span class="font-bold text-forge-text text-sm">{auto.name}</span>
              <span class="text-xs font-mono text-forge-muted mt-1 uppercase">IF {auto.trigger_type} THEN {auto.action_type}</span>
            </div>
            <div class="flex items-center gap-4">
              <label class="flex items-center cursor-pointer">
                <div class="relative">
                  <input type="checkbox" class="sr-only toggle-automation-active" data-id={auto.id} checked={auto.is_active === 1}>
                  <div class="block bg-forge-panel border border-forge-border w-8 h-5 rounded-full transition-colors"></div>
                  <div class="dot absolute left-1 top-1 bg-forge-muted w-3 h-3 rounded-full transition-transform"></div>
                </div>
              </label>
              <button class="btn-delete-automation text-forge-muted hover:text-forge-error p-1 rounded hover:bg-forge-error/10 transition-colors" data-id={auto.id} title={t('ws.settings.delete_rule')} aria-label={t('ws.settings.delete_rule')}>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
              </button>
            </div>
          </div>
        ))}
        {automations.length === 0 && (
          <div class="py-6 text-center text-forge-muted text-sm border border-dashed border-forge-border rounded-lg bg-forge-bg/30">
            {t('ws.settings.no_rules')}
          </div>
        )}
      </div>
    </div>
    )}
    
    {/* Solo con la auditoría encendida (funciones del espacio). */}
    {funcionesEspacio.auditoria && (
    <div class="panel p-6 overflow-hidden flex flex-col max-h-[600px]">
      <div class="flex items-center justify-between mb-6 shrink-0">
        <h2 class="text-lg font-bold text-forge-text">{t('ws.settings.audit')}
        </h2>
        <span class="hint">{t('ws.settings.last_events')}</span>
      </div>
      
      <div class="mb-4 flex flex-wrap gap-3 p-3 bg-forge-bg rounded-lg border border-forge-border">
        <input type="text" id="audit-filter-user" aria-label={t('a11y.filter_user')} placeholder={t('ws.audit.filter_user')} class="campo" />
        <select id="audit-filter-action" aria-label={t('a11y.filter_action')} class="campo">
          <option value="">{t('ws.audit.all_actions')}</option>
          {[...new Set(auditLogs.map((l: any) => l.action))].map(action => (
            <option value={action}>{action}</option>
          ))}
        </select>
        <input type="date" id="audit-filter-date" aria-label={t('a11y.filter_date')} class="campo" />
      </div>

      <div class="overflow-y-auto pr-2 -mr-2 space-y-2 flex-1" id="audit-logs-container">
        {auditLogs.map((log: any) => {
          const date = new Date(log.timestamp.replace(' ', 'T') + 'Z').toLocaleString();
          let detailsText = '';
          try {
            const details = JSON.parse(log.details_json);
            if (details) {
              if (details.oldStatus && details.newStatus) {
                detailsText = `Moved ${log.entity_type} from ${details.oldStatus} to ${details.newStatus}`;
              } else if (log.action === 'issue.created') {
                detailsText = `Created a new ${log.entity_type}`;
              } else if (log.action === 'issue.deleted') {
                detailsText = `Deleted ${log.entity_type}`;
              } else {
                detailsText = Object.entries(details).map(([k, v]) => `${k}: ${v}`).join(', ');
              }
            }
          } catch (e) {}
          
          return (
            <div class="audit-log-item flex flex-col p-3 rounded-lg bg-forge-bg/50 border border-forge-border/40 hover:border-forge-text transition-colors" data-user={log.username?.toLowerCase() || 'system'} data-action={log.action} data-date={date.split(',')[0]}>
              <div class="flex justify-between items-start mb-2">
                <div class="flex items-center gap-2">
                  <div class="w-6 h-6 rounded-full overflow-hidden bg-forge-panel shrink-0 border border-forge-border">
                    <img src={log.avatar_url || '/default-avatar.svg'} alt={log.username} class="w-full h-full object-cover" loading="lazy" decoding="async" />
                  </div>
                  <span class="text-sm font-bold text-forge-text">{log.username || 'System'}</span>
                  <span class="text-xs text-forge-muted bg-forge-panel px-1.5 py-0.5 rounded border border-forge-border/50">{log.action}</span>
                </div>
                <span class="text-xs text-forge-muted font-mono">{date}</span>
              </div>
              <div class="text-xs text-forge-text pl-8">
                <span class="font-bold text-forge-accent-text">{log.entity_type}</span>: <span class="font-mono text-forge-muted">{log.entity_id.substring(0,8)}</span>
                {detailsText && <p class="mt-1 font-mono text-sm text-forge-text" title={log.details_json}>{detailsText}</p>}
              </div>
            </div>
          );
        })}
        {auditLogs.length === 0 && (
          <div class="py-8 text-center text-forge-muted text-sm font-mono">
            {t('ws.audit.empty')}
          </div>
        )}
      </div>
    </div>
    )}
    
    <!-- Danger Zone -->
    <div class="panel !border-forge-error p-6">
      <h2 class="text-lg font-bold text-forge-error mb-2">{t('ws.settings.danger')}</h2>
      <p class="text-forge-muted text-sm mb-4">{t('ws.settings.danger_desc')}</p>
      <button id="btn-delete-workspace-prompt" class="btn btn-danger" data-ws-id={ws.id}>
        {t('ws.settings.delete')}
      </button>
    </div>

  </div>

  <dialog id="delete-workspace-modal" class="ventana">
    <h2 class="ventana-titulo text-forge-error">{t('ws.settings.delete_title')}</h2>
    <p class="mb-4 text-sm text-forge-muted">{t('ws.settings.delete_confirm_1')} <span class="font-bold text-forge-text">{ws.name}</span> {t('ws.settings.delete_confirm_2')}</p>
    <div class="mb-4">
      <input type="text" id="delete-workspace-confirm-input" aria-label={t('a11y.confirm_ws_name')} class="campo w-full" placeholder={ws.name}>
    </div>
    <div class="flex justify-end gap-3 mt-6">
      <button type="button" class="btn btn-ghost" onclick="document.getElementById('delete-workspace-modal').close()">{t('ws.settings.modal_cancel')}</button>
      <button type="button" id="btn-delete-workspace" class="btn btn-danger" data-ws-id={ws.id} data-ws-name={ws.name} disabled>{t('ws.settings.delete_title')}</button>
    </div>
  </dialog>

  <dialog id="add-member-modal" class="ventana">
    <h2 class="ventana-titulo">{t('ws.settings.modal_add_member')}</h2>
    <div class="mb-4">
      <label class="block field-label mb-1" for="add-member-username">{t('ws.settings.modal_username')}</label>
      {/*
        El campo y la lista van juntos y en posición relativa: la lista se
        superpone al resto del diálogo en vez de empujarlo, que con un `dialog`
        de alto automático hace saltar el botón de enviar mientras escribes.
      */}
      <div class="relative">
        <input
          type="text"
          id="add-member-username"
          autocomplete="off"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="add-member-results"
          class="campo w-full"
          placeholder={t('ws.settings.modal_username_ph')}
        >
        {/*
          Aquí se pintan las sugerencias.
          Faltaba: el script las buscaba bien y salía por `if (!lista) return`
          sin un solo error, así que el campo se comportaba exactamente igual
          que antes de tener buscador.
        */}
        <div id="add-member-results" role="listbox" class="panel hidden absolute left-0 right-0 top-full mt-1 z-10 max-h-56 overflow-y-auto p-1"></div>
      </div>
    </div>
    <div class="mb-4">
      <label class="block field-label mb-1" for="add-member-role">{t('ws.settings.modal_role')}</label>
      <select id="add-member-role" class="campo w-full">
        <option value="viewer">{t('ws.settings.role_viewer')}</option>

        <option value="editor">{t('ws.settings.role_editor')}</option>
        <option value="owner">{t('ws.settings.role_owner')}</option>
      </select>
    </div>
    <div class="flex justify-end gap-3 mt-6">
      <button type="button" class="btn btn-ghost" onclick="document.getElementById('add-member-modal').close()">{t('ws.settings.modal_cancel')}</button>
      <button type="button" id="btn-confirm-add" class="btn btn-primary" data-ws-id={ws.id}>{t('ws.settings.modal_send_invite')}</button>
    </div>
  </dialog>

  <!-- Add Automation Modal -->
  <dialog id="add-automation-modal" class="ventana">
    <h2 class="ventana-titulo flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-forge-accent-text"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
      {t('ws.settings.modal_create_rule')}
    </h2>
    <div class="space-y-4">
      <div>
        {/* Decía «Nombre del workspace»: reutilizaba la clave del nombre del
            espacio, que es otro campo de esta misma pantalla. Con la etiqueta
            ya asociada al campo, un lector de pantalla lo anunciaba así con
            toda seguridad. */}
        <label class="block field-label mb-1" for="auto-name">{t('ws.settings.rule_name')}</label>
        <input type="text" id="auto-name" class="campo w-full" placeholder={t('ws.settings.rule_name_ph')}>
      </div>
      
      {/*
        Un disparador y una acción, que son los que existen.

        El desplegable ofrecía cuatro disparadores y tres acciones; solo la
        combinación «issue movido → webhook» tenía motor detrás, y ni esa
        funcionaba porque los valores no coincidían con los que consulta.
        Ofrecer opciones que no hacen nada es la misma enfermedad que decir
        «Guardado» mientras se pierde contenido.

        Y los dos campos libres pedían JSON —lo parseaban al enviar— con
        marcadores que sugerían texto plano («e.g. In Progress»). Ahora se
        pregunta lo que de verdad hace falta y el JSON lo compone el cliente.
      */}
      <div class="p-4 rounded border border-forge-border bg-forge-bg/30">
        <p class="block text-sm font-bold text-forge-accent-text mb-2">{t('ws.settings.modal_trigger')}</p>
        <p class="text-sm text-forge-text mb-3">{t('ws.settings.trigger_desc')}</p>

        <label for="auto-trigger-cond" class="block field-label mb-1">{t('ws.settings.target_status')}</label>
        <select id="auto-trigger-cond" class="campo w-full">
