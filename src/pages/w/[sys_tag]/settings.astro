        <label for="auto-action-payload" class="block field-label mb-1">{t('ws.settings.webhook_url')}</label>
        <input type="url" id="auto-action-payload" class="campo w-full" placeholder="https://ejemplo.com/hook" />
        <p class="text-xs text-forge-muted mt-1">{t('ws.settings.webhook_hint')}</p>
      </div>
    </div>
    
    <div class="flex justify-end gap-3 mt-6">
      <button type="button" class="btn btn-ghost" onclick="document.getElementById('add-automation-modal').close()">{t('ws.settings.modal_cancel')}</button>
      <button type="button" id="btn-save-automation" class="btn btn-primary" data-ws-id={ws.id}>{t('ws.settings.modal_save_rule')}</button>
    </div>
  </dialog>

</MainLayout>
<style>
  /* Era `var(--forge-primary)`, que no existe: el interruptor no cambiaba
     de color al encenderlo. */
  input:checked + div { background-color: var(--forge-accent-primary); border-color: var(--forge-accent-primary); }
  input:checked + div + .dot { transform: translateX(12px); background-color: var(--forge-bg); }
</style>

<script is:inline define:vars={{
  autoNeedName: t('ws.settings.auto_need_name'),
  autoNeedUrl: t('ws.settings.auto_need_url'),
  sysTag: sys_tag,
  LBL: {
    edit: t('labels.edit'),
    editNamed: t('labels.edit_named'),
    editTitle: t('labels.edit_title'),
    name: t('labels.name'),
    save: t('labels.save'),
    cancel: t('labels.cancel'),
    del: t('labels.delete'),
    delConfirm: t('labels.delete_confirm'),
    unused: t('labels.unused'),
    errRequired: t('labels.err_required'),
    errTooLong: t('labels.err_too_long'),
    errDuplicate: t('labels.err_duplicate'),
    errTooMany: t('labels.err_too_many'),
    errBadColor: t('labels.err_bad_color'),
    errGeneric: t('labels.err_generic'),
    inviteNone: t('ws.settings.invite_none'),
  },
}}>
  // ── Sugerencias al invitar ─────────────────────────────────────────────────
  //
  // El campo era texto libre: había que escribir el nombre exacto de memoria y,
  // si fallabas una letra, el error llegaba **después** de enviar la
  // invitación. Escribir de memoria el nombre de alguien es justo lo que un
  // buscador evita.
  (() => {
    const campo = document.getElementById('add-member-username');
    const lista = document.getElementById('add-member-results');
    if (!campo || !lista) return;

    const cerrar = () => {
      lista.classList.add('hidden');
      campo.setAttribute('aria-expanded', 'false');
    };

    const pintar = (usuarios) => {
      lista.innerHTML = '';
      if (!usuarios.length) {
        const vacio = document.createElement('p');
        vacio.className = 'px-2 py-1.5 text-xs text-forge-muted italic';
        vacio.textContent = LBL.inviteNone;
        lista.appendChild(vacio);
      } else {
        for (const u of usuarios) {
          const fila = document.createElement('button');
          fila.type = 'button';
          fila.setAttribute('role', 'option');
          fila.className = 'w-full flex items-center gap-2 px-2 py-1.5 rounded text-sm text-forge-text hover:bg-forge-bg transition-colors text-left';

          const avatar = document.createElement('img');
          avatar.src = u.avatarUrl || '/default-avatar.svg';
          avatar.alt = '';
          avatar.className = 'w-5 h-5 rounded-full border border-forge-border shrink-0';

          const nombre = document.createElement('span');
          nombre.className = 'truncate';
          // Por `textContent`: el nombre lo elige quien se registra.
          nombre.textContent = u.username;

          fila.append(avatar, nombre);
          fila.addEventListener('mousedown', (e) => {
            // `mousedown` y no `click`: el `blur` del campo esconde la lista
            // antes de que llegue el `click`.
            e.preventDefault();
            campo.value = u.username;
            cerrar();
          });
          lista.appendChild(fila);
        }
      }
      lista.classList.remove('hidden');
      campo.setAttribute('aria-expanded', 'true');
    };

    let espera;
    let ultima = 0;
    campo.addEventListener('input', () => {
      clearTimeout(espera);
      const texto = campo.value.trim();
      if (texto.length < 2) { cerrar(); return; }

      espera = setTimeout(async () => {
        const mio = ++ultima;
        try {
          const res = await fetch(`/api/w/${sysTag}/members/search?q=${encodeURIComponent(texto)}`);
          if (!res.ok || mio !== ultima) return;  // llegó tarde: manda la última
          pintar((await res.json()).users || []);
        } catch {
          cerrar();
        }
      }, 200);
    });

    campo.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrar(); });
    campo.addEventListener('blur', () => setTimeout(cerrar, 150));
  })();

  // ── Etiquetas ──────────────────────────────────────────────────────────────
  //
  // Todo sin recargar: la lista se retoca en el sitio. Recargar la página
  // entera por crear una etiqueta pierde el resto del formulario de ajustes, y
  // era una de las quejas concretas sobre la aplicación.
  (() => {
    const apiEtiquetas = `/api/w/${sysTag}/labels`;
    const lista = document.getElementById('lista-etiquetas');
    const vacio = document.getElementById('etiquetas-vacio');
    const form = document.getElementById('form-nueva-etiqueta');
    const campoNombre = document.getElementById('etiqueta-nombre');
    const paletaNueva = document.getElementById('etiqueta-colores');
    if (!lista || !form) return;

    /** Traduce el código que devuelve la API. Nunca se enseña el código a secas. */
    const explicar = (codigo) => ({
      required: LBL.errRequired,
      too_long: LBL.errTooLong,
      duplicate: LBL.errDuplicate,
      too_many: LBL.errTooMany,
      bad_color: LBL.errBadColor,
    }[codigo] ?? LBL.errGeneric);

    function marcarColor(paleta, color) {
      paleta?.querySelectorAll('.color-opt').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.color === color));
      });
    }
    const colorElegido = (paleta) =>
      paleta?.querySelector('.color-opt[aria-pressed="true"]')?.dataset.color;

    paletaNueva?.addEventListener('click', (e) => {
      const boton = e.target.closest('.color-opt');
      if (boton) marcarColor(paletaNueva, boton.dataset.color);
    });

    function refrescarVacio() {
      vacio?.classList.toggle('hidden', lista.children.length > 0);
    }

    /** Pinta una fila. El nombre va por textContent: lo escribe cualquiera. */
    function filaDe(etiqueta) {
      const li = document.createElement('li');
      li.className = 'fila-etiqueta flex items-center justify-between gap-3 bg-forge-bg/50 border border-forge-border p-3 rounded-lg';
      li.dataset.id = etiqueta.id;
      li.dataset.name = etiqueta.name;
      li.dataset.color = etiqueta.color;

      li.innerHTML = `
        <div class="flex items-center gap-3 min-w-0">
          <span class="chip max-w-full"><span class="sw" aria-hidden="true"></span><span class="truncate chip-name"></span></span>
          <span class="chip-uso text-xs text-forge-muted truncate"></span>
        </div>
        <div class="flex items-center gap-1 shrink-0">
          <button type="button" class="btn-editar-etiqueta btn btn-ghost btn-sm"></button>
          <button type="button" class="btn-borrar-etiqueta btn btn-ghost btn-icon btn-sm !text-forge-error">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
          </button>
        </div>
      `;
      li.querySelector('.chip').style.setProperty('--c', etiqueta.color);
      li.querySelector('.chip-name').textContent = etiqueta.name;
      li.querySelector('.chip-uso').textContent = LBL.unused;
      const editar = li.querySelector('.btn-editar-etiqueta');
      editar.textContent = LBL.edit;
      editar.setAttribute('aria-label', LBL.editNamed.replace('{nombre}', etiqueta.name));
      const borrar = li.querySelector('.btn-borrar-etiqueta');
      borrar.setAttribute('aria-label', LBL.del);
      borrar.title = LBL.del;
      return li;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = campoNombre.value.trim();
      if (!name) return window.showToast?.(LBL.errRequired, true);

      const res = await fetch(apiEtiquetas, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, color: colorElegido(paletaNueva) }),
      });
      const datos = await res.json().catch(() => ({}));
      if (!res.ok) return window.showToast?.(explicar(datos.error_code), true);

      // Se inserta donde toca: la lista va por nombre, y añadir al final la
      // dejaría desordenada hasta la siguiente recarga.
      const nueva = filaDe(datos);
      const siguiente = [...lista.children].find(
        (li) => li.dataset.name.localeCompare(datos.name, undefined, { sensitivity: 'base' }) > 0
      );
      lista.insertBefore(nueva, siguiente ?? null);
      campoNombre.value = '';
      refrescarVacio();
    });

    lista.addEventListener('click', async (e) => {
      const fila = e.target.closest('.fila-etiqueta');
      if (!fila) return;

      if (e.target.closest('.btn-borrar-etiqueta')) {
        window.forgeConfirm?.(LBL.delConfirm, async () => {
          const res = await fetch(apiEtiquetas, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: fila.dataset.id }),
          });
          if (!res.ok) return window.showToast?.(LBL.errGeneric, true);
          fila.remove();
          refrescarVacio();
        }, LBL.del);
        return;
      }

      if (e.target.closest('.btn-editar-etiqueta')) abrirEdicion(fila);
    });

    /** Nombre y color, en la ventana compartida con los tipos. La fila se retoca sin recargar. */
    function abrirEdicion(fila) {
      window.forgeEditarCatalogo?.({
        titulo: LBL.editTitle,
        rotulo: LBL.name,
        nombre: fila.dataset.name,
        color: fila.dataset.color,
        maximo: 40,
        guardar: async (name, color) => {
          const res = await fetch(apiEtiquetas, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: fila.dataset.id, name, color }),
          });
          const datos = await res.json().catch(() => ({}));
          if (!res.ok) return explicar(datos.error_code);
          // Se conserva el texto de uso: editarla no cambia dónde está puesta.
          const uso = fila.querySelector('.chip-uso')?.textContent ?? '';
          const nueva = filaDe({ id: fila.dataset.id, name, color: color || fila.dataset.color });
          nueva.querySelector('.chip-uso').textContent = uso;
          fila.replaceWith(nueva);
          return null;
        },
      });
    }
  })();

  const wsId = document.getElementById('btn-save-general')?.getAttribute('data-ws-id');
  let newIconUrl = null;
  const iconInput = document.getElementById('ws-icon-file-input');
  
  iconInput?.addEventListener('change', async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;

    /**
     * El redimensionado y la subida viven en `lib/client/imagen.ts`.
     *
     * Esta copia recortaba a 512 px de **ancho y alto** —las otras dos solo el
     * ancho, que es lo correcto para no deformar— y comprimía a 0.80 en vez de
     * 0.85, sin ninguna razón escrita. Con tres versiones, corregir una dejaba
     * las otras dos atrás. Ya pasó.
     */
    const r = await window.forgeImagen.subir(file, {
      maxAncho: window.forgeImagen.ANCHOS.icono,
      nombre: 'icon.webp',
      entidad: { tipo: 'workspace', id: wsId },
    });

    if (!r.ok) {
      window.showToast?.(window.forgeMsg?.errGenerico || '', true);
      return;
    }

    newIconUrl = r.url;
    const iconPreview = document.getElementById('ws-icon-preview-img');
    if (iconPreview) {
      iconPreview.src = newIconUrl;
    } else {
      const container = document.getElementById('ws-icon-preview-container');
      document.getElementById('ws-icon-preview-text')?.style.setProperty('display', 'none');
      const newImg = document.createElement('img');
      newImg.src = newIconUrl;
      newImg.id = 'ws-icon-preview-img';
      newImg.className = 'w-full h-full object-cover z-0';
      newImg.loading = 'lazy';
      newImg.decoding = 'async';
      container?.insertBefore(newImg, container.firstChild);
    }
  });

  document.getElementById('btn-save-general')?.addEventListener('click', async (e) => {
    const wsIdAttr = e.currentTarget.getAttribute('data-ws-id');
    const name = document.getElementById('ws-name-input').value;
    const sys_tag = document.getElementById('ws-tag-input').value;
    const description = document.getElementById('ws-desc-input')?.value || "";
    const is_public = document.getElementById('ws-public-input')?.value === "1";
    const join_policy = document.getElementById('ws-join-policy-input')?.value || "disabled";
    
    let finalIcon = newIconUrl;
    if (!finalIcon) {
       const existingImg = document.getElementById('ws-icon-preview-img');
       if (existingImg) finalIcon = existingImg.src;
       else {
         const existingText = document.getElementById('ws-icon-preview-text');
         if (existingText && existingText.textContent && existingText.textContent.trim().length <= 2) {
            finalIcon = existingText.textContent.trim();
         }
       }
    }

    const res = await fetch(`/api/workspaces/${wsIdAttr}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, sys_tag, description, icon: finalIcon, is_public, join_policy })
    });
    
    if (res.ok) {
      window.showToast('Workspace updated!');
    } else {
      console.error('ajustes del espacio:', await res.text());
      window.showToast(window.forgeMsg?.errGuardarAjustes || '', true);
    }
  });

  // Members
  document.querySelectorAll('.role-select').forEach(select => {
    select.addEventListener('change', async (e) => {
      const el = e.currentTarget;
      const userId = el.getAttribute('data-user-id');
      const wsId = el.getAttribute('data-ws-id');
      const role = el.value;

      const res = await fetch(`/api/workspaces/${wsId}/members`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId, role })
      });
      if (res.ok) {
        window.showToast('Role updated');
      } else {
        console.error(await res.text());
      window.showToast(window.forgeMsg?.errGenerico || '', true);
        window.location.reload(); // reset select
      }
    });
  });

  // Join Requests
  document.querySelectorAll('.btn-req-accept').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const el = e.currentTarget;
      const reqId = el.getAttribute('data-req-id');
      const wsId = document.getElementById('btn-save-general')?.getAttribute('data-ws-id');
      
      const res = await fetch(`/api/workspaces/${wsId}/requests/${reqId}/accept`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({})
      });
      if (res.ok) {
        window.showToast('Request accepted');
        window.location.reload();
      } else {
        console.error(await res.text());
      window.showToast(window.forgeMsg?.errGenerico || '', true);
      }
    });
  });

  document.querySelectorAll('.btn-req-reject').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const el = e.currentTarget;
      const reqId = el.getAttribute('data-req-id');
      const wsId = document.getElementById('btn-save-general')?.getAttribute('data-ws-id');
      
      const res = await fetch(`/api/workspaces/${wsId}/requests/${reqId}/reject`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({})
      });
      if (res.ok) {
        el.closest('div.bg-forge-bg')?.remove();
        window.showToast('Request rejected');
      } else {
        console.error(await res.text());
      window.showToast(window.forgeMsg?.errGenerico || '', true);
      }
    });
  });

  document.querySelectorAll('.btn-remove-member').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const el = e.currentTarget;
      const userId = el.getAttribute('data-user-id');
      const wsId = el.getAttribute('data-ws-id');
      
      window.forgeConfirm(window.forgeMsg?.confirmarQuitarMiembro || '', async () => {
        const res = await fetch(`/api/workspaces/${wsId}/members`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId })
        });
        if (res.ok) {
          el.closest('div')?.parentElement?.remove();
          window.showToast('User removed');
        } else {
          console.error(await res.text());
      window.showToast(window.forgeMsg?.errGenerico || '', true);
        }
      });
    });
  });

  document.getElementById('btn-add-member')?.addEventListener('click', () => {
    document.getElementById('add-member-modal').showModal();
  });

  document.getElementById('btn-confirm-add')?.addEventListener('click', async (e) => {
    const wsId = e.currentTarget.getAttribute('data-ws-id');
    const username = document.getElementById('add-member-username').value;
    const role = document.getElementById('add-member-role').value;
    
    const res = await fetch(`/api/workspaces/${wsId}/members`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username, role })
    });
    if (res.ok) {
      window.showToast(`Invitation sent to ${username}!`);
      document.getElementById('add-member-username').value = '';
      document.getElementById('add-member-modal').close();
    } else {
      console.error(await res.text());
      window.showToast(window.forgeMsg?.errGenerico || '', true);
    }
  });

  // Danger
  const deleteInput = document.getElementById('delete-workspace-confirm-input');
  const deleteBtn = document.getElementById('btn-delete-workspace');
  document.getElementById('btn-delete-workspace-prompt')?.addEventListener('click', () => {
    document.getElementById('delete-workspace-modal').showModal();
  });
  deleteInput?.addEventListener('input', (e) => {
    if (e.target.value === deleteBtn.getAttribute('data-ws-name')) {
      deleteBtn.disabled = false;
    } else {
      deleteBtn.disabled = true;
    }
  });

  deleteBtn?.addEventListener('click', async (e) => {
    if (deleteBtn.disabled) return;
    const wsId = e.currentTarget.getAttribute('data-ws-id');
    const res = await fetch(`/api/workspaces/${wsId}`, { method: 'DELETE' });
    if (res.ok) {
      window.location.href = '/';
    } else {
      console.error(await res.text());
      window.showToast(window.forgeMsg?.errGenerico || '', true);
    }
  });

  // Audit Logs Filtering
  function filterAuditLogs() {
    const userFilter = document.getElementById('audit-filter-user').value.toLowerCase();
    const actionFilter = document.getElementById('audit-filter-action').value;
    const dateFilter = document.getElementById('audit-filter-date').value; // YYYY-MM-DD
    
    document.querySelectorAll('.audit-log-item').forEach(item => {
      const user = item.getAttribute('data-user') || '';
      const action = item.getAttribute('data-action') || '';
      const dateStr = item.getAttribute('data-date') || ''; // "M/D/YYYY" or similar depending on toLocaleString()
      
      let show = true;
      if (userFilter && !user.includes(userFilter)) show = false;
      if (actionFilter && action !== actionFilter) show = false;
      if (dateFilter) {
        const d = new Date(dateFilter);
        const logD = new Date(dateStr);
        if (d.toDateString() !== logD.toDateString()) show = false;
      }
      
      item.style.display = show ? 'flex' : 'none';
    });
  }
  
  document.getElementById('audit-filter-user')?.addEventListener('input', filterAuditLogs);
  document.getElementById('audit-filter-action')?.addEventListener('change', filterAuditLogs);
  document.getElementById('audit-filter-date')?.addEventListener('change', filterAuditLogs);
    // Automations
  document.getElementById('btn-add-automation')?.addEventListener('click', () => {
    document.getElementById('add-automation-modal').showModal();
  });

  document.getElementById('btn-save-automation')?.addEventListener('click', async (e) => {
    const wsId = e.currentTarget.getAttribute('data-ws-id');
    const name = document.getElementById('auto-name').value.trim();
    const toStatus = document.getElementById('auto-trigger-cond').value;
    const url = document.getElementById('auto-action-payload').value.trim();

    // Los ids que se leían aquí —`auto-trigger-type` y `auto-action-type`— no
    // existían: los `<select>` eran `auto-trigger` y `auto-action`. `null.value`
    // lanzaba una excepción y el manejador moría antes del fetch, así que el
    // botón «Guardar regla» no hacía absolutamente nada.
    if (!name) return window.showToast(autoNeedName, true);
    if (!url) return window.showToast(autoNeedUrl, true);

    // El JSON lo compone el cliente. Antes se pedía al usuario que lo
    // escribiera a mano en dos campos cuyos marcadores sugerían texto plano.
    const res = await fetch(`/api/automations`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        workspaceId: wsId,
        name,
        trigger_type: 'issue_status_changed',
        trigger_condition: JSON.stringify({ to_status: toStatus }),
        action_type: 'webhook',
        action_payload: JSON.stringify({ url }),
      })
    });

    if (res.ok) {
      window.location.reload();
    } else {
      console.error(await res.text());
      window.showToast(window.forgeMsg?.errGenerico || '', true);
    }
  });

  document.querySelectorAll('.btn-delete-automation').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const id = e.currentTarget.getAttribute('data-id');
      window.forgeConfirm(window.forgeMsg?.confirmarBorrarAutomatizacion || '', async () => {
        const res = await fetch(`/api/automations/${id}`, { method: 'DELETE' });
        if (res.ok) window.location.reload();
      });
    });
  });

  document.querySelectorAll('.toggle-automation-active').forEach(checkbox => {
    checkbox.addEventListener('change', async (e) => {
      const target = e.currentTarget;
      const id = target.getAttribute('data-id');
      const is_active = target.checked ? 1 : 0;
      await fetch(`/api/automations/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ is_active })
      });
    });
  });

</script>

<script>
  /**
   * Tipos de ticket del espacio.
   *
   * Mismo patrón que las etiquetas de arriba: se opera contra la API y se
   * recarga la página al terminar. Un tipo cambia el desplegable de nuevo
   * ticket, la insignia de cada tarjeta y el filtro, así que mantener todo eso
   * al día a mano desde aquí son cuatro sitios que se desincronizan.
   */
  // ── La ventana de editar (etiquetas y tipos) ───────────────────────────────
  type Edicion = {
    titulo: string; rotulo: string; nombre: string; color: string; maximo: number;
    /** Devuelve el error que enseñar, o `null` si se guardó. */
    guardar: (nombre: string, color: string | undefined) => Promise<string | null>;
  };
  (() => {
    const dlg = document.getElementById('editar-catalogo') as HTMLDialogElement | null;
    const form = document.getElementById('editar-catalogo-form') as HTMLFormElement | null;
    const campo = document.getElementById('editar-catalogo-nombre') as HTMLInputElement | null;
    const paleta = document.getElementById('editar-catalogo-colores');
    const error = document.getElementById('editar-catalogo-error');
    if (!dlg || !form || !campo || !paleta || !error) return;
    let actual: Edicion | null = null;
    const marcar = (color: string) => paleta.querySelectorAll<HTMLElement>('.color-opt').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.color === color)));

    paleta.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('.color-opt');
      if (b?.dataset.color) marcar(b.dataset.color);
    });
    document.getElementById('editar-catalogo-cancelar')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!actual) return;
      const color = paleta.querySelector<HTMLElement>('.color-opt[aria-pressed="true"]')?.dataset.color;
      const fallo = await actual.guardar(campo.value.trim(), color);
      if (fallo === null) { dlg.close(); return; }
      error.textContent = fallo;
      error.classList.remove('hidden');
    });

    (window as any).forgeEditarCatalogo = (edicion: Edicion) => {
      actual = edicion;
      document.getElementById('editar-catalogo-titulo')!.textContent = edicion.titulo;
      document.getElementById('editar-catalogo-rotulo')!.textContent = edicion.rotulo;
      campo.value = edicion.nombre;
      campo.maxLength = edicion.maximo;
      marcar(edicion.color);
      error.classList.add('hidden');
      dlg.showModal();
      campo.select();
    };
  })();

  (() => {
    const raiz = document.getElementById('tipos-ticket');
    if (!raiz) return;
    const sysTag = raiz.dataset.sysTag;
    const base = `/api/w/${sysTag}/issue-types`;

    const aviso = (msg: string, error = false) => (window as any).showToast?.(msg, error);
    const fallo = () => aviso(raiz.dataset.tError || '', true);

    // ── Alta ────────────────────────────────────────────────────────────────
    let colorElegido = '#0091FF';
    raiz.querySelectorAll<HTMLButtonElement>('.tipo-color-opt').forEach((b) => {
      if (b.getAttribute('aria-pressed') === 'true') colorElegido = b.dataset.color!;
      b.addEventListener('click', () => {
        raiz.querySelectorAll('.tipo-color-opt').forEach((o) => o.setAttribute('aria-pressed', 'false'));
        b.setAttribute('aria-pressed', 'true');
        colorElegido = b.dataset.color!;
      });
    });

    document.getElementById('form-nuevo-tipo')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById('tipo-nombre') as HTMLInputElement;
      const name = input.value.trim();
      if (!name) return;

      const res = await fetch(base, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, color: colorElegido }),
      });
      if (res.ok) { window.location.reload(); return; }
      const datos = await res.json().catch(() => null);
      // El servidor manda códigos, no frases: se traducen aquí.
      // `data-t-errnombre_vacio` llega como `tErrnombre_vacio`: los guiones bajos
      // no se camelizan, solo los guiones.
      aviso((raiz.dataset[`tErr${datos?.error_code}`] as string) || raiz.dataset.tError || '', true);
    });

    // ── Editar ──────────────────────────────────────────────────────────────
    raiz.querySelectorAll('.btn-editar-tipo').forEach((b) => {
      b.addEventListener('click', () => {
        const fila = b.closest('.fila-tipo') as HTMLElement;
        const visible = fila.dataset.visible || fila.dataset.name || '';
        (window as any).forgeEditarCatalogo?.({
          titulo: raiz.dataset.tEditTitle || '',
          rotulo: raiz.dataset.tName || '',
          nombre: visible,
          color: fila.dataset.color || '',
          maximo: 30,
          guardar: async (nombre: string, color: string | undefined) => {
            // El nombre solo viaja si cambia: un tipo de serie con su nombre
            // traducido («Tarea») pasaría a llamarse así para siempre y dejaría
            // de cambiar con el idioma. Renombrar no toca la clave, así que
            // ningún ticket cambia de tipo.
            const cuerpo: Record<string, string> = {};
            if (nombre !== visible) cuerpo.name = nombre;
            if (color && color !== fila.dataset.color) cuerpo.color = color;
            if (!Object.keys(cuerpo).length) return null;
            const res = await fetch(`${base}/${fila.dataset.id}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(cuerpo),
            });
            if (res.ok) { window.location.reload(); return null; }
            const datos = await res.json().catch(() => null);
            return (raiz.dataset[`tErr${datos?.error_code}`] as string) || raiz.dataset.tError || '';
          },
        });
      });
    });

    // ── Baja ────────────────────────────────────────────────────────────────
    const modal = document.getElementById('tipo-borrar-modal') as HTMLDialogElement;
    const selectSustituto = document.getElementById('tipo-sustituto') as HTMLSelectElement;
    let enCurso: string | null = null;

    document.getElementById('tipo-borrar-cancelar')?.addEventListener('click', () => modal.close());

    document.getElementById('tipo-borrar-confirmar')?.addEventListener('click', async () => {
      if (!enCurso) return;
      const res = await fetch(`${base}/${enCurso}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ replacement: selectSustituto.value }),
      });
      if (res.ok) window.location.reload();
      else fallo();
    });

    raiz.querySelectorAll('.btn-borrar-tipo').forEach((b) => {
      b.addEventListener('click', async () => {
        const fila = b.closest('.fila-tipo') as HTMLElement;
        const id = fila.dataset.id!;

        // Se intenta y es el servidor quien dice si hay trabajo dentro: contar
        // aquí obligaría a traerse los tickets de todo el espacio.
        const res = await fetch(`${base}/${id}`, { method: 'DELETE' });
        if (res.ok) { window.location.reload(); return; }

        const datos = await res.json().catch(() => null);

        if (datos?.error_code === 'last_type') { aviso(raiz.dataset.tLast || '', true); return; }

        if (datos?.error_code === 'in_use') {
          enCurso = id;
          const lead = document.getElementById('tipo-borrar-lead')!;
          lead.textContent = (datos.in_use === 1
            ? raiz.dataset.tInUseOne || ''
            : (raiz.dataset.tInUse || '').replace('{n}', String(datos.in_use))
          ).replace('{tipo}', fila.dataset.name || '');

          selectSustituto.replaceChildren(...datos.candidates.map((c: any) => {
            const o = document.createElement('option');
            o.value = c.key;
            o.textContent = c.name;
            return o;
          }));
          modal.showModal();
          return;
        }
        fallo();
      });
    });
  })();
</script>

<script>
  /**
   * Funciones del tablero: cada interruptor guarda al momento.
   *
   * Si el servidor dice que no, el interruptor vuelve a donde estaba: dejarlo
   * cambiado haría creer que la función está apagada cuando sigue encendida.
   */
  (() => {
    const raiz = document.getElementById('funciones-tablero');
    if (!raiz) return;
    const sysTag = raiz.dataset.sysTag;
    raiz.querySelectorAll<HTMLInputElement>('.funcion-tablero').forEach((casilla) => {
      casilla.addEventListener('change', async () => {
        const funcion = casilla.dataset.funcion!;
        const valor = casilla.checked;
        casilla.disabled = true;
        try {
          const res = await fetch(`/api/w/${sysTag}/features`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ [funcion]: valor }),
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          window.showToast?.(raiz.dataset.tSaved || '');
          // Automatizaciones y auditoría tienen su sección en esta misma
          // página, pintada en el servidor: se recarga para que aparezca o
          // desaparezca.
          if (casilla.dataset.recargar === 'true') window.location.reload();
        } catch (e) {
          console.error('funciones del tablero:', e);
          casilla.checked = !valor;
          window.showToast?.(raiz.dataset.tError || '', true);
        } finally {
          casilla.disabled = false;
        }
      });
    });
  })();
</script>

