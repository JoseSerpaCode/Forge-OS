---
import MainLayout from '../../../layouts/MainLayout.astro';
import db from '../../../lib/db';
import { checkWorkspaceAccess } from '../../../lib/guard';
import { useTranslations } from '../../../i18n/ui';
import LabelChip from '../../../components/labels/LabelChip.astro';
import WorkspaceIcon from '../../../components/brand/WorkspaceIcon.astro';
import { COLORES, listar as listarEtiquetas } from '../../../lib/labels';
import { listar as listarTipos } from '../../../lib/issueTypes';
import { abrirEspacioDePagina } from '../../../lib/paginaEspacio';

const user = Astro.locals.user!;
const t = useTranslations(Astro.locals.lang || 'en');
if (!user) return Astro.redirect('/login');

const { sys_tag } = Astro.params;

const acceso = abrirEspacioDePagina(sys_tag, user, 'owner');
if (!acceso.ok) return Astro.redirect(acceso.redirigir);
const ws = acceso.ws;

const etiquetas = listarEtiquetas(ws.id);

// Cuántos tickets usa cada tipo: es el dato que decide si borrarlo es una
// limpieza o una reorganización.
const tiposTicket = listarTipos(ws.id).map((ti) => ({
  ...ti,
  usos: (db.prepare('SELECT COUNT(*) AS n FROM issues WHERE workspace_id = ? AND type = ?')
    .get(ws.id, ti.key) as any).n as number,
}));

const members = db.prepare(`
  SELECT u.id, u.username, u.avatar_url, wm.ws_role, wm.joined_at
  FROM workspace_members wm
  JOIN users u ON wm.user_id = u.id
  WHERE wm.workspace_id = ?
  ORDER BY wm.joined_at ASC
`).all(ws.id) as any[];

const joinRequests = db.prepare(`
  SELECT r.id, r.status, r.created_at, u.username, u.avatar_url
  FROM workspace_join_requests r
  JOIN users u ON r.user_id = u.id
  WHERE r.workspace_id = ? AND r.status = 'pending'
  ORDER BY r.created_at DESC
`).all(ws.id) as any[];

const auditLogs = db.prepare(`
  SELECT a.id, a.action, a.entity_type, a.entity_id, a.details_json, a.timestamp, u.username, u.avatar_url
  FROM audit_logs a
  LEFT JOIN users u ON a.user_id = u.id
  WHERE a.workspace_id = ?
  ORDER BY a.timestamp DESC
  LIMIT 50
`).all(ws.id) as any[];

const automations = db.prepare(`
  SELECT id, name, trigger_type, trigger_condition, action_type, action_payload, is_active
  FROM automations
  WHERE workspace_id = ?
`).all(ws.id) as any[];

// El filtro por espacio va **en el SQL**, no en JavaScript.
//
// Antes esta consulta se traía *todas* las invitaciones pendientes de la
// instancia entera —de cualquier espacio y de cualquier persona— para quedarse
// con las de este espacio parseando el JSON de cada fila en el servidor. El
// coste de abrir los ajustes de un espacio crecía con el uso global del
// producto: con mil espacios activos, mirar los tuyos leía las invitaciones de
// los novecientos noventa y nueve restantes.
//
// `json_valid` va antes que `json_extract` a propósito: `link_url` es una
// columna de texto libre y `json_extract` sobre algo que no es JSON aborta la
// consulta entera. SQLite evalúa el AND en orden, así que una fila con basura
// se descarta en vez de tumbar la página.
const wsPendingInvites = (db.prepare(`
  SELECT n.id, n.link_url, n.created_at, u.username, u.avatar_url,
         COALESCE(json_extract(n.link_url, '$.role'), 'viewer') AS role
  FROM notifications n
  JOIN users u ON n.user_id = u.id
  WHERE n.type = 'invite'
    AND json_valid(n.link_url)
    AND json_extract(n.link_url, '$.ws_id') = ?
  ORDER BY n.created_at DESC
`).all(ws.id) as any[]).map(n => {
  const SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;
  const isExpired = (Date.now() - new Date(n.created_at + 'Z').getTime()) > SEVEN_DAYS_MS;

  return { ...n, isExpired };
});
---

<MainLayout hideFooter={true} title={`${t('sidebar.settings')} - ${ws.name}`} workspaceId={ws.id}>
  <div class="max-w-4xl mx-auto mt-4 sm:mt-10 p-0 sm:p-6 space-y-6 sm:space-y-8 relative">
    {/* Mismo caso que la cabecera del panel: en una fila, el enlace de vuelta
        se lleva su ancho y el título se parte en dos líneas de dos palabras. */}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-3">
      <h1 class="text-2xl sm:text-3xl font-bold text-forge-text">{t('ws.settings.title')}</h1>
      <a href={`/w/${sys_tag}`} class="text-forge-muted hover:text-forge-text text-sm hover:underline shrink-0">{t('ws.settings.back')}</a>
    </div>

    <!-- General Settings -->
    <div class="bg-forge-panel border border-forge-border rounded-lg shadow-lg p-6">
      <h2 class="text-xl font-bold text-forge-text mb-6 border-b border-forge-border pb-2">{t('ws.settings.general')}</h2>
      <div class="flex flex-col md:flex-row items-start gap-6">
        <div class="relative w-32 h-32 rounded-xl border-2 border-dashed border-forge-border hover:border-forge-secondary flex items-center justify-center bg-forge-bg overflow-hidden group cursor-pointer shrink-0" id="ws-icon-preview-container">
          <WorkspaceIcon icon={ws.icon} name={ws.name} class="text-4xl" imgId="ws-icon-preview-img" textId="ws-icon-preview-text" />
          <div class="absolute inset-0 bg-black/60 hidden group-hover:flex items-center justify-center transition-all z-10 flex-col">
            <span class="text-[10px] font-bold text-white uppercase tracking-widest text-center px-2">{t('ws.settings.upload')}</span>
          </div>
          <input type="file" id="ws-icon-file-input" aria-label={t('a11y.ws_icon')} accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer z-20" title="Upload image icon" />
        </div>
        
        <div class="flex-1 space-y-4">
          <div>
            <label class="block text-sm font-bold text-forge-muted uppercase mb-1" for="ws-name-input">{t('ws.settings.name')}</label>
            <input type="text" id="ws-name-input" value={ws.name} class="w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:outline-none focus:border-forge-secondary" />
          </div>
          <div>
            <label class="block text-sm font-bold text-forge-muted uppercase mb-1" for="ws-tag-input">{t('ws.settings.tag')}</label>
            <input type="text" id="ws-tag-input" value={ws.sys_tag} class="w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:outline-none focus:border-forge-secondary" />
          </div>
          <div>
            <label class="block text-sm font-bold text-forge-muted uppercase mb-1" for="ws-desc-input">{t('ws.settings.desc')}</label>
            <textarea id="ws-desc-input" rows="2" class="w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:outline-none focus:border-forge-secondary">{ws.description || ''}</textarea>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-bold text-forge-muted uppercase mb-1" for="ws-public-input">{t('ws.settings.visibility')}</label>
              <select id="ws-public-input" class={`w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:outline-none focus:border-forge-secondary ${user.is_guest ? 'guest-restricted-action opacity-50' : ''}`} data-guest={user.is_guest ? 'true' : 'false'} data-guest-msg="Create an account to change project visibility.">
                <option value="0" selected={ws.is_public === 0}>{t('ws.settings.private')}</option>
                <option value="1" selected={ws.is_public === 1}>{t('ws.settings.public')}</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-bold text-forge-muted uppercase mb-1" for="ws-join-policy-input">{t('ws.settings.join_policy')}</label>
              <select id="ws-join-policy-input" class={`w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:outline-none focus:border-forge-secondary ${user.is_guest ? 'guest-restricted-action opacity-50' : ''}`} data-guest={user.is_guest ? 'true' : 'false'} data-guest-msg="Create an account to change join policy.">
                <option value="disabled" selected={ws.join_policy === 'disabled'}>{t('ws.settings.policy_disabled')}</option>
                <option value="friends_only" selected={ws.join_policy === 'friends_only'}>{t('ws.settings.policy_friends')}</option>
                <option value="open" selected={ws.join_policy === 'open'}>{t('ws.settings.policy_open')}</option>
              </select>
            </div>
          </div>
          <button id="btn-save-general" class={`bg-forge-primary text-forge-on-accent font-bold py-2 px-6 rounded hover:bg-forge-primary/90 transition-colors mt-2 ${user.is_guest ? 'guest-restricted-action opacity-50' : ''}`} data-ws-id={ws.id} data-guest={user.is_guest ? 'true' : 'false'} data-guest-msg="Create an account to save workspace settings.">
            {t('ws.settings.save')}
          </button>
        </div>
      </div>
    </div>

    <!-- Members -->
    <div class="bg-forge-panel border border-forge-border rounded-lg shadow-lg p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-forge-text">{t('ws.settings.members')}</h2>
        <button id="btn-add-member" class={`bg-forge-bg border border-forge-border text-forge-text px-3 py-1.5 text-sm rounded hover:border-forge-secondary transition-colors ${user.is_guest ? 'guest-restricted-action opacity-50' : ''}`} data-guest={user.is_guest ? 'true' : 'false'} data-guest-msg="Create an account to invite users.">
          {t('ws.settings.invite')}
        </button>
      </div>

      <div class="space-y-3">
        {members.map((m) => (
          <div class="flex items-center justify-between bg-forge-bg border border-forge-border p-3 rounded">
            <div class="flex items-center gap-3">
              {m.avatar_url ? (
                <img src={m.avatar_url} class="w-8 h-8 rounded-full border border-forge-border object-cover" alt={`${m.username} avatar`} loading="lazy" />
              ) : (
                <div class="w-8 h-8 rounded-full border border-forge-border flex items-center justify-center text-forge-accent-text shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
              )}
              <span class="font-bold text-forge-text">{m.username}</span>
            </div>
            
            <div class="flex items-center gap-3">
              <select aria-label={t('a11y.member_role')} class="role-select bg-forge-panel border border-forge-border text-forge-muted text-sm rounded p-1 focus:outline-none focus:border-forge-secondary" data-user-id={m.id} data-ws-id={ws.id}>
                <option value="owner" selected={m.ws_role === 'owner'}>{t('ws.settings.role_owner')}</option>
                <option value="editor" selected={m.ws_role === 'editor'}>{t('ws.settings.role_editor')}</option>

                <option value="viewer" selected={m.ws_role === 'viewer'}>{t('ws.settings.role_viewer')}</option>
              </select>
              
              <button class="btn-remove-member text-forge-muted hover:text-forge-error p-1 rounded hover:bg-red-500/10 transition-colors" data-user-id={m.id} data-ws-id={ws.id} title="Remove User">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
              </button>
            </div>
          </div>
        ))}
        {wsPendingInvites.map((m: any) => (
          <div class="flex items-center justify-between bg-forge-bg/50 border border-forge-border border-dashed p-3 rounded opacity-75">
            <div class="flex items-center gap-3">
              {m.avatar_url ? (
                <img src={m.avatar_url} class="w-8 h-8 rounded-full border border-forge-border object-cover" alt={`${m.username} avatar`} loading="lazy" />
              ) : (
                <div class="w-8 h-8 rounded-full border border-forge-border flex items-center justify-center text-forge-accent-text shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
              )}
              <span class="font-bold text-forge-text">{m.username}</span>
              {m.isExpired ? (
                <span class="text-[10px] font-bold text-forge-error bg-red-400/10 px-2 py-0.5 rounded uppercase tracking-wider" title="This invitation has expired">Expired</span>
              ) : (
                <span class="text-[10px] font-bold text-forge-warning bg-orange-400/10 px-2 py-0.5 rounded uppercase tracking-wider">Pending</span>
              )}
            </div>
            
            <div class="flex items-center gap-3">
              <span class="text-xs text-forge-muted capitalize">{m.role}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
    
    <!-- Join Requests -->
    <div class="bg-forge-panel border border-forge-border rounded-lg shadow-lg p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-forge-text">{t('ws.settings.join_requests')}</h2>
        <span class="text-xs text-forge-accent-text font-medium px-3 py-1 bg-forge-secondary/10 rounded border border-forge-secondary/20">
          {joinRequests.length} pending
        </span>
      </div>

      <div class="space-y-3">
        {joinRequests.length === 0 ? (
          <div class="text-forge-muted text-sm italic">{t('ws.settings.no_requests')}</div>
        ) : (
          joinRequests.map((req) => (
            <div class="flex items-center justify-between bg-forge-bg border border-forge-border p-3 rounded">
              <div class="flex items-center gap-3">
                {req.avatar_url ? (
                  <img src={req.avatar_url} class="w-8 h-8 rounded-full border border-forge-border object-cover" alt={`${req.username} avatar`} loading="lazy" />
                ) : (
                  <div class="w-8 h-8 rounded-full border border-forge-border flex items-center justify-center text-forge-accent-text shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  </div>
                )}
                <div>
                  <span class="font-bold text-forge-text block">@{req.username}</span>
                  <span class="text-[10px] text-forge-muted">{new Date(req.created_at).toLocaleDateString()}</span>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <button class="btn-req-accept px-3 py-1 bg-green-600/20 text-forge-success hover:bg-green-600/30 rounded border border-green-500/30 transition-colors text-sm font-medium" data-req-id={req.id}>{t('ws.settings.accept')}</button>
                <button class="btn-req-reject px-3 py-1 bg-red-600/20 text-forge-error hover:bg-red-600/30 rounded border border-red-500/30 transition-colors text-sm font-medium" data-req-id={req.id}>{t('ws.settings.reject')}</button>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
    
    <!-- Etiquetas del espacio -->
    <div class="bg-forge-panel border border-forge-border rounded-lg shadow-lg p-6">
      <div class="flex items-center justify-between mb-2 gap-4">
        <h2 class="text-xl font-bold text-forge-text flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-forge-accent-text"><path d="M12.6 2.6A2 2 0 0 0 11.2 2H4a2 2 0 0 0-2 2v7.2a2 2 0 0 0 .6 1.4l8.7 8.7a2.4 2.4 0 0 0 3.4 0l6.6-6.6a2.4 2.4 0 0 0 0-3.4Z"/><path d="M7.5 7.5h.01"/></svg>
          {t('labels.title')}
        </h2>
      </div>
      <p class="text-sm text-forge-muted mb-6 max-w-2xl leading-relaxed">{t('labels.desc')}</p>

      <form id="form-nueva-etiqueta" class="flex flex-col sm:flex-row gap-3 sm:items-end mb-6">
        <div class="flex-1 min-w-0">
          <label class="block text-[10px] font-bold uppercase tracking-widest text-forge-muted mb-1.5" for="etiqueta-nombre">{t('labels.name')}</label>
          <input type="text" id="etiqueta-nombre" maxlength="40" autocomplete="off" placeholder={t('labels.name_ph')} class="w-full bg-forge-bg border border-forge-border rounded-lg px-3 py-2 text-sm text-forge-text focus:border-forge-secondary focus:ring-1 focus:ring-forge-secondary/30 outline-none transition-all">
        </div>
        <fieldset class="shrink-0">
          <legend class="block text-[10px] font-bold uppercase tracking-widest text-forge-muted mb-1.5">{t('labels.color')}</legend>
          <div id="etiqueta-colores" class="flex flex-wrap gap-1.5">
            {COLORES.map((c, i) => (
              <button
                type="button"
                class="color-opt w-7 h-7 rounded-lg border-2 border-transparent transition-all focus:outline-none focus:ring-2 focus:ring-forge-secondary/40 aria-pressed:border-forge-text"
                style={`background-color:${c}`}
                data-color={c}
                aria-pressed={i === 1 ? 'true' : 'false'}
                aria-label={c}
              ></button>
            ))}
          </div>
        </fieldset>
        <button type="submit" class="shrink-0 bg-forge-primary text-forge-on-accent font-bold px-4 py-2 rounded-lg text-sm hover:opacity-90 transition-opacity">
          {t('labels.create')}
        </button>
      </form>

      <ul id="lista-etiquetas" class="space-y-2">
        {etiquetas.map((e: any) => (
          <li class="fila-etiqueta flex items-center justify-between gap-3 bg-forge-bg/50 border border-forge-border p-3 rounded-lg" data-id={e.id} data-name={e.name} data-color={e.color}>
            <div class="flex items-center gap-3 min-w-0">
              <LabelChip name={e.name} color={e.color} />
              <span class="text-xs text-forge-muted truncate">
                {e.usos === 0 ? t('labels.unused') : e.usos === 1 ? t('labels.used_in_one') : t('labels.used_in').replace('{n}', String(e.usos))}
              </span>
            </div>
            <div class="flex items-center gap-1 shrink-0">
              <button class="btn-renombrar-etiqueta text-xs font-bold text-forge-muted hover:text-forge-text px-2 py-1.5 rounded transition-colors">{t('labels.rename')}</button>
              <button class="btn-borrar-etiqueta text-forge-muted hover:text-forge-error p-1.5 rounded hover:bg-red-500/10 transition-colors" aria-label={t('labels.delete')} title={t('labels.delete')}>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
              </button>
            </div>
          </li>
        ))}
      </ul>
      <div id="etiquetas-vacio" class:list={['py-6 text-center text-forge-muted text-sm border border-dashed border-forge-border rounded-lg bg-forge-bg/30', etiquetas.length > 0 && 'hidden']}>
        {t('labels.none')}
      </div>
    </div>

    <!-- Tipos de ticket -->
    <div id="tipos-ticket" class="bg-forge-panel border border-forge-border rounded-lg shadow-lg p-6"
      data-sys-tag={sys_tag}
      data-t-error={t('types.error')}
      data-t-in-use={t('types.in_use_confirm')}
      data-t-in-use-one={t('types.in_use_confirm_one')}
      data-t-last={t('types.err_last')}
      data-t-delete={t('types.delete')}
      data-t-rename={t('types.rename_prompt')}
      data-t-errrepetido={t('types.err_repetido')}
      data-t-errnombre_vacio={t('types.err_nombre_vacio')}
      data-t-errnombre_largo={t('types.err_nombre_largo')}
      data-t-errdemasiados={t('types.err_demasiados')}>
      <div class="flex items-center justify-between mb-2 gap-4">
        <h2 class="text-xl font-bold text-forge-text flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-forge-accent-text" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
          {t('types.title')}
        </h2>
      </div>
      <p class="text-sm text-forge-muted mb-6 max-w-2xl leading-relaxed">{t('types.desc')}</p>

      <form id="form-nuevo-tipo" class="flex flex-col sm:flex-row gap-3 sm:items-end mb-6">
        <div class="flex-1 min-w-0">
          <label class="block text-[10px] font-bold uppercase tracking-widest text-forge-muted mb-1.5" for="tipo-nombre">{t('types.name')}</label>
          <input type="text" id="tipo-nombre" maxlength="30" autocomplete="off" placeholder={t('types.name_ph')} class="w-full bg-forge-bg border border-forge-border rounded-lg px-3 py-2 text-sm text-forge-text focus:border-forge-secondary focus:ring-1 focus:ring-forge-secondary/30 outline-none transition-all">
        </div>
        <fieldset class="shrink-0">
          <legend class="block text-[10px] font-bold uppercase tracking-widest text-forge-muted mb-1.5">{t('types.color')}</legend>
          <div id="tipo-colores" class="flex flex-wrap gap-1.5">
            {COLORES.map((c, i) => (
              <button
                type="button"
                class="tipo-color-opt w-7 h-7 rounded-lg border-2 border-transparent transition-all focus:outline-none focus:ring-2 focus:ring-forge-secondary/40 aria-pressed:border-forge-text"
                style={`background-color:${c}`}
                data-color={c}
                aria-pressed={i === 5 ? 'true' : 'false'}
                aria-label={c}
              ></button>
            ))}
          </div>
        </fieldset>
        <button type="submit" class="shrink-0 bg-forge-primary text-forge-on-accent font-bold px-4 py-2 rounded-lg text-sm hover:opacity-90 transition-opacity">
          {t('types.create')}
        </button>
      </form>

      {/* Cada tipo, en dos filas cuando la pantalla es estrecha.

          En una sola, «Renombrar» más la papelera se llevan 120 px fijos de los
          290 que hay, y los dos textos de la izquierda —el nombre del tipo y su
          uso— se reparten lo que queda encogiéndose a la vez. El resultado era
          «T… en 1… Renombrar», con el nombre recortado a una letra: la lista
          dejaba de decir qué tipos existen, que es lo único que hace. */}
      <ul id="lista-tipos" class="space-y-2">
        {tiposTicket.map((ti: any) => (
          <li class="fila-tipo flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-3 bg-forge-bg/50 border border-forge-border p-3 rounded-lg"
            data-id={ti.id} data-key={ti.key} data-name={ti.name} data-color={ti.color} data-builtin={ti.isBuiltin ? '1' : '0'}>
            <div class="flex items-center gap-3 min-w-0 flex-wrap">
              <span class="w-3 h-3 rounded-full shrink-0" style={`background:${ti.color}`} aria-hidden="true"></span>
              <span class="text-sm font-semibold text-forge-text truncate">
                {ti.isBuiltin ? (t(`type.${ti.key}` as any) || ti.name) : ti.name}
              </span>
              <span class="text-xs text-forge-muted truncate">
                {ti.usos === 0 ? t('types.unused') : ti.usos === 1 ? t('types.used_in_one') : t('types.used_in').replace('{n}', String(ti.usos))}
              </span>
            </div>
            <div class="flex items-center gap-1 shrink-0 self-end sm:self-auto">
              <button class="btn-renombrar-tipo text-xs font-bold text-forge-muted hover:text-forge-text px-2 py-1.5 rounded transition-colors">{t('types.rename')}</button>
              <button class="btn-borrar-tipo text-forge-muted hover:text-forge-error p-1.5 rounded hover:bg-red-500/10 transition-colors" aria-label={t('types.delete')} title={t('types.delete')}>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
              </button>
            </div>
          </li>
        ))}
      </ul>
    </div>

    {/*
      Borrar un tipo que está en uso.
      El servidor se niega y devuelve cuántos tickets lo llevan y a qué tipos
      pueden pasar. Esto es esa pregunta, con el número delante: «afecta a
      algunos tickets» no permite decidir nada.
    */}
    <dialog id="tipo-borrar-modal" class="bg-forge-panel border border-forge-border rounded-2xl p-6 w-full max-w-[440px] text-forge-text shadow-xl backdrop:bg-black/60">
      <h2 class="text-lg font-bold mb-1">{t('types.delete')}</h2>
      <p id="tipo-borrar-lead" class="text-sm text-forge-muted mb-5"></p>
      <label class="block text-[10px] font-bold uppercase tracking-widest text-forge-muted mb-1.5" for="tipo-sustituto">{t('types.replacement')}</label>
      <select id="tipo-sustituto" class="w-full bg-forge-bg border border-forge-border rounded-lg p-2 text-sm text-forge-text focus:border-forge-secondary focus:outline-none"></select>
      <div class="flex justify-end gap-3 mt-6">
        <button type="button" id="tipo-borrar-cancelar" class="px-4 py-2 text-sm font-bold text-forge-muted hover:text-forge-text">{t('modal.cancel')}</button>
        <button type="button" id="tipo-borrar-confirmar" class="bg-forge-primary text-forge-on-accent px-5 py-2 rounded-xl text-sm font-bold hover:opacity-90 transition-opacity">{t('types.delete_move')}</button>
      </div>
    </dialog>

    <!-- Automations Engine -->
    <div class="bg-forge-panel border border-forge-border rounded-lg shadow-lg p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-forge-text flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-forge-accent-text"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          {t('ws.settings.automations')}
        </h2>
        <button id="btn-add-automation" class="bg-forge-primary text-forge-on-accent font-bold px-3 py-1.5 text-sm rounded hover:opacity-90 transition-opacity">
          {t('ws.settings.new_rule')}
        </button>
      </div>

      <div class="space-y-4">
        {automations.map((auto: any) => (
          <div class="flex items-center justify-between bg-forge-bg/50 border border-forge-border p-4 rounded-lg">
            <div class="flex flex-col">
              <span class="font-bold text-forge-text text-sm">{auto.name}</span>
              <span class="text-[10px] font-mono text-forge-muted mt-1 uppercase">IF {auto.trigger_type} THEN {auto.action_type}</span>
            </div>
            <div class="flex items-center gap-4">
              <label class="flex items-center cursor-pointer">
                <div class="relative">
                  <input type="checkbox" class="sr-only toggle-automation-active" data-id={auto.id} checked={auto.is_active === 1}>
                  <div class="block bg-forge-panel border border-forge-border w-8 h-5 rounded-full transition-colors"></div>
                  <div class="dot absolute left-1 top-1 bg-forge-muted w-3 h-3 rounded-full transition-transform"></div>
                </div>
              </label>
              <button class="btn-delete-automation text-forge-muted hover:text-forge-error p-1 rounded hover:bg-red-500/10 transition-colors" data-id={auto.id} title="Delete Rule">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
              </button>
            </div>
          </div>
        ))}
        {automations.length === 0 && (
          <div class="py-6 text-center text-forge-muted text-sm border border-dashed border-forge-border rounded-lg bg-forge-bg/30">
            {t('ws.settings.no_rules')}
          </div>
        )}
      </div>
    </div>
    
    <!-- Audit Logs -->
    <div class="bg-forge-panel border border-forge-border rounded-lg shadow-lg p-6 overflow-hidden flex flex-col max-h-[600px]">
      <div class="flex items-center justify-between mb-6 shrink-0">
        <h2 class="text-xl font-bold text-forge-text flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-forge-accent-text"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
          {t('ws.settings.audit')}
        </h2>
        <span class="text-xs text-forge-muted font-mono bg-forge-bg px-2 py-1 rounded">{t('ws.settings.last_events')}</span>
      </div>
      
      <div class="mb-4 flex flex-wrap gap-3 p-3 bg-forge-bg rounded-lg border border-forge-border">
        <input type="text" id="audit-filter-user" aria-label={t('a11y.filter_user')} placeholder="Filter by user..." class="bg-forge-panel border border-forge-border rounded p-1.5 text-sm text-forge-text focus:outline-none focus:border-forge-secondary" />
        <select id="audit-filter-action" aria-label={t('a11y.filter_action')} class="bg-forge-panel border border-forge-border rounded p-1.5 text-sm text-forge-text focus:outline-none focus:border-forge-secondary">
          <option value="">All Actions</option>
          {[...new Set(auditLogs.map((l: any) => l.action))].map(action => (
            <option value={action}>{action}</option>
          ))}
        </select>
        <input type="date" id="audit-filter-date" aria-label={t('a11y.filter_date')} class="bg-forge-panel border border-forge-border rounded p-1.5 text-sm text-forge-text focus:outline-none focus:border-forge-secondary" />
      </div>

      <div class="overflow-y-auto pr-2 -mr-2 space-y-2 flex-1" id="audit-logs-container">
        {auditLogs.map((log: any) => {
          const date = new Date(log.timestamp.replace(' ', 'T') + 'Z').toLocaleString();
          let detailsText = '';
          try {
            const details = JSON.parse(log.details_json);
            if (details) {
              if (details.oldStatus && details.newStatus) {
                detailsText = `Moved ${log.entity_type} from ${details.oldStatus} to ${details.newStatus}`;
              } else if (log.action === 'issue.created') {
                detailsText = `Created a new ${log.entity_type}`;
              } else if (log.action === 'issue.deleted') {
                detailsText = `Deleted ${log.entity_type}`;
              } else {
                detailsText = Object.entries(details).map(([k, v]) => `${k}: ${v}`).join(', ');
              }
            }
          } catch (e) {}
          
          return (
            <div class="audit-log-item flex flex-col p-3 rounded-lg bg-forge-bg/50 border border-forge-border/40 hover:border-forge-secondary/30 transition-colors" data-user={log.username?.toLowerCase() || 'system'} data-action={log.action} data-date={date.split(',')[0]}>
              <div class="flex justify-between items-start mb-2">
                <div class="flex items-center gap-2">
                  <div class="w-6 h-6 rounded-full overflow-hidden bg-forge-panel shrink-0 border border-forge-border">
                    <img src={log.avatar_url || '/default-avatar.svg'} alt={log.username} class="w-full h-full object-cover" loading="lazy" decoding="async" />
                  </div>
                  <span class="text-sm font-bold text-forge-text">{log.username || 'System'}</span>
                  <span class="text-xs text-forge-muted uppercase tracking-wider bg-forge-panel px-1.5 py-0.5 rounded border border-forge-border/50">{log.action}</span>
                </div>
                <span class="text-[10px] text-forge-muted font-mono">{date}</span>
              </div>
              <div class="text-xs text-forge-text/80 pl-8">
                <span class="font-bold text-forge-accent-text">{log.entity_type}</span>: <span class="font-mono text-forge-muted">{log.entity_id.substring(0,8)}</span>
                {detailsText && <p class="mt-1 font-mono text-sm text-forge-text" title={log.details_json}>{detailsText}</p>}
              </div>
            </div>
          );
        })}
        {auditLogs.length === 0 && (
          <div class="py-8 text-center text-forge-muted text-sm font-mono">
            No audit logs recorded yet.
          </div>
        )}
      </div>
    </div>
    
    <!-- Danger Zone -->
    <div class="bg-red-500/5 border border-red-500/20 rounded-lg shadow-lg p-6">
      <h2 class="text-xl font-bold text-forge-error mb-2">{t('ws.settings.danger')}</h2>
      <p class="text-forge-muted text-sm mb-4">{t('ws.settings.danger_desc')}</p>
      <button id="btn-delete-workspace-prompt" class="bg-red-500/10 text-forge-error border border-red-500/30 px-4 py-2 rounded font-bold hover:bg-red-500 hover:text-white transition-colors" data-ws-id={ws.id}>
        {t('ws.settings.delete')}
      </button>
    </div>

  </div>

  <dialog id="delete-workspace-modal" class="bg-forge-panel border border-forge-border rounded-lg p-6 w-full max-w-[400px] text-forge-text shadow-xl backdrop:bg-black/50">
    <h2 class="text-xl font-bold mb-4 text-forge-error">Delete Workspace</h2>
    <p class="mb-4 text-sm text-forge-muted">This action cannot be undone. Please type <span class="font-bold text-forge-text">{ws.name}</span> to confirm.</p>
    <div class="mb-4">
      <input type="text" id="delete-workspace-confirm-input" aria-label={t('a11y.confirm_ws_name')} class="w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:border-red-500 focus:outline-none" placeholder={ws.name}>
    </div>
    <div class="flex justify-end gap-3 mt-6">
      <button type="button" class="px-4 py-2 text-forge-muted hover:text-forge-text" onclick="document.getElementById('delete-workspace-modal').close()">Cancel</button>
      <button type="button" id="btn-delete-workspace" class="bg-red-500/50 text-white px-4 py-2 rounded font-bold cursor-not-allowed transition-colors" data-ws-id={ws.id} data-ws-name={ws.name} disabled>Delete Workspace</button>
    </div>
  </dialog>

  <dialog id="add-member-modal" class="bg-forge-panel border border-forge-border rounded-lg p-6 w-full max-w-[400px] text-forge-text shadow-xl backdrop:bg-black/50">
    <h2 class="text-xl font-bold mb-4">{t('ws.settings.modal_add_member')}</h2>
    <div class="mb-4">
      <label class="block text-xs uppercase tracking-wider text-forge-muted mb-1" for="add-member-username">{t('ws.settings.modal_username')}</label>
      {/*
        El campo y la lista van juntos y en posición relativa: la lista se
        superpone al resto del diálogo en vez de empujarlo, que con un `dialog`
        de alto automático hace saltar el botón de enviar mientras escribes.
      */}
      <div class="relative">
        <input
          type="text"
          id="add-member-username"
          autocomplete="off"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="add-member-results"
          class="w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:border-forge-secondary focus:outline-none"
          placeholder={t('ws.settings.modal_username_ph')}
        >
        {/*
          Aquí se pintan las sugerencias.
          Faltaba: el script las buscaba bien y salía por `if (!lista) return`
          sin un solo error, así que el campo se comportaba exactamente igual
          que antes de tener buscador.
        */}
        <div id="add-member-results" role="listbox" class="hidden absolute left-0 right-0 top-full mt-1 z-10 max-h-56 overflow-y-auto bg-forge-panel border border-forge-border rounded-lg shadow-xl p-1"></div>
      </div>
    </div>
    <div class="mb-4">
      <label class="block text-xs uppercase tracking-wider text-forge-muted mb-1" for="add-member-role">{t('ws.settings.modal_role')}</label>
      <select id="add-member-role" class="w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:border-forge-secondary focus:outline-none">
        <option value="viewer">{t('ws.settings.role_viewer')}</option>

        <option value="editor">{t('ws.settings.role_editor')}</option>
        <option value="owner">{t('ws.settings.role_owner')}</option>
      </select>
    </div>
    <div class="flex justify-end gap-3 mt-6">
      <button type="button" class="px-4 py-2 text-forge-muted hover:text-forge-text" onclick="document.getElementById('add-member-modal').close()">{t('ws.settings.modal_cancel')}</button>
      <button type="button" id="btn-confirm-add" class="bg-forge-primary text-forge-on-accent px-4 py-2 rounded font-bold hover:opacity-90 transition-opacity" data-ws-id={ws.id}>{t('ws.settings.modal_send_invite')}</button>
    </div>
  </dialog>

  <!-- Add Automation Modal -->
  <dialog id="add-automation-modal" class="bg-forge-panel border border-forge-border rounded-lg p-6 w-full max-w-[500px] text-forge-text shadow-xl backdrop:bg-black/50">
    <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-forge-accent-text"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
      {t('ws.settings.modal_create_rule')}
    </h2>
    <div class="space-y-4">
      <div>
        {/* Decía «Nombre del workspace»: reutilizaba la clave del nombre del
            espacio, que es otro campo de esta misma pantalla. Con la etiqueta
            ya asociada al campo, un lector de pantalla lo anunciaba así con
            toda seguridad. */}
        <label class="block text-xs uppercase tracking-wider text-forge-muted mb-1" for="auto-name">{t('ws.settings.rule_name')}</label>
        <input type="text" id="auto-name" class="w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:border-forge-secondary focus:outline-none" placeholder={t('ws.settings.rule_name_ph')}>
      </div>
      
      {/*
        Un disparador y una acción, que son los que existen.

        El desplegable ofrecía cuatro disparadores y tres acciones; solo la
        combinación «issue movido → webhook» tenía motor detrás, y ni esa
        funcionaba porque los valores no coincidían con los que consulta.
        Ofrecer opciones que no hacen nada es la misma enfermedad que decir
        «Guardado» mientras se pierde contenido.

        Y los dos campos libres pedían JSON —lo parseaban al enviar— con
        marcadores que sugerían texto plano («e.g. In Progress»). Ahora se
        pregunta lo que de verdad hace falta y el JSON lo compone el cliente.
      */}
      <div class="p-4 rounded border border-forge-border bg-forge-bg/30">
        <p class="block text-sm font-bold text-forge-accent-text mb-2 uppercase tracking-wider">{t('ws.settings.modal_trigger')}</p>
        <p class="text-sm text-forge-text mb-3">{t('ws.settings.trigger_desc')}</p>

        <label for="auto-trigger-cond" class="block text-xs uppercase tracking-wider text-forge-muted mb-1">{t('ws.settings.target_status')}</label>
        <select id="auto-trigger-cond" class="w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:border-forge-secondary focus:outline-none">
          <option value="todo">{t('metrics.todo')}</option>
          <option value="in_progress">{t('metrics.in_progress')}</option>
          <option value="review">{t('ws.settings.status_review')}</option>
          <option value="done" selected>{t('metrics.done')}</option>
        </select>
      </div>

      <div class="p-4 rounded border border-forge-border bg-forge-bg/30">
        <p class="block text-sm font-bold text-forge-accent-text mb-2 uppercase tracking-wider">{t('ws.settings.modal_action')}</p>
        <p class="text-sm text-forge-text mb-3">{t('ws.settings.action_desc')}</p>

        <label for="auto-action-payload" class="block text-xs uppercase tracking-wider text-forge-muted mb-1">{t('ws.settings.webhook_url')}</label>
        <input type="url" id="auto-action-payload" class="w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:border-forge-secondary focus:outline-none" placeholder="https://ejemplo.com/hook" />
        <p class="text-xs text-forge-muted mt-1">{t('ws.settings.webhook_hint')}</p>
      </div>
    </div>
    
    <div class="flex justify-end gap-3 mt-6">
      <button type="button" class="px-4 py-2 text-forge-muted hover:text-forge-text" onclick="document.getElementById('add-automation-modal').close()">{t('ws.settings.modal_cancel')}</button>
      <button type="button" id="btn-save-automation" class="bg-forge-primary text-forge-on-accent px-4 py-2 rounded font-bold hover:opacity-90 transition-opacity" data-ws-id={ws.id}>{t('ws.settings.modal_save_rule')}</button>
    </div>
  </dialog>

</MainLayout>
<style>
  input:checked + div { background-color: var(--forge-secondary); border-color: var(--forge-secondary); }
  input:checked + div + .dot { transform: translateX(12px); background-color: var(--forge-bg); }
</style>

<script is:inline define:vars={{
  autoNeedName: t('ws.settings.auto_need_name'),
  autoNeedUrl: t('ws.settings.auto_need_url'),
  sysTag: sys_tag,
  LBL: {
    rename: t('labels.rename'),
    save: t('labels.save'),
    cancel: t('labels.cancel'),
    del: t('labels.delete'),
    delConfirm: t('labels.delete_confirm'),
    unused: t('labels.unused'),
    errRequired: t('labels.err_required'),
    errTooLong: t('labels.err_too_long'),
    errDuplicate: t('labels.err_duplicate'),
    errTooMany: t('labels.err_too_many'),
    errBadColor: t('labels.err_bad_color'),
    errGeneric: t('labels.err_generic'),
    inviteNone: t('ws.settings.invite_none'),
  },
}}>
  // ── Sugerencias al invitar ─────────────────────────────────────────────────
  //
  // El campo era texto libre: había que escribir el nombre exacto de memoria y,
  // si fallabas una letra, el error llegaba **después** de enviar la
  // invitación. Escribir de memoria el nombre de alguien es justo lo que un
  // buscador evita.
  (() => {
    const campo = document.getElementById('add-member-username');
    const lista = document.getElementById('add-member-results');
    if (!campo || !lista) return;

    const cerrar = () => {
      lista.classList.add('hidden');
      campo.setAttribute('aria-expanded', 'false');
    };

    const pintar = (usuarios) => {
      lista.innerHTML = '';
      if (!usuarios.length) {
        const vacio = document.createElement('p');
        vacio.className = 'px-2 py-1.5 text-xs text-forge-muted italic';
        vacio.textContent = LBL.inviteNone;
        lista.appendChild(vacio);
      } else {
        for (const u of usuarios) {
          const fila = document.createElement('button');
          fila.type = 'button';
          fila.setAttribute('role', 'option');
          fila.className = 'w-full flex items-center gap-2 px-2 py-1.5 rounded text-sm text-forge-text hover:bg-forge-bg transition-colors text-left';

          const avatar = document.createElement('img');
          avatar.src = u.avatarUrl || '/default-avatar.svg';
          avatar.alt = '';
          avatar.className = 'w-5 h-5 rounded-full border border-forge-border shrink-0';

          const nombre = document.createElement('span');
          nombre.className = 'truncate';
          // Por `textContent`: el nombre lo elige quien se registra.
          nombre.textContent = u.username;

          fila.append(avatar, nombre);
          fila.addEventListener('mousedown', (e) => {
            // `mousedown` y no `click`: el `blur` del campo esconde la lista
            // antes de que llegue el `click`.
            e.preventDefault();
            campo.value = u.username;
            cerrar();
          });
          lista.appendChild(fila);
        }
      }
      lista.classList.remove('hidden');
      campo.setAttribute('aria-expanded', 'true');
    };

    let espera;
    let ultima = 0;
    campo.addEventListener('input', () => {
      clearTimeout(espera);
      const texto = campo.value.trim();
      if (texto.length < 2) { cerrar(); return; }

      espera = setTimeout(async () => {
        const mio = ++ultima;
        try {
          const res = await fetch(`/api/w/${sysTag}/members/search?q=${encodeURIComponent(texto)}`);
          if (!res.ok || mio !== ultima) return;  // llegó tarde: manda la última
          pintar((await res.json()).users || []);
        } catch {
          cerrar();
        }
      }, 200);
    });

    campo.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrar(); });
    campo.addEventListener('blur', () => setTimeout(cerrar, 150));
  })();

  // ── Etiquetas ──────────────────────────────────────────────────────────────
  //
  // Todo sin recargar: la lista se retoca en el sitio. Recargar la página
  // entera por crear una etiqueta pierde el resto del formulario de ajustes, y
  // era una de las quejas concretas sobre la aplicación.
  (() => {
    const apiEtiquetas = `/api/w/${sysTag}/labels`;
    const lista = document.getElementById('lista-etiquetas');
    const vacio = document.getElementById('etiquetas-vacio');
    const form = document.getElementById('form-nueva-etiqueta');
    const campoNombre = document.getElementById('etiqueta-nombre');
    const paletaNueva = document.getElementById('etiqueta-colores');
    if (!lista || !form) return;

    /** Traduce el código que devuelve la API. Nunca se enseña el código a secas. */
    const explicar = (codigo) => ({
      required: LBL.errRequired,
      too_long: LBL.errTooLong,
      duplicate: LBL.errDuplicate,
      too_many: LBL.errTooMany,
      bad_color: LBL.errBadColor,
    }[codigo] ?? LBL.errGeneric);

    function marcarColor(paleta, color) {
      paleta?.querySelectorAll('.color-opt').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.color === color));
      });
    }
    const colorElegido = (paleta) =>
      paleta?.querySelector('.color-opt[aria-pressed="true"]')?.dataset.color;

    paletaNueva?.addEventListener('click', (e) => {
      const boton = e.target.closest('.color-opt');
      if (boton) marcarColor(paletaNueva, boton.dataset.color);
    });

    function refrescarVacio() {
      vacio?.classList.toggle('hidden', lista.children.length > 0);
    }

    /** Pinta una fila. El nombre va por textContent: lo escribe cualquiera. */
    function filaDe(etiqueta) {
      const li = document.createElement('li');
      li.className = 'fila-etiqueta flex items-center justify-between gap-3 bg-forge-bg/50 border border-forge-border p-3 rounded-lg';
      li.dataset.id = etiqueta.id;
      li.dataset.name = etiqueta.name;
      li.dataset.color = etiqueta.color;

      li.innerHTML = `
        <div class="flex items-center gap-3 min-w-0 flex-wrap">
          <span class="inline-flex items-center gap-1.5 rounded-md border border-forge-border/60 bg-forge-bg text-forge-text max-w-full px-2 py-1 text-xs">
            <span class="rounded-full shrink-0 w-2 h-2 chip-dot"></span>
            <span class="truncate chip-name"></span>
          </span>
          <span class="text-xs text-forge-muted truncate chip-uso"></span>
        </div>
        <div class="flex items-center gap-1 shrink-0 self-end sm:self-auto">
          <button class="btn-renombrar-etiqueta text-xs font-bold text-forge-muted hover:text-forge-text px-2 py-1.5 rounded transition-colors"></button>
          <button class="btn-borrar-etiqueta text-forge-muted hover:text-forge-error p-1.5 rounded hover:bg-red-500/10 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
          </button>
        </div>
      `;
      li.querySelector('.chip-dot').style.backgroundColor = etiqueta.color;
      li.querySelector('.chip-name').textContent = etiqueta.name;
      li.querySelector('.chip-uso').textContent = LBL.unused;
      li.querySelector('.btn-renombrar-etiqueta').textContent = LBL.rename;
      const borrar = li.querySelector('.btn-borrar-etiqueta');
      borrar.setAttribute('aria-label', LBL.del);
      borrar.title = LBL.del;
      return li;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = campoNombre.value.trim();
      if (!name) return window.showToast?.(LBL.errRequired, true);

      const res = await fetch(apiEtiquetas, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, color: colorElegido(paletaNueva) }),
      });
      const datos = await res.json().catch(() => ({}));
      if (!res.ok) return window.showToast?.(explicar(datos.error_code), true);

      // Se inserta donde toca: la lista va por nombre, y añadir al final la
      // dejaría desordenada hasta la siguiente recarga.
      const nueva = filaDe(datos);
      const siguiente = [...lista.children].find(
        (li) => li.dataset.name.localeCompare(datos.name, undefined, { sensitivity: 'base' }) > 0
      );
      lista.insertBefore(nueva, siguiente ?? null);
      campoNombre.value = '';
      refrescarVacio();
    });

    lista.addEventListener('click', async (e) => {
      const fila = e.target.closest('.fila-etiqueta');
      if (!fila) return;

      if (e.target.closest('.btn-borrar-etiqueta')) {
        window.forgeConfirm?.(LBL.delConfirm, async () => {
          const res = await fetch(apiEtiquetas, {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: fila.dataset.id }),
          });
          if (!res.ok) return window.showToast?.(LBL.errGeneric, true);
          fila.remove();
          refrescarVacio();
        }, LBL.del);
        return;
      }

      if (e.target.closest('.btn-renombrar-etiqueta')) abrirEdicion(fila);
    });

    /** Cambia la fila por un formulario en el sitio, sin modal. */
    function abrirEdicion(fila) {
      if (fila.querySelector('.edicion-etiqueta')) return;
      const original = fila.innerHTML;

      const caja = document.createElement('div');
      caja.className = 'edicion-etiqueta flex flex-col sm:flex-row sm:items-center gap-3 w-full';
      caja.innerHTML = `
        <input type="text" maxlength="40" class="editar-nombre flex-1 min-w-0 bg-forge-bg border border-forge-border rounded-lg px-3 py-2 text-sm text-forge-text focus:border-forge-secondary focus:ring-1 focus:ring-forge-secondary/30 outline-none">
        <div class="editar-colores flex flex-wrap gap-1.5"></div>
        <div class="flex gap-2 shrink-0">
          <button class="editar-guardar bg-forge-primary text-forge-on-accent font-bold px-3 py-1.5 rounded-lg text-xs"></button>
          <button class="editar-cancelar text-xs font-bold text-forge-muted hover:text-forge-text px-2 py-1.5"></button>
        </div>
      `;
      caja.querySelector('.editar-guardar').textContent = LBL.save;
      caja.querySelector('.editar-cancelar').textContent = LBL.cancel;
      const campo = caja.querySelector('.editar-nombre');
      campo.value = fila.dataset.name;

      const paleta = caja.querySelector('.editar-colores');
      paletaNueva.querySelectorAll('.color-opt').forEach((modelo) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'color-opt w-7 h-7 rounded-lg border-2 border-transparent transition-all focus:outline-none focus:ring-2 focus:ring-forge-secondary/40 aria-pressed:border-forge-text';
        b.style.backgroundColor = modelo.dataset.color;
        b.dataset.color = modelo.dataset.color;
        b.setAttribute('aria-label', modelo.dataset.color);
        b.setAttribute('aria-pressed', String(modelo.dataset.color === fila.dataset.color));
        paleta.appendChild(b);
      });
      paleta.addEventListener('click', (ev) => {
        const boton = ev.target.closest('.color-opt');
        if (boton) marcarColor(paleta, boton.dataset.color);
      });

      fila.innerHTML = '';
      fila.appendChild(caja);
      campo.focus();
      campo.select();

      caja.querySelector('.editar-cancelar').addEventListener('click', () => { fila.innerHTML = original; });

      caja.querySelector('.editar-guardar').addEventListener('click', async () => {
        const name = campo.value.trim();
        const color = colorElegido(paleta);
        const res = await fetch(apiEtiquetas, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: fila.dataset.id, name, color }),
        });
        const datos = await res.json().catch(() => ({}));
        if (!res.ok) return window.showToast?.(explicar(datos.error_code), true);

        // Se conserva el texto de uso: renombrar no cambia dónde está puesta.
        const uso = new DOMParser().parseFromString(original, 'text/html')
          .querySelector('.chip-uso, .text-xs.text-forge-muted')?.textContent ?? '';
        fila.dataset.name = name;
        fila.dataset.color = color;
        fila.innerHTML = filaDe({ id: fila.dataset.id, name, color }).innerHTML;
        const usoEl = fila.querySelector('.chip-uso');
        if (usoEl && uso) usoEl.textContent = uso;
      });
    }
  })();

  const wsId = document.getElementById('btn-save-general')?.getAttribute('data-ws-id');
  let newIconUrl = null;
  const iconInput = document.getElementById('ws-icon-file-input');
  
  iconInput?.addEventListener('change', async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;

    /**
     * El redimensionado y la subida viven en `lib/client/imagen.ts`.
     *
     * Esta copia recortaba a 512 px de **ancho y alto** —las otras dos solo el
     * ancho, que es lo correcto para no deformar— y comprimía a 0.80 en vez de
     * 0.85, sin ninguna razón escrita. Con tres versiones, corregir una dejaba
     * las otras dos atrás. Ya pasó.
     */
    const r = await window.forgeImagen.subir(file, {
      maxAncho: window.forgeImagen.ANCHOS.icono,
      nombre: 'icon.webp',
      entidad: { tipo: 'workspace', id: wsId },
    });

    if (!r.ok) {
      window.showToast?.(window.forgeMsg?.errGenerico || '', true);
      return;
    }

    newIconUrl = r.url;
    const iconPreview = document.getElementById('ws-icon-preview-img');
    if (iconPreview) {
      iconPreview.src = newIconUrl;
    } else {
      const container = document.getElementById('ws-icon-preview-container');
      document.getElementById('ws-icon-preview-text')?.style.setProperty('display', 'none');
      const newImg = document.createElement('img');
      newImg.src = newIconUrl;
      newImg.id = 'ws-icon-preview-img';
      newImg.className = 'w-full h-full object-cover z-0';
      newImg.loading = 'lazy';
      newImg.decoding = 'async';
      container?.insertBefore(newImg, container.firstChild);
    }
  });

  document.getElementById('btn-save-general')?.addEventListener('click', async (e) => {
    const wsIdAttr = e.currentTarget.getAttribute('data-ws-id');
    const name = document.getElementById('ws-name-input').value;
    const sys_tag = document.getElementById('ws-tag-input').value;
    const description = document.getElementById('ws-desc-input')?.value || "";
    const is_public = document.getElementById('ws-public-input')?.value === "1";
    const join_policy = document.getElementById('ws-join-policy-input')?.value || "disabled";
    
    let finalIcon = newIconUrl;
    if (!finalIcon) {
       const existingImg = document.getElementById('ws-icon-preview-img');
       if (existingImg) finalIcon = existingImg.src;
       else {
         const existingText = document.getElementById('ws-icon-preview-text');
         if (existingText && existingText.textContent && existingText.textContent.trim().length <= 2) {
            finalIcon = existingText.textContent.trim();
         }
       }
    }

    const res = await fetch(`/api/workspaces/${wsIdAttr}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, sys_tag, description, icon: finalIcon, is_public, join_policy })
    });
    
    if (res.ok) {
      window.showToast('Workspace updated!');
    } else {
      console.error('ajustes del espacio:', await res.text());
      window.showToast(window.forgeMsg?.errGuardarAjustes || '', true);
    }
  });

  // Members
  document.querySelectorAll('.role-select').forEach(select => {
    select.addEventListener('change', async (e) => {
      const el = e.currentTarget;
      const userId = el.getAttribute('data-user-id');
      const wsId = el.getAttribute('data-ws-id');
      const role = el.value;

      const res = await fetch(`/api/workspaces/${wsId}/members`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId, role })
      });
      if (res.ok) {
        window.showToast('Role updated');
      } else {
        console.error(await res.text());
      window.showToast(window.forgeMsg?.errGenerico || '', true);
        window.location.reload(); // reset select
      }
    });
  });

  // Join Requests
  document.querySelectorAll('.btn-req-accept').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const el = e.currentTarget;
      const reqId = el.getAttribute('data-req-id');
      const wsId = document.getElementById('btn-save-general')?.getAttribute('data-ws-id');
      
      const res = await fetch(`/api/workspaces/${wsId}/requests/${reqId}/accept`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({})
      });
      if (res.ok) {
        window.showToast('Request accepted');
        window.location.reload();
      } else {
        console.error(await res.text());
      window.showToast(window.forgeMsg?.errGenerico || '', true);
      }
    });
  });

  document.querySelectorAll('.btn-req-reject').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const el = e.currentTarget;
      const reqId = el.getAttribute('data-req-id');
      const wsId = document.getElementById('btn-save-general')?.getAttribute('data-ws-id');
      
      const res = await fetch(`/api/workspaces/${wsId}/requests/${reqId}/reject`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({})
      });
      if (res.ok) {
        el.closest('div.bg-forge-bg')?.remove();
        window.showToast('Request rejected');
      } else {
        console.error(await res.text());
      window.showToast(window.forgeMsg?.errGenerico || '', true);
      }
    });
  });

  document.querySelectorAll('.btn-remove-member').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const el = e.currentTarget;
      const userId = el.getAttribute('data-user-id');
      const wsId = el.getAttribute('data-ws-id');
      
      window.forgeConfirm(window.forgeMsg?.confirmarQuitarMiembro || '', async () => {
        const res = await fetch(`/api/workspaces/${wsId}/members`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId })
        });
        if (res.ok) {
          el.closest('div')?.parentElement?.remove();
          window.showToast('User removed');
        } else {
          console.error(await res.text());
      window.showToast(window.forgeMsg?.errGenerico || '', true);
        }
      });
    });
  });

  document.getElementById('btn-add-member')?.addEventListener('click', () => {
    document.getElementById('add-member-modal').showModal();
  });

  document.getElementById('btn-confirm-add')?.addEventListener('click', async (e) => {
    const wsId = e.currentTarget.getAttribute('data-ws-id');
    const username = document.getElementById('add-member-username').value;
    const role = document.getElementById('add-member-role').value;
    
    const res = await fetch(`/api/workspaces/${wsId}/members`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username, role })
    });
    if (res.ok) {
      window.showToast(`Invitation sent to ${username}!`);
      document.getElementById('add-member-username').value = '';
      document.getElementById('add-member-modal').close();
    } else {
      console.error(await res.text());
      window.showToast(window.forgeMsg?.errGenerico || '', true);
    }
  });

  // Danger
  const deleteInput = document.getElementById('delete-workspace-confirm-input');
  const deleteBtn = document.getElementById('btn-delete-workspace');
  document.getElementById('btn-delete-workspace-prompt')?.addEventListener('click', () => {
    document.getElementById('delete-workspace-modal').showModal();
  });
  deleteInput?.addEventListener('input', (e) => {
    if (e.target.value === deleteBtn.getAttribute('data-ws-name')) {
      deleteBtn.disabled = false;
      deleteBtn.classList.remove('bg-red-500/50', 'cursor-not-allowed');
      deleteBtn.classList.add('bg-red-500', 'hover:bg-red-600');
    } else {
      deleteBtn.disabled = true;
      deleteBtn.classList.add('bg-red-500/50', 'cursor-not-allowed');
      deleteBtn.classList.remove('bg-red-500', 'hover:bg-red-600');
    }
  });

  deleteBtn?.addEventListener('click', async (e) => {
    if (deleteBtn.disabled) return;
    const wsId = e.currentTarget.getAttribute('data-ws-id');
    const res = await fetch(`/api/workspaces/${wsId}`, { method: 'DELETE' });
    if (res.ok) {
      window.location.href = '/';
    } else {
      console.error(await res.text());
      window.showToast(window.forgeMsg?.errGenerico || '', true);
    }
  });

  // Audit Logs Filtering
  function filterAuditLogs() {
    const userFilter = document.getElementById('audit-filter-user').value.toLowerCase();
    const actionFilter = document.getElementById('audit-filter-action').value;
    const dateFilter = document.getElementById('audit-filter-date').value; // YYYY-MM-DD
    
    document.querySelectorAll('.audit-log-item').forEach(item => {
      const user = item.getAttribute('data-user') || '';
      const action = item.getAttribute('data-action') || '';
      const dateStr = item.getAttribute('data-date') || ''; // "M/D/YYYY" or similar depending on toLocaleString()
      
      let show = true;
      if (userFilter && !user.includes(userFilter)) show = false;
      if (actionFilter && action !== actionFilter) show = false;
      if (dateFilter) {
        const d = new Date(dateFilter);
        const logD = new Date(dateStr);
        if (d.toDateString() !== logD.toDateString()) show = false;
      }
      
      item.style.display = show ? 'flex' : 'none';
    });
  }
  
  document.getElementById('audit-filter-user')?.addEventListener('input', filterAuditLogs);
  document.getElementById('audit-filter-action')?.addEventListener('change', filterAuditLogs);
  document.getElementById('audit-filter-date')?.addEventListener('change', filterAuditLogs);
    // Automations
  document.getElementById('btn-add-automation')?.addEventListener('click', () => {
    document.getElementById('add-automation-modal').showModal();
  });

  document.getElementById('btn-save-automation')?.addEventListener('click', async (e) => {
    const wsId = e.currentTarget.getAttribute('data-ws-id');
    const name = document.getElementById('auto-name').value.trim();
    const toStatus = document.getElementById('auto-trigger-cond').value;
    const url = document.getElementById('auto-action-payload').value.trim();

    // Los ids que se leían aquí —`auto-trigger-type` y `auto-action-type`— no
    // existían: los `<select>` eran `auto-trigger` y `auto-action`. `null.value`
    // lanzaba una excepción y el manejador moría antes del fetch, así que el
    // botón «Guardar regla» no hacía absolutamente nada.
    if (!name) return window.showToast(autoNeedName, true);
    if (!url) return window.showToast(autoNeedUrl, true);

    // El JSON lo compone el cliente. Antes se pedía al usuario que lo
    // escribiera a mano en dos campos cuyos marcadores sugerían texto plano.
    const res = await fetch(`/api/automations`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        workspaceId: wsId,
        name,
        trigger_type: 'issue_status_changed',
        trigger_condition: JSON.stringify({ to_status: toStatus }),
        action_type: 'webhook',
        action_payload: JSON.stringify({ url }),
      })
    });

    if (res.ok) {
      window.location.reload();
    } else {
      console.error(await res.text());
      window.showToast(window.forgeMsg?.errGenerico || '', true);
    }
  });

  document.querySelectorAll('.btn-delete-automation').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const id = e.currentTarget.getAttribute('data-id');
      window.forgeConfirm(window.forgeMsg?.confirmarBorrarAutomatizacion || '', async () => {
        const res = await fetch(`/api/automations/${id}`, { method: 'DELETE' });
        if (res.ok) window.location.reload();
      });
    });
  });

  document.querySelectorAll('.toggle-automation-active').forEach(checkbox => {
    checkbox.addEventListener('change', async (e) => {
      const target = e.currentTarget;
      const id = target.getAttribute('data-id');
      const is_active = target.checked ? 1 : 0;
      await fetch(`/api/automations/${id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ is_active })
      });
    });
  });

</script>

<script>
  /**
   * Tipos de ticket del espacio.
   *
   * Mismo patrón que las etiquetas de arriba: se opera contra la API y se
   * recarga la página al terminar. Un tipo cambia el desplegable de nuevo
   * ticket, la insignia de cada tarjeta y el filtro, así que mantener todo eso
   * al día a mano desde aquí son cuatro sitios que se desincronizan.
   */
  (() => {
    const raiz = document.getElementById('tipos-ticket');
    if (!raiz) return;
    const sysTag = raiz.dataset.sysTag;
    const base = `/api/w/${sysTag}/issue-types`;

    const aviso = (msg: string, error = false) => (window as any).showToast?.(msg, error);
    const fallo = () => aviso(raiz.dataset.tError || '', true);

    // ── Alta ────────────────────────────────────────────────────────────────
    let colorElegido = '#0091FF';
    raiz.querySelectorAll<HTMLButtonElement>('.tipo-color-opt').forEach((b) => {
      if (b.getAttribute('aria-pressed') === 'true') colorElegido = b.dataset.color!;
      b.addEventListener('click', () => {
        raiz.querySelectorAll('.tipo-color-opt').forEach((o) => o.setAttribute('aria-pressed', 'false'));
        b.setAttribute('aria-pressed', 'true');
        colorElegido = b.dataset.color!;
      });
    });

    document.getElementById('form-nuevo-tipo')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById('tipo-nombre') as HTMLInputElement;
      const name = input.value.trim();
      if (!name) return;

      const res = await fetch(base, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, color: colorElegido }),
      });
      if (res.ok) { window.location.reload(); return; }
      const datos = await res.json().catch(() => null);
      // El servidor manda códigos, no frases: se traducen aquí.
      // `data-t-errnombre_vacio` llega como `tErrnombre_vacio`: los guiones bajos
      // no se camelizan, solo los guiones.
      aviso((raiz.dataset[`tErr${datos?.error_code}`] as string) || raiz.dataset.tError || '', true);
    });

    // ── Renombrar ───────────────────────────────────────────────────────────
    raiz.querySelectorAll('.btn-renombrar-tipo').forEach((b) => {
      b.addEventListener('click', async () => {
        const fila = b.closest('.fila-tipo') as HTMLElement;
        // Renombrar no toca la clave, así que ningún ticket cambia de tipo.
        const nuevo = window.prompt(raiz.dataset.tRename || '', fila.dataset.name || '');
        if (nuevo === null || nuevo.trim() === fila.dataset.name) return;

        const res = await fetch(`${base}/${fila.dataset.id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: nuevo.trim() }),
        });
        if (res.ok) window.location.reload();
        else fallo();
      });
    });

    // ── Baja ────────────────────────────────────────────────────────────────
    const modal = document.getElementById('tipo-borrar-modal') as HTMLDialogElement;
    const selectSustituto = document.getElementById('tipo-sustituto') as HTMLSelectElement;
    let enCurso: string | null = null;

    document.getElementById('tipo-borrar-cancelar')?.addEventListener('click', () => modal.close());

    document.getElementById('tipo-borrar-confirmar')?.addEventListener('click', async () => {
      if (!enCurso) return;
      const res = await fetch(`${base}/${enCurso}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ replacement: selectSustituto.value }),
      });
      if (res.ok) window.location.reload();
      else fallo();
    });

    raiz.querySelectorAll('.btn-borrar-tipo').forEach((b) => {
      b.addEventListener('click', async () => {
        const fila = b.closest('.fila-tipo') as HTMLElement;
        const id = fila.dataset.id!;

        // Se intenta y es el servidor quien dice si hay trabajo dentro: contar
        // aquí obligaría a traerse los tickets de todo el espacio.
        const res = await fetch(`${base}/${id}`, { method: 'DELETE' });
        if (res.ok) { window.location.reload(); return; }

        const datos = await res.json().catch(() => null);

        if (datos?.error_code === 'last_type') { aviso(raiz.dataset.tLast || '', true); return; }

        if (datos?.error_code === 'in_use') {
          enCurso = id;
          const lead = document.getElementById('tipo-borrar-lead')!;
          lead.textContent = (datos.in_use === 1
            ? raiz.dataset.tInUseOne || ''
            : (raiz.dataset.tInUse || '').replace('{n}', String(datos.in_use))
          ).replace('{tipo}', fila.dataset.name || '');

          selectSustituto.replaceChildren(...datos.candidates.map((c: any) => {
            const o = document.createElement('option');
            o.value = c.key;
            o.textContent = c.name;
            return o;
          }));
          modal.showModal();
          return;
        }
        fallo();
      });
    });
  })();
</script>
