---
import MainLayout from '../../../layouts/MainLayout.astro';
import KanbanBoard from '../../../components/jira/KanbanBoard.astro';
import db from '../../../lib/db';
import { checkWorkspaceAccess } from '../../../lib/guard';
import { useTranslations } from '../../../i18n/ui';
import { listar as listarEtiquetas } from '../../../lib/labels';
import { cargarTablero, cargarVista } from '../../../lib/tablero';
import { hoyEn, sumarDiasIso } from '../../../lib/fechas';
import { funciones } from '../../../lib/funcionesEspacio';
import { OPCIONES as OPCIONES_PRIORIDAD } from '../../../lib/prioridad';
import { listar as listarTipos, nombreVisible } from '../../../lib/issueTypes';
import { abrirEspacioDePagina } from '../../../lib/paginaEspacio';
import { listar as listarContactos } from '../../../lib/contactos';
import { PREFIJO_CONTACTO, valorDeContacto } from '../../../lib/responsables';

const { sys_tag } = Astro.params;
const user = Astro.locals.user!;
const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);

if (!user) return Astro.redirect('/login');

const acceso = abrirEspacioDePagina(sys_tag, user, 'viewer');
if (!acceso.ok) return Astro.redirect(acceso.redirigir);
const workspace = acceso.ws;

const funcs = funciones(workspace.id);

/**
 * El sprint que se mira, solo si el espacio usa sprints.
 *
 * Con la función apagada no hay selector, ni cookie, ni filtro: el tablero
 * enseña **todas** las tareas del espacio. Un `?sprint=` que llegue en un
 * enlace viejo se ignora en vez de dar 404.
 */
let activeSprintId: string | null = null;
let currentSprintObj: any = null;
let sprints: any[] = [];

if (funcs.sprints) {
  const requestedSprintId = Astro.url.searchParams.get('sprint');
  const savedSprint = Astro.cookies.get(`forge_last_sprint_${workspace.id}`)?.value;
  if (!Astro.url.search.includes('sprint=')) {
    if (savedSprint && savedSprint !== 'backlog') {
      return Astro.redirect(`/w/${sys_tag}/board?sprint=${savedSprint}`);
    }
  }

  // Sin sprint en la URL ni cookie, se abre el **sprint activo**, no el
  // backlog: en un espacio bien llevado el backlog está casi siempre vacío y
  // la primera visita mostraba «Tu tablero kanban está vacío».
  //
  // Solo cuando no hay elección previa. La cookie `backlog` no redirigía, pero
  // este bloque abría el sprint activo igualmente porque la URL seguía sin
  // `sprint=`: elegir el backlog nunca se recordaba.
  let defaultSprintId: string | null = null;
  if (!Astro.url.search.includes('sprint=') && savedSprint !== 'backlog') {
    const active = db
      .prepare("SELECT id FROM sprints WHERE workspace_id = ? AND status = 'active' ORDER BY rowid DESC LIMIT 1")
      .get(workspace.id) as { id: string } | undefined;
    if (active) defaultSprintId = active.id;
  }

  // IDOR: el sprint pedido tiene que ser de este espacio.
  if (requestedSprintId && requestedSprintId !== 'backlog') {
    const sprintCheck = db.prepare('SELECT workspace_id, status FROM sprints WHERE id = ?').get(requestedSprintId) as any;
    if (!sprintCheck || sprintCheck.workspace_id !== workspace.id) {
      return new Response('Sprint Not Found', { status: 404 });
    }
    activeSprintId = requestedSprintId;
    currentSprintObj = sprintCheck;
  } else if (defaultSprintId) {
    activeSprintId = defaultSprintId;
    currentSprintObj = db.prepare('SELECT workspace_id, status FROM sprints WHERE id = ?').get(defaultSprintId) as any;
  }

  sprints = db.prepare('SELECT id, name, status FROM sprints WHERE workspace_id = ? ORDER BY start_date DESC, rowid DESC').all(workspace.id) as any[];
}

/**
 * Filtro por etiqueta.
 *
 * Va en la consulta y no en el navegador porque el tablero no trae todas las
 * tarjetas: filtrar en pantalla buscaría dentro de las que llegaron y diría que
 * no hay más. Se comprueba que la etiqueta sea **de este espacio** antes de
 * usarla; si no lo es, se ignora en vez de fingir un tablero vacío.
 */
const etiquetaPedida = Astro.url.searchParams.get('label');
const etiquetaFiltro = etiquetaPedida
  ? (db.prepare('SELECT id, name, color FROM labels WHERE id = ? AND workspace_id = ?')
      .get(etiquetaPedida, workspace.id) as any) ?? null
  : null;

/**
 * Filtros de prioridad, «vence en N días» y responsable.
 *
 * Cada valor se valida: una prioridad de las cuatro, un número de días acotado
 * y una persona que **sea miembro de este espacio** (o `yo`). Lo que no vale se
 * ignora en vez de vaciar el tablero.
 */
const qp = Astro.url.searchParams;
const prioridadPedida = qp.get('prioridad');
const filtroPrioridad = (['highest', 'high', 'medium', 'low'] as const).find((p) => p === prioridadPedida) ?? null;
const venceDias = Number(qp.get('vence'));
const filtroVence = Number.isInteger(venceDias) && venceDias >= 1 && venceDias <= 60 ? venceDias : null;
const responsablePedido = qp.get('responsable');
// Tus contactos sin cuenta, para asignar y filtrar (`lib/contactos.ts`).
const contactos = user.is_guest ? [] : listarContactos(user.id).map((c) => ({ id: c.id, name: c.name }));
const filtroResponsable = responsablePedido === 'yo'
  ? user.id
  : responsablePedido?.startsWith(PREFIJO_CONTACTO)
    // Un contacto solo filtra si es tuyo: el id de uno ajeno no dice nada aquí.
    ? (contactos.some((c) => valorDeContacto(c.id) === responsablePedido) ? responsablePedido : null)
    : responsablePedido && db.prepare('SELECT 1 FROM workspace_members WHERE workspace_id = ? AND user_id = ?').get(workspace.id, responsablePedido)
      ? responsablePedido
      : null;

/** Un carril por etiqueta. En la URL, como el filtro: el enlace se puede pasar. */
const agrupar = Astro.url.searchParams.get('group') === 'label';

/**
 * La vista: el tablero de columnas, «Hoy» o «Próximos».
 *
 * Las dos últimas miran fechas y no columnas, en el día de **quien mira**
 * (`users.timezone`): el servidor corre en UTC.
 */
const vistaPedida = Astro.url.searchParams.get('vista');
const vista: 'tablero' | 'hoy' | 'proximos' = vistaPedida === 'hoy' || vistaPedida === 'proximos' ? vistaPedida : 'tablero';
const hoy = hoyEn(user.timezone);
const filtrosExtra = {
  prioridad: filtroPrioridad,
  vence: filtroVence ? { hoy, hasta: sumarDiasIso(hoy, filtroVence - 1) } : null,
  responsable: filtroResponsable,
};
const dias = Math.min(Math.max(Number(Astro.url.searchParams.get('dias')) || 14, 14), 84);
const grupos = vista === 'tablero' ? [] : cargarVista({
  workspaceId: workspace.id,
  userId: user.id,
  labelId: etiquetaFiltro?.id ?? null,
  ...filtrosExtra,
  vista,
  hoy,
  hasta: sumarDiasIso(hoy, dias - 1),
});

const { tarjetas: issues, conteos: statusCounts } = vista === 'tablero'
  ? cargarTablero({
      workspaceId: workspace.id,
      userId: user.id,
      sprintId: funcs.sprints ? activeSprintId : undefined,
      labelId: etiquetaFiltro?.id ?? null,
      agruparPorEtiqueta: agrupar,
      ...filtrosExtra,
    })
  : { tarjetas: [] as any[], conteos: {} as Record<string, number> };

/** Enlace a otra vista conservando el filtro de etiqueta. */
const enlaceVista = (v: string) => {
  const u = new URL(Astro.url);
  u.searchParams.delete('dias');
  u.searchParams.delete('group');
  if (v === 'tablero') u.searchParams.delete('vista'); else u.searchParams.set('vista', v);
  return `${u.pathname}${u.search}`;
};

const etiquetasDelEspacio = listarEtiquetas(workspace.id);
const tiposDelEspacio = listarTipos(workspace.id);

const workspaceMembers = db.prepare(`
  SELECT u.id, u.username
  FROM workspace_members wm
  JOIN users u ON wm.user_id = u.id
  WHERE wm.workspace_id = ?
`).all(workspace.id) as any[];

/**
 * Horas de lo que se está mirando: el sprint, el backlog o, sin sprints, todo.
 *
 * Solo con la medición de tiempo encendida; apagada, el bloque no se pinta.
 */
let totalLogged = 0;
let totalEstimated = 0;
if (funcs.tiempo) {
  const filtroSprint = !funcs.sprints ? '' : activeSprintId ? 'AND sprint_id = ?' : 'AND sprint_id IS NULL';
  const totales = db.prepare(`
    SELECT SUM(logged_hours) AS total_logged, SUM(estimated_hours) AS total_estimated
    FROM issues WHERE workspace_id = ? ${filtroSprint}
  `).get(...(funcs.sprints && activeSprintId ? [workspace.id, activeSprintId] : [workspace.id])) as any;
  // Redondeado: sumar fracciones de sesión en coma flotante da 11.032300000000001.
  const enHoras = (n: number) => parseFloat((n || 0).toFixed(2));
  totalLogged = enHoras(totales?.total_logged || 0);
  totalEstimated = enHoras(totales?.total_estimated || 0);
}
const metaDescription = `${workspace.name} board on Forge OS. Track issues, sprints, and tasks efficiently.`;
const puedeEditar = acceso.rol === 'owner' || acceso.rol === 'editor';


// El sprint que se mira, para la línea de datos bajo el título.
const sprintActual = funcs.sprints && activeSprintId ? (sprints.find((sp: any) => sp.id === activeSprintId) ?? null) : null;
---

<MainLayout hideFooter={true}
  title={`${t('nav.board')} - ${workspace.name}`} 
  workspaceId={workspace.id}
  description={metaDescription}
>
  <div class="h-full flex flex-col pt-4 overflow-hidden">
    {/*
      Cabecera del tablero (fase 1 del rediseño, docs/rediseno/tablero.html).

      El título en Archivo estrecho, entero —se parte en líneas, no se recorta—
      y debajo una línea de datos: el sprint que se mira y las horas, con su
      barra. En móvil el título se esconde: la barra superior ya dice dónde
      estás y aquí cuesta una fila entera.

      Debajo, la barra de herramientas en dos grupos con todos los controles a
      la misma altura: a la izquierda lo que cambia **qué** se ve (vista,
      sprint, etiqueta, filtros, carriles); a la derecha lo que **hace** algo
      (ordenar, acciones del sprint, nueva tarea).
    */}
    <header class="page-head !mb-3">
      <div class="min-w-0 max-sm:hidden">
        <h1 class="page-title">{workspace.name}</h1>
        {(sprintActual || funcs.tiempo) && (
          <div class="page-meta">
            {sprintActual && <span>{sprintActual.name}{sprintActual.status === 'active' ? ` · ${t('board.sprint_active_suffix').replace(/[()]/g, '').trim()}` : ''}</span>}
            {funcs.tiempo && (
              <span class="inline-flex items-center gap-2.5" id="sprint-time-container" data-t-no-estimate={t('dashboard.logged_no_estimate')} data-logged={totalLogged} data-estimated={totalEstimated}>
                <span class="barra w-28" aria-hidden="true">
                  <span id="sprint-time-bar" class:list={['block h-full rounded-full', totalEstimated > 0 && totalLogged / totalEstimated > 1 ? 'bg-forge-error' : 'bg-forge-text']} style={`width: ${totalEstimated > 0 ? Math.min((totalLogged / totalEstimated) * 100, 100) : 0}%`}></span>
                </span>
                <span id="sprint-time-text">
                  {totalEstimated > 0
                    ? `${totalLogged}h / ${totalEstimated}h`
                    : t('dashboard.logged_no_estimate').replace('{h}', String(totalLogged))}
                </span>
              </span>
            )}
          </div>
        )}
      </div>
    </header>

    <div class="barra-herramientas max-sm:!justify-start">
      <div class="grupo-herramientas max-sm:contents">
        {/* La vista: enlaces con `aria-current`, no pestañas que fingen serlo. */}
        <nav aria-label={t('view.switcher')} class="segmentado max-sm:w-full max-sm:[&>a]:flex-1">
          {([['tablero', t('view.board')], ['hoy', t('view.today')], ['proximos', t('view.upcoming')]] as const).map(([v, texto]) => (
            <a href={enlaceVista(v)} aria-current={vista === v ? 'page' : undefined}>{texto}</a>
          ))}
        </nav>

        {vista === 'tablero' && funcs.sprints && (
          <select id="sprint-selector" aria-label={t('a11y.sprint_selector')} class="campo campo-inline max-w-[16rem]">
            <option value="backlog" selected={!activeSprintId}>{t('board.backlog')}</option>
            {sprints.map(s => (
              <option value={s.id} selected={activeSprintId === s.id}>{s.name} {s.status === 'active' ? t('board.sprint_active_suffix') : s.status === 'completed' ? t('board.sprint_completed_suffix') : ''}</option>
            ))}
          </select>
        )}

        {/* Filtro por etiqueta. Solo aparece si hay etiquetas: un desplegable
            con una única opción vacía es ruido. */}
        {etiquetasDelEspacio.length > 0 && (
          <select id="label-filter" aria-label={t('labels.filter')} class="campo campo-inline max-w-[14rem]">
            <option value="">{t('labels.filter_all')}</option>
            {etiquetasDelEspacio.map((e: any) => (
              <option value={e.id} selected={etiquetaFiltro?.id === e.id}>{e.name}</option>
            ))}
          </select>
        )}

        {/* Más filtros y guardar la vista, en un desplegable. */}
        <details class="relative" id="filtros-tablero" data-sys-tag={sys_tag}
          data-t-saved={t('views.saved')} data-t-error={t('views.error')}>
          <summary class="btn btn-secondary list-none [&::-webkit-details-marker]:hidden" aria-pressed={(filtroPrioridad || filtroVence || responsablePedido) ? 'true' : 'false'}>
            {t('filters.button')}
          </summary>
          <div class="menu menu-sprint absolute sm:left-0 top-full mt-1.5 w-72 z-50 !p-3 space-y-3">
            <label class="field">
              <span class="field-label">{t('priority.label')}</span>
              <select id="filtro-prioridad" data-param="prioridad" class="filtro-param campo">
                <option value="">{t('filters.priority_any')}</option>
                {OPCIONES_PRIORIDAD.map((p) => (
                  <option value={p.valor} selected={filtroPrioridad === p.valor}>{t(`priority.${p.nivel}`)}</option>
                ))}
              </select>
            </label>
            <label class="field">
              <span class="field-label">{t('filters.due')}</span>
              <select id="filtro-vence" data-param="vence" class="filtro-param campo">
                <option value="">{t('filters.due_any')}</option>
                {[3, 7, 14, 30].map((n) => <option value={n} selected={filtroVence === n}>{t('filters.due_days').replace('{n}', String(n))}</option>)}
              </select>
            </label>
            <label class="field">
              <span class="field-label">{t('filters.assignee')}</span>
              <select id="filtro-responsable" data-param="responsable" class="filtro-param campo">
                <option value="">{t('filters.assignee_any')}</option>
                <option value="yo" selected={responsablePedido === 'yo'}>{t('filters.me')}</option>
                {workspaceMembers.filter((m) => m.id !== user.id).map((m) => <option value={m.id} selected={responsablePedido === m.id}>{m.username}</option>)}
                {contactos.length > 0 && (
                  <optgroup label={t('contacts.title')}>
                    {contactos.map((c) => <option value={valorDeContacto(c.id)} selected={responsablePedido === valorDeContacto(c.id)}>{c.name}</option>)}
                  </optgroup>
                )}
              </select>
            </label>
            <div class="border-t border-forge-border pt-3 field">
              <label class="field-label" for="vista-nombre">{t('views.save_label')}</label>
              <div class="flex gap-1.5">
                <input id="vista-nombre" type="text" maxlength="40" class="campo flex-1 min-w-0" />
                <button type="button" id="btn-guardar-vista" class="btn btn-primary shrink-0">{t('views.save')}</button>
              </div>
            </div>
          </div>
        </details>

        {/* Un carril por etiqueta: con una etiqueta por asignatura, cada
            asignatura con sus cuatro columnas. */}
        {vista === 'tablero' && etiquetasDelEspacio.length > 0 && (
          <button type="button" id="btn-group-label" aria-pressed={agrupar ? 'true' : 'false'} class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/></svg>
            {t('board.group_label')}
          </button>
        )}
      </div>

      <div class="grupo-herramientas max-sm:contents">
        {/*
          Ordenar es una **acción**, no una vista: reescribe el orden de cada
          columna una vez —con «Deshacer»— y se puede seguir arrastrando a
          partir de ahí. «Hecho» no se toca: va siempre por cuándo se terminó.
        */}
        {vista === 'tablero' && puedeEditar && (
          <div class="relative" id="sort-menu-root">
            <button id="btn-sort-menu" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="sort-menu" class="btn btn-secondary">
              {t('board.sort_action')}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div id="sort-menu" role="menu" class="hidden menu menu-sprint absolute sm:right-0 top-full mt-1.5 min-w-[13rem] z-50"
              data-t-done={t('board.sorted_by')}
              data-t-undo={t('board.undo')}
              data-t-undone={t('board.sort_undone')}
              data-t-error={t('board.sort_error')}>
              {[
                ['priority', t('board.sort_priority')],
                ['due', t('board.sort_due')],
                ['title', t('board.sort_title')],
                ['created', t('board.sort_created')],
                ...(funcs.puntos ? [['points', t('board.sort_points')]] : []),
              ].map(([clave, texto]) => (
                <button type="button" role="menuitem" class="sprint-menu-item menu-item orden-item" data-orden={clave}>{texto}</button>
              ))}
            </div>
          </div>
        )}

        {/* Las acciones del sprint, en un menú: se usan una vez cada mucho, no
            en cada visita. Lo que se usa a diario se queda fuera. */}
        {vista === 'tablero' && funcs.sprints && acceso.rol !== 'viewer' && (
          <div class="relative" id="sprint-menu-root">
            <button id="btn-sprint-menu" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="sprint-menu" class="btn btn-secondary">
              {t('board.sprint_actions')}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>

            <div id="sprint-menu" role="menu" class="hidden menu menu-sprint absolute sm:right-0 top-full mt-1.5 min-w-[13rem] z-50">
              {(acceso.rol === 'owner' || acceso.rol === 'editor') && (
                <>
                  <button type="button" role="menuitem" id="btn-new-sprint" class="sprint-menu-item menu-item">
                    {t('board.create_sprint')}
                  </button>
                  {acceso.rol === 'owner' && sprints.length > 0 && (
                    <button type="button" role="menuitem" id="btn-manage-sprints" class="sprint-menu-item menu-item">
                      {t('sprint.manage')}
                    </button>
                  )}
                  <div class="menu-sep"></div>
                </>
              )}

              {/* Lo que sigue solo tiene sentido con un sprint delante: en el
                  backlog no hay nada que completar ni que borrar. */}
              {activeSprintId && currentSprintObj && (
                <>
                  <button type="button" role="menuitem" id="btn-toggle-sprint" data-sprint-id={activeSprintId} data-current-status={currentSprintObj.status} class="sprint-menu-item menu-item">
                    {currentSprintObj.status === 'planned' ? t('board.sprint_start') : currentSprintObj.status === 'active' ? t('board.sprint_complete') : t('board.sprint_reopen')}
                  </button>

                  {currentSprintObj.status === 'active' && (
                    <button type="button" role="menuitem" id="btn-deactivate-sprint" data-sprint-id={activeSprintId} class="sprint-menu-item menu-item">
                      {t('board.deactivate')}
                    </button>
                  )}

                  {acceso.rol === 'owner' && (
                    <>
                      <div class="menu-sep"></div>
                      {/* Borrar reorganiza el trabajo de todo el equipo, así que
                          es de dueños. Los tickets no se van con él. */}
                      <button type="button" role="menuitem" id="btn-delete-sprint" data-sprint-id={activeSprintId} class="sprint-menu-item menu-item !text-forge-error">
                        {t('board.delete_sprint')}
                      </button>
                    </>
                  )}
                </>
              )}
            </div>
          </div>
        )}

        {acceso.rol !== 'viewer' && (
          <button id="btn-new-issue" type="button" title={t('board.new_issue_hint')} class="btn btn-primary max-sm:flex-1">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            {t('board.new_issue')}
            {/* El atajo solo donde hay teclado. */}
            <kbd class="max-sm:hidden" aria-hidden="true">C</kbd>
          </button>
        )}
      </div>
    </div>

    <div class="flex-1 overflow-hidden">
      <!-- Pass sprints to KanbanBoard so IssueDetailsModal can use it -->
      <KanbanBoard workspaceId={workspace.id} issues={issues} sprints={sprints} currentSprintId={activeSprintId} workspaceMembers={workspaceMembers} contactos={contactos} userRole={acceso.rol} statusCounts={statusCounts} labels={etiquetasDelEspacio} issueTypes={tiposDelEspacio} sysTag={sys_tag} funciones={funcs} agrupar={agrupar} filtroEtiqueta={etiquetaFiltro?.id ?? null} filtrosUrl={new URLSearchParams(Object.entries({ prioridad: filtroPrioridad ?? '', vence: filtroVence ? String(filtroVence) : '', responsable: responsablePedido && filtroResponsable ? responsablePedido : '' }).filter(([, v]) => v)).toString()} vista={vista} grupos={grupos} hoy={hoy} dias={dias} />
    </div>
  </div>

  {/* Gestionar sprints: la lista, con borrar en cada uno. */}
  {funcs.sprints && acceso.rol === 'owner' && (
    <dialog id="gestionar-sprints" aria-labelledby="gestionar-sprints-titulo" class="ventana !max-w-[28rem]">
      <h2 id="gestionar-sprints-titulo" class="ventana-titulo">{t('sprint.manage_title')}</h2>
      <ul class="space-y-2">
        {sprints.map((sp) => (
          <li class="flex items-center justify-between gap-3 border-b border-forge-border last:border-b-0 py-2">
            <span class="min-w-0 truncate text-sm">{sp.name} <span class="text-forge-muted">{sp.status === 'active' ? t('board.sprint_active_suffix') : sp.status === 'completed' ? t('board.sprint_completed_suffix') : ''}</span></span>
            <button type="button" class="btn-borrar-sprint btn btn-ghost btn-sm !text-forge-error shrink-0" data-sprint-id={sp.id}
              aria-label={t('sprint.delete_named').replace('{nombre}', sp.name)}>{t('board.delete_sprint')}</button>
          </li>
        ))}
      </ul>
      <div class="ventana-pie">
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('gestionar-sprints').close()">{t('common.close')}</button>
      </div>
    </dialog>

    <dialog id="borrar-sprint-modal" aria-labelledby="borrar-sprint-titulo"
      data-t-backlog={t('sprint.delete_to_backlog')}
      data-t-to-sprint={t('sprint.delete_to_sprint')}
      data-t-discard={t('sprint.delete_discard')}
      data-t-target-for={t('sprint.delete_target_for')}
      data-t-summary={t('sprint.delete_summary')}
      data-t-confirm={t('sprint.delete_confirm')}
      data-t-confirm-danger={t('sprint.delete_confirm_danger')}
      data-t-error={t('sprint.err_delete')}
      class="ventana !max-w-[35rem] max-h-[85vh] flex-col open:flex">
      <h2 id="borrar-sprint-titulo" class="ventana-titulo !mb-1">{t('sprint.delete_title')}</h2>
      <p class="text-sm text-forge-muted mb-4">{t('sprint.delete_lead')}</p>
      <div class="flex items-center justify-between gap-3 mb-3">
        <label class="field-label" for="borrar-sprint-todas">{t('sprint.delete_all')}</label>
        <select id="borrar-sprint-todas" class="campo campo-inline"></select>
      </div>
      <ul id="borrar-sprint-lista" class="space-y-2 overflow-y-auto flex-1 min-h-0 pr-1"></ul>
      <p id="borrar-sprint-resumen" class="text-sm text-forge-muted mt-4" aria-live="polite"></p>
      <div class="ventana-pie">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('borrar-sprint-modal').close()">{t('modal.cancel')}</button>
        <button type="button" id="borrar-sprint-confirmar" class="btn btn-primary"></button>
      </div>
    </dialog>
  )}

  <!-- New Sprint Modal -->
  <dialog id="new-sprint-modal" data-t-name-required={t('board.sprint_name_required')} class="ventana">
    <h2 class="ventana-titulo">{t('board.create_sprint')}</h2>
    <div class="mb-4">
      <label class="block field-label mb-1.5" for="sprint-name">{t('board.sprint_name')}</label>
      <input type="text" id="sprint-name" class="campo" placeholder={t('board.sprint_name_ph')}>
    </div>
    <div class="ventana-pie">
      <button type="button" class="btn btn-ghost" onclick="document.getElementById('new-sprint-modal').close()">{t('modal.cancel')}</button>
      <button type="button" id="btn-save-sprint" class="btn btn-primary">{t('modal.create')}</button>
    </div>
  </dialog>

  {/* Cerrar un sprint con trabajo dentro.
      El servidor ya se negaba a cerrarlo en silencio y devolvía las tres
      salidas posibles, pero nadie las enseñaba: la respuesta llegaba al tablero
      y se pintaba el JSON crudo en un aviso. Esto es esa pregunta, hecha. */}
  <dialog id="close-sprint-modal"
    data-t-pending={t('sprint.close_pending')}
    data-t-pending-one={t('sprint.close_pending_one')}
    data-t-clean={t('sprint.close_clean')}
    data-t-reopen={t('sprint.reopen_confirm')}
    data-t-deactivate={t('sprint.deactivate_confirm')}
    data-t-err-deactivate={t('sprint.err_deactivate')}
    data-t-err-create={t('issue.err_create')}
    data-t-err-title={t('issue.err_title')}
    data-t-creating={t('issue.creating')}
    data-t-err-delete={t('sprint.err_delete')}
    data-t-err={t('sprint.err_close')}
    data-t-no-target={t('sprint.err_no_target')}
    class="ventana !max-w-[30rem]">
    <h2 class="ventana-titulo !mb-1">{t('sprint.close_title')}</h2>
    <p id="close-sprint-lead" class="text-sm text-forge-muted mb-5"></p>

    <div class="space-y-2">
      {[
        { v: 'backlog', t: t('sprint.close_backlog'), d: t('sprint.close_backlog_desc') },
        { v: 'next', t: t('sprint.close_next'), d: t('sprint.close_next_desc') },
        { v: 'keep', t: t('sprint.close_keep'), d: t('sprint.close_keep_desc') },
      ].map((o, i) => (
        <label class="flex gap-3 items-start border border-forge-border rounded-[14px] p-3 cursor-pointer hover:border-forge-border-strong has-[:checked]:border-forge-text has-[:checked]:bg-forge-surface-2">
          <input type="radio" name="close-strategy" value={o.v} checked={i === 0} class="mt-1 accent-forge-primary shrink-0">
          <span class="min-w-0">
            <span class="block text-sm font-bold text-forge-text">{o.t}</span>
            <span class="block text-xs text-forge-muted mt-0.5 leading-relaxed">{o.d}</span>
          </span>
        </label>
      ))}
    </div>

    <div id="close-sprint-target-wrap" class="hidden mt-4">
      <label class="block field-label mb-1.5" for="close-sprint-target">{t('sprint.close_target')}</label>
      <select id="close-sprint-target" class="campo">
        {sprints.filter((sp: any) => sp.status !== 'completed').map((sp: any) => (
          <option value={sp.id} data-current={sp.id === activeSprintId ? 'true' : 'false'}>{sp.name}</option>
        ))}
      </select>
    </div>

    <div class="ventana-pie">
      <button type="button" class="btn btn-ghost" onclick="document.getElementById('close-sprint-modal').close()">{t('sprint.close_cancel')}</button>
      <button type="button" id="btn-close-sprint-confirm" class="btn btn-primary">{t('sprint.close_confirm')}</button>
    </div>
  </dialog>


  <script>
    const workspaceId = document.querySelector('.kanban-container')?.getAttribute('data-workspace') || 'default';

    // Recordar el sprint elegido, solo si el espacio usa sprints: sin selector
    // no hay nada que recordar, y una cookie de sprint en un espacio sin
    // sprints redirigiría a un `?sprint=` que ya no significa nada.
    const selector = document.getElementById('sprint-selector') as HTMLSelectElement | null;
    if (selector) {
      const sprintToSave = new URLSearchParams(window.location.search).get('sprint') || 'backlog';
      try { localStorage.setItem(`forge_last_sprint_${workspaceId}`, sprintToSave); } catch { /* sin almacenamiento */ }
      document.cookie = `forge_last_sprint_${workspaceId}=${sprintToSave}; path=/; max-age=31536000`;
    }
    selector?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      try { localStorage.setItem(`forge_last_sprint_${workspaceId}`, val); } catch { /* sin almacenamiento */ }
      const url = new URL(window.location.href);
      // `?sprint=backlog` explícito, **no** quitar el parámetro.
      //
      // Sin parámetro, el servidor entiende «no ha elegido» y aplica la cookie
      // del último sprint, así que devolvía al sprint del que se acababa de
      // salir. Elegir «Backlog» no llevaba a ninguna parte y no había forma de
      // volver a él.
      url.searchParams.set('sprint', val);
      window.location.href = url.toString();
    });

    // FILTRO POR ETIQUETA
    //
    // Va en la URL y no en `localStorage`: así el enlace de «solo Parcial 2»
    // se puede pegar en un mensaje y le abre a otro lo mismo que estás viendo.
    // Y a diferencia del sprint, no se recuerda entre visitas: un filtro
    // pegajoso hace creer que el tablero se ha vaciado.
    // Agrupar por etiqueta: en la URL como el filtro, y sin recordarse.
    document.getElementById('btn-group-label')?.addEventListener('click', (e) => {
      const activo = (e.currentTarget as HTMLElement).getAttribute('aria-pressed') === 'true';
      const url = new URL(window.location.href);
      if (activo) url.searchParams.delete('group');
      else url.searchParams.set('group', 'label');
      window.location.href = url.toString();
    });

    // Filtros de prioridad, vencimiento y responsable: en la URL, como el de
    // etiqueta, para que se puedan pasar y guardar.
    document.querySelectorAll<HTMLSelectElement>('.filtro-param').forEach((sel) => {
      sel.addEventListener('change', () => {
        const url = new URL(window.location.href);
        if (sel.value) url.searchParams.set(sel.dataset.param!, sel.value);
        else url.searchParams.delete(sel.dataset.param!);
        window.location.href = url.toString();
      });
    });

    /**
     * Guardar la vista: los parámetros de la URL actual, con nombre. El
     * servidor se queda solo con los que reconoce.
     */
    document.getElementById('btn-guardar-vista')?.addEventListener('click', async () => {
      const raiz = document.getElementById('filtros-tablero')!;
      const nombre = (document.getElementById('vista-nombre') as HTMLInputElement).value.trim();
      if (!nombre) { (document.getElementById('vista-nombre') as HTMLInputElement).focus(); return; }
      const p = new URLSearchParams(window.location.search);
      const query: Record<string, string | number> = {};
      for (const clave of ['vista', 'label', 'group', 'prioridad', 'vence', 'responsable']) {
        const v = p.get(clave);
        if (v) query[clave] = clave === 'vence' ? Number(v) : v;
      }
      const res = await fetch(`/api/w/${raiz.dataset.sysTag}/views`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: nombre, query }),
      }).catch(() => null);
      if (res?.ok) { window.showToast?.(raiz.dataset.tSaved || ''); window.location.reload(); }
      else window.showToast?.(raiz.dataset.tError || '', true);
    });

    const filtroEtiqueta = document.getElementById('label-filter') as HTMLSelectElement | null;
    filtroEtiqueta?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      const url = new URL(window.location.href);
      if (val) url.searchParams.set('label', val);
      else url.searchParams.delete('label');
      window.location.href = url.toString();
    });

    // NEW SPRINT MODAL
    const newSprintBtn = document.getElementById('btn-new-sprint');
    const sprintModal = document.getElementById('new-sprint-modal') as HTMLDialogElement;
    const saveSprintBtn = document.getElementById('btn-save-sprint');

    newSprintBtn?.addEventListener('click', () => sprintModal?.showModal());

    saveSprintBtn?.addEventListener('click', async () => {
      const name = (document.getElementById('sprint-name') as HTMLInputElement).value;
      if (!name) return window.showToast?.(sprintModal?.dataset.tNameRequired || '', 'error');
      
      const res = await fetch('/api/sprints', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, workspaceId })
      });
      
      if (res.ok) {
        const data = await res.json();
        const url = new URL(window.location.href);
        url.searchParams.set('sprint', data.id);
        window.location.href = url.toString();
      } else {
        console.error('API Error: ', await res.text());
      }
    });

    /**
     * El menú de acciones del sprint.
     *
     * Mismo comportamiento que el de la cuenta: cierra al pulsar fuera y con
     * Escape, devolviendo el foco. Sin lo segundo, quien navega con teclado
     * queda atrapado dentro de un menú abierto.
     */
    function menuDesplegable(idBoton: string, idMenu: string) {
      const boton = document.getElementById(idBoton);
      const menu = document.getElementById(idMenu);
      if (!boton || !menu) return;

      const cerrar = () => {
        menu.classList.add('hidden');
        boton.setAttribute('aria-expanded', 'false');
      };

      boton.addEventListener('click', (e) => {
        e.stopPropagation();
        const abierto = !menu.classList.contains('hidden');
        menu.classList.toggle('hidden', abierto);
        boton.setAttribute('aria-expanded', String(!abierto));
      });

      document.addEventListener('click', (e) => {
        if (!menu.contains(e.target as Node)) cerrar();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
          cerrar();
          boton.focus();
        }
      });
      // Al elegir una acción el menú sobra: lo que sigue es un diálogo.
      menu.addEventListener('click', () => cerrar());
    }
    menuDesplegable('btn-sprint-menu', 'sprint-menu');
    menuDesplegable('btn-sort-menu', 'sort-menu');

    /**
     * Ordenar: reescribe el orden de las columnas de trabajo y ofrece deshacer.
     *
     * Tras ordenar hay que recargar —las tarjetas cambian de sitio en tres
     * columnas—, así que lo necesario para deshacer se guarda en
     * `sessionStorage` y el aviso con «Deshacer» sale ya en la página nueva.
     */
    (() => {
      const menu = document.getElementById('sort-menu');
      if (!menu) return;
      const sysTag = window.location.pathname.split('/')[2];
      const CLAVE = `forge_reorden_${sysTag}`;
      // El ámbito es lo que se está viendo: el sprint que pintó el servidor
      // (que puede venir de la cookie, no de la URL) y la etiqueta filtrada.
      const tablero = document.querySelector<HTMLElement>('.kanban-container');
      const ambito = { label: tablero?.dataset.label || null, sprint: tablero?.dataset.sprint || null };

      menu.querySelectorAll<HTMLButtonElement>('.orden-item').forEach((item) => {
        item.addEventListener('click', async () => {
          try {
            const res = await fetch(`/api/w/${sysTag}/board/reorder`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ by: item.dataset.orden, ...ambito }),
            });
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const { previo } = await res.json();
            try {
              sessionStorage.setItem(CLAVE, JSON.stringify({ previo, nombre: item.textContent?.trim() || '' }));
            } catch { /* sin almacenamiento: se ordena igual, sin deshacer */ }
            window.location.reload();
          } catch (e) {
            console.error('ordenar:', e);
            window.showToast?.(menu.dataset.tError || '', true);
          }
        });
      });

      let pendiente: { previo: Array<{ id: string; position: number }>; nombre: string } | null = null;
      try {
        pendiente = JSON.parse(sessionStorage.getItem(CLAVE) || 'null');
        sessionStorage.removeItem(CLAVE);
      } catch { pendiente = null; }
      if (pendiente?.previo?.length) {
        const datos = pendiente;
        window.showToast?.((menu.dataset.tDone || '').replace('{orden}', datos.nombre.toLowerCase()), false, {
          accion: menu.dataset.tUndo || '',
          alPulsar: async () => {
            const res = await fetch(`/api/w/${sysTag}/board/reorder`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ previo: datos.previo }),
            });
            if (res.ok) window.location.reload();
            else window.showToast?.(menu.dataset.tError || '', true);
          },
        });
      }
    })();

    const dialogoCierre = document.getElementById('close-sprint-modal') as HTMLDialogElement | null;
    const destinoWrap = document.getElementById('close-sprint-target-wrap');
    const destinoSel = document.getElementById('close-sprint-target') as HTMLSelectElement | null;

    // «A qué sprint» solo tiene sentido con la opción de moverlas elegida.
    dialogoCierre?.querySelectorAll<HTMLInputElement>('input[name="close-strategy"]').forEach((r) => {
      r.addEventListener('change', () => {
        destinoWrap?.classList.toggle('hidden', r.value !== 'next' || !r.checked);
      });
    });

    function abrirDialogoCierre(
      pendientes: number,
      enviar: (c: Record<string, unknown>) => Promise<Response>,
      borrando = false
    ) {
      if (!dialogoCierre) return;
      const lead = document.getElementById('close-sprint-lead');
      const plantilla = pendientes === 1
        ? dialogoCierre.getAttribute('data-t-pending-one') || ''
        : (dialogoCierre.getAttribute('data-t-pending') || '').replace('{n}', String(pendientes));
      if (lead) lead.textContent = plantilla;

      // El sprint que se está cerrando no puede ser su propio destino.
      let hayDestino = false;
      destinoSel?.querySelectorAll('option').forEach((o) => {
        const esActual = o.getAttribute('data-current') === 'true';
        o.hidden = esActual;
        o.disabled = esActual;
        if (!esActual) hayDestino = true;
      });
      if (destinoSel && hayDestino && destinoSel.selectedOptions[0]?.disabled) {
        const libre = Array.from(destinoSel.options).find((o) => !o.disabled);
        if (libre) destinoSel.value = libre.value;
      }
      /**
       * Al borrar, «dejarlas aquí» no es una opción.
       *
       * Cerrando un sprint tiene sentido: los tickets se quedan dentro de un
       * sprint terminado. Borrándolo no existe ese dentro, así que ofrecerlo
       * sería ofrecer perderlos.
       */
      const filaKeep = dialogoCierre.querySelector<HTMLInputElement>('input[value="keep"]')?.closest('label');
      if (filaKeep) filaKeep.classList.toggle('hidden', borrando);
      if (borrando && dialogoCierre.querySelector<HTMLInputElement>('input[value="keep"]')?.checked) {
        dialogoCierre.querySelector<HTMLInputElement>('input[value="backlog"]')!.checked = true;
      }

      // Sin otro sprint al que pasarlas, la opción no se ofrece.
      const radioNext = dialogoCierre.querySelector<HTMLInputElement>('input[value="next"]');
      const filaNext = radioNext?.closest('label');
      if (filaNext) filaNext.classList.toggle('hidden', !hayDestino);
      if (!hayDestino && radioNext?.checked) {
        dialogoCierre.querySelector<HTMLInputElement>('input[value="backlog"]')!.checked = true;
        destinoWrap?.classList.add('hidden');
      }

      const confirmar = document.getElementById('btn-close-sprint-confirm');
      const alPulsar = async () => {
        const elegida = dialogoCierre.querySelector<HTMLInputElement>('input[name="close-strategy"]:checked')?.value || 'backlog';
        const cuerpo: Record<string, unknown> = { strategy: elegida };
        if (elegida === 'next') {
          if (!destinoSel?.value) {
            // @ts-ignore
            window.showToast(dialogoCierre.getAttribute('data-t-no-target') || '', 'error');
            return;
          }
          cuerpo.target_sprint_id = destinoSel.value;
        }
        const r = await enviar(cuerpo);
        if (r.ok) { window.location.reload(); return; }
        // @ts-ignore
        window.showToast(dialogoCierre.getAttribute('data-t-err') || '', 'error');
      };
      confirmar?.addEventListener('click', alPulsar, { once: true });
      dialogoCierre.addEventListener('close', () => confirmar?.removeEventListener('click', alPulsar), { once: true });
      dialogoCierre.showModal();
    }

    // SPRINT TOGGLE (START/COMPLETE/REOPEN)
    const toggleSprintBtn = document.getElementById('btn-toggle-sprint');
    toggleSprintBtn?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLElement;
      const sprintId = btn.getAttribute('data-sprint-id');
      const currentStatus = btn.getAttribute('data-current-status');
      
      let newStatus = 'active';
      if (currentStatus === 'active') newStatus = 'completed';
      if (currentStatus === 'completed') newStatus = 'active'; // Allow reopening if they are looking at a completed sprint

      const cerrar = (cuerpo: Record<string, unknown>) =>
        fetch(`/api/sprints/${sprintId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: newStatus, ...cuerpo })
        });

      // Reabrir o arrancar no arrastra nada: se pregunta y ya.
      if (newStatus !== 'completed') {
        // @ts-ignore
        window.forgeConfirm(dialogoCierre?.getAttribute('data-t-reopen') || '', async () => {
          const res = await cerrar({});
          if (res.ok) window.location.reload();
          // @ts-ignore
          else window.showToast(dialogoCierre?.getAttribute('data-t-err') || '', 'error');
        });
        return;
      }

      // Cerrar sí: puede haber trabajo sin terminar dentro.
      //
      // Quién cuenta las tareas pendientes importa. Antes las contaba esta
      // página mirando las tarjetas dibujadas, y el tablero solo trae cien por
      // columna: con un sprint grande decía «hay 100» cuando había 743, o «no
      // queda nada» estando en el backlog. Ahora se intenta cerrar y es el
      // servidor —que las cuenta todas— quien responde cuántas quedan.
      const res = await cerrar({});
      if (res.ok) { window.location.reload(); return; }

      let datos: any = null;
      try { datos = await res.clone().json(); } catch { /* no era JSON */ }

      if (res.status === 409 && datos?.error_code === 'unfinished_issues') {
        abrirDialogoCierre(datos.pending, cerrar);
        return;
      }

      // @ts-ignore
      window.showToast(dialogoCierre?.getAttribute('data-t-err') || '', 'error');
    });

    /**
     * Borrar un sprint, decidiendo tarea por tarea.
     *
     * Sin tareas dentro se borra sin preguntar. Con tareas, el servidor
     * responde con la lista y aquí se elige qué pasa con cada una: al backlog,
     * a otro sprint o borrarla. «Borrar» nunca es lo que viene marcado: perder
     * trabajo tiene que ser una decisión, no un descuido al pulsar «aceptar».
     */
    async function borrarSprint(sprintId: string) {
      const enviar = (cuerpo: Record<string, unknown>) => fetch(`/api/sprints/${sprintId}`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(cuerpo),
      });
      const fin = () => { window.location.href = window.location.pathname + '?sprint=backlog'; };

      const res = await enviar({});
      if (res.ok) { fin(); return; }
      let datos: any = null;
      try { datos = await res.clone().json(); } catch { /* no era JSON */ }
      const dlg = document.getElementById('borrar-sprint-modal') as HTMLDialogElement | null;
      if (!(res.status === 409 && datos?.error_code === 'sprint_not_empty' && dlg)) {
        window.showToast?.(dialogoCierre?.getAttribute('data-t-err-delete') || '', 'error');
        return;
      }

      const t = dlg.dataset;
      const opciones: Array<[string, string]> = [
        ['backlog', t.tBacklog || ''],
        ...(datos.candidates as Array<{ id: string; name: string }>).map((c): [string, string] => [c.id, (t.tToSprint || '').replace('{nombre}', c.name)]),
        ['borrar', t.tDiscard || ''],
      ];
      const rellenar = (sel: HTMLSelectElement) => {
        sel.replaceChildren(...opciones.map(([v, texto]) => new Option(texto, v)));
        sel.value = 'backlog';
      };
      const lista = document.getElementById('borrar-sprint-lista')!;
      const todas = document.getElementById('borrar-sprint-todas') as HTMLSelectElement;
      const resumen = document.getElementById('borrar-sprint-resumen')!;
      const confirmar = document.getElementById('borrar-sprint-confirmar') as HTMLButtonElement;
      rellenar(todas);

      // Un desplegable por tarea, con `aria-label` y no `id` fijo: se repiten.
      lista.replaceChildren(...(datos.issues as Array<{ id: string; title: string }>).map((tarea) => {
        const li = document.createElement('li');
        li.className = 'flex items-center justify-between gap-3 border-b border-forge-border last:border-b-0 py-2';
        const nombre = document.createElement('span');
        nombre.className = 'min-w-0 truncate text-sm';
        nombre.textContent = tarea.title;
        const sel = document.createElement('select');
        sel.className = 'destino-tarea campo campo-inline shrink-0 max-w-[45%]';
        sel.dataset.issueId = tarea.id;
        sel.setAttribute('aria-label', (t.tTargetFor || '').replace('{titulo}', tarea.title));
        rellenar(sel);
        li.append(nombre, sel);
        return li;
      }));

      const actualizar = () => {
        const sels = Array.from(lista.querySelectorAll<HTMLSelectElement>('.destino-tarea'));
        const borrar = sels.filter((s) => s.value === 'borrar').length;
        resumen.textContent = (t.tSummary || '').replace('{mover}', String(sels.length - borrar)).replace('{borrar}', String(borrar));
        confirmar.textContent = borrar > 0 ? (t.tConfirmDanger || '').replace('{n}', String(borrar)) : (t.tConfirm || '');
        // Rojo solo cuando de verdad se va a perder algo.
        confirmar.classList.toggle('bg-forge-error', borrar > 0);
        confirmar.classList.toggle('text-white', borrar > 0);
        confirmar.classList.toggle('bg-forge-primary', borrar === 0);
        confirmar.classList.toggle('text-forge-on-accent', borrar === 0);
      };
      lista.onchange = actualizar;
      todas.onchange = () => {
        lista.querySelectorAll<HTMLSelectElement>('.destino-tarea').forEach((s) => { s.value = todas.value; });
        actualizar();
      };
      actualizar();

      confirmar.onclick = async () => {
        const destinos: Record<string, string> = {};
        lista.querySelectorAll<HTMLSelectElement>('.destino-tarea').forEach((s) => { destinos[s.dataset.issueId!] = s.value; });
        confirmar.disabled = true;
        const r = await enviar({ destinos });
        confirmar.disabled = false;
        if (r.ok) { fin(); return; }
        window.showToast?.(t.tError || '', 'error');
      };
      dlg.showModal();
    }

    document.getElementById('btn-delete-sprint')?.addEventListener('click', (e) => {
      const sprintId = (e.currentTarget as HTMLElement).getAttribute('data-sprint-id');
      if (sprintId) borrarSprint(sprintId);
    });
    document.getElementById('btn-manage-sprints')?.addEventListener('click', () => {
      (document.getElementById('gestionar-sprints') as HTMLDialogElement | null)?.showModal();
    });
    document.querySelectorAll<HTMLButtonElement>('.btn-borrar-sprint').forEach((b) => {
      b.addEventListener('click', () => {
        (document.getElementById('gestionar-sprints') as HTMLDialogElement | null)?.close();
        borrarSprint(b.dataset.sprintId!);
      });
    });

    const deactivateSprintBtn = document.getElementById('btn-deactivate-sprint');
    deactivateSprintBtn?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLElement;
      const sprintId = btn.getAttribute('data-sprint-id');
      
      // @ts-ignore
      window.forgeConfirm(dialogoCierre?.getAttribute('data-t-deactivate') || '', async () => {
        const res = await fetch(`/api/sprints/${sprintId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: 'planned' })
        });

        if (res.ok) {
          window.location.reload();
        } else {
          console.error('desactivar sprint:', await res.text());
          // @ts-ignore
          window.showToast(dialogoCierre?.getAttribute('data-t-err-deactivate') || '', 'error');
        }
      });
    });
  </script>
  <script>
    // Update sprint time counter dynamically
    window.addEventListener('worklog-changed', (e: any) => {
      const container = document.getElementById('sprint-time-container');
      const text = document.getElementById('sprint-time-text');
      const bar = document.getElementById('sprint-time-bar');
      if (!container || !text || !bar) return;

      const delta = e.detail.hoursDelta;
      let logged = parseFloat(container.getAttribute('data-logged') || '0');
      const estimated = parseFloat(container.getAttribute('data-estimated') || '0');

      logged = Math.max(0, logged + delta);
      container.setAttribute('data-logged', logged.toString());

      const displayLogged = Math.round(logged * 10) / 10;
      const displayEst = Math.round(estimated * 10) / 10;

      if (estimated > 0) {
        text.textContent = `${displayLogged}h / ${displayEst}h`;
      } else {
        text.textContent = (container.dataset.tNoEstimate || '').replace('{h}', String(displayLogged));
      }

      if (estimated > 0) {
        const pct = Math.min((logged / estimated) * 100, 100);
        bar.style.width = `${pct}%`;
        if (logged / estimated > 1) {
          bar.className = 'block h-full rounded-full bg-forge-error';
        } else {
          bar.className = 'block h-full rounded-full bg-forge-text';
        }
      } else {
        bar.style.width = '0%';
      }
    });

    window.addEventListener('estimate-changed', (e: any) => {
      const container = document.getElementById('sprint-time-container');
      const text = document.getElementById('sprint-time-text');
      const bar = document.getElementById('sprint-time-bar');
      if (!container || !text || !bar) return;

      const delta = e.detail.estimateDelta;
      let estimated = parseFloat(container.getAttribute('data-estimated') || '0');
      const logged = parseFloat(container.getAttribute('data-logged') || '0');

      estimated = Math.max(0, estimated + delta);
      container.setAttribute('data-estimated', estimated.toString());

      const displayLogged = Math.round(logged * 10) / 10;
      const displayEst = Math.round(estimated * 10) / 10;

      if (estimated > 0) {
        text.textContent = `${displayLogged}h / ${displayEst}h`;
      } else {
        text.textContent = (container.dataset.tNoEstimate || '').replace('{h}', String(displayLogged));
      }

      if (estimated > 0) {
        const pct = Math.min((logged / estimated) * 100, 100);
        bar.style.width = `${pct}%`;
        if (logged / estimated > 1) {
          bar.className = 'block h-full rounded-full bg-forge-error';
        } else {
          bar.className = 'block h-full rounded-full bg-forge-text';
        }
      } else {
        bar.style.width = '0%';
      }
    });
  </script>
</MainLayout>

<style>
  /*
    En móvil el menú no se ancla al botón, sino a la pantalla.

    El botón vive en una rejilla de dos columnas y en cuál cae depende de
    cuántos controles haya delante — el filtro de etiquetas solo aparece si el
    espacio tiene alguna. Anclado a la izquierda del botón se salía por la
    derecha cuando caía en la columna derecha; anclado a la derecha se salía por
    la izquierda cuando caía en la izquierda. Se probaron las dos y cada una
    falla en la mitad de los tableros.

    Fijado a los dos bordes ya no depende de dónde esté el botón. `top: auto`
    es imprescindible: `top-full` significa «100 % de la altura», que en
    `absolute` es «justo debajo del botón» y en `fixed` es «el borde de abajo
    de la pantalla».
  */
  @media (max-width: 40rem) {
    .menu-sprint {
      position: fixed;
      left: 1rem;
      right: 1rem;
      top: auto;
      min-width: 0;
    }
  }

</style>
