---
import MainLayout from '../../../layouts/MainLayout.astro';
import KanbanBoard from '../../../components/jira/KanbanBoard.astro';
import db from '../../../lib/db';
import { checkWorkspaceAccess } from '../../../lib/guard';
import { useTranslations } from '../../../i18n/ui';
import { deVarias, listar as listarEtiquetas } from '../../../lib/labels';
import { listar as listarTipos } from '../../../lib/issueTypes';

const { sys_tag } = Astro.params;
const user = Astro.locals.user!;
const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);

if (!user) return Astro.redirect('/login');

const workspace = db.prepare('SELECT id, name FROM workspaces WHERE sys_tag = ?').get(sys_tag) as any;
if (!workspace) return Astro.redirect('/404');

const access = checkWorkspaceAccess(user.id, user.is_sysadmin, workspace.id, 'viewer');
if (!access.granted) return new Response('Access Denied', { status: 403 });

// Read sprint from URL
const requestedSprintId = Astro.url.searchParams.get('sprint');
let activeSprintId = null;
let currentSprintObj = null;

if (!Astro.url.search.includes('sprint=')) {
  const savedSprint = Astro.cookies.get(`forge_last_sprint_${workspace.id}`)?.value;
  if (savedSprint && savedSprint !== 'backlog') {
    return Astro.redirect(`/w/${sys_tag}/board?sprint=${savedSprint}`);
  }
}

// Sin sprint en la URL ni cookie, se abre el **sprint activo**, no el backlog.
//
// Antes caía en el backlog, que en un espacio bien llevado está casi siempre
// vacío: la primera visita a un tablero con un sprint en marcha y doce issues
// dentro mostraba «Tu tablero kanban está vacío». Es la peor primera impresión
// posible, y además invitaba a crear un issue suelto fuera del sprint.
//
// Solo se aplica cuando no hay elección previa: si alguien pide el backlog a
// propósito —o eligió otro sprint y quedó en la cookie— se respeta.
let defaultSprintId: string | null = null;
if (!Astro.url.search.includes('sprint=')) {
  const active = db
    .prepare("SELECT id FROM sprints WHERE workspace_id = ? AND status = 'active' ORDER BY rowid DESC LIMIT 1")
    .get(workspace.id) as { id: string } | undefined;
  if (active) defaultSprintId = active.id;
}

// IDOR Protection: Validate requested sprint belongs to this workspace
if (requestedSprintId && requestedSprintId !== 'backlog') {
  const sprintCheck = db.prepare('SELECT workspace_id, status FROM sprints WHERE id = ?').get(requestedSprintId) as any;
  if (!sprintCheck || sprintCheck.workspace_id !== workspace.id) {
    return new Response('Sprint Not Found', { status: 404 });
  }
  activeSprintId = requestedSprintId;
  currentSprintObj = sprintCheck;
} else if (defaultSprintId) {
  activeSprintId = defaultSprintId;
  currentSprintObj = db
    .prepare('SELECT workspace_id, status FROM sprints WHERE id = ?')
    .get(defaultSprintId) as any;
}

// Fetch all sprints for the dropdown
const sprints = db.prepare('SELECT id, name, status FROM sprints WHERE workspace_id = ? ORDER BY start_date DESC, rowid DESC').all(workspace.id) as any[];

/**
 * Ordenar el tablero.
 *
 * Es una **vista**, no un cambio: se aplica en el `ORDER BY` de la consulta y
 * no toca `position`, que es el orden que la gente colocó a mano arrastrando
 * tarjetas. Reescribir `position` para «ordenar por prioridad» destruiría ese
 * trabajo, y volver a «manual» ya no devolvería nada porque no quedaría a qué
 * volver.
 *
 * La consecuencia hay que asumirla y decirla: con un orden que no es el manual,
 * **arrastrar no puede funcionar**. Soltar una tarjeta escribiría un `position`
 * que la vista ignora, así que volvería a su sitio sola y parecería que la
 * aplicación está rota. Con un orden activo se desactiva el arrastre y se
 * explica por qué.
 *
 * Cada orden se escribe **dos veces**, con y sin el prefijo de la tabla: uno va
 * en el `ROW_NUMBER() OVER (...)` que recorta a cien por columna, donde la
 * consulta tiene alias, y otro en el `ORDER BY` de fuera, donde ya no los hay.
 * Se escriben a mano en vez de reescribir el SQL con una expresión regular:
 * generar SQL a base de sustituciones es exactamente como se cuelan cosas donde
 * no deben.
 *
 * `NULLS LAST` a mano con `IS NULL`: SQLite ordena los nulos primero, y un
 * tablero ordenado por fecha de entrega que empieza por las tarjetas **sin**
 * fecha entierra justo lo que se buscaba.
 */
const PRIORIDAD_SQL = (c: string) =>
  // `CASE` y no alfabético: 'high' va antes que 'low' en el diccionario, lo que
  // dejaría lo urgente en medio de la columna.
  `CASE ${c}priority WHEN 'highest' THEN 0 WHEN 'high' THEN 1 WHEN 'medium' THEN 2 WHEN 'low' THEN 3 WHEN 'lowest' THEN 4 ELSE 2 END ASC`;

const ORDENES: Record<string, (c: string) => string> = {
  manual:   (c) => `${c}position ASC, ${c}id ASC`,
  priority: (c) => `${PRIORIDAD_SQL(c)}, ${c}position ASC`,
  due:      (c) => `${c}due_date IS NULL ASC, ${c}due_date ASC, ${c}position ASC`,
  created:  (c) => `${c}created_at DESC, ${c}position ASC`,
  updated:  (c) => `${c}updated_at DESC, ${c}position ASC`,
  title:    (c) => `${c}title COLLATE NOCASE ASC`,
  points:   (c) => `${c}story_points DESC, ${c}position ASC`,
};

const ordenPedido = Astro.url.searchParams.get('sort') ?? 'manual';
// Con `hasOwn` y no con `in`: `'toString' in ORDENES` es cierto por la cadena
// de prototipos, y devolvería una función donde tiene que ir SQL.
const ordenActivo = Object.hasOwn(ORDENES, ordenPedido) ? ordenPedido : 'manual';
const ordenSQL = ORDENES[ordenActivo];

let issuesQuery = `
  SELECT i.*, 
         i.logged_hours,
         u1.username as reporter_username, 
         u1.avatar_url as reporter_avatar,
         u2.username as assignee_username,
         u2.avatar_url as assignee_avatar,
         (SELECT started_at FROM time_tracking_sessions WHERE issue_id = i.id AND user_id = ?) as active_session_start,
         ROW_NUMBER() OVER (PARTITION BY i.status ORDER BY ${ordenSQL('i.')}) AS rn
  FROM issues i
  LEFT JOIN users u1 ON i.reporter_id = u1.id
  LEFT JOIN users u2 ON i.assignee_id = u2.id
  WHERE i.workspace_id = ?
`;
const queryParams: any[] = [user.id, workspace.id];

if (activeSprintId) {
  issuesQuery += ' AND i.sprint_id = ?';
  queryParams.push(activeSprintId);
} else {
  issuesQuery += ' AND i.sprint_id IS NULL';
}

/**
 * Filtro por etiqueta.
 *
 * Va en la consulta y no en el navegador porque el tablero solo trae cien
 * tarjetas por columna: filtrar en pantalla buscaría dentro de esas cien y
 * diría que no hay nada más, cuando lo que se busca puede estar entre las que
 * no llegaron. Se comprueba que la etiqueta sea **de este espacio** antes de
 * usarla; si no lo es, se ignora en vez de fingir un tablero vacío.
 */
const etiquetaPedida = Astro.url.searchParams.get('label');
const etiquetaFiltro = etiquetaPedida
  ? (db.prepare('SELECT id, name, color FROM labels WHERE id = ? AND workspace_id = ?')
      .get(etiquetaPedida, workspace.id) as any) ?? null
  : null;

if (etiquetaFiltro) {
  issuesQuery += ' AND EXISTS (SELECT 1 FROM issue_labels il WHERE il.issue_id = i.id AND il.label_id = ?)';
  queryParams.push(etiquetaFiltro.id);
}

/**
 * Tope por columna.
 *
 * La consulta no tenía ninguno: pintaba **todos** los issues del sprint. Medido
 * en local, un backlog de 2.000 issues genera 5 MB de HTML en una sola carga —y
 * la tarjeta escribe la descripción dos veces, visible y en `data-description`,
 * de donde la lee el modal—. En la `e2-micro` de producción eso son dos
 * problemas: el proceso renderiza 5 MB con 1 GB de RAM y un núcleo compartido,
 * y el tier gratuito da **1 GB de egress al mes**, así que doscientas aperturas
 * del tablero se lo comen entero. Cloudflare no puede ayudar: es HTML privado
 * por usuario, no cacheable.
 *
 * El tope va **por columna** y no sobre el total: con un tope global, 300
 * issues en «Por hacer» dejarían «Hecho» vacío y el tablero mentiría sobre el
 * estado del sprint. `ROW_NUMBER() OVER (PARTITION BY status)` reparte el
 * presupuesto entre las cuatro, así que el techo real son 4 × COLUMN_LIMIT.
 *
 * Lo que se corta se cuenta y se dice, más abajo, en cada cabecera de columna:
 * un tablero que esconde trabajo sin avisar es peor que uno lento.
 */
const COLUMN_LIMIT = 100;

// Cuántos hay de verdad en cada columna, para poder decir «100 de 743».
const countsQuery = issuesQuery.replace(
  /SELECT[\s\S]*?FROM issues i/,
  'SELECT i.status, COUNT(*) as n FROM issues i'
) + ' GROUP BY i.status';
const statusCounts = Object.fromEntries(
  (db.prepare(countsQuery).all(...queryParams.slice(1)) as { status: string; n: number }[])
    .map((r) => [r.status, r.n])
);

const pagedQuery = `
  SELECT * FROM (
    ${issuesQuery}
  ) WHERE rn <= ${COLUMN_LIMIT}
  ORDER BY ${ordenSQL('')}
`;
const issues = db.prepare(pagedQuery).all(...queryParams) as any[];

// Las etiquetas de todas las tarjetas en **una** consulta. Una por tarjeta
// serían cien consultas por carga de tablero.
const etiquetasPorIssue = deVarias('issue', issues.map((i) => i.id));
for (const issue of issues) issue.labels = etiquetasPorIssue.get(issue.id) ?? [];

const etiquetasDelEspacio = listarEtiquetas(workspace.id);
const tiposDelEspacio = listarTipos(workspace.id);

const activeSprintName = activeSprintId ? sprints.find(s => s.id === activeSprintId)?.name : 'Backlog';

// Fetch workspace members for assignee/reporter dropdowns
const workspaceMembers = db.prepare(`
  SELECT u.id, u.username 
  FROM workspace_members wm 
  JOIN users u ON wm.user_id = u.id 
  WHERE wm.workspace_id = ?
`).all(workspace.id) as any[];

let totalLogged = 0;
let totalEstimated = 0;
if (activeSprintId) {
  const totals = db.prepare(`
    SELECT SUM(logged_hours) as total_logged, SUM(estimated_hours) as total_estimated
    FROM issues
    WHERE sprint_id = ?
  `).get(activeSprintId) as any;
  totalLogged = totals.total_logged || 0;
  totalEstimated = totals.total_estimated || 0;
}
const metaDescription = `${workspace.name} board on Forge OS. Track issues, sprints, and tasks efficiently.`;
---

<MainLayout hideFooter={true}
  title={`Board - ${workspace.name}`} 
  workspaceId={workspace.id}
  description={metaDescription}
>
  <div class="h-full flex flex-col pt-4 overflow-hidden">
    {/*
      La barra se amontonaba.
      El título ocupaba dos líneas con un nombre de espacio largo, el bloque de
      tiempo quedaba estrujado a 14rem con el texto partido a mitad de frase, y
      los seis controles caían en dos filas pegadas. Ahora el título se recorta
      —el nombre completo está en la barra lateral y en la pestaña—, el bloque
      de tiempo tiene su ancho y los controles respiran al envolverse.
    */}
    <header class="mb-4 flex flex-col xl:flex-row justify-between items-start xl:items-center gap-x-4 gap-y-3">
      <div class="flex items-center gap-4 min-w-0">
        <h1 class="text-2xl font-bold text-forge-text truncate max-w-[15rem]" title={`${workspace.name} Board`}>{workspace.name} Board</h1>
        {/*
          La etiqueta encima y la cifra debajo, no una al lado de la otra.
          En horizontal, «0h registradas — sin estimar» no cabía junto a
          «TIEMPO» y se partía a mitad de frase, encima del rótulo.
        */}
        {activeSprintId && (
          <div class="hidden md:flex flex-col w-[12.5rem] shrink-0 bg-forge-bg/80 border border-forge-border rounded-lg px-3 py-2 shadow-sm" id="sprint-time-container" data-logged={totalLogged} data-estimated={totalEstimated}>
            <span class="text-[9px] font-mono text-forge-muted font-bold tracking-widest uppercase leading-none">{t('dashboard.time') || 'Time'}</span>
            <span class="text-[11px] font-mono font-bold text-forge-accent-text leading-tight mt-1 mb-1.5 truncate" id="sprint-time-text">
              {totalEstimated > 0
                ? `${totalLogged}h / ${totalEstimated}h`
                : `${totalLogged}h ${t('dashboard.logged') || 'logged'}`}
            </span>
            <div class="h-1.5 w-full bg-forge-panel rounded-full overflow-hidden border border-forge-border">
              <div id="sprint-time-bar" class={`h-full transition-all ${totalEstimated > 0 && (totalLogged / totalEstimated) > 1 ? 'bg-forge-error' : 'bg-forge-secondary'}`} style={`width: ${totalEstimated > 0 ? Math.min((totalLogged / totalEstimated) * 100, 100) : 0}%`}></div>
            </div>
          </div>
        )}
      </div>

      <div class="flex flex-wrap gap-x-2 gap-y-2.5 items-center w-full xl:w-auto xl:justify-end">
        <select id="sprint-selector" aria-label={t('a11y.sprint_selector')} class="bg-forge-bg text-forge-text border border-forge-border rounded-md px-3 py-1.5 text-sm focus:outline-none focus:border-forge-secondary">
          <option value="backlog" selected={!activeSprintId}>{t('board.backlog')}</option>
          {sprints.map(s => (
            <option value={s.id} selected={activeSprintId === s.id}>{s.name} {s.status === 'active' ? '(Active)' : s.status === 'completed' ? '(Completed)' : ''}</option>
          ))}
        </select>
        <label class="sr-only" for="board-sort">{t('board.sort')}</label>
        <select id="board-sort" class="bg-forge-bg text-forge-text border border-forge-border rounded-md px-3 py-1.5 text-sm focus:outline-none focus:border-forge-secondary">
          <option value="manual" selected={ordenActivo === 'manual'}>{t('board.sort_manual')}</option>
          <option value="priority" selected={ordenActivo === 'priority'}>{t('board.sort_priority')}</option>
          <option value="due" selected={ordenActivo === 'due'}>{t('board.sort_due')}</option>
          <option value="points" selected={ordenActivo === 'points'}>{t('board.sort_points')}</option>
          <option value="updated" selected={ordenActivo === 'updated'}>{t('board.sort_updated')}</option>
          <option value="created" selected={ordenActivo === 'created'}>{t('board.sort_created')}</option>
          <option value="title" selected={ordenActivo === 'title'}>{t('board.sort_title')}</option>
        </select>

        {/* Filtro por etiqueta. Solo aparece si hay etiquetas: un desplegable
            con una única opción vacía es ruido. */}
        {etiquetasDelEspacio.length > 0 && (
          <select id="label-filter" aria-label={t('labels.filter')} class="bg-forge-bg text-forge-text border border-forge-border rounded-md px-3 py-1.5 text-sm focus:outline-none focus:border-forge-secondary">
            <option value="">{t('labels.filter_all')}</option>
            {etiquetasDelEspacio.map((e: any) => (
              <option value={e.id} selected={etiquetaFiltro?.id === e.id}>{e.name}</option>
            ))}
          </select>
        )}
        
        {access.role !== 'viewer' && activeSprintId && currentSprintObj && (
          <div class="flex items-center gap-1 bg-forge-bg rounded-md border border-forge-border/50 p-1">
            <button id="btn-toggle-sprint" data-sprint-id={activeSprintId} data-current-status={currentSprintObj.status} class={`font-bold px-3 py-1 rounded text-xs transition-colors ${currentSprintObj.status === 'planned' ? 'bg-forge-success text-white hover:opacity-90' : currentSprintObj.status === 'active' ? 'bg-forge-primary text-forge-on-accent hover:opacity-90' : 'bg-forge-primary text-forge-on-accent hover:opacity-90'}`}>
              {currentSprintObj.status === 'planned' ? t('board.sprint_start') : currentSprintObj.status === 'active' ? t('board.sprint_complete') : t('board.sprint_reopen')}
            </button>
            {currentSprintObj.status === 'active' && (
              <button id="btn-deactivate-sprint" data-sprint-id={activeSprintId} class="text-forge-muted hover:text-forge-error px-2 py-1 rounded transition-colors" title={t('board.deactivate')}>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path><line x1="12" y1="2" x2="12" y2="12"></line></svg>
              </button>
            )}
          </div>
        )}

        {(access.role === 'owner' || access.role === 'editor') && (
          <button id="btn-new-sprint" class="bg-forge-panel border border-forge-border hover:bg-forge-border/40 text-forge-text font-bold px-3 py-1.5 rounded-md text-sm transition-colors">
            + Sprint
          </button>
        )}
        
        {access.role !== 'viewer' && (
          <button id="btn-new-issue" title={t('board.new_issue_hint')} class="bg-forge-primary text-forge-on-accent font-bold px-3 py-1.5 rounded-md text-sm hover:opacity-90 transition-opacity ml-2 relative group z-50">
            + Issue
            <!-- Tooltip -->
            <span class="absolute -bottom-10 left-1/2 -translate-x-1/2 bg-forge-panel border border-forge-border text-forge-text text-[10px] px-2 py-1.5 rounded opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap shadow-xl z-50">New Issue <kbd class="font-mono bg-forge-bg border border-forge-border px-1 py-0.5 rounded text-[8px] ml-1">C</kbd></span>
          </button>
        )}
      </div>
    </header>

    <div class="flex-1 overflow-hidden">
      <!-- Pass sprints to KanbanBoard so IssueDetailsModal can use it -->
      <KanbanBoard workspaceId={workspace.id} issues={issues} sprints={sprints} currentSprintId={activeSprintId} workspaceMembers={workspaceMembers} userRole={access.role} statusCounts={statusCounts} labels={etiquetasDelEspacio} issueTypes={tiposDelEspacio} sysTag={sys_tag} sortMode={ordenActivo} />
    </div>
  </div>

  <!-- New Sprint Modal -->
  <dialog id="new-sprint-modal" class="bg-forge-panel border border-forge-border rounded-lg p-6 w-full max-w-[400px] text-forge-text shadow-xl backdrop:bg-black/50">
    <h2 class="text-xl font-bold mb-4">{t('board.create_sprint')}</h2>
    <div class="mb-4">
      <label class="block text-xs uppercase tracking-wider text-forge-muted mb-1" for="sprint-name">Name</label>
      <input type="text" id="sprint-name" class="w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:outline-none focus:border-forge-secondary" placeholder={t('board.sprint_name_ph')}>
    </div>
    <div class="flex justify-end gap-3 mt-6">
      <button type="button" class="px-4 py-2 text-forge-muted hover:text-forge-text" onclick="document.getElementById('new-sprint-modal').close()">{t('modal.cancel')}</button>
      <button type="button" id="btn-save-sprint" class="bg-forge-primary text-forge-on-accent px-4 py-2 rounded font-bold hover:bg-opacity-90 transition-colors">{t('modal.create')}</button>
    </div>
  </dialog>

  {/* Cerrar un sprint con trabajo dentro.
      El servidor ya se negaba a cerrarlo en silencio y devolvía las tres
      salidas posibles, pero nadie las enseñaba: la respuesta llegaba al tablero
      y se pintaba el JSON crudo en un aviso. Esto es esa pregunta, hecha. */}
  <dialog id="close-sprint-modal"
    data-t-pending={t('sprint.close_pending')}
    data-t-pending-one={t('sprint.close_pending_one')}
    data-t-clean={t('sprint.close_clean')}
    data-t-reopen={t('sprint.reopen_confirm')}
    data-t-deactivate={t('sprint.deactivate_confirm')}
    data-t-err-deactivate={t('sprint.err_deactivate')}
    data-t-err-create={t('issue.err_create')}
    data-t-err={t('sprint.err_close')}
    data-t-no-target={t('sprint.err_no_target')}
    class="bg-forge-panel border border-forge-border rounded-2xl p-6 w-full max-w-[480px] text-forge-text shadow-xl backdrop:bg-black/60">
    <h2 class="text-xl font-bold mb-1">{t('sprint.close_title')}</h2>
    <p id="close-sprint-lead" class="text-sm text-forge-muted mb-5"></p>

    <div class="space-y-2">
      {[
        { v: 'backlog', t: t('sprint.close_backlog'), d: t('sprint.close_backlog_desc') },
        { v: 'next', t: t('sprint.close_next'), d: t('sprint.close_next_desc') },
        { v: 'keep', t: t('sprint.close_keep'), d: t('sprint.close_keep_desc') },
      ].map((o, i) => (
        <label class="flex gap-3 items-start border border-forge-border rounded-xl p-3 cursor-pointer hover:border-forge-secondary/50 transition-colors has-[:checked]:border-forge-secondary has-[:checked]:bg-forge-secondary/5">
          <input type="radio" name="close-strategy" value={o.v} checked={i === 0} class="mt-1 accent-forge-primary shrink-0">
          <span class="min-w-0">
            <span class="block text-sm font-bold text-forge-text">{o.t}</span>
            <span class="block text-xs text-forge-muted mt-0.5 leading-relaxed">{o.d}</span>
          </span>
        </label>
      ))}
    </div>

    <div id="close-sprint-target-wrap" class="hidden mt-4">
      <label class="block text-[10px] font-bold uppercase tracking-widest text-forge-muted mb-1.5" for="close-sprint-target">{t('sprint.close_target')}</label>
      <select id="close-sprint-target" class="w-full bg-forge-bg border border-forge-border rounded-lg p-2 text-sm text-forge-text focus:border-forge-secondary focus:outline-none">
        {sprints.filter((sp: any) => sp.status !== 'completed').map((sp: any) => (
          <option value={sp.id} data-current={sp.id === activeSprintId ? 'true' : 'false'}>{sp.name}</option>
        ))}
      </select>
    </div>

    <div class="flex justify-end gap-3 mt-6">
      <button type="button" class="px-4 py-2 text-sm font-bold text-forge-muted hover:text-forge-text" onclick="document.getElementById('close-sprint-modal').close()">{t('sprint.close_cancel')}</button>
      <button type="button" id="btn-close-sprint-confirm" class="bg-forge-primary text-forge-on-accent px-5 py-2 rounded-xl text-sm font-bold hover:opacity-90 transition-opacity">{t('sprint.close_confirm')}</button>
    </div>
  </dialog>

  <!-- New Issue Modal -->
  <dialog id="new-issue-modal" class="bg-forge-panel border border-forge-border rounded-lg p-6 w-full max-w-[500px] text-forge-text shadow-xl backdrop:bg-black/50">
    <h2 class="text-xl font-bold mb-4">{t('modal.create_issue')}</h2>
    <div class="space-y-4">
      <div>
        <label class="block text-xs uppercase tracking-wider text-forge-muted mb-1" for="new-issue-title">{t('modal.title')}</label>
        <input type="text" id="new-issue-title" class="w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:border-forge-secondary outline-none" placeholder={t('modal.title_placeholder') as string}>
      </div>
      <div>
        <label class="block text-xs uppercase tracking-wider text-forge-muted mb-1" for="new-issue-type">{t('modal.type')}</label>
        <select id="new-issue-type" class="w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:border-forge-secondary outline-none">
          {tiposDelEspacio.map((ti) => (
            <option value={ti.key}>{ti.isBuiltin ? (t(`type.${ti.key}` as any) || ti.name) : ti.name}</option>
          ))}
        </select>
      </div>
      <div>
        <label class="block text-xs uppercase tracking-wider text-forge-muted mb-1" for="new-issue-sprint">{t('modal.sprint')}</label>
        <select id="new-issue-sprint" class="w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:border-forge-secondary outline-none">
          <option value="">{t('modal.backlog')}</option>
          {sprints.map(s => (
            <option value={s.id} selected={activeSprintId === s.id}>{s.name}</option>
          ))}
        </select>
      </div>
      <div>
        <label class="block text-xs uppercase tracking-wider text-forge-muted mb-1" for="new-issue-assignee">{t('modal.assignee') || 'Assignee'}</label>
        <select id="new-issue-assignee" class="w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:border-forge-secondary outline-none">
          <option value="">{t('modal.unassigned')}</option>
          {workspaceMembers.map(m => (
            <option value={m.id}>{m.username}</option>
          ))}
        </select>
      </div>
      <div>
        <label class="block text-xs uppercase tracking-wider text-forge-muted mb-1" for="new-issue-due-date">{t('modal.due_date') || 'Due Date'}</label>
        <input type="date" id="new-issue-due-date" class="w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:border-forge-secondary outline-none font-mono" />
      </div>
      <div>
        <label class="block text-xs uppercase tracking-wider text-forge-muted mb-1" for="new-issue-desc">{t('modal.description') || 'Description'}</label>
        <textarea id="new-issue-desc" rows="3" class="w-full bg-forge-bg border border-forge-border rounded p-2 text-sm text-forge-text focus:border-forge-secondary outline-none placeholder:text-forge-muted" placeholder={t('modal.desc_placeholder') as string}></textarea>
      </div>
    </div>
    <div class="flex justify-end gap-3 mt-6">
      <button type="button" class="px-4 py-2 text-forge-muted hover:text-forge-text" onclick="document.getElementById('new-issue-modal').close()">{t('modal.cancel')}</button>
      <button type="button" id="btn-save-issue" class="bg-forge-primary text-forge-on-accent px-4 py-2 rounded font-bold hover:opacity-90 transition-opacity">{t('modal.create')}</button>
    </div>
  </dialog>

  <script>
    const workspaceId = document.querySelector('.kanban-container')?.getAttribute('data-workspace') || 'default';

    // PERSIST SPRINT SELECTION
    const urlParams = new URLSearchParams(window.location.search);
    const sprintParam = urlParams.get('sprint');
    
    const sprintToSave = sprintParam || 'backlog';
    localStorage.setItem(`forge_last_sprint_${workspaceId}`, sprintToSave);
    document.cookie = `forge_last_sprint_${workspaceId}=${sprintToSave}; path=/; max-age=31536000`;

    // SPRINT SELECTOR
    const selector = document.getElementById('sprint-selector') as HTMLSelectElement;
    selector?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      localStorage.setItem(`forge_last_sprint_${workspaceId}`, val);
      const url = new URL(window.location.href);
      // `?sprint=backlog` explícito, **no** quitar el parámetro.
      //
      // Sin parámetro, el servidor entiende «no ha elegido» y aplica la cookie
      // del último sprint, así que devolvía al sprint del que se acababa de
      // salir. Elegir «Backlog» no llevaba a ninguna parte y no había forma de
      // volver a él.
      url.searchParams.set('sprint', val);
      window.location.href = url.toString();
    });

    // FILTRO POR ETIQUETA
    //
    // Va en la URL y no en `localStorage`: así el enlace de «solo Parcial 2»
    // se puede pegar en un mensaje y le abre a otro lo mismo que estás viendo.
    // Y a diferencia del sprint, no se recuerda entre visitas: un filtro
    // pegajoso hace creer que el tablero se ha vaciado.
    /**
     * El orden va en la URL, como el filtro de etiqueta.
     *
     * Así «el tablero ordenado por lo que vence antes» se puede pegar en un
     * mensaje. Y como el filtro, **no se recuerda entre visitas**: un orden
     * pegajoso hace creer que las tarjetas se han movido solas.
     */
    const selectorOrden = document.getElementById('board-sort') as HTMLSelectElement | null;
    selectorOrden?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      const url = new URL(window.location.href);
      if (val && val !== 'manual') url.searchParams.set('sort', val);
      else url.searchParams.delete('sort');
      window.location.href = url.toString();
    });

    const filtroEtiqueta = document.getElementById('label-filter') as HTMLSelectElement | null;
    filtroEtiqueta?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      const url = new URL(window.location.href);
      if (val) url.searchParams.set('label', val);
      else url.searchParams.delete('label');
      window.location.href = url.toString();
    });

    // NEW SPRINT MODAL
    const newSprintBtn = document.getElementById('btn-new-sprint');
    const sprintModal = document.getElementById('new-sprint-modal') as HTMLDialogElement;
    const saveSprintBtn = document.getElementById('btn-save-sprint');

    newSprintBtn?.addEventListener('click', () => sprintModal?.showModal());

    saveSprintBtn?.addEventListener('click', async () => {
      const name = (document.getElementById('sprint-name') as HTMLInputElement).value;
      if (!name) return window.showToast?.('Name required', 'error');
      
      const res = await fetch('/api/sprints', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, workspaceId })
      });
      
      if (res.ok) {
        const data = await res.json();
        const url = new URL(window.location.href);
        url.searchParams.set('sprint', data.id);
        window.location.href = url.toString();
      } else {
        console.error('API Error: ', await res.text());
      }
    });

    // NEW ISSUE MODAL
    const newIssueBtn = document.getElementById('btn-new-issue');
    const issueModal = document.getElementById('new-issue-modal') as HTMLDialogElement;
    const saveIssueBtn = document.getElementById('btn-save-issue');

    newIssueBtn?.addEventListener('click', () => issueModal?.showModal());

    saveIssueBtn?.addEventListener('click', async () => {
      const title = (document.getElementById('new-issue-title') as HTMLInputElement).value;
      const type = (document.getElementById('new-issue-type') as HTMLSelectElement).value;
      const sprintId = (document.getElementById('new-issue-sprint') as HTMLSelectElement).value;
      const assigneeId = (document.getElementById('new-issue-assignee') as HTMLSelectElement).value;
      const dueDate = (document.getElementById('new-issue-due-date') as HTMLInputElement).value;
      const description = (document.getElementById('new-issue-desc') as HTMLTextAreaElement).value;

      if (!title) return window.showToast?.('Title is required', 'error');

      saveIssueBtn.textContent = 'Creating...';
      const sysTag = window.location.pathname.split('/')[2];
      const res = await fetch(`/api/w/${sysTag}/issues`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
          title, 
          type, 
          sprint_id: sprintId || null, 
          assignee_id: assigneeId || null,
          due_date: dueDate || null,
          description: description || null
        })
      });

      if (res.ok) {
        window.location.reload();
      } else {
        // El cuerpo de la respuesta es para el registro, no para la pantalla.
        console.error('crear issue:', await res.text());
        window.showToast?.(dialogoCierre?.getAttribute('data-t-err-create') || '', 'error');
      }
    });

    const dialogoCierre = document.getElementById('close-sprint-modal') as HTMLDialogElement | null;
    const destinoWrap = document.getElementById('close-sprint-target-wrap');
    const destinoSel = document.getElementById('close-sprint-target') as HTMLSelectElement | null;

    // «A qué sprint» solo tiene sentido con la opción de moverlas elegida.
    dialogoCierre?.querySelectorAll<HTMLInputElement>('input[name="close-strategy"]').forEach((r) => {
      r.addEventListener('change', () => {
        destinoWrap?.classList.toggle('hidden', r.value !== 'next' || !r.checked);
      });
    });

    function abrirDialogoCierre(pendientes: number, enviar: (c: Record<string, unknown>) => Promise<Response>) {
      if (!dialogoCierre) return;
      const lead = document.getElementById('close-sprint-lead');
      const plantilla = pendientes === 1
        ? dialogoCierre.getAttribute('data-t-pending-one') || ''
        : (dialogoCierre.getAttribute('data-t-pending') || '').replace('{n}', String(pendientes));
      if (lead) lead.textContent = plantilla;

      // El sprint que se está cerrando no puede ser su propio destino.
      let hayDestino = false;
      destinoSel?.querySelectorAll('option').forEach((o) => {
        const esActual = o.getAttribute('data-current') === 'true';
        o.hidden = esActual;
        o.disabled = esActual;
        if (!esActual) hayDestino = true;
      });
      if (destinoSel && hayDestino && destinoSel.selectedOptions[0]?.disabled) {
        const libre = Array.from(destinoSel.options).find((o) => !o.disabled);
        if (libre) destinoSel.value = libre.value;
      }
      // Sin otro sprint al que pasarlas, la opción no se ofrece.
      const radioNext = dialogoCierre.querySelector<HTMLInputElement>('input[value="next"]');
      const filaNext = radioNext?.closest('label');
      if (filaNext) filaNext.classList.toggle('hidden', !hayDestino);
      if (!hayDestino && radioNext?.checked) {
        dialogoCierre.querySelector<HTMLInputElement>('input[value="backlog"]')!.checked = true;
        destinoWrap?.classList.add('hidden');
      }

      const confirmar = document.getElementById('btn-close-sprint-confirm');
      const alPulsar = async () => {
        const elegida = dialogoCierre.querySelector<HTMLInputElement>('input[name="close-strategy"]:checked')?.value || 'backlog';
        const cuerpo: Record<string, unknown> = { strategy: elegida };
        if (elegida === 'next') {
          if (!destinoSel?.value) {
            // @ts-ignore
            window.showToast(dialogoCierre.getAttribute('data-t-no-target') || '', 'error');
            return;
          }
          cuerpo.target_sprint_id = destinoSel.value;
        }
        const r = await enviar(cuerpo);
        if (r.ok) { window.location.reload(); return; }
        // @ts-ignore
        window.showToast(dialogoCierre.getAttribute('data-t-err') || '', 'error');
      };
      confirmar?.addEventListener('click', alPulsar, { once: true });
      dialogoCierre.addEventListener('close', () => confirmar?.removeEventListener('click', alPulsar), { once: true });
      dialogoCierre.showModal();
    }

    // SPRINT TOGGLE (START/COMPLETE/REOPEN)
    const toggleSprintBtn = document.getElementById('btn-toggle-sprint');
    toggleSprintBtn?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLElement;
      const sprintId = btn.getAttribute('data-sprint-id');
      const currentStatus = btn.getAttribute('data-current-status');
      
      let newStatus = 'active';
      if (currentStatus === 'active') newStatus = 'completed';
      if (currentStatus === 'completed') newStatus = 'active'; // Allow reopening if they are looking at a completed sprint

      const cerrar = (cuerpo: Record<string, unknown>) =>
        fetch(`/api/sprints/${sprintId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: newStatus, workspaceId, ...cuerpo })
        });

      // Reabrir o arrancar no arrastra nada: se pregunta y ya.
      if (newStatus !== 'completed') {
        // @ts-ignore
        window.forgeConfirm(dialogoCierre?.getAttribute('data-t-reopen') || '', async () => {
          const res = await cerrar({});
          if (res.ok) window.location.reload();
          // @ts-ignore
          else window.showToast(dialogoCierre?.getAttribute('data-t-err') || '', 'error');
        });
        return;
      }

      // Cerrar sí: puede haber trabajo sin terminar dentro.
      //
      // Quién cuenta las tareas pendientes importa. Antes las contaba esta
      // página mirando las tarjetas dibujadas, y el tablero solo trae cien por
      // columna: con un sprint grande decía «hay 100» cuando había 743, o «no
      // queda nada» estando en el backlog. Ahora se intenta cerrar y es el
      // servidor —que las cuenta todas— quien responde cuántas quedan.
      const res = await cerrar({});
      if (res.ok) { window.location.reload(); return; }

      let datos: any = null;
      try { datos = await res.clone().json(); } catch { /* no era JSON */ }

      if (res.status === 409 && datos?.error_code === 'unfinished_issues') {
        abrirDialogoCierre(datos.pending, cerrar);
        return;
      }

      // @ts-ignore
      window.showToast(dialogoCierre?.getAttribute('data-t-err') || '', 'error');
    });

    const deactivateSprintBtn = document.getElementById('btn-deactivate-sprint');
    deactivateSprintBtn?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLElement;
      const sprintId = btn.getAttribute('data-sprint-id');
      
      // @ts-ignore
      window.forgeConfirm(dialogoCierre?.getAttribute('data-t-deactivate') || '', async () => {
        const res = await fetch(`/api/sprints/${sprintId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: 'planned', workspaceId })
        });

        if (res.ok) {
          window.location.reload();
        } else {
          console.error('desactivar sprint:', await res.text());
          // @ts-ignore
          window.showToast(dialogoCierre?.getAttribute('data-t-err-deactivate') || '', 'error');
        }
      });
    });
  </script>
  <script>
    // Update sprint time counter dynamically
    window.addEventListener('worklog-changed', (e: any) => {
      const container = document.getElementById('sprint-time-container');
      const text = document.getElementById('sprint-time-text');
      const bar = document.getElementById('sprint-time-bar');
      if (!container || !text || !bar) return;

      const delta = e.detail.hoursDelta;
      let logged = parseFloat(container.getAttribute('data-logged') || '0');
      const estimated = parseFloat(container.getAttribute('data-estimated') || '0');

      logged = Math.max(0, logged + delta);
      container.setAttribute('data-logged', logged.toString());

      const displayLogged = Math.round(logged * 10) / 10;
      const displayEst = Math.round(estimated * 10) / 10;

      if (estimated > 0) {
        text.textContent = `${displayLogged}h / ${displayEst}h`;
      } else {
        text.textContent = `${displayLogged}h logged — no estimate`;
      }

      if (estimated > 0) {
        const pct = Math.min((logged / estimated) * 100, 100);
        bar.style.width = `${pct}%`;
        if (logged / estimated > 1) {
          bar.className = 'h-full transition-all bg-forge-error';
        } else {
          bar.className = 'h-full transition-all bg-forge-secondary';
        }
      } else {
        bar.style.width = '0%';
      }
    });

    window.addEventListener('estimate-changed', (e: any) => {
      const container = document.getElementById('sprint-time-container');
      const text = document.getElementById('sprint-time-text');
      const bar = document.getElementById('sprint-time-bar');
      if (!container || !text || !bar) return;

      const delta = e.detail.estimateDelta;
      let estimated = parseFloat(container.getAttribute('data-estimated') || '0');
      const logged = parseFloat(container.getAttribute('data-logged') || '0');

      estimated = Math.max(0, estimated + delta);
      container.setAttribute('data-estimated', estimated.toString());

      const displayLogged = Math.round(logged * 10) / 10;
      const displayEst = Math.round(estimated * 10) / 10;

      if (estimated > 0) {
        text.textContent = `${displayLogged}h / ${displayEst}h`;
      } else {
        text.textContent = `${displayLogged}h logged — no estimate`;
      }

      if (estimated > 0) {
        const pct = Math.min((logged / estimated) * 100, 100);
        bar.style.width = `${pct}%`;
        if (logged / estimated > 1) {
          bar.className = 'h-full transition-all bg-forge-error';
        } else {
          bar.className = 'h-full transition-all bg-forge-secondary';
        }
      } else {
        bar.style.width = '0%';
      }
    });
  </script>
</MainLayout>
