---
import MainLayout from '../layouts/MainLayout.astro';
import db from '../lib/db';

const user = Astro.locals.user!;
if (!user) return Astro.redirect('/login');
if (user.is_guest) return Astro.redirect('/register');

const memberships = db.prepare(`
  SELECT w.id, w.name, w.sys_tag, w.icon, wm.ws_role 
  FROM workspace_members wm
  JOIN workspaces w ON w.id = wm.workspace_id
  WHERE wm.user_id = ?
`).all(user.id) as any[];

const tienePassword = (h: unknown) => typeof h === 'string' && h.startsWith('$2');
const userProfile = db.prepare('SELECT bio, banner_url, pronouns, public_email, email, is_public, github_id, google_id, password_hash, notif_mute_all, notif_mute_assign, notif_mute_mention, notif_mute_sprint, notif_mute_system FROM users WHERE id = ?').get(user.id) as any || {};

// Una cuenta creada por un proveedor guarda la cadena `oauth` como hash, que no
// es bcrypt válido. A quien está en esa situación no se le puede pedir «la
// contraseña actual»: no tiene ninguna, y pedírsela era lo que la dejaba sin
// poder ponerse una.
const pwRow = db.prepare('SELECT password_hash FROM users WHERE id = ?').get(user.id) as any;
const hasPassword = typeof pwRow?.password_hash === 'string' && pwRow.password_hash.startsWith('$2');
import { useTranslations } from '../i18n/ui';
import { credentialsFor } from '../lib/oauth';
const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);

// Un botón «Conectar» que lleva a un 404 es peor que no ofrecerlo: quien lo
// pulsa cree que la aplicación está rota. Si el proveedor no tiene
// credenciales, se dice que no está configurado y se acabó.
const oauthAvailable = {
  google: Boolean(credentialsFor('google')),
  github: Boolean(credentialsFor('github')),
};

// Avisos de vuelta del proveedor.
const params = Astro.url.searchParams;
const oauthNotice =
  params.get('error') === 'oauth_taken'
    ? { kind: 'error' as const, text: t('user.settings.oauth_taken') }
    : params.get('error') === 'oauth_last_method'
      ? { kind: 'error' as const, text: t('user.settings.oauth_last_method') }
      : params.get('connected')
        ? { kind: 'ok' as const, text: t('user.settings.oauth_connected') }
        : params.get('disconnected')
          ? { kind: 'ok' as const, text: t('user.settings.oauth_disconnected') }
          : null;
---

<MainLayout title={t('user.settings.title')}>
  <div id="settings-wrapper" data-i18n-saved={t('user.settings.saved_short') || 'Saved'} class="max-w-5xl mx-auto mt-4 sm:mt-8 p-0 sm:p-6 pb-20">
    
    <div class="border-b border-forge-border/40 pb-5 mb-8 flex flex-wrap gap-4 justify-between items-start sm:items-end">
      <div>
        <h1 class="text-2xl font-semibold text-forge-text">{t('user.settings.title')}</h1>
        <p class="text-forge-muted text-sm mt-1">{t('user.settings.desc')}</p>
      </div>
      {/* Los dos juntos, y el de «en todas partes» detrás: es el menos
          frecuente y el de consecuencias más amplias, así que no compite de
          igual a igual con el de cerrar esta sesión. */}
      <div class="flex flex-wrap items-center gap-2">
      <button id="btn-logout" class="bg-forge-panel border border-forge-border/60 hover:border-red-500/50 hover:bg-red-500/10 text-forge-muted hover:text-forge-error font-medium py-2 px-4 rounded-lg transition-colors flex items-center gap-2 text-sm shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        {t('user.settings.signout')}
      </button>
      {/*
        `logout-all` existía desde hace tiempo —revoca **todas** las sesiones
        del usuario— y no lo llamaba nadie: era una función de seguridad
        inalcanzable. Es lo que se necesita cuando sospechas que alguien tiene
        tu contraseña, o cuando cerraste sesión en un ordenador ajeno y no te
        acuerdas.
      */}
      <button id="btn-logout-all" class="bg-forge-panel border border-forge-border/60 hover:border-red-500/50 hover:bg-red-500/10 text-forge-muted hover:text-forge-error font-medium py-2 px-4 rounded-lg transition-colors flex items-center gap-2 text-sm shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="14" height="11" rx="2"/><path d="M6 19h8"/><path d="M10 15v4"/><rect x="18" y="9" width="4" height="11" rx="1"/></svg>
        {t('user.settings.signout_all')}
      </button>
      </div>
    </div>

    <div class="space-y-10">
      
      <!-- Public Profile Section -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="md:col-span-1">
          <h2 class="text-base font-semibold text-forge-text">{t('user.settings.public_profile')}</h2>
          <p class="text-sm text-forge-muted mt-1">{t('user.settings.public_desc')}</p>
        </div>
        
        <div class="md:col-span-2 bg-forge-panel border border-forge-border/60 rounded-xl shadow-sm overflow-hidden flex flex-col">
          <div class="p-6 space-y-7 flex-1">
            {/*
              El banner solo se podía cambiar desde el propio perfil público,
              pasando el ratón por encima de la imagen. Nada lo anunciaba, y a
              tu perfil no llevaba ningún enlace: era una función que había que
              descubrir por accidente. Aquí está donde se buscan las cosas del
              perfil, junto al resto.
            */}
            <div>
              <div class="flex items-center justify-between mb-2">
                <h3 class="font-semibold text-forge-text text-sm">{t('user.settings.banner')}</h3>
                {userProfile.banner_url && (
                  <button id="btn-remove-banner" class="text-xs font-semibold text-forge-muted hover:text-forge-error transition-colors">{t('user.settings.banner_remove')}</button>
                )}
              </div>
              <div class="relative group cursor-pointer w-full h-32 rounded-lg border border-forge-border/40 bg-forge-bg overflow-hidden shadow-sm" id="banner-preview-container">
                {userProfile.banner_url ? (
                  <img src={userProfile.banner_url} class="w-full h-full object-cover" id="banner-preview-img" alt="" loading="lazy" />
                ) : (
                  <div class="w-full h-full bg-gradient-to-r from-forge-secondary/30 via-forge-primary/20 to-forge-bg" id="banner-preview-empty"></div>
                )}
                <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2 text-white text-xs font-semibold z-10">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                  {t('user.settings.banner_change')}
                </div>
                <input type="file" id="banner-file-input" accept="image/*" aria-label={t('user.settings.banner_change')} class="absolute inset-0 opacity-0 cursor-pointer z-20" title={t('user.settings.banner_change')} />
              </div>
              <p class="text-xs text-forge-muted mt-2">{t('user.settings.banner_desc')}</p>
            </div>

            <div class="w-full h-px bg-forge-border/40"></div>

            <!-- Avatar -->
            <div class="flex items-center gap-6">
              <div class="relative group cursor-pointer w-24 h-24 rounded-full border border-forge-border/40 bg-forge-bg flex items-center justify-center overflow-hidden shadow-sm shrink-0" id="avatar-preview-container" data-user-id={user.id}>
                {user.avatar_url ? (
                  <img src={user.avatar_url} class="w-full h-full object-cover" id="avatar-preview-img" alt="User Avatar" loading="lazy" />
                ) : (
                  <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-forge-muted" id="avatar-preview-default"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                )}
                <!-- Hover Edit Overlay -->
                <div class="absolute inset-0 bg-black/50 hidden group-hover:flex items-center justify-center transition-all z-10 text-white">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                </div>
                <input type="file" id="avatar-file-input" accept="image/*" aria-label={t('user.settings.upload_avatar')} class="absolute inset-0 opacity-0 cursor-pointer z-20" title={t('user.settings.upload_avatar')} />
              </div>
              <div>
                <h3 class="font-semibold text-forge-text text-sm mb-1">{t('user.settings.picture')}</h3>
                <p class="text-xs text-forge-muted">{t('user.settings.picture_desc')}</p>
              </div>
            </div>

            <div class="w-full h-px bg-forge-border/40"></div>

            <!-- Form -->
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-semibold text-forge-text mb-2" for="profile-bio">{t('user.settings.bio')}</label>
                <textarea id="profile-bio" rows="3" class="w-full bg-forge-bg border border-forge-border/60 rounded-md p-3 text-sm text-forge-text focus:outline-none focus:border-forge-secondary focus:ring-1 focus:ring-forge-secondary shadow-sm transition-all resize-y placeholder:text-forge-muted" placeholder={t('user.settings.bio_placeholder') || "Tell us a little bit about yourself..."}>{userProfile.bio || ''}</textarea>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
                <div>
                  <label for="profile-pronouns" class="block text-sm font-semibold text-forge-text mb-2">{t('user.settings.pronouns')}</label>
                  <select id="profile-pronouns" class="w-full bg-forge-bg border border-forge-border/60 rounded-md p-2.5 text-sm text-forge-text focus:outline-none focus:border-forge-secondary focus:ring-1 focus:ring-forge-secondary shadow-sm transition-all cursor-pointer">
                    <option value="" selected={!userProfile.pronouns}>{t('user.settings.dont_specify')}</option>
                    <option value="they/them" selected={userProfile.pronouns === 'they/them'}>{t('user.settings.they_them')}</option>
                    <option value="she/her" selected={userProfile.pronouns === 'she/her'}>{t('user.settings.she_her')}</option>
                    <option value="he/him" selected={userProfile.pronouns === 'he/him'}>{t('user.settings.he_him')}</option>
                    <option value="custom" selected={userProfile.pronouns === 'custom'}>{t('user.settings.custom')}</option>
                  </select>
                </div>
                <div>
                  {/*
                    Antes esto era un `<select>` sin `id` ni listener, y lo que
                    se guardaba era un `<input type="hidden">` que nunca
                    cambiaba: elegir en el desplegable no hacía absolutamente
                    nada. Además ofrecía «elige un correo verificado» y una sola
                    opción, que ya era el valor actual — un menú de una entrada
                    sobre un concepto, el de correos verificados, que no existe.

                    La elección real es binaria: enseñar el correo de la cuenta
                    en el perfil público, o no enseñar ninguno.
                  */}
                  <label for="profile-email" class="block text-sm font-semibold text-forge-text mb-2">{t('user.settings.public_email')}</label>
                  {userProfile.email ? (
                    <select id="profile-email" class="w-full bg-forge-bg border border-forge-border/60 rounded-md p-2.5 text-sm text-forge-text focus:outline-none focus:border-forge-secondary focus:ring-1 focus:ring-forge-secondary shadow-sm transition-all cursor-pointer">
                      <option value="" selected={!userProfile.public_email}>{t('user.settings.email_hidden')}</option>
                      <option value={userProfile.email} selected={userProfile.public_email === userProfile.email}>{userProfile.email}</option>
                    </select>
                  ) : (
                    <>
                      <select id="profile-email" disabled class="w-full bg-forge-bg border border-forge-border/60 rounded-md p-2.5 text-sm text-forge-muted shadow-sm">
                        <option value="">{t('user.settings.no_email')}</option>
                      </select>
                      <p class="text-xs text-forge-muted mt-1">{t('user.settings.no_email_hint')}</p>
                    </>
                  )}
                </div>
              </div>
              
              <div class="pt-4 border-t border-forge-border/40 flex items-center justify-between">
                <div>
                  <h4 class="text-sm font-semibold text-forge-text">{t('user.settings.public_profile')}</h4>
                  <p class="text-xs text-forge-muted">{t('user.settings.public_profile_note')}</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="profile-is-public" class="sr-only peer" checked={userProfile.is_public !== 0} />
                  <div class="w-11 h-6 bg-forge-bg peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-forge-muted after:border-forge-muted after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-forge-primary peer-checked:after:bg-white border border-forge-border/60"></div>
                </label>
              </div>
            </div>
          </div>
          <!-- Card Footer -->
          <div class="bg-forge-bg px-6 py-4 border-t border-forge-border/40 flex justify-end">
              <button id="btn-save-profile" class="w-full bg-forge-primary text-forge-on-accent font-bold py-2 px-4 rounded hover:bg-forge-primary/90 transition-colors">
                {t('user.settings.save_profile')}
              </button>
          </div>
        </div>
      </section>

      <div class="h-px w-full bg-forge-border/40"></div>

      <!-- Account Settings Section -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="md:col-span-1">
          <h2 class="text-base font-semibold text-forge-text">{t('user.settings.account')}</h2>
          <p class="text-sm text-forge-muted mt-1">{t('user.settings.account_desc')}</p>
        </div>
        
        <div class="md:col-span-2 space-y-6">
          <div class="bg-forge-panel border border-forge-border/60 rounded-xl shadow-sm overflow-hidden flex flex-col">
            <div class="p-6 space-y-7 flex-1">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
                <div>
                  <label class="block text-sm font-semibold text-forge-text mb-2" for="username-input">Username</label>
                  <input type="text" id="username-input" value={user.username} class="w-full bg-forge-bg border border-forge-border/60 rounded-md p-2.5 text-sm text-forge-text focus:outline-none focus:border-forge-secondary focus:ring-1 focus:ring-forge-secondary shadow-sm" />
                </div>
                <div>
                  <label class="block text-sm font-semibold text-forge-text mb-2" for="theme-selector">{t('user.settings.theme')}</label>
                  <select id="theme-selector" class="w-full bg-forge-bg border border-forge-border/60 rounded-md p-2.5 text-sm text-forge-text focus:outline-none focus:border-forge-secondary focus:ring-1 focus:ring-forge-secondary shadow-sm cursor-pointer">
                    <option value="dark" selected={userProfile.theme_preference === 'dark'}>{t('user.settings.dark')}</option>
                    <option value="light" selected={userProfile.theme_preference === 'light'}>{t('user.settings.light')}</option>
                  </select>
                </div>
                
                <div class="mb-4">
                  <label class="block text-sm font-semibold text-forge-text mb-2" for="lang-selector">{t('user.settings.language')}</label>
                  <form method="post" action="/api/lang">
                    <input type="hidden" name="current_path" value="/settings" />
                    <select id="lang-selector" name="lang" onchange="this.form.submit()" class="w-full bg-forge-bg border border-forge-border/60 rounded-md p-2.5 text-sm text-forge-text focus:outline-none focus:border-forge-secondary focus:ring-1 focus:ring-forge-secondary shadow-sm cursor-pointer">
                      <option value="en" selected={lang === 'en'}>🇬🇧 English</option>
                      <option value="es" selected={lang === 'es'}>🇪🇸 Español</option>
                    </select>
                  </form>
                </div>
              </div>
              
              <div class="w-full h-px bg-forge-border/40"></div>

              <div class="space-y-4">
                <h3 class="font-semibold text-forge-text text-sm">{t('user.settings.change_password')}</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  {hasPassword ? (
                    <input type="password" id="current-password" aria-label={t('user.settings.old_password')} placeholder={t('user.settings.old_password') || "Old password"} class="w-full bg-forge-bg border border-forge-border/60 rounded-md p-2.5 text-sm text-forge-text focus:outline-none focus:border-forge-secondary shadow-sm" />
                  ) : (
                    <input type="hidden" id="current-password" value="" />
                  )}
                  <input type="password" id="new-password" aria-label={t('user.settings.new_password')} placeholder={t('user.settings.new_password') || "New password"} class="w-full bg-forge-bg border border-forge-border/60 rounded-md p-2.5 text-sm text-forge-text focus:outline-none focus:border-forge-secondary shadow-sm" />
                  <input type="password" id="confirm-password" aria-label={t('user.settings.confirm_password')} placeholder={t('user.settings.confirm_password') || "Confirm new"} class="w-full bg-forge-bg border border-forge-border/60 rounded-md p-2.5 text-sm text-forge-text focus:outline-none focus:border-forge-secondary shadow-sm" />
                </div>
              </div>
            </div>
            <!-- Card Footer -->
            <div class="bg-forge-bg px-6 py-4 border-t border-forge-border/40 flex justify-end">
              <button id="btn-save-settings" class="bg-forge-panel border border-forge-border/60 hover:bg-forge-border/40 text-forge-text font-bold py-2 px-6 rounded-md transition-colors text-sm shadow-sm">
                {t('user.settings.save_account')}
              </button>
            </div>
          </div>

          <!-- Connected Services -->
          <div class="bg-forge-panel border border-forge-border/60 rounded-xl shadow-sm overflow-hidden p-6">
            <h3 class="font-semibold text-forge-text text-sm mb-4">{t('user.settings.connected')}</h3>

            {oauthNotice && (
              <p
                class:list={[
                  'text-xs leading-relaxed mb-4 px-3 py-2 rounded-md border',
                  oauthNotice.kind === 'error'
                    ? 'text-forge-text bg-red-500/10 border-red-500/40'
                    : 'text-forge-text bg-green-500/10 border-green-500/40',
                ]}
                role="status"
              >
                {oauthNotice.text}
              </p>
            )}
            <div class="space-y-3">
              <!-- Google -->
              <div class="flex items-center justify-between p-3 border border-forge-border/60 rounded-md bg-forge-bg shadow-sm">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-white rounded-full p-1.5 flex items-center justify-center border border-forge-border/30">
                    <svg viewBox="0 0 48 48" class="w-full h-full"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
                  </div>
                  <div>
                    <h4 class="font-semibold text-forge-text text-sm leading-tight">{t('user.settings.google')}</h4>
                    <p class="text-[11px] text-forge-muted">{userProfile.google_id ? t('user.settings.linked') : t('user.settings.not_linked')}</p>
                  </div>
                </div>
                {userProfile.google_id ? (
                  <form method="POST" action="/api/auth/oauth/google/unlink">
                    <button type="submit" class="text-xs font-semibold px-4 py-1.5 rounded bg-forge-panel border border-forge-border/60 hover:border-forge-error/50 hover:text-forge-error transition-colors text-forge-text">
                      {t('user.settings.disconnect')}
                    </button>
                  </form>
                ) : oauthAvailable.google ? (
                  <a href="/api/auth/oauth/google" rel="nofollow" class="text-xs font-semibold px-4 py-1.5 rounded bg-forge-panel border border-forge-border/60 hover:bg-forge-border/40 transition-colors text-forge-text">
                    {t('user.settings.connect')}
                  </a>
                ) : (
                  <span class="text-[11px] text-forge-muted italic">{t('user.settings.unconfigured')}</span>
                )}
              </div>
              
              <!-- GitHub -->
              <div class="flex items-center justify-between p-3 border border-forge-border/60 rounded-md bg-forge-bg shadow-sm">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-white rounded-full p-1 flex items-center justify-center border border-forge-border/30">
                    <svg viewBox="0 0 24 24" class="w-full h-full text-black"><path fill="currentColor" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
                  </div>
                  <div>
                    <h4 class="font-semibold text-forge-text text-sm leading-tight">{t('user.settings.github')}</h4>
                    <p class="text-[11px] text-forge-muted">{userProfile.github_id ? t('user.settings.linked') : t('user.settings.not_linked')}</p>
                  </div>
                </div>
                {userProfile.github_id ? (
