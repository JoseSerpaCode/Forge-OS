<script is:inline define:vars={{
  confirmSignOutAll: t('user.settings.signout_all_confirm'),
  miNombre: user.username,
  txtConfirmSalir: t('confirm.signout'),
  // El servidor devuelve códigos (`{error_field, error_code}`), no frases. Sin
  // este mapa, el aviso enseñaba la respuesta cruda:
  //   Failed: {"error_field":"username","error_code":"charset"}
  // Es la pantalla diciéndole a una persona que mire un JSON.
  errores: Object.fromEntries(
    [
      'username.required','username.too_short','username.too_long','username.charset',
      'username.edge_punctuation','username.reserved','username.inappropriate',
      'username.looks_like_guest','username.taken',
      'email.required','email.invalid','email.too_long','email.taken',
      'password.too_short','password.too_long',
    ].map((k) => [k, t(`err.${k}` as any)])
  ),
  txtImg: {
    grande: t('user.settings.img_too_big'),
    invalida: t('user.settings.img_invalid'),
    subiendo: t('user.settings.img_uploading'),
    listo: t('user.settings.img_done'),
    fallo: t('user.settings.img_failed'),
  },
  txtAmigos: {
    ver: t('friends.view_profile'),
    aceptar: t('friends.accept'),
    rechazar: t('friends.reject'),
    cancelar: t('friends.cancel'),
    quitar: t('friends.remove'),
    pendiente: t('friends.awaiting'),
  },
  msgGuardado: t('user.settings.saved_ok'),
  msgRed: t('err.network'),
  msgGenerico: t('err.generic'),
  delTxt: {
    wouldHappen: t('account.delete.would_happen'),
    keeps: t('account.delete.keeps'),
    keepsNote: t('account.delete.keeps_note'),
    goes: t('account.delete.goes'),
    goesNote: t('account.delete.goes_note'),
    blocked: t('account.delete.blocked'),
    blockedNote: t('account.delete.blocked_note'),
    wsDeleted: t('account.delete.ws_deleted'),
    errMismatch: t('err.confirm_mismatch'),
    errPassword: t('err.bad_password'),
    errOwnership: t('err.workspace_ownership'),
    nIssues: t('account.delete.n_issues'),
    nPages: t('account.delete.n_pages'),
    nLogs: t('account.delete.n_logs'),
    nIssuesOne: t('account.delete.n_issues_one'),
    nPagesOne: t('account.delete.n_pages_one'),
    nLogsOne: t('account.delete.n_logs_one'),
  },
}}>
  const userId = document.getElementById('avatar-preview-container')?.getAttribute('data-user-id');
  const themeSelector = document.getElementById('theme-selector');
  if (themeSelector) {
    // Apply theme immediately
    themeSelector.addEventListener('change', () => {
      const selected = themeSelector.value;
      localStorage.setItem('forge_theme', selected);
      document.documentElement.setAttribute('data-theme', selected);
    });
  }

  /**
   * Redimensionar y subir una imagen.
   *
   * Era el cuerpo del manejador del avatar, escrito en línea y con las cinco
   * frases en inglés a mano («Uploading avatar...», «Image is too massive»).
   * El banner necesita exactamente lo mismo, así que o se sacaba a una función
   * o eran dos copias que se separan a la primera corrección.
   *
   * El redimensionado ocurre **aquí**, antes de subir: una foto de móvil son
   * cuatro megas, y lo que se ve son 96 píxeles de avatar. Subirla entera gasta
   * disco del servidor y salida de red cada vez que alguien la mira.
   */
  async function subirImagen(file, { maxAncho, nombre }) {
    if (file.size > 10 * 1024 * 1024) {
      window.showToast?.(txtImg.grande, true);
      return null;
    }

    const bitmap = await new Promise((ok, err) => {
      const reader = new FileReader();
      reader.onload = (ev) => {
        const img = new Image();
        img.onload = () => ok(img);
        img.onerror = err;
        img.src = ev.target?.result;
      };
      reader.onerror = err;
      reader.readAsDataURL(file);
    }).catch(() => null);

    if (!bitmap) { window.showToast?.(txtImg.invalida, true); return null; }

    let { width, height } = bitmap;
    if (width > maxAncho) { height = Math.round(height * (maxAncho / width)); width = maxAncho; }

    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    canvas.getContext('2d')?.drawImage(bitmap, 0, 0, width, height);

    const blob = await new Promise((ok) => canvas.toBlob(ok, 'image/webp', 0.85));
    if (!blob) { window.showToast?.(txtImg.fallo, true); return null; }

    const formData = new FormData();
    formData.append('entity_type', 'user');
    formData.append('entity_id', userId);
    formData.append('file', blob, nombre);

    window.showToast?.(txtImg.subiendo);
    try {
      const res = await fetch('/api/upload', { method: 'POST', body: formData });
      if (!res.ok) { window.showToast?.(txtImg.fallo, true); return null; }
      const data = await res.json();
      window.showToast?.(txtImg.listo);
      return data.url;
    } catch (e) {
      console.error('subir imagen:', e);
      window.showToast?.(txtImg.fallo, true);
      return null;
    }
  }

  let newAvatarUrl = null;
  document.getElementById('avatar-file-input')?.addEventListener('change', async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    // 512 basta: el avatar más grande que se pinta es de 96 px, y el doble
    // cubre las pantallas de densidad alta.
    const url = await subirImagen(file, { maxAncho: 512, nombre: 'avatar.webp' });
    if (!url) return;
    newAvatarUrl = url;

    const preview = document.getElementById('avatar-preview-img');
    if (preview) { preview.src = url; return; }
    const container = document.getElementById('avatar-preview-container');
    document.getElementById('avatar-preview-default')?.style.setProperty('display', 'none');
    const img = document.createElement('img');
    img.src = url;
    img.id = 'avatar-preview-img';
    img.className = 'w-full h-full object-cover z-0';
    container?.insertBefore(img, container.firstChild);
  });

  /**
   * El banner se guarda al soltarlo, no al pulsar «Guardar perfil».
   *
   * Es lo que ya hacía en el perfil público y lo que espera quien acaba de ver
   * la imagen puesta: si la pantalla ya enseña el banner nuevo, dar por hecho
   * que hace falta confirmar en otro sitio es cómo se pierden los cambios.
   */
  async function guardarBanner(url) {
    const res = await fetch('/api/user/settings', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ banner_url: url }),
    });
    if (!res.ok) { window.showToast?.(msgGenerico, true); return false; }
    return true;
  }

  document.getElementById('banner-file-input')?.addEventListener('change', async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    // Ancho completo de una tarjeta de perfil; 1600 cubre pantallas grandes.
    const url = await subirImagen(file, { maxAncho: 1600, nombre: 'banner.webp' });
    if (!url || !(await guardarBanner(url))) return;

    const contenedor = document.getElementById('banner-preview-container');
    let img = document.getElementById('banner-preview-img');
    if (!img) {
      document.getElementById('banner-preview-empty')?.remove();
      img = document.createElement('img');
      img.id = 'banner-preview-img';
      img.className = 'w-full h-full object-cover';
      img.alt = '';
      contenedor?.insertBefore(img, contenedor.firstChild);
    }
    img.src = url;
    document.getElementById('btn-remove-banner')?.classList.remove('hidden');
  });

  document.getElementById('btn-remove-banner')?.addEventListener('click', async () => {
    if (!(await guardarBanner(null))) return;
    document.getElementById('banner-preview-img')?.remove();
    const contenedor = document.getElementById('banner-preview-container');
    if (contenedor && !document.getElementById('banner-preview-empty')) {
      const vacio = document.createElement('div');
      vacio.id = 'banner-preview-empty';
      vacio.className = 'w-full h-full bg-gradient-to-r from-forge-secondary/30 via-forge-primary/20 to-forge-bg';
      contenedor.insertBefore(vacio, contenedor.firstChild);
    }
    document.getElementById('btn-remove-banner')?.classList.add('hidden');
  });

  const wrapper = document.getElementById('settings-wrapper');
  const i18nSaved = wrapper?.dataset?.i18nSaved || 'Saved';

  function showInlineSuccess(btn) {
    const existing = btn.nextElementSibling;
    if (existing?.classList.contains('inline-success-msg')) existing.remove();

    const msg = document.createElement('span');
    // Start with opacity-0 and transform
    msg.className = 'inline-success-msg text-forge-success font-bold text-sm flex items-center gap-1.5 opacity-0 transition-all duration-300 transform translate-x-2 pointer-events-none';
    msg.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="animate-bounce"><polyline points="20 6 9 17 4 12"></polyline></svg> ${i18nSaved}`;
    
    btn.parentNode.insertBefore(msg, btn.nextSibling);

    // Double requestAnimationFrame ensures the browser paints the starting state before transitioning
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        msg.classList.remove('opacity-0', 'translate-x-2');
        msg.classList.add('opacity-100', 'translate-x-0');
      });
    });

    setTimeout(() => {
      msg.classList.remove('opacity-100', 'translate-x-0');
      msg.classList.add('opacity-0', 'translate-x-2');
      // Wait for the exit transition to finish before removing
      setTimeout(() => msg.remove(), 300);
    }, 2500);
  }

  async function handleSave(btn, endpoint, payload, successMsg, onSuccess) {
    const originalText = btn.innerHTML;
    btn.innerHTML = '<span class="opacity-70">...</span>';
    btn.disabled = true;
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (res.ok) {
        window.showToast?.(successMsg);
        showInlineSuccess(btn);
        if (onSuccess) onSuccess();
      } else {
        // Se traduce el código; si llega algo que no está en el mapa, un
        // mensaje genérico. Nunca el cuerpo de la respuesta: puede traer
        // detalles internos y, sobre todo, no significa nada para quien lee.
        let mensaje = msgGenerico;
        try {
          const data = await res.json();
          if (data?.error_field && data?.error_code) {
            mensaje = errores[`${data.error_field}.${data.error_code}`] || msgGenerico;
          }
        } catch { /* respuesta sin JSON: se queda el genérico */ }
        window.showToast?.(mensaje, true);
      }
    } catch (e) {
      console.error(e);
      window.showToast?.(msgRed, true);
    } finally {
      btn.innerHTML = originalText;
      btn.disabled = false;
    }
  }

  const btnSaveProfile = document.getElementById('btn-save-profile');
    btnSaveProfile?.addEventListener('click', async () => {
      const payload = {
        bio: document.getElementById('profile-bio').value,
        pronouns: document.getElementById('profile-pronouns').value,
        public_email: document.getElementById('profile-email').value,
        is_public: document.getElementById('profile-is-public').checked,
      };

      // El avatar solo viaja si se ha elegido uno nuevo.
      //
      // Antes se mandaba siempre, y valía `null` cuando no se había tocado la
      // foto. El servidor distingue tres cosas —ausente = no tocar, `''` =
      // borrar, una cadena = ponerla— y `null` no es ninguna: `validateImageUrl`
      // lo rechazaba con «Invalid Avatar format». Es decir, **guardar el perfil
      // fallaba siempre** salvo que subieras una foto nueva en ese mismo
      // momento. La biografía, los pronombres y el correo no se guardaban nunca.
      if (newAvatarUrl) payload.avatar_url = newAvatarUrl;

      await handleSave(btnSaveProfile, '/api/user/settings', payload, msgGuardado);
    });

    document.getElementById('btn-logout-all')?.addEventListener('click', () => {
      window.forgeConfirm?.(confirmSignOutAll, async () => {
        try {
          const res = await fetch('/api/auth/logout-all', { method: 'POST' });
          if (res.ok) window.location.href = '/login';
        } catch (e) {
          console.error(e);
        }
      });
    });

    const btnLogout = document.getElementById('btn-logout');
    btnLogout?.addEventListener('click', () => {
      window.forgeConfirm?.(txtConfirmSalir, async () => {
        try {
          const res = await fetch('/api/auth/logout', { method: 'POST' });
          if (res.ok) window.location.href = '/login';
        } catch (e) {
          console.error(e);
        }
      });
    });

  // User settings save
  document.getElementById('btn-save-settings')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    const newUsername = document.getElementById('username-input').value;
    const currentPassword = document.getElementById('current-password').value;
    const newPassword = document.getElementById('new-password').value;
    const confirmPassword = document.getElementById('confirm-password').value;
    const theme_preference = document.getElementById('theme-selector').value;

    if (newPassword && newPassword !== confirmPassword) {
      // @ts-ignore
      return window.showToast('New passwords do not match!', true);
    }

    const payload = { username: newUsername, theme_preference };
    if (newAvatarUrl) {
      payload.avatar_url = newAvatarUrl;
    }
    // `current_password` va solo si se ha escrito. Quien entró por un
    // proveedor no tiene ninguna que dar, y exigirla aquí dejaba el campo
    // nuevo sin enviar: el servidor distingue los dos casos.
    if (newPassword) {
      payload.new_password = newPassword;
      if (currentPassword) payload.current_password = currentPassword;
    }

    await handleSave(btn, '/api/user/settings', payload, msgGuardado, () => {
      setTimeout(() => window.location.reload(), 1200);
    });
  });

  // Notifications logic
  const muteAllChk = document.getElementById('notif-mute-all');
  const catDiv = document.getElementById('notif-categories');
  muteAllChk?.addEventListener('change', (e) => {
    if (e.target.checked) {
      catDiv.style.opacity = '0.5';
      catDiv.style.pointerEvents = 'none';
    } else {
      catDiv.style.opacity = '1';
      catDiv.style.pointerEvents = 'auto';
    }
  });

  document.getElementById('btn-save-notifs')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    // Se lee solo lo que está en pantalla. La casilla de menciones ya no se
    // muestra —no hay menciones que silenciar—, y leerla aquí reventaría el
    // guardado entero con «Cannot read properties of null»: se perderían
    // también las otras cuatro preferencias.
    const leer = (id) => (document.getElementById(id)?.checked ? 1 : 0);
    const payload = {
      notif_mute_all: muteAllChk.checked ? 1 : 0,
      notif_mute_assign: leer('notif-mute-assign'),
      notif_mute_sprint: leer('notif-mute-sprint'),
      notif_mute_system: leer('notif-mute-system'),
    };
    await handleSave(btn, '/api/user/settings', payload, msgGuardado);
  });

  // Delete Workspace
  document.querySelectorAll('.btn-delete-ws').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const id = e.currentTarget.getAttribute('data-id');
      // @ts-ignore
      window.forgeConfirm(window.forgeMsg?.confirmarBorrarEspacio || '', async () => {
        const res = await fetch(`/api/workspaces/${id}`, { method: 'DELETE' });
        if (res.ok) {
          window.location.reload();
        } else {
          // @ts-ignore
          console.error('borrar espacio:', await res.text());
          window.showToast(window.forgeMsg?.errBorrarEspacio || '', true);
        }
      });
    });
  });

  // Leave Workspace
  document.querySelectorAll('.btn-leave-ws').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const wsId = e.currentTarget.getAttribute('data-id');
      const userId = e.currentTarget.getAttribute('data-user-id');
      
      // @ts-ignore
      window.forgeConfirm(window.forgeMsg?.confirmarSalirEspacio || '', async () => {
        const res = await fetch(`/api/workspaces/${wsId}/members`, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId })
        });
        
        if (res.ok) {
          window.location.reload();
        } else {
          // @ts-ignore
          console.error('salir del espacio:', await res.text());
          window.showToast(window.forgeMsg?.errSalirEspacio || '', true);
        }
      });
    });
  });

  // ── Borrado permanente de la cuenta ────────────────────────────────────────
  (function () {
    const abrir = document.getElementById('btn-open-delete');
    const panel = document.getElementById('delete-panel');
    const cajaConsecuencias = document.getElementById('delete-consequences');
    const formulario = document.getElementById('delete-form');
    const campoNombre = document.getElementById('delete-confirm-username');
    const campoPassword = document.getElementById('delete-password');
    const botonBorrar = document.getElementById('btn-confirm-delete');
    const botonCancelar = document.getElementById('btn-cancel-delete');
    if (!abrir || !panel) return;

    const esc = (v) => String(v).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

    function pintar(p) {
      const bloqueado = p.blocking && p.blocking.length > 0;
      let html = '';

      if (bloqueado) {
        html += '<div class="rounded-lg border border-red-500/50 bg-red-500/10 p-3">' +
          '<p class="font-bold text-red-500">' + esc(delTxt.blocked) + '</p>' +
          '<p class="text-forge-text mt-1">' + esc(delTxt.blockedNote) + '</p>' +
          '<ul class="mt-2 list-disc list-inside text-forge-text">' +
          p.blocking.map((w) => '<li>' + esc(w.name) + '</li>').join('') +
          '</ul></div>';
      }

      if (p.workspacesDeleted && p.workspacesDeleted.length) {
        html += '<div class="rounded-lg border border-forge-border/60 p-3">' +
          '<p class="font-bold text-forge-text">' + esc(delTxt.goes) + '</p>' +
          // Estando bloqueado, «estos espacios se borrarán» afirma algo que no
          // va a pasar: el borrado está detenido. Se pasa a condicional para no
          // contradecir al aviso rojo de justo encima.
          (bloqueado ? '<p class="text-forge-muted mt-1 italic">' + esc(delTxt.wouldHappen) + '</p>' : '') +
          '<p class="text-forge-muted mt-1">' + esc(delTxt.goesNote) + '</p>' +
          '<p class="text-forge-text mt-2 font-semibold">' + esc(delTxt.wsDeleted) + '</p>' +
          '<ul class="mt-1 list-disc list-inside text-forge-text">' +
          p.workspacesDeleted.map((w) => '<li>' + esc(w.name) + '</li>').join('') +
          '</ul></div>';
      } else {
        html += '<div class="rounded-lg border border-forge-border/60 p-3">' +
          '<p class="font-bold text-forge-text">' + esc(delTxt.goes) + '</p>' +
          '<p class="text-forge-muted mt-1">' + esc(delTxt.goesNote) + '</p></div>';
      }

      const conservado = (p.issuesReported || 0) + (p.pagesCreated || 0) + (p.workLogs || 0);
      if (conservado > 0) {
        html += '<div class="rounded-lg border border-forge-border/60 p-3">' +
          '<p class="font-bold text-forge-text">' + esc(delTxt.keeps) + '</p>' +
          '<p class="text-forge-muted mt-1">' + esc(delTxt.keepsNote) + '</p>' +
          // Con etiqueta. Tres números sueltos separados por puntos no dicen
          // qué se está contando, y esta es justo la pantalla donde hace falta
          // entenderlo a la primera.
          // Singular cuando toca. «1 tickets reportados» chirría justo en la
          // pantalla que más calma necesita transmitir.
          '<ul class="mt-2 text-forge-text list-disc list-inside">' +
          '<li>' + p.issuesReported + ' ' + esc(p.issuesReported === 1 ? delTxt.nIssuesOne : delTxt.nIssues) + '</li>' +
          '<li>' + p.pagesCreated + ' ' + esc(p.pagesCreated === 1 ? delTxt.nPagesOne : delTxt.nPages) + '</li>' +
          '<li>' + p.workLogs + ' ' + esc(p.workLogs === 1 ? delTxt.nLogsOne : delTxt.nLogs) + '</li>' +
          '</ul></div>';
      }

      cajaConsecuencias.innerHTML = html;
      // Sin salida posible, el formulario sobra: enseñarlo invita a pelearse
      // con un botón que no va a funcionar.
      formulario.classList.toggle('hidden', bloqueado);
    }

    // El botón permanece apagado hasta que el nombre coincida exactamente. Un
    // botón rojo activo sobre un formulario vacío invita a pulsarlo para «ver
    // qué pasa», y lo que pasa es un error; aquí la respuesta a un clic
    // distraído debe ser que no ocurra nada.
    const revisarNombre = () => {
      if (!botonBorrar || !campoNombre) return;
      botonBorrar.disabled = campoNombre.value !== miNombre;
    };
    campoNombre?.addEventListener('input', revisarNombre);

    abrir.addEventListener('click', async () => {
      panel.classList.remove('hidden');
      abrir.classList.add('hidden');
      try {
        const res = await fetch('/api/user/account');
        if (res.ok) pintar(await res.json());
      } catch (e) {
        console.error('[ACCOUNT]', e);
      }
    });

    botonCancelar?.addEventListener('click', () => {
      panel.classList.add('hidden');
      abrir.classList.remove('hidden');
      if (campoNombre) campoNombre.value = '';
      if (campoPassword) campoPassword.value = '';
      revisarNombre();
    });

    botonBorrar?.addEventListener('click', async () => {
      botonBorrar.disabled = true;
      try {
        const res = await fetch('/api/user/account', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            confirm_username: campoNombre?.value || '',
            password: campoPassword?.value || '',
          }),
        });

        if (res.ok) {
          // A la portada, que es lo único que queda accesible sin cuenta.
          window.location.href = '/';
          return;
        }

        const data = await res.json().catch(() => ({}));
        const mensajes = {
          confirm_mismatch: delTxt.errMismatch,
          bad_password: delTxt.errPassword,
          workspace_ownership: delTxt.errOwnership,
        };
        window.showToast?.(mensajes[data.error_code] || 'Error', true);
        if (data.error_code === 'workspace_ownership' && data.preview) pintar(data.preview);
      } catch (e) {
        window.showToast?.(String(e), true);
      } finally {
        revisarNombre();
      }
    });
  })();
</script>