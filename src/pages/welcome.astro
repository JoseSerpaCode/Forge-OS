---
/**
 * La portada, siempre, tengas sesión o no.
 *
 * `/` decide por sesión: con cuenta muestra el hub, sin ella la portada. El
 * efecto secundario es que una vez dentro —con cuenta o como invitado— **no
 * había ninguna forma de volver a verla**. Ni para enseñársela a alguien, ni
 * para releer qué prometía, ni para copiar los comandos de instalación.
 *
 * Esta ruta existe solo para eso. No es un objetivo de búsqueda: lleva
 * `noindex` y su canónica apunta a `/`, porque servir el mismo contenido en dos
 * URL indexables es contenido duplicado, y Google reparte el crédito entre las
 * dos en vez de dárselo a la que importa.
 */
import Landing from '../components/landing/Landing.astro';
import PublicLayout from '../layouts/PublicLayout.astro';
import { textosPortada } from '../components/landing/textosPortada';

const lang = Astro.locals.lang || 'en';
const meta = textosPortada(lang).meta;
---

<PublicLayout
  title={meta.title}
  description={meta.desc}
  canonicalPath="/"
  noindex
>
  <Landing />
</PublicLayout>
