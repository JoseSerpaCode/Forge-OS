---
import PublicLayout from '../layouts/PublicLayout.astro';
import AuthShell from '../components/auth/AuthShell.astro';
import AuthForm from '../components/auth/AuthForm.astro';
import { useTranslations } from '../i18n/ui';
import db from '../lib/db';

const user = Astro.locals.user;
if (user && !user.is_guest) return Astro.redirect('/');

let guestWorkspaces: { id: string; name: string }[] = [];
if (user?.is_guest) {
  guestWorkspaces = db
    .prepare(
      `SELECT w.id, w.name FROM workspaces w
       JOIN workspace_members wm ON w.id = wm.workspace_id
       WHERE wm.user_id = ?`
    )
    .all(user.id) as { id: string; name: string }[];
}

const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);

// `/api/auth/guest` manda aquí con `?reason=guest_limit` cuando alguien agota el
// límite por IP. Hasta ahora nadie leía el parámetro, así que esa persona
// aterrizaba en un formulario de registro sin que nada explicara por qué el
// botón de «probar sin cuenta» no había hecho lo que decía.
const reason = Astro.url.searchParams.get('reason');
const notice = reason === 'guest_limit' ? t('auth.reason.guest_limit') : null;
---

<PublicLayout title={`${t('auth.register.title')} | Forge OS`} description={t('auth.register.sub')}>
  <AuthShell heading={t('auth.register.title')} sub={t('auth.register.sub')}>
    {notice && <p slot="notice" class="au-notice">{notice}</p>}
    <AuthForm mode="register" guestWorkspaces={guestWorkspaces} />
    <Fragment slot="swap">
      <a href="/login" class="au-swap-link">{t('auth.have_account')}</a>
    </Fragment>
  </AuthShell>
</PublicLayout>

<style is:global>
  .au-swap-link {
    color: var(--forge-accent-text);
    text-decoration: none;
    font-weight: 600;
  }
  .au-swap-link:hover { text-decoration: underline; }

  .au-notice {
    margin: 0 0 1.25rem;
    padding: 0.7rem 0.85rem;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--forge-text);
    background: color-mix(in srgb, var(--forge-info) 12%, var(--forge-panel));
    border: 1px solid color-mix(in srgb, var(--forge-info) 40%, transparent);
    border-left: 3px solid var(--forge-info);
    border-radius: 0.45rem;
  }
</style>
