---
// La raíz sirve dos páginas distintas según quién llame.
//
// Antes exigía sesión, y quien no la tenía recibía una cuenta de invitado
// creada por el middleware y un salto directo a un espacio de trabajo vacío:
// cuatro filas escritas por cada visita anónima, y ningún sitio donde explicar
// qué es esto.
//
// El hub vive ahora en components/dashboard/Hub.astro, sin cambios. El motivo
// de separarlo es que sus consultas a la base de datos están en el frontmatter
// y no deben ejecutarse para alguien que solo viene a mirar.
import Hub from '../components/dashboard/Hub.astro';
import Landing from '../components/landing/Landing.astro';
import PublicLayout from '../layouts/PublicLayout.astro';
import { useTranslations } from '../i18n/ui';

const user = Astro.locals.user;
const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);
---

{
  user ? (
    <Hub />
  ) : (
    <PublicLayout title={t('landing.meta.title')} description={t('landing.meta.desc')}>
      <Landing />
    </PublicLayout>
  )
}
