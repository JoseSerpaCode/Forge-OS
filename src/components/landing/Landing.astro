---
import { useTranslations } from '../../i18n/ui';
import pkg from '../../../package.json';
import Bento from './Bento.astro';
import Logo from '../brand/Logo.astro';
import LangSwitch from '../i18n/LangSwitch.astro';
import ThemeSwitch from '../i18n/ThemeSwitch.astro';
import TypeDemo from './TypeDemo.astro';
import Showcase from './Showcase.astro';
import Changelog from './Changelog.astro';

const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);
const version = pkg.version;

// La portada también se ve **con sesión iniciada**, desde /welcome. Ofrecerle
// «Crear cuenta» y «Probar sin cuenta» a alguien que ya está dentro es, en el
// mejor caso, ruido; en el peor, un botón que le crea una cuenta de invitado y
// le tira de la suya.
const user = Astro.locals.user;
const signedIn = Boolean(user);
const isGuest = user?.is_guest === 1;

// Las tres ideas del producto. Ya no llevan captura propia —las cuatro
// capturas están juntas en el carrusel de arriba, donde se comparan mejor y no
// obligan a bajar cuatro pantallas para verlas—, sino un dibujo de línea que
// resume la idea sin competir con el texto.
const sections = [
  {
    eyebrow: t('landing.f1.eyebrow'),
    title: t('landing.f1.title'),
    body: t('landing.f1.body'),
    art: 'board',
  },
  {
    eyebrow: t('landing.f2.eyebrow'),
    title: t('landing.f2.title'),
    body: t('landing.f2.body'),
    art: 'links',
  },
  {
    eyebrow: t('landing.f3.eyebrow'),
    title: t('landing.f3.title'),
    body: t('landing.f3.body'),
    art: 'files',
  },
  {
    eyebrow: t('landing.f4.eyebrow'),
    title: t('landing.f4.title'),
    body: t('landing.f4.body'),
    art: 'chart',
  },
];
---

<header class="lp-nav">
  <Logo href="/" size="md" />
  <nav class="lp-nav-actions">
    <ThemeSwitch />
    <LangSwitch />
    <a href="https://github.com/JoseSerpaCode/Forge-OS" target="_blank" rel="noopener noreferrer" class="lp-link">GitHub</a>
    {signedIn ? (
      <a href="/" class="lp-btn lp-btn-primary">{t('landing.open')}</a>
    ) : (
      <>
        <a href="/login" class="lp-link">{t('landing.signin')}</a>
        <a href="/register" class="lp-btn lp-btn-ghost">{t('landing.signup')}</a>
      </>
    )}
  </nav>
</header>

<main class="lp">
  <section class="lp-hero">
   <div class="lp-hero-text">
    <p class="lp-eyebrow">{t('landing.eyebrow')}</p>

    {/*
      El elemento memorable de la página: el titular no describe el producto,
      LO ES. La tesis de Forge OS es que todo el trabajo cabe en un archivo que
      controlas tú, así que el archivo aparece dentro del titular, en mono,
      chocando con la Inter enorme. Notion resalta una palabra con una píldora
      azul; aquí es un artefacto monoespaciado sobre casi negro.
    */}
    <h1 class="lp-h1">
      {t('landing.h1.before')}
      <span class="lp-file">forge.db</span>
    </h1>

    <p class="lp-sub">{t('landing.sub')}</p>

    <div class="lp-cta">
      {signedIn ? (
        <>
          <a href="/" class="lp-btn lp-btn-primary">{t('landing.open')}</a>
          {isGuest && <a href="/register" class="lp-btn lp-btn-ghost">{t('landing.keep')}</a>}
        </>
      ) : (
        <>
          <form method="POST" action="/api/auth/guest">
            <button type="submit" class="lp-btn lp-btn-primary">{t('landing.try')}</button>
          </form>
          <a href="/login" class="lp-btn lp-btn-ghost">{t('landing.signin')}</a>
        </>
      )}
    </div>

    {/*
      La advertencia va pegada al botón, no escondida tras el registro: una
      cuenta temporal que caduca sin avisar y se lleva el trabajo por delante
      es una trampa, por barata que salga la conversión.
    */}
    {!signedIn && <p class="lp-caveat">{t('landing.try.caveat')}</p>}
    {isGuest && <p class="lp-caveat">{t('landing.guest.caveat')}</p>}
   </div>

   {/*
     La captura gigante que había aquí enseñaba el producto quieto. Esto lo
     enseña funcionando, pesa unos KB en vez de cientos, y se lee nítido en
     cualquier pantalla porque es HTML y no una imagen escalada.
   */}
   <div class="lp-hero-demo"><TypeDemo /></div>
  </section>

  <Showcase />

  <Bento />

  <section class="lp-facts">
    <dl>
      <div><dt>{t('landing.fact1.k')}</dt><dd>{t('landing.fact1.v')}</dd></div>
      <div><dt>{t('landing.fact2.k')}</dt><dd>{t('landing.fact2.v')}</dd></div>
      <div><dt>{t('landing.fact3.k')}</dt><dd>{t('landing.fact3.v')}</dd></div>
      <div><dt>{t('landing.fact4.k')}</dt><dd>MIT</dd></div>
    </dl>
  </section>

  <div class="lp-cards">
    {sections.map((s) => (
      <section class="lp-card">
        {/*
          Dibujos de línea, no ilustraciones a todo color. Se hacen con cuatro
          trazos, pesan nada, heredan el color de marca y —al no representar
          personas ni escenas— no envejecen ni chocan con el tono del producto.
          Son decorativos: lo que dicen ya está escrito debajo.
        */}
        <div class="lp-art" aria-hidden="true">
          {s.art === 'board' && (
            <svg viewBox="0 0 120 80" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="14" width="30" height="58" rx="4" opacity="0.5" />
              <rect x="45" y="14" width="30" height="58" rx="4" opacity="0.5" />
              <rect x="86" y="14" width="30" height="58" rx="4" opacity="0.5" />
              <rect x="9" y="22" width="20" height="9" rx="2.5" />
              <rect x="9" y="36" width="20" height="9" rx="2.5" opacity="0.55" />
              <rect x="91" y="22" width="20" height="9" rx="2.5" opacity="0.55" />
              <rect x="50" y="49" width="20" height="9" rx="2.5" class="lp-art-hot" />
              <path d="M32 27c8 3 10 12 17 20" stroke-dasharray="3 4" opacity="0.8" />
              <path d="M46 44l4 3-4 3" />
            </svg>
          )}
          {s.art === 'links' && (
            <svg viewBox="0 0 120 80" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="6" y="12" width="38" height="50" rx="4" opacity="0.5" />
              <path d="M13 24h24M13 32h20M13 40h24M13 48h14" opacity="0.7" />
              <rect x="76" y="20" width="38" height="42" rx="4" opacity="0.5" />
              <path d="M83 32h24M83 40h16" opacity="0.7" />
              <path d="M47 30h24" class="lp-art-hot" />
              <path d="M67 26l5 4-5 4" class="lp-art-hot" />
              <path d="M73 48H49" class="lp-art-hot" />
              <path d="M53 44l-5 4 5 4" class="lp-art-hot" />
            </svg>
          )}
          {s.art === 'files' && (
            <svg viewBox="0 0 120 80" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              {/* Una carpeta abajo, una nube arriba y la flecha que va de una a
                  otra sin tocar el servidor. Es literalmente lo que hace. */}
              <path d="M6 62V22a4 4 0 014-4h16l6 7h20a4 4 0 014 4v33a4 4 0 01-4 4H10a4 4 0 01-4-4z" opacity="0.5" />
              <path d="M86 30a13 13 0 00-25 3 10 10 0 00.5 20h25a12 12 0 000-23z" opacity="0.5" transform="translate(16 4)" />
              <path d="M62 40h22" class="lp-art-hot" stroke-dasharray="3 4" />
              <path d="M80 36l5 4-5 4" class="lp-art-hot" />
              <path d="M18 34h18M18 44h12" opacity="0.7" />
            </svg>
          )}
          {s.art === 'chart' && (
            <svg viewBox="0 0 120 80" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 8v58h96" opacity="0.5" />
              <rect x="24" y="44" width="13" height="22" rx="2" opacity="0.6" />
              <rect x="45" y="34" width="13" height="32" rx="2" opacity="0.6" />
              <rect x="66" y="48" width="13" height="18" rx="2" opacity="0.6" />
              <rect x="87" y="24" width="13" height="42" rx="2" class="lp-art-hot" />
              <path d="M26 36c14-4 22 6 34-6s20-6 34-14" stroke-dasharray="3 4" class="lp-art-hot" />
            </svg>
          )}
        </div>
        <p class="lp-eyebrow">{s.eyebrow}</p>
        <h2 class="lp-h3">{s.title}</h2>
        <p class="lp-body">{s.body}</p>
      </section>
    ))}
  </div>

  {/*
    La etiqueta cruzando las tres cosas.

    Es la diferencia real con tener Trello, Notion y Drive por separado, y era
    lo único de lo que la página hablaba sin enseñarlo. Va en HTML y CSS, sin
    JavaScript ni imágenes: pesa poco más que el texto que contiene, y el
    lector de pantalla lee las tres tarjetas como lo que son.
  */}
  <section class="lp-cross">
    <h2 class="lp-h2">{t('landing.cross.title')}</h2>
    <p class="lp-body lp-cross-lead">{t('landing.cross.body')}</p>

    <div class="lp-cross-row">
      {[
        { k: 'task', icon: 'M9 11l3 3L22 4', box: true },
        { k: 'note', icon: 'M15 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V7z' },
        { k: 'file', icon: 'M20 20a2 2 0 002-2V8a2 2 0 00-2-2h-7.9a2 2 0 01-1.69-.9L9.6 3.9A2 2 0 007.93 3H4a2 2 0 00-2 2v13a2 2 0 002 2z' },
      ].map((c) => (
        <article class="lp-cross-card">
          <span class="lp-cross-kind">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={c.icon} />
            </svg>
            {t(`landing.cross.${c.k}.kind` as any)}
          </span>
          <p class="lp-cross-name">{t(`landing.cross.${c.k}.name` as any)}</p>
          <span class="lp-chip"><span class="lp-chip-dot"></span>{t('landing.cross.label')}</span>
        </article>
      ))}
    </div>
  </section>

  {/*
    Por qué esto y no otra cosa.
    
    Quien llega de un buscador no está comparando arquitecturas: está decidiendo
    si le compensa mudarse de donde ya está. Las tres razones van con su
    contrapartida dicha —hace falta un sitio donde correrlo—, porque una lista
    de ventajas sin ningún «pero» se lee como publicidad y se descarta entera.
  */}
  <section class="lp-why">
    <h2 class="lp-h2">{t('landing.why.title')}</h2>
    <div class="lp-why-grid">
      {[1, 2, 3].map((n) => (
        <div class="lp-why-item">
          <h3>{t(`landing.why.${n}.t` as any)}</h3>
          <p>{t(`landing.why.${n}.b` as any)}</p>
        </div>
      ))}
    </div>
  </section>

  <Changelog />

  <section class="lp-end">
    <h2 class="lp-h2">{t('landing.end.title')}</h2>
    <p class="lp-body">{t('landing.end.body')}</p>
    <div class="lp-cta">
      {signedIn ? (
        <a href="/" class="lp-btn lp-btn-primary">{t('landing.open')}</a>
      ) : (
        <>
          <form method="POST" action="/api/auth/guest">
            <button type="submit" class="lp-btn lp-btn-primary">{t('landing.try')}</button>
          </form>
          <a href="/register" class="lp-btn lp-btn-ghost">{t('landing.signup')}</a>
        </>
      )}
    </div>
    {!signedIn && <p class="lp-caveat">{t('landing.try.caveat')}</p>}
  </section>

  {/*
    El pie era una sola línea con la versión y dos enlaces: cerraba la página
    de golpe, sin darle fondo a nada. Este reparte lo que hay en cuatro
    columnas —producto, código, legal— y **solo enlaza a sitios que existen**:
    nada de un «Precios» o un «Blog» de adorno que lleve a un 404.
  */}
  <footer class="lp-foot">
    <div class="lp-foot-top">
      <div class="lp-foot-brand">
        <Logo href="/" size="md" />
        <p class="lp-foot-pitch">{t('foot.pitch')}</p>
        {signedIn ? (
          <a href="/" class="lp-btn lp-btn-ghost lp-foot-cta">{t('landing.open')}</a>
        ) : (
          <form method="POST" action="/api/auth/guest">
            <button type="submit" class="lp-btn lp-btn-ghost lp-foot-cta">{t('landing.try')}</button>
          </form>
        )}
      </div>

      <nav class="lp-foot-cols" aria-label={t('foot.nav')}>
        <div class="lp-foot-col">
          <h2>{t('foot.product')}</h2>
          {signedIn ? (
            <a href="/" class="lp-link">{t('landing.open')}</a>
          ) : (
            <>
              <a href="/register" class="lp-link">{t('landing.signup')}</a>
              <a href="/login" class="lp-link">{t('landing.signin')}</a>
            </>
          )}
          <a href="#sc-title" class="lp-link">{t('foot.screens')}</a>
        </div>
        <div class="lp-foot-col">
          <h2>{t('foot.code')}</h2>
          <a href="https://github.com/JoseSerpaCode/Forge-OS" target="_blank" rel="noopener noreferrer" class="lp-link">{t('foot.repo')}</a>
          <a href="https://github.com/JoseSerpaCode/Forge-OS/issues" target="_blank" rel="noopener noreferrer" class="lp-link">{t('foot.issues')}</a>
          <a href="https://github.com/JoseSerpaCode/Forge-OS/blob/main/deploy/README.md" target="_blank" rel="noopener noreferrer" class="lp-link">{t('foot.deploy')}</a>
        </div>
        <div class="lp-foot-col">
          <h2>{t('foot.legal')}</h2>
          <a href="https://github.com/JoseSerpaCode/Forge-OS/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="lp-link">{t('foot.license')}</a>
          <span class="lp-foot-note">{t('foot.privacy')}</span>
        </div>
      </nav>
    </div>

    <div class="lp-foot-bottom">
      <span class="lp-foot-ver">Forge OS v{version}</span>
    </div>
  </footer>
</main>

<style>
  /* Todo sale de los tokens de themes.css. La paleta está calibrada a cero
     fallos WCAG AA y hay reglas sobre qué token es texto y cuál es marca
     (ver CLAUDE.md): --forge-accent-text para naranja sobre fondo, y
     --forge-on-accent para texto encima del naranja. */

  .lp {
    --lp-max: 1120px;
    --lp-gap: clamp(5rem, 12vw, 9rem);
    max-width: var(--lp-max);
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 5vw, 2rem);
  }

  /* ── Navegación ─────────────────────────────────────────────────────── */
  .lp-nav {
    max-width: 1120px;
    margin: 0 auto;
    padding: 1.5rem clamp(1.25rem, 5vw, 2rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .lp-nav-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    white-space: nowrap;
  }

  /* En pantallas estrechas no cabe todo sin partir palabras. GitHub sale del
     encabezado: sigue en el pie y en los datos, así que no se pierde. */
  @media (max-width: 30rem) {
    .lp-nav { padding-inline: 1.25rem; gap: 0.75rem; }
    .lp-nav-actions { gap: 0.9rem; }
    .lp-nav-actions .lp-link:first-child { display: none; }
    .lp-btn { padding: 0.7rem 1rem; font-size: 0.9rem; }
  }

  /* ── Tipografía ─────────────────────────────────────────────────────── */
  /* La mono no decora: es la voz de los artefactos del producto —rutas,
     tamaños, licencias—. Por eso lleva los antetítulos y los datos. */
  .lp-eyebrow {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--forge-muted);
    margin: 0 0 1.25rem;
  }

  /* El 8.5vw venía de cuando el titular ocupaba el ancho entero. Ahora vive en
     media columna, y con ese tamaño se partía en cinco líneas y estiraba el
     hero a dos pantallas. El `min()` con `7vw` lo ata al ancho real disponible
     sin renunciar al tamaño en pantallas pequeñas, donde sigue a una columna. */
  .lp-h1 {
    font-size: clamp(2.6rem, 7vw, 4.4rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 800;
    color: var(--forge-text);
    margin: 0;
    text-wrap: balance;
  }

  .lp-h2 {
    font-size: clamp(1.9rem, 4.5vw, 3.1rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 800;
    color: var(--forge-text);
    margin: 0 0 1rem;
    text-wrap: balance;
  }

  /* El chip del archivo. Va a 0.62em del titular para que quepa en móvil
     sin desbordar, y como inline-block para que envuelva entero en vez de
     partirse por la mitad. */
  .lp-file {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.62em;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--forge-accent-text);
    background: color-mix(in srgb, var(--forge-accent-primary) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--forge-accent-primary) 35%, transparent);
    border-radius: 0.5rem;
    padding: 0.12em 0.4em;
    box-shadow: 0 0 40px color-mix(in srgb, var(--forge-accent-primary) 22%, transparent);
    display: inline-block;
    white-space: nowrap;
    /* El chip es 0.62em del titular; sin este empuje su caja se cuelga por
       debajo de la línea base de la Inter y el conjunto parece descolgado. */
    transform: translateY(-0.06em);
  }

  .lp-sub, .lp-body {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.6;
    color: var(--forge-muted);
    margin: 1.75rem 0 0;
    max-width: 46ch;
  }
  .lp-body { margin-top: 0; }

  /* ── Hero ───────────────────────────────────────────────────────────── */
  .lp-hero {
    padding: clamp(3rem, 9vw, 6rem) 0 0;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }
  /* A dos columnas solo cuando hay sitio de verdad. Por debajo, la demo se
     pone bajo el texto: partirla antes deja el titular en cuatro palabras por
     línea. La proporción 1.05/1 da a la demo casi la mitad sin comerse el
     titular, que sigue siendo lo primero que hay que leer. */
  @media (min-width: 64rem) {
    .lp-hero { grid-template-columns: 1.05fr 1fr; }
    .lp-h1 { font-size: clamp(2.8rem, 4.2vw, 3.9rem); }
  }
  .lp-hero-text { min-width: 0; }
  .lp-hero-demo { min-width: 0; }
  /* El calor de la forja, que hasta ahora el nombre prometía y el diseño no
     daba. Difuso, detrás de todo y anclado al chip del archivo, así que
     refuerza el elemento protagonista en vez de competir con él. */
  .lp-hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 12%;
    left: -12%;
    width: min(680px, 90%);
    aspect-ratio: 1.6;
    background: radial-gradient(
      ellipse at 30% 50%,
      color-mix(in srgb, var(--forge-accent-primary) 38%, transparent),
      transparent 68%
    );
    filter: blur(70px);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .lp-hero::before { animation: heat 9s ease-in-out infinite alternate; }
  }
  @keyframes heat {
    from { opacity: 0.75; transform: scale(1); }
    to   { opacity: 1; transform: scale(1.08); }
  }

  .lp-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .lp-caveat {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--forge-muted);
    margin: 1rem 0 0;
    max-width: 52ch;
  }

  /* ── Botones ────────────────────────────────────────────────────────── */
  .lp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.4rem;
    border-radius: 0.6rem;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s, transform 0.15s;
  }
  /* El naranja aparece exactamente aquí y en el chip del archivo. Nada más.
     Un acento repartido por toda la página deja de ser un acento. */
  .lp-btn-primary {
    background: var(--forge-accent-primary);
    color: var(--forge-on-accent);
  }
  .lp-btn-primary:hover { background: var(--forge-accent-primary-hover); }
  .lp-btn-ghost {
    background: transparent;
    color: var(--forge-text);
    border-color: var(--forge-border);
  }
  .lp-btn-ghost:hover { border-color: var(--forge-muted); }
  .lp-btn:active { transform: translateY(1px); }

  .lp-link {
    color: var(--forge-muted);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.15s;
  }
  .lp-link:hover { color: var(--forge-text); }

  /* ── Datos ──────────────────────────────────────────────────────────── */
  /* La banda de cifras se lee de un vistazo, así que no necesita el aire de una
     sección: con `--lp-gap` arriba quedaba flotando en medio de dos vacíos y no
     se veía a qué pertenecía. */
  .lp-facts { margin-top: calc(var(--lp-gap) * 0.55); }
  .lp-facts dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 2rem;
    margin: 0;
