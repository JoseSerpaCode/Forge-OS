---
/**
 * Portada «Taller» (docs/rediseno/portada.html).
 *
 * El marcado y las clases son los de la maqueta; los estilos, en
 * `styles/portada.css` con alcance `.portada`. Los textos están en
 * `textosPortada.ts` y las figuras en `figuras.ts`.
 *
 * La portada también se ve **con sesión iniciada**, desde /welcome. A quien ya
 * está dentro no se le ofrece «Crear cuenta» ni «Probar sin cuenta»: en el
 * peor caso, ese botón le crearía una cuenta de invitado y le sacaría de la
 * suya.
 */
import '../../styles/portada.css';
import raw from '../../../CHANGELOG.md?raw';
import pkg from '../../../package.json';
import { parseChangelog } from '../../lib/changelog';
import { fecha } from '../../lib/fechas';
import LangSwitch from '../i18n/LangSwitch.astro';
import ThemeSwitch from '../i18n/ThemeSwitch.astro';
import { textosPortada } from './textosPortada';
import { FIGURAS } from './figuras';

const lang = Astro.locals.lang || 'en';
const x = textosPortada(lang);
const user = Astro.locals.user;
const signedIn = Boolean(user);
const isGuest = user?.is_guest === 1;

const REPO = 'https://github.com/JoseSerpaCode/Forge-OS';
const INSTALAR = `${REPO}/blob/main/deploy/README.md`;

// Las novedades salen del CHANGELOG de verdad, incrustado al compilar.
const cambios = parseChangelog(raw, 3);
// El título de una entrada suele ser una etiqueta («Perfil»); sola no dice
// nada. Con la primera frase del cuerpo se entiende sin abrir el CHANGELOG.
const primeraFrase = (t: string) => t.split(/(?<=[.!?])\s/)[0];

const COLUMNAS = [
  ['todo', 's-todo', x.columnas.todo],
  ['progreso', 's-progress', x.columnas.progreso],
  ['revision', 's-review', x.columnas.revision],
  ['hecho', 's-done', x.columnas.hecho],
] as const;

const LOGO = '<svg viewBox="0 0 64 64" width="26" height="26" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M6 59V53H10V27A22 22 0 0 1 54 27V53H58V59ZM21 53V32A11 11 0 0 1 43 32V53Z"/><path fill="var(--brand-orange)" d="M21 53V45A11 8 0 0 1 43 45V53Z"/></svg>';
const ICONO_HECHO = '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7"/></svg>';
---

<div class="portada">
<div class="site">
  <header class="site-head">
    <a href="/" aria-label="Forge OS"><span class="brand"><Fragment set:html={LOGO} /><span class="brand-word">Forge OS</span></span></a>
    <nav>
      <a class="btn btn-ghost hide-sm" href="#cambios">{x.nav.cambios}</a>
      <a class="btn btn-ghost hide-sm" href={REPO} target="_blank" rel="noopener noreferrer">{x.nav.codigo}</a>
      <LangSwitch />
      <ThemeSwitch />
      {signedIn ? (
        <a class="btn btn-primary" href="/">{x.nav.abrir}</a>
      ) : (
        <>
          <a class="btn btn-ghost" href="/login">{x.nav.entrar}</a>
          <a class="btn btn-primary" href="/register">{x.nav.crear}</a>
        </>
      )}
    </nav>
  </header>

  <main>
  <section class="hero-x">
    <h1 class="hero-title">
      <span class="ln"><span class="w">{x.hero.l1}</span><span class="inl inl-col" aria-hidden="true"><i></i>{x.hero.col}<b>3</b></span></span>
      <span class="ln"><span class="w">{x.hero.l2}</span><span class="inl inl-note" aria-hidden="true"><i></i>{x.hero.nota}</span></span>
      <span class="ln"><span class="w">{x.hero.l3}</span><span class="inl inl-file" aria-hidden="true"><em>PDF</em>{x.hero.archivo}<Fragment set:html={FIGURAS.sit} /></span></span>
      <span class="ln ln-wide">{x.hero.l4}</span>
    </h1>
    <div class="hero-stickers" aria-hidden="true"><span class="inl inl-col"><i></i>{x.hero.col}<b>3</b></span><span class="inl inl-note"><i></i>{x.hero.nota}</span><span class="inl inl-file"><em>PDF</em>{x.hero.archivo}<Fragment set:html={FIGURAS.sit} /></span></div>
    <div class="hero-foot">
      <p>{x.hero.texto}</p>
      <div class="hero-cta">
        <div class="actions">
          {signedIn ? (
            <>
              <a class="btn btn-primary btn-lg" href="/">{x.nav.abrir}</a>
              {isGuest && <a class="btn btn-secondary btn-lg" href="/register">{x.hero.conservar}</a>}
            </>
          ) : (
            <>
              <form method="POST" action="/api/auth/guest"><button type="submit" class="btn btn-primary btn-lg">{x.hero.probar}</button></form>
              <a class="btn btn-secondary btn-lg" href={INSTALAR} target="_blank" rel="noopener noreferrer">{x.hero.instalar}</a>
            </>
          )}
        </div>
        {/* El aviso va pegado al botón, antes de decidir: una cuenta temporal
            que caduca sin avisar es una trampa, por barata que salga. */}
        {!signedIn && <p class="hint">{x.hero.aviso}</p>}
        {isGuest && <p class="hint">{x.hero.avisoInvitado}</p>}
      </div>
    </div>
  </section>

  <Fragment set:html={FIGURAS.show} />
  <figure class="showcase">
    <div class="showcase-sign">
      <strong>{x.muestra.sprint}</strong>
      <span class="sign-meta"><span class="bar" aria-hidden="true"><span style="width:26%;--c:var(--brand-ink)"></span></span>{x.muestra.meta}</span>
    </div>
    <div class="showcase-board"><div class="board">
      {COLUMNAS.map(([clave, clase, nombre]) => (
        <section class:list={['column', clase]}>
          <header class="column-head"><h2>{nombre}</h2><span class="n">{x.tarjetas[clave].length}</span></header>
          <div class="column-body">
            {x.tarjetas[clave].map((c, i) => (
              <>
                <article data-pin={c.pin} class:list={['card', { dragging: c.arrastrando }]} style={`--type:${c.color}`}>
                  <h3>{c.titulo}</h3>
                  <div class="card-foot">
                    <span class="type"><span class="sw" style={`--c:${c.color}`}></span>{c.tipo} · {c.pts} pts</span>
                    <span class="chip" style={`--c:${c.etiqueta[1]}`}><span class="sw"></span>{c.etiqueta[0]}</span>
                    <span class="push">
                      {c.pie && <span class:list={['due', { late: c.tarde }]}>{c.pie}</span>}
                      <span class={`avatar p-${c.quien}`} title={c.quien}>{c.quien.slice(0, 2)}</span>
                    </span>
                  </div>
                  {c.reloj && <div class="timer"><span class="live">{x.muestra.enMarcha} <b>00:42:13</b></span><span class="btn btn-secondary btn-sm">{x.muestra.parar}</span></div>}
                </article>
                {c.arrastrando && i === 0 && <div class="slot slot-label">{x.muestra.soltar}</div>}
              </>
            ))}
          </div>
        </section>
      ))}
    </div></div>
  </figure>
  <ol class="show-notes">
    {x.muestra.notas.map((n, i) => (
      <li data-n={i + 1}><span class="pin-n">{i + 1}</span><p>{n}</p></li>
    ))}
  </ol>

  <section class="site-section qh" id="que-hace">
    <header class="qh-head">
      <h2>{x.queHace.titulo} <Fragment set:html={FIGURAS.throw} /></h2>
      <p class="qh-lead">{x.queHace.entrada}</p>
      <nav class="qh-index" aria-label={x.queHace.titulo}>
        <a href="#qh-tablero"><b>01</b>{x.queHace.tablero.nombre}</a>
        <a href="#qh-notas"><b>02</b>{x.queHace.notas.nombre}</a>
        <a href="#qh-archivos"><b>03</b>{x.queHace.archivos.nombre}</a>
        <a href="#qh-metricas"><b>04</b>{x.queHace.metricas.nombre}</a>
      </nav>
    </header>

    <article class="qh-feat" id="qh-tablero">
      <div class="qh-text">
        <span class="qh-n">01 / 04</span><h3>{x.queHace.tablero.nombre}</h3><p>{x.queHace.tablero.texto}</p>
        <dl class="qh-facts">{x.queHace.tablero.cifras.map(([n, d]) => <div><dt>{n}</dt><dd>{d}</dd></div>)}</dl>
      </div>
      <div class="qh-stage qh-board" aria-hidden="true">
        <section class="column s-progress"><header class="column-head"><h2>{x.columnas.progreso}</h2><span class="n">3</span></header>
          <div class="column-body">
            {x.tarjetas.progreso.slice(0, 2).map((c) => (
              <article class="card" style={`--type:${c.color}`}>
                <h3>{c.titulo}</h3>
                <div class="card-foot">
                  <span class="type"><span class="sw" style={`--c:${c.color}`}></span>{c.tipo} · {c.pts} pts</span>
                  <span class="chip" style={`--c:${c.etiqueta[1]}`}><span class="sw"></span>{c.etiqueta[0]}</span>
                  <span class="push">{c.pie && <span class:list={['due', { late: c.tarde }]}>{c.pie}</span>}<span class={`avatar p-${c.quien}`}>{c.quien.slice(0, 2)}</span></span>
                </div>
                {c.reloj && <div class="timer"><span class="live">{x.muestra.enMarcha} <b>00:42:13</b></span><span class="btn btn-secondary btn-sm">{x.muestra.parar}</span></div>}
              </article>
            ))}
          </div>
        </section>
        <div class="qh-drag">
          {x.tarjetas.hecho.slice(0, 1).map((c) => (
            <article class="card dragging" style={`--type:${c.color}`}>
              <h3>{c.titulo}</h3>
              <div class="card-foot"><span class="type"><span class="sw" style={`--c:${c.color}`}></span>{c.tipo} · {c.pts} pts</span><span class="chip" style={`--c:${c.etiqueta[1]}`}><span class="sw"></span>{c.etiqueta[0]}</span><span class="push"><span class={`avatar p-${c.quien}`}>{c.quien.slice(0, 2)}</span></span></div>
            </article>
          ))}
          <div class="slot slot-label">{x.muestra.soltar}</div>
        </div>
        <div class="toast qh-toast"><Fragment set:html={ICONO_HECHO} />{x.queHace.tablero.aviso}<span class="act">{x.queHace.tablero.deshacer}</span></div>
      </div>
    </article>

    <article class="qh-feat" id="qh-notas">
      <div class="qh-text">
        <span class="qh-n">02 / 04</span><h3>{x.queHace.notas.nombre}</h3><p>{x.queHace.notas.texto}</p>
        <dl class="qh-facts">{x.queHace.notas.cifras.map(([n, d]) => <div><dt>{n}</dt><dd>{d}</dd></div>)}</dl>
      </div>
      <div class="qh-stage qh-notes" aria-hidden="true">
        <div class="qh-note">
          <article class="panel qh-doc">
            <p class="doc-title" style="font-size:2.2rem">{x.queHace.notas.doc}</p>
            <p class="hint" style="margin:8px 0 16px">{x.queHace.notas.quien} · <span class="chip" style={`--c:${x.etiquetaApi[1]}`}><span class="sw"></span>{x.etiquetaApi[0]}</span></p>
            <div class="qh-sel">
              <div class="bubble qh-bubble"><span class="on"><b>B</b></span><span><i>I</i></span><span class="sepv"></span><span>T2</span><span>@</span></div>
              <p>{x.queHace.notas.p1a} <code class="mono">workspace_id</code>. <span class="sel"><b>{x.queHace.notas.p1b}</b></span>{x.queHace.notas.p1c}</p>
            </div>
            <p style="margin-top:14px">{x.queHace.notas.p2} <span class="typing"><b>@Lu</b><span class="caret"></span></span></p>
          </article>
          <div class="menu qh-menu"><span class="menu-label">{x.queHace.notas.mencion}</span>
            <div>
              {x.queHace.notas.contactos.map(([nombre, tipo], i) => (
                <span class:list={['menu-item', { on: i === 0 }]}><span class="avatar">{nombre.slice(0, 2)}</span><span>{nombre}</span><span class="push hint">{tipo}</span></span>
              ))}
            </div>
          </div>
        </div>
        <p class="qh-back"><span class="chip" style={`--c:${x.etiquetaApi[1]}`}><span class="sw"></span>{x.etiquetaApi[0]}</span><span>{x.queHace.notas.vuelta}</span></p>
      </div>
    </article>

    <article class="qh-feat" id="qh-archivos">
      <div class="qh-text">
        <span class="qh-n">03 / 04</span><h3>{x.queHace.archivos.nombre}</h3><p>{x.queHace.archivos.texto}</p>
        <dl class="qh-facts">{x.queHace.archivos.cifras.map(([n, d]) => <div><dt>{n}</dt><dd>{d}</dd></div>)}</dl>
      </div>
      <div class="qh-stage qh-files">
        <div class="qh-flow" role="img" aria-label={x.queHace.archivos.flujo}>
          <div class="node server"><b>{x.queHace.archivos.servidor}</b><small>{x.queHace.archivos.servidorSub}</small></div>
          <div class="node browser"><b>{x.queHace.archivos.navegador}</b></div>
          <div class="arrow"><span class="lbl">{x.queHace.archivos.directos}</span></div>
          <div class="node drive"><b>{x.queHace.archivos.drive}</b><small>{x.queHace.archivos.driveSub}</small></div>
        </div>
        <div class="panel qh-archivos" aria-hidden="true">
          {[['PDF', lang === 'es' ? 'factura-plantilla.pdf' : 'invoice-template.pdf', x.tarjetas.progreso[0].etiqueta],
            ['PNG', lang === 'es' ? 'avatar-rechazado.png' : 'rejected-avatar.png', x.tarjetas.todo[1].etiqueta],
            ['CSV', lang === 'es' ? 'consumo-septiembre.csv' : 'usage-september.csv', x.etiquetaApi]].map(([formato, nombre, et]) => (
            <div class="qh-archivo"><span class="file-kind">{formato}</span><b class="demo-fname">{nombre}</b><span class="chip" style={`--c:${et[1]};margin-left:auto`}><span class="sw"></span>{et[0]}</span></div>
          ))}
        </div>
      </div>
    </article>

    <article class="qh-feat" id="qh-metricas">
      <div class="qh-text">
        <span class="qh-n">04 / 04</span><h3>{x.queHace.metricas.nombre}</h3><p>{x.queHace.metricas.texto}</p>
        <dl class="qh-facts">{x.queHace.metricas.cifras.map(([n, d]) => <div><dt>{n}</dt><dd>{d}</dd></div>)}</dl>
      </div>
      <div class="qh-stage qh-metrics" aria-hidden="true">
        <div class="qh-top">
          <div class="figures" style="margin:0">
            <div><b class="wide fig">14</b><span class="hint">{x.queHace.metricas.sinCerrar}</span></div>
            <div><b class="wide fig">4</b><span class="hint">{x.queHace.metricas.dias}</span></div>
            <div><b class="wide fig">{lang === 'es' ? '+5,3' : '+5.3'}</b><span class="hint">{x.queHace.metricas.sobre}</span></div>
          </div>
          <p class="qh-sticky"><b class="wide">{x.queHace.metricas.fecha}</b>{x.queHace.metricas.prevision}</p>
        </div>
        <div class="panel chart" style="padding:18px 20px">
          <div class="legend">
            <span><i class="line" style="--c:var(--text)"></i>{x.queHace.metricas.real}</span>
            <span><i class="dash" style="--c:var(--border-strong)"></i>{x.queHace.metricas.ideal}</span>
            <span style="margin-left:auto"><span class="seg"><button type="button" tabindex="-1" aria-pressed="true">{x.queHace.metricas.grafica}</button><button type="button" tabindex="-1" aria-pressed="false">{x.queHace.metricas.tabla}</button></span></span>
          </div>
          <svg viewBox="0 0 560 250" role="img" aria-label={x.queHace.metricas.aria}>
            <g class="grid"><line x1="34" x2="496" y1="224.0" y2="224.0"/><line x1="34" x2="496" y1="170.5" y2="170.5"/><line x1="34" x2="496" y1="117.0" y2="117.0"/><line x1="34" x2="496" y1="63.5" y2="63.5"/><line x1="34" x2="496" y1="10.0" y2="10.0"/></g>
            <text x="26" y="228.0" text-anchor="end">0</text><text x="26" y="174.5" text-anchor="end">10</text><text x="26" y="121.0" text-anchor="end">20</text><text x="26" y="67.5" text-anchor="end">30</text><text x="26" y="14.0" text-anchor="end">40</text>
            {x.queHace.metricas.ejes.map((e, i) => <text x={34 + i * 115.5} y="244" text-anchor="middle">{e}</text>)}
            <line class="axis" x1="34" x2="496" y1="224.0" y2="224.0"/>
            <line x1="34.0" y1="10.0" x2="496.0" y2="224.0" stroke="var(--border-strong)" stroke-width="2" stroke-dasharray="5 4"/>
            <polyline points="34.0,10.0 50.5,10.0 67.0,20.7 83.5,20.7 100.0,26.1 116.5,36.8 133.0,36.8 149.5,47.5 166.0,63.5 182.5,63.5 199.0,68.8 215.5,79.5 232.0,79.5 248.5,90.2 265.0,95.6 281.5,106.3 298.0,106.3 314.5,111.7 331.0,122.3 347.5,127.7 364.0,133.1 380.5,133.1 397.0,143.8 413.5,149.1" fill="none" stroke="var(--text)" stroke-width="2" stroke-linejoin="round"/>
            <circle cx="413.5" cy="149.1" r="4.5" fill="var(--text)" stroke="var(--surface-1)" stroke-width="2"/>
            <line x1="413.5" x2="413.5" y1="10" y2="224.0" stroke="var(--border-strong)" stroke-width="1"/>
            <text x="421.5" y="22" class="lbl">{x.queHace.metricas.hoy}</text>
            <text x="423.5" y="153.1" class="lbl">14 pts</text>
            <text x="502.0" y="218.0">{x.queHace.metricas.ideal}</text>
            <g class="tip"><line x1="314.5" x2="314.5" y1="10" y2="224.0" stroke="var(--text)" stroke-width="1" stroke-dasharray="2 3"/><circle cx="314.5" cy="111.65" r="5" fill="var(--accent)" stroke="var(--surface-1)" stroke-width="2"/><g transform="translate(164.5 37.65)"><rect width="136" height="56" rx="10" fill="var(--text)"/><text x="12" y="20" style="fill:var(--bg);font-weight:700">{x.queHace.metricas.tip1}</text><text x="12" y="40" style="fill:var(--bg)">{x.queHace.metricas.tip2}</text></g></g>
          </svg>
        </div>
      </div>
    </article>
  </section>

  <section class="placa">
    <Fragment set:html={FIGURAS.placa} />
    <h2>{x.ficha.titulo}</h2>
    <table class="datasheet">
      {x.ficha.filas.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}
    </table>
  </section>

  <section class="site-section" id="cambios">
    <h2>{x.cambios.titulo}</h2>
    <ul class="changes">
      {cambios.map((r) => (
        <li>
          <span><span class="v">{r.version}</span><span class="d">{fecha(r.date, lang)}</span></span>
          <ul>{r.items.slice(0, 2).map((it) => <li><b>{it.title}</b>{it.body && <> {primeraFrase(it.body)}</>}</li>)}</ul>
        </li>
      ))}
    </ul>
    <p style="margin-top:16px"><a class="link" href={`${REPO}/blob/main/CHANGELOG.md`} target="_blank" rel="noopener noreferrer">{x.cambios.todos}</a></p>
  </section>

  {!signedIn && (
    <section class="cta-final">
      <Fragment set:html={FIGURAS.jump} />
      <div><h2>{x.final.titulo}</h2><p>{x.final.texto}</p></div>
      <div class="actions">
        <form method="POST" action="/api/auth/guest"><button type="submit" class="btn btn-ink">{x.hero.probar}</button></form>
        <a class="btn btn-ink-outline" href={INSTALAR} target="_blank" rel="noopener noreferrer">{x.hero.instalar}</a>
      </div>
    </section>
  )}
  </main>

  <footer class="site-foot">
    <span class="brand"><Fragment set:html={LOGO.replace(/26/g, '20')} /><span class="brand-word">Forge OS</span></span>
    <span>{x.pie.licencia}</span>
    <span style="margin-left:auto;display:inline-flex;align-items:flex-end;gap:10px"><Fragment set:html={FIGURAS.foot} />v{pkg.version}</span>
  </footer>
</div>
</div>

<style>
  /* Lo que la maqueta resolvía con atributos `style` en línea. */
  .qh-archivos { padding: 6px 0; width: 100%; }
  .qh-archivo { display: flex; gap: 10px; align-items: center; padding: 12px 18px; }
  .qh-archivo + .qh-archivo { border-top: 1px solid var(--forge-border); }
  .demo-fname { font-weight: 600; }
  .portada .actions form { display: contents; }
  /* A 390 px no caben marca, idioma, tema y las dos entradas: el tema se va
     (sigue el del sistema), y la marca no se parte en dos líneas. */
  .portada .brand-word { white-space: nowrap; }
  @media (max-width: 420px) {
    .portada .site-head :global(.ts) { display: none; }
  }
</style>
