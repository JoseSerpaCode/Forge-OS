---
/**
 * Una tarjeta del tablero.
 *
 * Recibe la fila tal como sale de `lib/tablero.ts`: lo pintan el tablero y el
 * parcial de «ver más», y si cada uno adaptara la fila a su manera las tarjetas
 * cargadas después saldrían distintas de las primeras.
 */
import { useTranslations } from '../../i18n/ui';
import { nombreVisible } from '../../lib/issueTypes';
import LabelChip from '../labels/LabelChip.astro';
import { fecha, vencida } from '../../lib/fechas';
import { prioridadVisible } from '../../lib/prioridad';
import { describir } from '../../lib/recurrencia';
import { deFila as responsableDe, iniciales, valorDeContacto } from '../../lib/responsables';
import type { Funciones } from '../../lib/funcionesEspacio';
import { ESTADOS, INFO } from '../../lib/status';
import { tonoDe, esFotoReal } from '../../lib/tonos';

interface Props {
  issue: any;
  canEdit?: boolean;
  /** El tipo resuelto del espacio: nombre y color tal como los dejó el equipo. */
  tipo?: { key: string; name: string; color: string; isBuiltin: boolean } | null;
  funciones?: Funciones;
  /**
   * El carril en que se pinta, si el tablero va agrupado por etiqueta.
   *
   * Una tarea con dos etiquetas sale en dos carriles, y dos elementos no
   * pueden tener el mismo `id`: con carriles, el `id` del DOM lleva el carril
   * y el de la tarea va en `data-issue-id`. El código que busca una tarjeta lo
   * hace siempre por `data-issue-id`.
   */
  carril?: string | null;
}

const { issue, canEdit = false, tipo = null, funciones = { sprints: false, tiempo: false, puntos: false, automatizaciones: false, auditoria: false }, carril = null } = Astro.props;
// A quién va: una persona con cuenta o un contacto (`responsables.ts`).
const responsable = responsableDe(issue);
const valorResponsable = responsable?.tipo === 'contacto' ? valorDeContacto(responsable.id) : (issue.assignee_id || '');
const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);

const idDom = carril === null || carril === undefined ? issue.id : `${issue.id}~${carril || 'sin'}`;
const hecha = issue.status === 'done';
const prioridad = prioridadVisible(issue.priority);
const apuntes = Number(issue.apuntes || 0);
const subTotal = Number(issue.subtareas_total || 0);
const subHechas = Number(issue.subtareas_hechas || 0);
const horas = Math.round((issue.logged_hours || 0) * 10) / 10;
const entregaDia = issue.due_date ? String(issue.due_date).slice(0, 10) : null;
// Planificarla para después de la entrega se permite, pero se marca.
const trasEntrega = !!(issue.planned_date && entregaDia && issue.planned_date > entregaDia);
// En la zona de quien mira: el servidor corre en UTC.
const vence = issue.due_date && !hecha && vencida(issue.due_date, new Date(), issue.due_time, Astro.locals.user?.timezone);
---
{/*
  Tres `data-*` que estaban aquí ya no están: `data-assignee`, `data-reporter` y
  `data-active-session` no los leía nadie, y `data-t-due` y `data-t-no-desc`
  repetían la **misma cadena** en cada tarjeta —hasta cuatrocientas por
  tablero—. Los dos textos los pone ahora el modal, que es quien los usa.
*/}
<div id={idDom}
  data-issue-id={issue.id}
  draggable={canEdit ? 'true' : 'false'}
  data-points={issue.story_points || 0}
  data-position={issue.position || 0}
  data-sprint-id={issue.sprint_id || 'backlog'}
  data-assignee-id={issue.assignee_id || ''}
  data-responsable={valorResponsable}
  data-reporter-id={issue.reporter_id || ''}
  data-description={issue.description || ''}
  data-due-date={issue.due_date ? String(issue.due_date).slice(0, 10) : ''}
  data-due-time={issue.due_time || ''}
  data-planned-date={issue.planned_date || ''}
  data-priority={issue.priority || 'medium'}
  data-recurrence={issue.recurrence || ''}
  data-reminder={issue.reminder_minutes ?? ''}
  data-subtareas-total={subTotal}
  data-subtareas-hechas={subHechas}
  data-status={issue.status}
  data-cursor={hecha ? `${issue.cierre ?? issue.done_at ?? issue.updated_at}|${issue.id}` : undefined}
  data-labels={JSON.stringify(issue.labels || [])}
  class:list={['issue-card tarjeta group', canEdit ? 'cursor-grab active:cursor-grabbing' : 'cursor-pointer']}
  style={`--tipo: ${tipo?.color ?? 'var(--forge-border-strong)'}`}>
  {/*
    Tarjeta compacta (fase 1 del rediseño): título, una fila de pie con tipo,
    señales y responsable, y nada más. La descripción vive en el panel; el id
    hexadecimal no decía nada a nadie. El color del tipo va en la muesca de
    arriba (`.tarjeta::before`), no en una franja lateral.
  */}
  <div class="flex items-start gap-2">
    {/*
      Completar con un clic. Es un botón de verdad, con nombre que dice qué
      tarea completa, y su clic no abre el panel (lo corta el tablero).
    */}
    {canEdit && !hecha && (
      <button type="button" class="btn-completar mt-[3px] shrink-0 w-4 h-4 rounded-full border-2 border-forge-border-strong hover:border-forge-success hover:bg-forge-success/15 transition-colors"
        aria-label={t('card.complete').replace('{titulo}', issue.title)}
        title={t('card.complete').replace('{titulo}', issue.title)}></button>
    )}
    <h4 class="tarjeta-titulo min-w-0 flex-1">{issue.title}</h4>
    {/* Mover a otro sprint, desde la propia tarjeta. Aparece al acercarse; en
        táctil, siempre (reglas móviles de themes.css). */}
    {funciones.sprints && canEdit && (
      <button type="button" class="btn-mover-sprint btn btn-ghost btn-icon btn-sm -mt-1 -mr-2 opacity-0 group-hover:opacity-100 focus-visible:opacity-100"
        aria-haspopup="menu" aria-label={t('card.move_sprint')} title={t('card.move_sprint')}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="19" cy="12" r="1.8"/></svg>
      </button>
    )}
  </div>

  {issue.planned_date && !hecha && (
    <p class:list={['card-planned mt-1.5 text-xs', trasEntrega ? 'text-forge-error font-semibold' : 'text-forge-muted']}>
      {t('card.planned')} {fecha(issue.planned_date, lang)}{trasEntrega ? ` · ${t('card.after_due')}` : ''}
    </p>
  )}

  <div class="tarjeta-pie">
    {/*
      El nombre de un tipo de fábrica se traduce; el de uno propio no, porque
      lo escribió alguien. Si la clave no corresponde a ningún tipo —un ticket
      viejo de uno que se borró— se enseña la clave cruda: es información.
    */}
    <span class="issue-type-badge tarjeta-meta" data-type-key={issue.type}
      data-type-name={tipo ? nombreVisible(tipo, t) : issue.type}
      data-pts-label={funciones.puntos ? t('card.points_short') : undefined}>
      {tipo && <span class="sw" style={`--c:${tipo.color}`} aria-hidden="true"></span>}
      {tipo ? nombreVisible(tipo, t) : issue.type}{funciones.puntos && issue.story_points ? ` · ${issue.story_points} ${t('card.points_short')}` : ''}
    </span>

    {issue.labels && issue.labels.length > 0 && (
      <span class="card-labels contents">
        {issue.labels.map((l: any) => <LabelChip name={l.name} color={l.color} size="sm" />)}
      </span>
    )}

    {/* La prioridad solo se pinta si no es la normal: si todas llevaran
        bandera, ninguna destacaría. Con texto, no solo color. */}
    {prioridad.nivel !== 'normal' && (
      <span class:list={['card-priority tarjeta-meta font-semibold', prioridad.clase]} title={t('priority.label')}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M4 22V4"/><path d="M4 4h13l-2 4 2 4H4"/></svg>
        <span class="sr-only">{t('priority.label')}:</span>
        {t(`priority.${prioridad.nivel}`)}
      </span>
    )}

    {issue.recurrence && (
      <span class="card-repeat tarjeta-meta" title={t('repeat.card').replace('{regla}', describir(issue.recurrence, lang))}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
        <span class="sr-only">{t('repeat.card').replace('{regla}', describir(issue.recurrence, lang))}</span>
      </span>
    )}

    {/* Progreso de las subtareas, con texto: «2/5» dice más que una barra sola. */}
    {subTotal > 0 && (
      <span class="card-subtareas tarjeta-meta" title={t('subtasks.progress').replace('{hechas}', String(subHechas)).replace('{total}', String(subTotal))}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        <span class="sr-only">{t('subtasks.progress').replace('{hechas}', String(subHechas)).replace('{total}', String(subTotal))}</span>
        <span aria-hidden="true" class="card-subtareas-texto">{subHechas}/{subTotal}</span>
      </span>
    )}

    {apuntes > 0 && (
      <span class="card-notes tarjeta-meta" title={t('card.linked_notes').replace('{n}', String(apuntes))}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <span class="sr-only">{t('card.linked_notes').replace('{n}', String(apuntes))}</span>
        <span aria-hidden="true">{apuntes}</span>
      </span>
    )}

    <span class="empuja">
      {funciones.tiempo && hecha && horas > 0 && (
        <span class="due" title={t('card.total_time')}>{t('card.logged_hours').replace('{h}', String(horas))}</span>
      )}
      {issue.due_date && (
        <span class:list={['card-due due', vence && 'late']}>
          {/* `toLocaleDateString()` sin argumentos usa el idioma del navegador,
              no el elegido en la aplicación. */}
          <span class="sr-only">{t('card.due')} </span>{fecha(String(issue.due_date).slice(0, 10), lang)}{issue.due_time ? ` · ${issue.due_time}` : ''}
        </span>
      )}
      {/* Responsable solo si lo hay. Persona con cuenta: su foto o sus
          iniciales en el arco. Contacto sin cuenta: borde discontinuo. */}
      <span class:list={['card-responsable avatar', responsable?.tipo === 'contacto' && 'avatar-contacto', !responsable && 'hidden']}
        style={responsable ? `--c:${tonoDe(responsable.nombre)}` : undefined}
        title={responsable?.nombre || t('modal.unassigned')} role="img" aria-label={responsable?.nombre || t('modal.unassigned')}>
        {esFotoReal(responsable?.avatar) ? (
          <img src={responsable!.avatar!} alt="" loading="lazy" decoding="async" />
        ) : responsable ? (
          <span aria-hidden="true">{iniciales(responsable.nombre)}</span>
        ) : null}
      </span>
    </span>
  </div>

  {/*
    Mover una tarea, en móvil. El arrastrar y soltar del tablero es HTML5 y no
    dispara con eventos táctiles; un desplegable en la tarjeta sí.
  */}
  {canEdit && (
    <select
      class="mover-issue campo sm:hidden mt-3 text-xs"
      data-issue-id={issue.id}
      aria-label={t('card.move_to')}
    >
      {ESTADOS.map((e) => (
        <option value={e} selected={issue.status === e}>{t(INFO[e].i18n)}</option>
      ))}
    </select>
  )}

  {/* El cronómetro, solo si el espacio mide el tiempo. En marcha se ve
      siempre, porque es estado; para arrancarlo, el botón aparece al
      acercarse (en táctil, siempre). */}
  {funciones.tiempo && canEdit && !hecha && (
    issue.active_session_start ? (
      <div class="card-timer tarjeta-crono">
        <span class="active-timer-display en-marcha" data-start-time={issue.active_session_start} data-logged-hours={issue.logged_hours || 0}>
          {t('card.timer_running')} <b class="timer-text">00:00:00</b>
        </span>
        <button type="button" class="btn-stop-timer btn btn-secondary btn-sm" data-issue-id={issue.id} title={t('card.stop_timer')}>
          {t('card.timer_stop')}
        </button>
      </div>
    ) : (
      <div class="card-timer flex justify-end -mb-1 mt-1 opacity-0 group-hover:opacity-100 focus-within:opacity-100">
        <button type="button" class="btn-start-timer btn btn-ghost btn-sm" data-issue-id={issue.id} title={t('card.start_timer')}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="6 4 19 12 6 20 6 4"></polygon></svg>
          {t('card.timer_start')}
        </button>
      </div>
    )
  )}
</div>
