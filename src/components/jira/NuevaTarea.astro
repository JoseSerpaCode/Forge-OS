---
/**
 * El alta de tareas: una línea rápida y, debajo, todos los campos a la vista.
 *
 * Sustituye al formulario de `board.astro`, que se había quedado atrás: no
 * dejaba poner etiquetas, la fecha salía en mm/dd/yyyy con la app en español y
 * el título decía «Crear Issue». Vive en `MainLayout` y no en el tablero para
 * que `C` funcione desde cualquier página del espacio —también desde los
 * apuntes, que es donde suele surgir la tarea—.
 *
 * La línea y el formulario son el mismo estado. Lo que la línea reconoce
 * («viernes», «#Cálculo», «!1») rellena los campos de abajo; si alguien toca un
 * campo a mano, la línea deja de pisarlo. Las etiquetas son la unión de las
 * dos cosas.
 */
import db from '../../lib/db';
import { checkWorkspaceAccess } from '../../lib/guard';
import { useTranslations } from '../../i18n/ui';
import { funciones as funcionesDe } from '../../lib/funcionesEspacio';
import { listar as listarEtiquetas, COLOR_POR_DEFECTO } from '../../lib/labels';
import { listar as listarTipos, nombreVisible } from '../../lib/issueTypes';
import { OPCIONES as PRIORIDADES } from '../../lib/prioridad';
import { listar as listarPlantillas } from '../../lib/plantillas';
import { plantillasDeSerie } from '../../lib/plantillasDeSerie';
import { TIPOS_ADJUNTO } from '../../lib/adjuntos';
import CampoFecha from '../forms/CampoFecha.astro';
import OpcionesResponsable from './OpcionesResponsable.astro';
import { listar as listarContactos } from '../../lib/contactos';

interface Props { workspaceId: string }
const { workspaceId } = Astro.props;
const user = Astro.locals.user;
const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);

const ws = db.prepare('SELECT id, sys_tag FROM workspaces WHERE id = ?').get(workspaceId) as { id: string; sys_tag: string } | undefined;
const acceso = user && ws ? checkWorkspaceAccess(user.id, user.is_sysadmin, ws.id, 'editor') : { granted: false };
const puede = Boolean(ws && acceso.granted);

const funcs = puede ? funcionesDe(ws!.id) : { sprints: false, tiempo: false, puntos: false, automatizaciones: false, auditoria: false };
const etiquetas = puede ? listarEtiquetas(ws!.id) : [];
const tipos = puede ? listarTipos(ws!.id) : [];
const miembros = puede
  ? db.prepare('SELECT u.id, u.username FROM workspace_members wm JOIN users u ON u.id = wm.user_id WHERE wm.workspace_id = ? ORDER BY u.username COLLATE NOCASE').all(ws!.id) as Array<{ id: string; username: string }>
  : [];
const sprints = puede && funcs.sprints
  ? db.prepare("SELECT id, name FROM sprints WHERE workspace_id = ? AND status != 'completed' ORDER BY start_date DESC, rowid DESC").all(ws!.id) as Array<{ id: string; name: string }>
  : [];
const contactos = puede && user && !user.is_guest ? listarContactos(user.id).map((c) => ({ id: c.id, name: c.name })) : [];
const plantillas = puede ? listarPlantillas(ws!.id) : [];
const deSerie = puede ? plantillasDeSerie(lang) : [];
// Todas las plantillas con su contenido, para rellenar el formulario en el
// navegador sin ir al servidor. `e:` son las del espacio; `s:`, las de serie.
const plantillasCliente = Object.fromEntries([
  ...plantillas.map((p) => [`e:${p.id}`, { name: p.name, contenido: p.contenido }]),
  ...deSerie.map((p) => [`s:${p.clave}`, { name: p.nombre, contenido: p.contenido }]),
]);
// Gestionarlas es de quien entra en los ajustes del espacio.
const gestionaPlantillas = Boolean(puede && user && checkWorkspaceAccess(user.id, user.is_sysadmin, ws!.id, 'owner').granted);
const campo = 'campo';
---
{puede && (
  <dialog id="nueva-tarea"
    aria-labelledby="nueva-tarea-titulo"
    data-sys-tag={ws!.sys_tag}
    data-lang={lang}
    data-etiquetas={JSON.stringify(etiquetas.map((e) => ({ id: e.id, name: e.name, color: e.color })))}
    data-color-defecto={COLOR_POR_DEFECTO}
    data-t-remove={t('quick.remove_chip')}
    data-t-chip-fecha={t('quick.chip_date')}
    data-t-chip-hora={t('quick.chip_time')}
    data-t-chip-etiqueta={t('quick.chip_label')}
    data-t-chip-etiqueta-nueva={t('quick.chip_new_label')}
    data-t-chip-prioridad={t('quick.chip_priority')}
    data-t-chip-apunte={t('quick.chip_note')}
    data-t-chip-repeticion={t('quick.chip_repeat')}
    data-t-chip-trabajo={t('quick.chip_work')}
    data-t-chip-recordatorio={t('quick.chip_remind')}
    data-t-chip-responsable={t('quick.chip_assignee')}
    data-t-create-label={t('quick.create_label')}
    data-t-note-missing={t('quick.note_missing')}
    data-t-created={t('quick.created')}
    data-t-see={t('quick.see')}
    data-t-err-title={t('issue.err_title')}
    data-t-err-create={t('issue.err_create')}
    data-t-label-error={t('quick.label_error')}
    data-t-creating={t('issue.creating')}
    data-plantillas={JSON.stringify(plantillasCliente)}
    data-t-tpl-applied={t('tpl.applied')}
    data-t-tpl-steps={t('tpl.applied_steps')}
    data-t-tpl-repeat={t('tpl.applied_repeat')}
    data-t-uploading={t('files.uploading_n')}
    data-t-files-failed={t('issue.created_files_failed')}
    data-t-file-too-big={t('files.err_too_big')}
    data-t-file-type={t('files.err_type')}
    data-t-file-remove={t('files.attach_remove')}
    class="ventana !max-w-[36rem] sm:!p-6">
    {/* Sin maqueta propia: es la ventana única de docs/rediseno/ventanas.html
        con la línea de alta rápida en lugar del formulario. Lo que se
        escribe se entiende al vuelo y se enseña en píldoras debajo. */}
    <h2 id="nueva-tarea-titulo" class="ventana-titulo">{t('modal.create_issue')}</h2>

    <div class="relative">
      <label class="sr-only" for="nt-linea">{t('quick.label')}</label>
      <input type="text" id="nt-linea" autocomplete="off" spellcheck="true"
        role="combobox" aria-expanded="false" aria-controls="nt-apuntes-sugeridos" aria-autocomplete="list"
        aria-describedby="nt-ayuda"
        placeholder={t('quick.placeholder')}
        class="campo !h-12 !text-base !px-4 !rounded-xl" />
      <ul id="nt-apuntes-sugeridos" role="listbox" class="menu hidden absolute z-40 top-full left-0 right-0 mt-1 max-h-60 overflow-y-auto"></ul>
    </div>
    <p id="nt-ayuda" class="hint mt-2">{t('quick.help')}</p>

    {/* Plantillas: elegir una **rellena el formulario** —título, descripción,
        entrega, etiquetas, pasos— y se ajusta antes de crear. Antes creaba la
        tarea al instante con el título genérico («Parcial»), y solo salían
        las guardadas en el espacio: sin ninguna, no había nada que elegir.
        También se eligen escribiendo `/nombre` y Enter. */}
    <div class="mt-3">
      <div class="flex items-baseline justify-between gap-3 mb-1.5">
        <label class="block field-label" for="nt-plantilla">{t('tpl.label')}</label>
        {gestionaPlantillas && <a href={`/w/${ws!.sys_tag}/settings#plantillas-espacio`} class="enlace text-sm">{t('tpl.manage')}</a>}
      </div>
      <select id="nt-plantilla" class={campo} aria-describedby="nt-plantilla-resumen">
        <option value="">{t('tpl.none')}</option>
        {plantillas.length > 0 && (
          <optgroup label={t('tpl.group_space')}>
            {plantillas.map((p) => <option value={`e:${p.id}`}>{p.name}</option>)}
          </optgroup>
        )}
        <optgroup label={t('tpl.group_builtin')}>
          {deSerie.map((p) => <option value={`s:${p.clave}`}>{p.nombre}</option>)}
        </optgroup>
      </select>
    </div>
    <p id="nt-plantilla-resumen" class="hint mt-1.5 hidden" aria-live="polite"></p>

    {/* Lo que la línea ha reconocido. Cada chip se puede quitar: devuelve sus
        palabras al título. */}
    <ul id="nt-chips" class="flex flex-wrap gap-1.5 mt-2.5 empty:hidden" aria-live="polite"></ul>
    <p id="nt-aviso" class="hidden text-xs text-forge-error mt-2" role="alert"></p>

    {/* Todos los campos a la vista: plegados bajo «Más opciones» había que
        abrirlos en cada alta para llegar a la fecha o a las etiquetas. */}
    <div id="nt-mas" class="mt-4">
      <div class="space-y-3">
        <div>
          <label class="block field-label mb-1.5" for="nt-desc">{t('modal.description')}</label>
          <textarea id="nt-desc" rows="3" class={campo} placeholder={t('modal.desc_placeholder')}></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-[1fr_6.5rem] gap-2 items-start">
          <div>
            <label class="block field-label mb-1.5" for="nt-fecha-texto">{t('modal.due_date')}</label>
            <CampoFecha id="nt-fecha" inputClass={campo} />
          </div>
          <div>
            <label class="block field-label mb-1.5" for="nt-hora">{t('modal.due_time')}</label>
            <input type="text" id="nt-hora" inputmode="numeric" autocomplete="off" placeholder="18:00" maxlength="5" class={campo}
              aria-describedby="nt-hora-error" />
          </div>
          <p id="nt-hora-error" class="hidden sm:col-span-2 text-xs text-forge-error" role="alert">{t('modal.due_time_invalid')}</p>
        </div>

        <div>
          <label class="block field-label mb-1.5" for="nt-trabajo-texto">{t('modal.planned_date')}</label>
          <CampoFecha id="nt-trabajo" inputClass={campo} />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block field-label mb-1.5" for="nt-prioridad">{t('priority.label')}</label>
            <select id="nt-prioridad" class={campo}>
              {PRIORIDADES.map((p) => <option value={p.valor} selected={p.valor === 'medium'}>{t(`priority.${p.nivel}`)}</option>)}
            </select>
          </div>
          <div>
            <label class="block field-label mb-1.5" for="nt-tipo">{t('modal.type')}</label>
            <select id="nt-tipo" class={campo}>
              {tipos.map((ti) => <option value={ti.key}>{nombreVisible(ti, t)}</option>)}
            </select>
          </div>
          <div>
            <label class="block field-label mb-1.5" for="nt-responsable">{t('modal.assignee')}</label>
            {/* Miembros y contactos sin cuenta en el mismo desplegable: un
                contacto es otra opción, no otro campo. */}
            <select id="nt-responsable" class={`select-responsable ${campo}`}>
              <OpcionesResponsable miembros={miembros} contactos={contactos} vacia={t('modal.unassigned')} />
            </select>
          </div>
          {funcs.sprints && (
            <div>
              <label class="block field-label mb-1.5" for="nt-sprint">{t('modal.sprint')}</label>
              <select id="nt-sprint" class={campo}>
                <option value="">{t('modal.backlog')}</option>
                {sprints.map((s) => <option value={s.id}>{s.name}</option>)}
              </select>
            </div>
          )}
          {funcs.tiempo && (
            <div>
              <label class="block field-label mb-1.5" for="nt-estimado">{t('modal.estimated_hours')}</label>
              <input type="number" id="nt-estimado" min="0" step="0.5" placeholder="0" class={`${campo} font-mono`} />
            </div>
          )}
          {funcs.puntos && (
            <div>
              <label class="block field-label mb-1.5" for="nt-puntos">{t('modal.story_points')}</label>
              <input type="number" id="nt-puntos" min="0" max="1000" step="1" placeholder="0" class={`${campo} font-mono`} />
            </div>
          )}
        </div>

        {/* Etiquetas como botones que se encienden: cabe el catálogo entero de
            un vistazo, que con una etiqueta por asignatura son pocas. */}
        <fieldset>
          <legend class="block field-label mb-1.5">{t('quick.labels')}</legend>
          <div id="nt-etiquetas" class="flex flex-wrap gap-1.5">
            {etiquetas.map((e) => (
              <button type="button" class="nt-etiqueta etiqueta-opcion" aria-pressed="false" data-id={e.id} style={`--c:${/^#[0-9a-f]{6}$/i.test(e.color) ? e.color : '#8B8D98'}`}>
                <span class="sw" aria-hidden="true"></span>
                <svg class="marca" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span class="truncate">{e.name}</span>
              </button>
            ))}
          </div>
        </fieldset>

        {/* Archivos al crear: antes había que crear la tarea, abrirla y
            subirlos desde el panel. Se suben en cuanto existe la tarea. */}
        <div>
          <span class="block field-label mb-1.5">{t('files.attach_label')}</span>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
            <label class="btn btn-secondary btn-sm cursor-pointer">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
              {t('files.attach_add')}
              <input type="file" id="nt-archivos" multiple class="sr-only" accept={TIPOS_ADJUNTO.join(',')} aria-describedby="nt-archivos-ayuda" />
            </label>
            <span id="nt-archivos-ayuda" class="hint">{t('files.attach_hint')}</span>
          </div>
          <ul id="nt-archivos-lista" class="mt-2 space-y-1 empty:hidden"></ul>
        </div>
      </div>
    </div>

    <div class="ventana-pie flex-wrap">
      <button type="button" class="btn btn-ghost" id="nt-cancelar">{t('modal.cancel')}</button>
      <button type="button" id="nt-crear-abrir" title={t('quick.create_open_hint')} class="btn btn-secondary">{t('quick.create_open')}</button>
      <button type="button" id="nt-crear" class="btn btn-primary">{t('modal.create')}</button>
    </div>
  </dialog>
)}

<script>
  import { aPayload, nuevoContacto } from './responsableCliente';
  import { interpretar, normalizar, type Interpretacion, type Tramo } from '../../lib/altaRapida';
  import { describir } from '../../lib/recurrencia';
  import { normalizarHora } from '../../lib/hora';
  import { hoyLocal, sumarDiasIso } from '../../lib/fechas';
  import { MAXIMO_ADJUNTO, TIPOS_ADJUNTO } from '../../lib/adjuntos';
  import { subirAdjunto } from '../../lib/client/adjuntos';

  const dlg = document.getElementById('nueva-tarea') as HTMLDialogElement | null;
  if (dlg) montar(dlg);

  function montar(dlg: HTMLDialogElement) {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
    const d = dlg.dataset;
    const sysTag = d.sysTag!;
    const lang = d.lang || 'en';
    const linea = $<HTMLInputElement>('nt-linea')!;
    const sugeridos = $<HTMLUListElement>('nt-apuntes-sugeridos')!;
    const chips = $<HTMLUListElement>('nt-chips')!;
    const aviso = $<HTMLParagraphElement>('nt-aviso')!;
    const fecha = $<HTMLInputElement>('nt-fecha')!;
    const hora = $<HTMLInputElement>('nt-hora')!;
    const prioridad = $<HTMLSelectElement>('nt-prioridad')!;
    const tipo = $<HTMLSelectElement>('nt-tipo')!;
    const responsable = $<HTMLSelectElement>('nt-responsable');
    let responsablePrevio = '';
    responsable?.addEventListener('focus', () => { responsablePrevio = responsable.value; });
    responsable?.addEventListener('change', async () => {
      manual.responsable = true;
      if (responsable.value !== '__nuevo') { responsablePrevio = responsable.value; return; }
      const creado = await nuevoContacto();
      responsable.value = creado ? creado.valor : responsablePrevio;
      responsablePrevio = responsable.value;
    });
    const contEtiquetas = $<HTMLDivElement>('nt-etiquetas')!;
    const CLAVE_TIPO = `forge_ultimo_tipo_${sysTag}`;

    let catalogo: Array<{ id: string; name: string; color: string }> = JSON.parse(d.etiquetas || '[]');
    /** Tramos descartados, por tipo y texto: los desplazamientos cambian al seguir escribiendo. */
    const descartados = new Set<string>();
    /** Campos que alguien tocó a mano: la línea ya no los pisa. */
    const manual = { fecha: false, hora: false, prioridad: false, trabajo: false, responsable: false };
    /**
     * Lo que pone una plantilla elegida. Va **debajo** de la línea: si se
     * escribe «viernes» después de elegir «Parcial», gana el viernes.
     */
    const porDefecto = { fecha: '', hora: '', prioridad: 'medium' };
    /** Lo que la plantilla añade al crear y no tiene campo propio. */
    let dePlantilla: { subtareas: string[]; recurrence: string | null } = { subtareas: [], recurrence: null };
    /** Las etiquetas que puso la plantilla: al cambiarla se quitan esas y no otras. */
    let etiquetasDePlantilla: string[] = [];
    const encendidas = new Set<string>();
    const apagadas = new Set<string>();
    /** Título normalizado del apunte → id, al elegirlo en el buscador. */
    const apuntesElegidos = new Map<string, string>();
    let ultima: Interpretacion | null = null;

    const claveTramo = (t: Tramo) => `${t.tipo}:${t.texto.toLowerCase()}`;

    function analizar() {
      // Las personas salen del propio desplegable: así `@` reconoce también
      // un contacto recién creado con «Nuevo contacto…».
      const personas = Array.from(responsable?.options ?? [])
        .filter((o) => o.value && o.value !== '__nuevo')
        .map((o) => ({ valor: o.value, nombre: o.text }));
      const ctx = { hoy: new Date(), lang, etiquetas: catalogo, personas };
      const primera = interpretar(linea.value, ctx);
      const ignorar = new Set(primera.tramos.filter((t) => descartados.has(claveTramo(t))).map((t) => t.inicio));
      const r = ignorar.size ? interpretar(linea.value, { ...ctx, ignorar }) : primera;
      ultima = r;

      if (!manual.fecha) fecha.value = r.fecha ?? porDefecto.fecha;
      const trabajo = $<HTMLInputElement>('nt-trabajo');
      if (trabajo && !manual.trabajo) trabajo.value = r.fechaTrabajo ?? '';
      if (!manual.hora) hora.value = r.hora ?? porDefecto.hora;
      if (!manual.prioridad) prioridad.value = r.prioridad ?? porDefecto.prioridad;
      if (responsable && !manual.responsable) responsable.value = r.responsable?.valor ?? '';
      const desdeLinea = new Set(r.etiquetas.map((e) => e.id));
      contEtiquetas.querySelectorAll<HTMLButtonElement>('.nt-etiqueta').forEach((b) => {
        const id = b.dataset.id!;
        const on = !apagadas.has(id) && (encendidas.has(id) || desdeLinea.has(id));
        b.setAttribute('aria-pressed', String(on));
      });
      pintarChips(r);
    }

    function chip(textoVisible: string, tipoChip: string, quitar?: () => void) {
      const li = document.createElement('li');
      li.className = 'chip !h-7 !pr-1';
      const etiqueta = document.createElement('span');
      etiqueta.className = 'text-forge-muted';
      etiqueta.textContent = `${tipoChip}:`;
      const valor = document.createElement('span');
      valor.textContent = textoVisible;
      li.append(etiqueta, valor);
      if (quitar) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'btn btn-ghost btn-icon btn-sm !w-5 !h-5';
        b.setAttribute('aria-label', (d.tRemove || '').replace('{texto}', textoVisible));
        b.textContent = '×';
        b.addEventListener('click', () => { quitar(); linea.focus(); });
        li.append(b);
      }
      return li;
    }

    function pintarChips(r: Interpretacion) {
      chips.replaceChildren();
      const nombres: Record<string, string> = {
        fecha: d.tChipFecha || '', hora: d.tChipHora || '', etiqueta: d.tChipEtiqueta || '',
        prioridad: d.tChipPrioridad || '', apunte: d.tChipApunte || '', repeticion: d.tChipRepeticion || '',
        trabajo: d.tChipTrabajo || '', recordatorio: d.tChipRecordatorio || '', responsable: d.tChipResponsable || '',
      };
      const faltan: string[] = [];
      for (const t of r.tramos) {
        let visible = t.texto.trim();
        if (t.tipo === 'trabajo' && r.fechaTrabajo) visible = `${visible} → ${new Date(`${r.fechaTrabajo}T00:00:00`).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', { weekday: 'short', day: 'numeric', month: 'short' })}`;
        if (t.tipo === 'fecha' && r.fecha) visible = `${visible} → ${new Date(`${r.fecha}T00:00:00`).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', { weekday: 'short', day: 'numeric', month: 'short' })}`;
        if (t.tipo === 'responsable' && r.responsable) visible = r.responsable.nombre;
        if (t.tipo === 'repeticion' && r.recurrencia) visible = describir(r.recurrencia, lang);
        if (t.tipo === 'apunte') {
          const titulo = t.texto.slice(2, -2).trim();
          if (!apuntesElegidos.has(normalizar(titulo))) faltan.push(titulo);
        }
        // Una etiqueta que no existe no se asigna: el chip lo dice, para que no
        // parezca puesta. Crearla es el botón de al lado.
        const nueva = t.tipo === 'etiqueta' && r.etiquetasNuevas.includes(t.texto.trim().slice(1));
        chips.append(chip(visible, nueva ? (d.tChipEtiquetaNueva || '') : nombres[t.tipo], () => { descartados.add(claveTramo(t)); analizar(); }));
      }
      // Etiquetas que no existen: se ofrece crearlas, nunca se crean solas.
      for (const nueva of r.etiquetasNuevas) {
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'btn btn-secondary btn-sm border-dashed';
        b.textContent = (d.tCreateLabel || '').replace('{nombre}', nueva);
        b.addEventListener('click', () => crearEtiqueta(nueva));
        li.append(b);
        chips.append(li);
      }
      aviso.classList.toggle('hidden', faltan.length === 0);
      aviso.textContent = faltan.map((f) => (d.tNoteMissing || '').replace('{titulo}', f)).join(' ');
    }

    async function crearEtiqueta(nombre: string) {
      try {
        const res = await fetch(`/api/w/${sysTag}/labels`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: nombre, color: d.colorDefecto }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const e = await res.json();
        catalogo = [...catalogo, { id: e.id, name: e.name, color: e.color }];
        const b = document.createElement('button');
        b.type = 'button';
        // Igual que las que pinta el servidor (`.etiqueta-opcion`), ya elegida.
        b.className = 'nt-etiqueta etiqueta-opcion';
        b.dataset.id = e.id;
        b.setAttribute('aria-pressed', 'true');
        b.style.setProperty('--c', e.color);
        const sw = document.createElement('span');
        sw.className = 'sw';
        sw.setAttribute('aria-hidden', 'true');
        const marca = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        marca.setAttribute('class', 'marca');
        marca.setAttribute('viewBox', '0 0 24 24');
        marca.setAttribute('fill', 'none');
        marca.setAttribute('stroke', 'currentColor');
        marca.setAttribute('stroke-width', '3');
        marca.setAttribute('aria-hidden', 'true');
        const linea = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
        linea.setAttribute('points', '20 6 9 17 4 12');
        marca.append(linea);
        const rotulo = document.createElement('span');
        rotulo.className = 'truncate';
        rotulo.textContent = e.name;
        b.append(sw, marca, rotulo);
        contEtiquetas.append(b);
        analizar();
      } catch (err) {
        console.error('crear etiqueta:', err);
        window.showToast?.(d.tLabelError || '', true);
      }
    }

    contEtiquetas.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.nt-etiqueta');
      if (!b) return;
      const id = b.dataset.id!;
      const on = b.getAttribute('aria-pressed') !== 'true';
      if (on) { encendidas.add(id); apagadas.delete(id); } else { apagadas.add(id); encendidas.delete(id); }
      b.setAttribute('aria-pressed', String(on));
    });
    fecha.addEventListener('change', () => { manual.fecha = true; });
    $<HTMLInputElement>('nt-trabajo')?.addEventListener('change', () => { manual.trabajo = true; });
    // La hora se lee igual que en el panel y en el servidor (`lib/hora.ts`):
    // «9», «9:00» o «0900» quedan como «09:00». Lo que no sea una hora se
    // dice junto al campo, no con un «no se ha podido crear» genérico.
    const errorHora = $<HTMLParagraphElement>('nt-hora-error')!;
    const leerHora = () => {
      const h = normalizarHora(hora.value);
      errorHora.classList.toggle('hidden', h !== null);
      hora.setAttribute('aria-invalid', String(h === null));
      if (h !== null) hora.value = h;
      return h;
    };
    hora.addEventListener('change', () => { manual.hora = true; leerHora(); });
    prioridad.addEventListener('change', () => { manual.prioridad = true; });

    // ── `[[` busca apuntes ───────────────────────────────────────────────────
    let opciones: Array<{ id: string; title: string }> = [];
    let activo = -1;
    let temporizador: ReturnType<typeof setTimeout> | undefined;
    const fragmentoApunte = () => /\[\[([^\]\n]*)$/.exec(linea.value.slice(0, linea.selectionStart ?? linea.value.length));
    const cerrarSugeridos = () => {
      sugeridos.classList.add('hidden');
      linea.setAttribute('aria-expanded', 'false');
      linea.removeAttribute('aria-activedescendant');
      activo = -1;
    };
    const resaltar = (i: number) => {
      activo = i;
      sugeridos.querySelectorAll('[role="option"]').forEach((el, k) => {
        el.setAttribute('aria-selected', String(k === i));
        el.classList.toggle('bg-forge-bg', k === i);
      });
      if (i >= 0) linea.setAttribute('aria-activedescendant', `nt-op-${i}`);
    };
    function elegirApunte(i: number) {
      const p = opciones[i];
      const m = fragmentoApunte();
      if (!p || !m) return;
      const fin = linea.selectionStart ?? linea.value.length;
      const inicio = fin - m[0].length;
      const insertado = `[[${p.title}]] `;
      linea.value = linea.value.slice(0, inicio) + insertado + linea.value.slice(fin);
      const caret = inicio + insertado.length;
      linea.setSelectionRange(caret, caret);
      apuntesElegidos.set(normalizar(p.title), p.id);
      cerrarSugeridos();
      analizar();
    }
    function buscarApuntes() {
      const m = fragmentoApunte();
      if (!m) { cerrarSugeridos(); return; }
      clearTimeout(temporizador);
      temporizador = setTimeout(async () => {
        const res = await fetch(`/api/w/${sysTag}/pages/search?q=${encodeURIComponent(m[1])}`);
        opciones = res.ok ? await res.json() : [];
        sugeridos.replaceChildren(...opciones.map((p, i) => {
          const li = document.createElement('li');
          li.id = `nt-op-${i}`;
          li.setAttribute('role', 'option');
          li.setAttribute('aria-selected', 'false');
          li.className = 'menu-item cursor-pointer truncate';
          li.textContent = p.title || '—';
          li.addEventListener('mousedown', (e) => { e.preventDefault(); elegirApunte(i); });
          return li;
        }));
        const hay = opciones.length > 0;
        sugeridos.classList.toggle('hidden', !hay);
        linea.setAttribute('aria-expanded', String(hay));
        resaltar(hay ? 0 : -1);
      }, 120);
    }

    linea.addEventListener('input', () => { analizar(); buscarApuntes(); });
    linea.addEventListener('blur', () => setTimeout(cerrarSugeridos, 100));
    linea.addEventListener('keydown', (e) => {
      const abierto = !sugeridos.classList.contains('hidden');
      if (abierto && e.key === 'ArrowDown') { e.preventDefault(); resaltar(Math.min(activo + 1, opciones.length - 1)); return; }
      if (abierto && e.key === 'ArrowUp') { e.preventDefault(); resaltar(Math.max(activo - 1, 0)); return; }
      if (abierto && e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); cerrarSugeridos(); return; }
      if (e.key === 'Enter') {
        e.preventDefault();
        if (abierto && activo >= 0) { elegirApunte(activo); return; }
        crear(e.shiftKey);
      }
    });
    $('nt-desc')?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); crear(false); }
    });

    // ── Crear ────────────────────────────────────────────────────────────────
    let enviando = false;

    async function idsDeApuntes(titulos: string[]) {
      const ids: string[] = [];
      for (const titulo of titulos) {
        const clave = normalizar(titulo);
        let id = apuntesElegidos.get(clave);
        if (!id) {
          // Escrito a mano sin elegir del buscador: se vincula si hay uno con
          // ese título exacto. Si no, se avisó en pantalla y no se vincula.
          const res = await fetch(`/api/w/${sysTag}/pages/search?q=${encodeURIComponent(titulo)}`);
          const lista: Array<{ id: string; title: string }> = res.ok ? await res.json() : [];
          id = lista.find((p) => normalizar(p.title) === clave)?.id;
        }
        if (id) ids.push(id);
      }
      return ids;
    }

    // ── Plantillas ───────────────────────────────────────────────────────────
    type Contenido = {
      title?: string; description?: string; type?: string; priority?: string; label_ids?: string[];
      subtareas?: string[]; recurrence?: string; due_offset?: number; due_time?: string;
    };
    const plantillas: Record<string, { name: string; contenido: Contenido }> = JSON.parse(d.plantillas || '{}');
    const selPlantilla = $<HTMLSelectElement>('nt-plantilla');
    const resumenPlantilla = $<HTMLParagraphElement>('nt-plantilla-resumen');

    /** Rellena el formulario con la plantilla, o lo deja como estaba sin ella. */
    function aplicarPlantilla(clave: string) {
      const p = plantillas[clave];
      for (const id of etiquetasDePlantilla) encendidas.delete(id);
      etiquetasDePlantilla = [];
      if (!p) {
        porDefecto.fecha = porDefecto.hora = '';
        porDefecto.prioridad = 'medium';
        dePlantilla = { subtareas: [], recurrence: null };
        resumenPlantilla?.classList.add('hidden');
        analizar();
        return;
      }
      const c = p.contenido;
      linea.value = c.title ?? '';
      descartados.clear();
      ($<HTMLTextAreaElement>('nt-desc')!).value = c.description ?? '';
      // La entrega cuenta desde hoy, en la zona de quien crea.
      porDefecto.fecha = c.due_offset !== undefined ? sumarDiasIso(hoyLocal(), c.due_offset) : '';
      porDefecto.hora = c.due_offset !== undefined ? (c.due_time ?? '') : '';
      porDefecto.prioridad = c.priority === 'lowest' ? 'low' : (c.priority ?? 'medium');
      manual.fecha = manual.hora = manual.prioridad = false;
      if (c.type && Array.from(tipo.options).some((o) => o.value === c.type)) tipo.value = c.type;
      // Se suman a las que ya hubiera (la del filtro del tablero, por ejemplo).
      // Una etiqueta borrada no tiene botón y no se manda.
      etiquetasDePlantilla = (c.label_ids ?? []).filter((id) => !encendidas.has(id));
      for (const id of etiquetasDePlantilla) { encendidas.add(id); apagadas.delete(id); }
      dePlantilla = { subtareas: c.subtareas ?? [], recurrence: c.recurrence ?? null };

      const partes = [
        dePlantilla.subtareas.length ? (d.tTplSteps || '').replace('{n}', String(dePlantilla.subtareas.length)) : '',
        dePlantilla.recurrence ? (d.tTplRepeat || '').replace('{regla}', describir(dePlantilla.recurrence, lang)) : '',
      ].filter(Boolean);
      if (resumenPlantilla) {
        resumenPlantilla.textContent = partes.length ? (d.tTplApplied || '').replace('{detalle}', partes.join(' · ')) : '';
        resumenPlantilla.classList.toggle('hidden', partes.length === 0);
      }
      analizar();
      linea.focus();
    }
    selPlantilla?.addEventListener('change', () => aplicarPlantilla(selPlantilla.value));

    // ── Archivos ─────────────────────────────────────────────────────────────
    const entradaArchivos = $<HTMLInputElement>('nt-archivos');
    const listaArchivos = $<HTMLUListElement>('nt-archivos-lista')!;
    let archivos: File[] = [];
    /** Por qué no se va a subir, antes de intentarlo. Las fotos se reducen al subir, así que su tamaño no cuenta aquí. */
    const problemaDe = (f: File) => {
      if (!TIPOS_ADJUNTO.includes(f.type)) return (d.tFileType || '').replace('{nombre}', f.name);
      if (!/^image\/(jpeg|png|webp)$/.test(f.type) && f.size > MAXIMO_ADJUNTO) return (d.tFileTooBig || '').replace('{nombre}', f.name);
      return '';
    };
    function pintarArchivos() {
      listaArchivos.replaceChildren(...archivos.map((f, i) => {
        const li = document.createElement('li');
        li.className = 'flex items-center gap-2 text-sm';
        const nombre = document.createElement('span');
        nombre.className = 'truncate flex-1 min-w-0';
        nombre.textContent = f.name;
        const tam = document.createElement('span');
        tam.className = 'hint shrink-0';
        tam.textContent = f.size >= 1048576 ? `${(f.size / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(f.size / 1024))} KB`;
        const quitar = document.createElement('button');
        quitar.type = 'button';
        quitar.className = 'btn btn-ghost btn-icon btn-sm shrink-0';
        quitar.setAttribute('aria-label', (d.tFileRemove || '').replace('{nombre}', f.name));
        quitar.textContent = '×';
        quitar.addEventListener('click', () => { archivos.splice(i, 1); pintarArchivos(); });
        li.append(nombre, tam, quitar);
        const problema = problemaDe(f);
        if (problema) {
          const aviso = document.createElement('span');
          aviso.className = 'basis-full text-xs text-forge-error';
          aviso.textContent = problema;
          li.classList.add('flex-wrap');
          li.append(aviso);
        }
        return li;
      }));
    }
    entradaArchivos?.addEventListener('change', () => {
      for (const f of Array.from(entradaArchivos.files ?? [])) {
        if (!archivos.some((x) => x.name === f.name && x.size === f.size)) archivos.push(f);
      }
      entradaArchivos.value = '';
      pintarArchivos();
    });

    /** Sube los adjuntos a la tarea recién creada y devuelve los que fallaron. */
    async function subirArchivos(issueId: string, boton: HTMLElement) {
      const fallidos: string[] = [];
      const validos = archivos.filter((f) => !problemaDe(f));
      for (const [i, f] of validos.entries()) {
        boton.textContent = (d.tUploading || '').replace('{n}', String(i + 1)).replace('{total}', String(validos.length));
        const r = await subirAdjunto(f, issueId);
        if (!r.ok) fallidos.push(f.name);
      }
      return [...fallidos, ...archivos.filter((f) => problemaDe(f)).map((f) => f.name)];
    }

    async function crear(abrir: boolean) {
      if (enviando) return;
      // `/nombre` + Enter elige esa plantilla: rellena el formulario, no crea.
      const barra = /^\/(.+)$/.exec(linea.value.trim());
      if (barra) {
        const buscado = normalizar(barra[1]);
        const claves = Object.keys(plantillas);
        const clave = claves.find((k) => normalizar(plantillas[k].name) === buscado) ?? claves.find((k) => normalizar(plantillas[k].name).startsWith(buscado));
        if (clave) {
          if (selPlantilla) selPlantilla.value = clave;
          aplicarPlantilla(clave);
          return;
        }
      }
      analizar();
      const r = ultima!;
      const titulo = r.titulo.trim();
      if (!titulo) { window.showToast?.(d.tErrTitle || '', true); linea.focus(); return; }
      const horaTexto = leerHora();
      if (horaTexto === null) { hora.focus(); return; }
      const regla = r.recurrencia ?? dePlantilla.recurrence;

      enviando = true;
      const boton = $('nt-crear')!;
      const textoBoton = boton.textContent;
      boton.textContent = d.tCreating || '';
      try {
        const etiquetasElegidas = Array.from(contEtiquetas.querySelectorAll<HTMLButtonElement>('.nt-etiqueta[aria-pressed="true"]')).map((b) => b.dataset.id!);
        const cuerpo: Record<string, unknown> = {
          title: titulo,
          type: tipo.value,
          description: ($<HTMLTextAreaElement>('nt-desc')?.value || '').trim() || null,
          due_date: fecha.value || null,
          due_time: fecha.value && horaTexto ? horaTexto : null,
          priority: prioridad.value,
          ...aPayload($<HTMLSelectElement>('nt-responsable')?.value || ''),
          label_ids: etiquetasElegidas,
          page_ids: await idsDeApuntes(r.apuntes),
          // Una repetición sin fecha no se manda: el servidor la rechazaría.
          recurrence: regla && fecha.value ? regla : null,
          subtareas: dePlantilla.subtareas,
          planned_date: ($<HTMLInputElement>('nt-trabajo')?.value) || r.fechaTrabajo || null,
          // Un recordatorio sin entrega no tiene a qué referirse.
          reminder_minutes: fecha.value && r.recordatorio !== null ? r.recordatorio : null,
        };
        const sprint = $<HTMLSelectElement>('nt-sprint');
        if (sprint) cuerpo.sprint_id = sprint.value || null;
        const estimado = $<HTMLInputElement>('nt-estimado');
        if (estimado?.value) cuerpo.estimated_hours = Number(estimado.value);
        const puntos = $<HTMLInputElement>('nt-puntos');
        if (puntos?.value) cuerpo.story_points = Number(puntos.value);

        const res = await fetch(`/api/w/${sysTag}/issues`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(cuerpo),
        });
        if (!res.ok) {
          console.error('crear tarea:', await res.text());
          throw new Error(`HTTP ${res.status}`);
        }
        const { id } = await res.json();
        try { localStorage.setItem(CLAVE_TIPO, tipo.value); } catch { /* sin almacenamiento */ }

        // La tarea ya existe: un archivo que falla no la deshace, se avisa.
        const fallidos = archivos.length ? await subirArchivos(id, boton) : [];
        const avisoFallo = fallidos.length ? (d.tFilesFailed || '').replace('{lista}', fallidos.join(', ')) : '';
        // Si la página se va a recargar, el aviso viaja a la siguiente.
        const enTablero = !!document.querySelector('.kanban-container') && window.location.pathname.endsWith('/board');
        if (avisoFallo && (abrir || enTablero)) {
          try { sessionStorage.setItem('forge_aviso', JSON.stringify({ texto: avisoFallo, error: true })); } catch { /* sin almacenamiento */ }
        }

        if (abrir || !enTablero) {
          if (abrir) { window.location.href = `/w/${sysTag}/board?issue=${encodeURIComponent(id)}`; return; }
          dlg.close();
          if (avisoFallo) { window.showToast?.(avisoFallo, true); return; }
          window.showToast?.(d.tCreated || '', false, {
            accion: d.tSee || '',
            alPulsar: () => { window.location.href = `/w/${sysTag}/board?issue=${encodeURIComponent(id)}`; },
          });
          return;
        }
        window.location.reload();
      } catch (err) {
        console.error('crear tarea:', err);
        window.showToast?.(d.tErrCreate || '', true);
      } finally {
        enviando = false;
        boton.textContent = textoBoton;
      }
    }

    $('nt-crear')?.addEventListener('click', () => crear(false));
    $('nt-crear-abrir')?.addEventListener('click', () => crear(true));
    $('nt-cancelar')?.addEventListener('click', () => dlg.close());

    function abrirAlta() {
      linea.value = '';
      ($<HTMLTextAreaElement>('nt-desc')!).value = '';
      if (selPlantilla) selPlantilla.value = '';
      aplicarPlantilla('');
      archivos = [];
      pintarArchivos();
      errorHora.classList.add('hidden');
      hora.removeAttribute('aria-invalid');
      descartados.clear();
      encendidas.clear();
      apagadas.clear();
      apuntesElegidos.clear();
      manual.fecha = manual.hora = manual.prioridad = manual.trabajo = manual.responsable = false;
      const est = $<HTMLInputElement>('nt-estimado');
      if (est) est.value = '';
      const pts = $<HTMLInputElement>('nt-puntos');
      if (pts) pts.value = '';
      // El último tipo usado en este espacio, no siempre el primero de la lista.
      try {
        const guardado = localStorage.getItem(CLAVE_TIPO);
        if (guardado && Array.from(tipo.options).some((o) => o.value === guardado)) tipo.value = guardado;
      } catch { /* sin almacenamiento */ }
      // Desde el tablero, el sprint que se está mirando.
      const sprint = $<HTMLSelectElement>('nt-sprint');
      const actual = document.querySelector<HTMLElement>('.kanban-container')?.dataset.sprint;
      if (sprint) sprint.value = actual && actual !== 'backlog' && Array.from(sprint.options).some((o) => o.value === actual) ? actual : '';
      // Con el tablero filtrado por una etiqueta, la tarea nueva la lleva.
      const filtro = document.querySelector<HTMLElement>('.kanban-container')?.dataset.label;
      if (filtro) encendidas.add(filtro);
      analizar();
      dlg.showModal();
      linea.focus();
    }
    (window as any).forgeNuevaTarea = abrirAlta;
    document.getElementById('btn-new-issue')?.addEventListener('click', abrirAlta);
  }
</script>
