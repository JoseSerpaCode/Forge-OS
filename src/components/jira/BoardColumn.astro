---
interface Props {
  title: string;
  status: string;
  /** La que se ve en móvil. Las demás se esconden por debajo de `sm`. */
  activaEnMovil?: boolean;
  /** Cuántos hay de verdad en esta columna, contados en la base. */
  total?: number;
  /** Cuántos se han pintado. Si es menor que `total`, se avisa. */
  shown?: number;
  /** El carril (id de etiqueta, o '' para «sin etiqueta») si el tablero va agrupado. */
  carril?: string | null;
  /**
   * Hecho no se recorta en silencio: enseña las últimas y un botón para
   * traer las siguientes. `cursor` es el de la última tarjeta pintada.
   */
  verMas?: { cursor: string } | null;
  /** Los puntos de la columna (con puntos encendidos), y los de las tarjetas pintadas. */
  puntos?: number;
  puntosMostrados?: number;
}

import { useTranslations } from '../../i18n/ui';
import { info as infoEstado } from '../../lib/status';

const { title, status, total, shown, activaEnMovil = false, carril = null, verMas = null, puntos, puntosMostrados = 0 } = Astro.props;
const t = useTranslations(Astro.locals.lang || 'en');

// El contador del encabezado lo pisa el JavaScript al arrastrar tarjetas, pero
// tiene que salir bien ya en el HTML: si no, quien llega con la conexión lenta
// —o con el JS bloqueado— ve un 0 sobre una columna llena.
const headerCount = typeof total === 'number' ? total : 0;
const truncated = typeof total === 'number' && typeof shown === 'number' && total > shown;
---
{/*
  En móvil se ve una columna, no cuatro: la elegida, a ancho completo, y el
  conmutador de arriba dice cuáles son las otras y cuánto hay en cada una.

  La columna remata en arco (la boca de la fragua del logo) y va teñida de su
  estado. El color sale de `lib/status.ts` y solo pinta fondo y punto: el
  rótulo va en tinta.
*/}
<section
  class:list={["board-column columna shrink-0 max-sm:w-full sm:w-auto flex flex-col min-w-0 relative", !activaEnMovil && "max-sm:hidden"]}
  style={`--c:${infoEstado(status).color}`}
  aria-label={`${title}, ${headerCount}`}
  data-status={status} data-carril={carril ?? undefined} data-total={headerCount} data-shown={shown ?? 0}
  data-puntos={puntos} data-puntos-shown={puntos === undefined ? undefined : puntosMostrados}>
  <header class="columna-cabeza">
    <h2 class="columna-titulo"><span class="truncate">{title}</span></h2>
    <span class="flex items-baseline gap-2 shrink-0">
      {puntos !== undefined && (
        <span class="columna-pts" data-plantilla={t('board.points_short')}>{t('board.points_short').replace('{n}', String(puntos))}</span>
      )}
      <span class="columna-n issue-count" aria-hidden="true">{headerCount}</span>
    </span>
  </header>
  <div class="flex-1 p-3 flex flex-col gap-2.5 overflow-y-auto min-h-[12rem] column-content relative">
    {/* Vacío tipográfico: sin dibujos, una frase que dice qué pasa aquí. */}
    <p class="empty-state hidden text-center text-sm text-forge-muted py-8 px-2 pointer-events-none">{t('board.drop_here')}</p>
    <slot />

    {/* Esconder trabajo sin decirlo es peor que ir lento: si la columna se ha
        recortado, se dice cuánto queda fuera y dónde verlo. */}
    {truncated && verMas && (
      <button type="button" class="ver-mas btn btn-ghost btn-sm self-center text-forge-accent-text"
        data-cursor={verMas.cursor}
        data-t-plantilla={t('board.show_more')}
        data-t-cargando={t('board.loading')}>
        {t('board.show_more').replace('{n}', String((total ?? 0) - (shown ?? 0)))}
      </button>
    )}
    {truncated && !verMas && (
      <p class="text-xs text-forge-muted text-center py-2">
        {shown} / {total} · {t('board.truncated')}
      </p>
    )}
  </div>
</section>

<style>
  /* Show empty state when there are no issue cards */
  .column-content:not(:has(.issue-card)) .empty-state {
    display: block;
  }
  /* Con el tablero entero vacío ya lo dice la línea de arriba: repetirlo en
     las cuatro columnas es ruido. */
  :global(.kanban-container[data-vacio='true']) .column-content .empty-state {
    display: none;
  }

</style>
