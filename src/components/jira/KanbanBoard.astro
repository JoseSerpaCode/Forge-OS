---
import BoardColumn from './BoardColumn.astro';
import IssueCard from './IssueCard.astro';
import IssueDetailsModal from './IssueDetailsModal.astro';

interface Props {
  issues: any[];
  workspaceId: string;
  sprints?: any[];
  currentSprintId?: string | null;
  workspaceMembers?: any[];
  userRole?: string;
  /** Total real por estado, para poder avisar de lo que no se pinta. */
  statusCounts?: Record<string, number>;
  /** Catálogo de etiquetas del espacio, para el selector del modal. */
  labels?: Array<{ id: string; name: string; color: string }>;
  /** Tipos de ticket del espacio. Ya no son tres fijos. */
  issueTypes?: Array<{ id: string; key: string; name: string; color: string; isBuiltin: boolean }>;
  /** Orden activo. Con uno que no es el manual, arrastrar no puede funcionar. */
  sortMode?: string;
  sysTag?: string;
}

import { useTranslations } from '../../i18n/ui';
const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);

const { issues, workspaceId, sprints = [], currentSprintId = null, workspaceMembers = [], userRole = 'viewer', statusCounts = {}, labels = [], issueTypes = [], sortMode = 'manual', sysTag = '' } = Astro.props;



// Por clave, para no recorrer la lista una vez por tarjeta.
const tiposPorClave = new Map(issueTypes.map((t) => [t.key, t]));
const canEdit = userRole === 'owner' || userRole === 'editor';

/**
 * Arrastrar solo tiene sentido con el orden manual.
 *
 * Con el tablero ordenado por prioridad, soltar una tarjeta escribiría un
 * `position` que la vista ni mira: la tarjeta volvería sola a su sitio y
 * parecería un fallo. Se apaga el arrastre y se dice por qué, en vez de dejar
 * que la gente lo intente tres veces.
 */
const ordenManual = sortMode === 'manual';
// Las tarjetas siguen siendo arrastrables aunque el tablero esté ordenado.
//
// Antes se apagaba el arrastre y se ponía una banda de aviso encima del
// tablero, permanente y en medio. Pero si alguien arrastra una tarjeta ya ha
// dicho lo que quiere: colocarla a mano. En vez de explicarle por qué no puede,
// se le ofrece volver al orden manual y seguir.
const sePuedeArrastrar = canEdit;

const columns = [
  { id: 'todo', title: t('status.todo'), corto: t('status.short.todo') },
  { id: 'in_progress', title: t('status.in_progress'), corto: t('status.short.in_progress') },
  { id: 'review', title: t('status.review'), corto: t('status.short.review') },
  { id: 'done', title: t('status.done'), corto: t('status.short.done') }
];

/**
 * El estado que se ve al abrir el tablero en un teléfono.
 *
 * `todo` y no «el primero que tenga algo»: el tablero tiene que abrirse
 * siempre en el mismo sitio, o el conmutador salta solo entre visitas y deja
 * de servir como punto de referencia.
 */
const ESTADO_INICIAL = 'todo';

// Se cuenta una vez y lo usan las columnas y el conmutador. Antes el `filter`
// se repetía dos veces por columna dentro del propio `map`.
const porEstado = new Map(
  columns.map((col) => [col.id, issues.filter((i) => i.status === col.id)])
);
const totalDe = (id: string) => statusCounts[id] ?? (porEstado.get(id)?.length ?? 0);

// Helper para extraer iniciales
function getInitials(username: string) {
  if (!username) return 'UN';
  return username.substring(0, 2).toUpperCase();
}
---
<div class="h-full flex flex-col relative">
  {/*
    El conmutador de estado.

    En escritorio las cuatro columnas se ven de un vistazo y el encabezado de
    cada una lleva su cuenta. En un teléfono no cabe ninguna de las dos cosas,
    así que la información se traslada aquí: qué estados hay, cuál se está
    mirando y cuánto hay en cada uno, en una fila.

    Es `role="tablist"` y no un `<select>` porque las cuatro opciones son fijas
    y caben: un desplegable escondería tras un toque lo que aquí se lee sin
    tocar nada, que es justamente la cuenta.
  */}
  <div class="sm:hidden shrink-0 mb-3 grid grid-cols-4 gap-1 p-1 bg-forge-panel border border-forge-border rounded-xl" role="tablist" aria-label={t('board.status_filter')}>
    {columns.map((col) => (
      <button
        type="button"
        role="tab"
        class:list={[
          'filtro-estado flex items-center justify-center gap-1 px-0.5 rounded-lg text-xs font-semibold transition-colors min-w-0',
          col.id === ESTADO_INICIAL ? 'bg-forge-primary text-forge-on-accent' : 'text-forge-muted',
        ]}
        data-estado={col.id}
        aria-selected={col.id === ESTADO_INICIAL ? 'true' : 'false'}
      >
        {/* La etiqueta corta, no la de la columna. En cuatro huecos de 78 px
            «en progreso» y «en revisión» se recortaban a «en progr…»; la
            cabecera de la columna sigue con el nombre entero, que es donde hay
            sitio para él. */}
        <span class="truncate">{col.corto}</span>
        <span class="font-mono opacity-70 shrink-0">{totalDe(col.id)}</span>
      </button>
    ))}
  </div>

  <div class="flex gap-4 h-full overflow-x-auto pb-4 kanban-container" data-workspace={workspaceId} data-can-edit={sePuedeArrastrar.toString()} data-sort-mode={sortMode} data-t-no-drag={t('board.sort_no_drag')}>
    {columns.map(col => (
      <BoardColumn
        title={col.title}
        status={col.id}
        total={totalDe(col.id)}
        shown={porEstado.get(col.id)!.length}
        activaEnMovil={col.id === ESTADO_INICIAL}
      >
        {porEstado.get(col.id)!.map(issue => (
          <IssueCard issue={{
            id: issue.id,
            title: issue.title,
            description: issue.description,
            type: issue.type,
            story_points: issue.story_points || 0,
            assignee_avatar: issue.assignee_avatar,
            assignee_username: issue.assignee_username,
            reporter_username: issue.reporter_username,
            assignee_id: issue.assignee_id,
            reporter_id: issue.reporter_id,
            position: issue.position || 0,
            sprint_id: issue.sprint_id || 'backlog',
            active_session_start: issue.active_session_start,
            due_date: issue.due_date,
            status: issue.status,
            logged_hours: issue.logged_hours,
            labels: issue.labels || []
          }} canEdit={canEdit} arrastrable={sePuedeArrastrar} tipo={tiposPorClave.get(issue.type) ?? null} />
        ))}
      </BoardColumn>
    ))}
  </div>
  
  {issues.length === 0 && (
    <div class="tablero-vacio absolute inset-0 z-10 flex flex-col items-center justify-center p-8 text-center bg-forge-bg/60 backdrop-blur-sm max-md:backdrop-blur-none rounded-xl border border-forge-border/30 m-4 shadow-xl">
      <div class="w-20 h-20 bg-forge-panel rounded-full border border-forge-border shadow-lg flex items-center justify-center mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-forge-accent-text"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line><path d="M13 8h4"></path><path d="M13 12h2"></path></svg>
      </div>
      <h3 class="text-xl font-black text-forge-text mb-2">{t('about.kanban.empty_title')}</h3>
      <p class="text-forge-muted max-w-md mx-auto mb-8 text-sm">{t('about.kanban.empty_desc')}</p>
      {canEdit && (
        <>
          {/* El atajo de teclado solo donde hay teclado.

              «Presiona [C] para crear una nueva tarea» es la primera —y única—
              indicación que ve quien abre un tablero vacío. En un teléfono
              señala una tecla que no existe, y encima se partía en tres líneas
              alrededor del recuadro de la C. Ahí se señala el botón, que sí
              está a un dedo de distancia. */}
          <div class="hidden sm:flex items-center gap-2 px-4 py-2 bg-forge-panel border border-forge-border rounded-lg shadow-sm text-sm text-forge-muted font-medium">
            {t('about.kanban.empty_cta_1')} <kbd class="px-2 py-1 bg-forge-bg border border-forge-border shadow-sm rounded text-[10px] text-forge-text font-mono font-bold mx-1">C</kbd> {t('about.kanban.empty_cta_2')}
          </div>
          <p class="sm:hidden px-4 py-2 bg-forge-panel border border-forge-border rounded-lg shadow-sm text-sm text-forge-muted font-medium text-center">
            {t('about.kanban.empty_cta_movil')}
          </p>
        </>
      )}
    </div>
  )}
</div>

<IssueDetailsModal sprints={sprints} currentSprintId={currentSprintId} workspaceMembers={workspaceMembers} labels={labels} issueTypes={issueTypes} sysTag={sysTag} />

<script>
  const columns = document.querySelectorAll('.board-column');
  const cards = document.querySelectorAll('.issue-card');
  const container = document.querySelector('.kanban-container');

  /**
   * El conmutador de estado, en móvil.
   *
   * Enseña una columna y esconde las otras tres con `max-sm:hidden`, la misma
   * clase con la que el servidor pinta el estado inicial. Así lo que hace el
   * JavaScript es exactamente lo que ya venía en el HTML, y no hay un momento
   * —entre la carga y el primer clic— en el que el tablero se comporte de otra
   * forma.
   */
  const filtros = Array.from(document.querySelectorAll('.filtro-estado')) as HTMLButtonElement[];
  filtros.forEach((boton) => {
    boton.addEventListener('click', () => {
      const estado = boton.dataset.estado;
      if (!estado) return;

      filtros.forEach((otro) => {
        const activo = otro === boton;
        otro.classList.toggle('bg-forge-primary', activo);
        otro.classList.toggle('text-forge-on-accent', activo);
        otro.classList.toggle('text-forge-muted', !activo);
        otro.setAttribute('aria-selected', String(activo));
      });

      columns.forEach((columna) => {
        const suyo = (columna as HTMLElement).dataset.status === estado;
        columna.classList.toggle('max-sm:hidden', !suyo);
      });
    });
  });

  /**
   * Mover un ticket desde el desplegable de su tarjeta.
   *
   * Es la única forma de moverlo en un teléfono: el arrastre del tablero es
   * HTML5 y no dispara en táctil.
   *
   * La posición que se manda es la del final de la columna destino. Colocarlo
   * en un punto exacto es lo que hace el arrastre, y en móvil no hay forma de
   * expresar «entre estas dos»; llegar al final es lo que espera quien mueve
   * algo a «En progreso».
   */
  document.addEventListener('change', async (e) => {
    const select = (e.target as HTMLElement)?.closest?.('.mover-issue') as HTMLSelectElement | null;
    if (!select) return;

    const issueId = select.dataset.issueId;
    const nuevo = select.value;
    if (!issueId || !nuevo) return;

    const destino = document.querySelector(`.board-column[data-status="${nuevo}"]`);
    const ultimas = destino?.querySelectorAll('.issue-card');
    const ultima = ultimas?.[ultimas.length - 1] as HTMLElement | undefined;
    const posicion = ultima ? Number(ultima.dataset.position || 0) + 100000 : 100000;

    select.disabled = true;
    try {
      const res = await fetch(`/api/issues/${issueId}/move`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: nuevo, position: posicion }),
      });
      if (!res.ok) {
        console.error('mover issue:', await res.text());
        (window as any).showToast?.(window.forgeMsg?.errGenerico || '', true);
        select.disabled = false;
        return;
      }
      // Recargar y no mover la tarjeta a mano: las cuentas de cada columna, el
      // total del sprint y la barra de tiempo cambian con ella, y actualizar
      // cuatro sitios por separado es como se quedan desfasados.
      window.location.reload();
    } catch (err) {
      console.error('mover issue:', err);
      (window as any).showToast?.(window.forgeMsg?.errGenerico || '', true);
      select.disabled = false;
    }
  });
  const workspaceId = container?.getAttribute('data-workspace');
  const canEdit = container?.getAttribute('data-can-edit') === 'true';

  // Inicializar conteos
  //
  // El contador cuenta las tarjetas del DOM, pero el tablero solo pinta las
  // primeras 100 de cada columna. Recontar a secas escribía «100» sobre una
  // columna de 1.995 y contradecía al aviso de justo debajo.
  //
  // Se parte del total que ha calculado el servidor y se le suma la diferencia
  // entre lo que hay ahora y lo que había al cargar: así arrastrar una tarjeta
  // mueve los dos contadores en uno, como debe, sin fingir que se conoce lo que
  // no se ha traído.
  const updateCounts = () => {
    columns.forEach(col => {
      const shownNow = col.querySelectorAll('.issue-card').length;
      const total = Number(col.getAttribute('data-total') ?? shownNow);
      const shownAtLoad = Number(col.getAttribute('data-shown') ?? shownNow);
      const count = total - shownAtLoad + shownNow;
      const countBadge = col.querySelector('.issue-count');
      if (countBadge) countBadge.textContent = count.toString();
    });
  };
  updateCounts();

  cards.forEach(card => {
    if (canEdit) {
      card.addEventListener('dragstart', (e: any) => {
        /**
         * Con un orden activo, arrastrar no puede funcionar: la posición que se
         * guardaría es la que la vista no mira, así que la tarjeta volvería
         * sola a su sitio y parecería que la aplicación está rota.
         *
         * Se corta el arrastre y se pregunta, en vez de dejar una banda de
         * aviso permanente ocupando sitio para algo que solo importa en este
         * instante.
         */
        if (container?.getAttribute('data-sort-mode') !== 'manual') {
          e.preventDefault();
          const volver = () => {
            const url = new URL(window.location.href);
            url.searchParams.delete('sort');
            window.location.href = url.toString();
          };
          (window as any).forgeConfirm?.(container?.getAttribute('data-t-no-drag') || '', volver);
          return;
        }

        e.dataTransfer.setData('text/plain', card.id);
        card.classList.add('opacity-50');
        e.dataTransfer.effectAllowed = 'move';
        
        // Store current status in card BEFORE it is moved by dragover appendChild
        card.setAttribute('data-status-val', card.closest('.board-column')?.getAttribute('data-status') || '');
      });

      card.addEventListener('dragend', () => {
        card.classList.remove('opacity-50');
        columns.forEach(c => {
          const content = c.querySelector('.column-content');
          if (content) content.classList.remove('bg-forge-secondary/10');
        });
      });
    }
    
    // Modal logic
    card.addEventListener('click', (e) => {
      /**
       * Pulsar el desplegable de mover no abre el ticket.
       *
       * La tarjeta entera abre el modal, así que tocar el `<select>` que hay
       * dentro lo abría encima y el desplegable no llegaba a desplegarse: en
       * móvil, mover un ticket era imposible **incluso con el control puesto**.
       */
      if ((e.target as HTMLElement)?.closest?.('.mover-issue')) return;

      try {
        const modal = document.getElementById('issue-details-modal');
        const titleEl = document.getElementById('modal-issue-title');
        const idEl = document.getElementById('modal-issue-id');
        const descEl = document.getElementById('modal-issue-desc') as HTMLTextAreaElement;
        const pointsEl = document.getElementById('modal-issue-points') as HTMLInputElement;
        
        if (!modal || !titleEl || !idEl || !descEl || !pointsEl) {
          if (window.showToast) window.showToast('Missing modal elements', true);
          return;
        }

        if (modal && titleEl && idEl && descEl && pointsEl) {
          idEl.textContent = card.id.substring(0, 8).toUpperCase();
          idEl.setAttribute('data-full-id', card.id);
          (titleEl as HTMLInputElement).value = card.querySelector('h4')?.textContent || '';
          descEl.value = card.getAttribute('data-description') || '';
          pointsEl.value = card.getAttribute('data-points') || '0';
          
          const sprintEl = document.getElementById('modal-issue-sprint') as HTMLSelectElement;
          if (sprintEl) {
            sprintEl.value = card.getAttribute('data-sprint-id') || 'backlog';
          }

          // Las etiquetas las pinta el propio modal: toda su lógica vive allí
          // y aquí solo se le dice de qué ticket se trata.
          (window as any).forgeLabelsOpen?.(card.id);
          (window as any).forgeDriveFilesOpen?.(card.id);

          // La clave viaja en un `data-*` de la insignia.
          //
          // Antes se sacaba de su **texto** en minúsculas y se comparaba con
          // 'task', 'bug' y 'story'. Eso ya fallaba con la interfaz en español
          // —«Tarea» no es 'task'— y con tipos propios falla siempre: el
          // desplegable del modal se quedaba en la primera opción y guardar
          // cualquier otro cambio le cambiaba el tipo al ticket sin tocarlo.
          const typeBadge = card.querySelector('.issue-type-badge');
          const typeEl = document.getElementById('modal-issue-type') as HTMLSelectElement;
          const clave = typeBadge?.getAttribute('data-type-key');
          if (typeEl && clave) {
            const existe = Array.from(typeEl.options).some((o) => o.value === clave);
            // Un tipo borrado ya no está en la lista. Se añade como opción
            // suelta para no cambiárselo por accidente al guardar otra cosa.
            if (!existe) {
              const suelta = document.createElement('option');
              suelta.value = clave;
              suelta.textContent = clave;
              typeEl.appendChild(suelta);
            }
            typeEl.value = clave;
          }
          
          // Update Assignee and Reporter
          const assigneeId = card.getAttribute('data-assignee-id');
          const reporterId = card.getAttribute('data-reporter-id');
          
          const assigneeSelect = document.getElementById('modal-issue-assignee') as HTMLSelectElement;
          const reporterSelect = document.getElementById('modal-issue-reporter') as HTMLSelectElement;
          
          if (assigneeSelect) assigneeSelect.value = assigneeId || '';
          if (reporterSelect) reporterSelect.value = reporterId || 'system';
          
          // @ts-ignore
          if (window.loadIssueAttachments) window.loadIssueAttachments(card.id);
          // @ts-ignore
          if (window.loadWorkLogs) window.loadWorkLogs(card.id);
          // @ts-ignore
          if (window.refreshTimeTrackingUI) window.refreshTimeTrackingUI(card.id);

          modal.classList.remove('translate-x-full');
          document.getElementById('issue-details-backdrop')?.classList.remove('hidden');
        }
      } catch (err: any) {
        if (window.showToast) window.showToast('Error opening modal: ' + err.message, true);
      }
    });
  });

  // Helper to determine insert position
  function getDragAfterElement(container: Element, y: number) {
    const draggableElements = [...container.querySelectorAll('.issue-card:not(.opacity-50)')];
    
    return draggableElements.reduce((closest, child) => {
      const box = child.getBoundingClientRect();
      const offset = y - box.top - box.height / 2;
      if (offset < 0 && offset > closest.offset) {
        return { offset: offset, element: child };
      } else {
        return closest;
      }
    }, { offset: Number.NEGATIVE_INFINITY, element: null as Element | null }).element;
  }

  if (canEdit) {
    columns.forEach(column => {
    const content = column.querySelector('.column-content');
    column.addEventListener('dragover', (e: any) => {
      e.preventDefault();
      if (content) {
        content.classList.add('bg-forge-secondary/10');
        const afterElement = getDragAfterElement(content, e.clientY);
        const draggable = document.querySelector('.opacity-50');
        if (draggable) {
          if (afterElement == null) {
            content.appendChild(draggable);
          } else {
            content.insertBefore(draggable, afterElement);
          }
        }
      }
    });

    column.addEventListener('dragleave', () => {
      if (content) content.classList.remove('bg-forge-secondary/10');
    });

    column.addEventListener('drop', async (e: any) => {
      e.preventDefault();
      if (content) content.classList.remove('bg-forge-secondary/10');
      
      const issueId = e.dataTransfer.getData('text/plain');
      const card = document.getElementById(issueId);
      const newStatus = column.getAttribute('data-status');

      if (card && content && newStatus) {
        updateCounts();
        
        // Calculate new position based on siblings
        const siblings = [...content.querySelectorAll('.issue-card')];
        const cardIndex = siblings.indexOf(card);
        
        let newPosition = 0;
        if (siblings.length === 1) {
          newPosition = 100000;
        } else if (cardIndex === 0) {
          const nextPos = parseFloat(siblings[1].getAttribute('data-position') || '100000');
          newPosition = nextPos / 2;
        } else if (cardIndex === siblings.length - 1) {
          const prevPos = parseFloat(siblings[cardIndex - 1].getAttribute('data-position') || '0');
          newPosition = prevPos + 100000;
        } else {
          const prevPos = parseFloat(siblings[cardIndex - 1].getAttribute('data-position') || '0');
          const nextPos = parseFloat(siblings[cardIndex + 1].getAttribute('data-position') || '0');
          newPosition = (prevPos + nextPos) / 2;
        }
        
        card.setAttribute('data-position', newPosition.toString());

        try {
          const response = await fetch(`/api/issues/${issueId}/move`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              status: newStatus,
              position: newPosition,
              workspaceId 
            })
          });
          
          if (!response.ok) {
            throw new Error('Failed to update status and position');
          }
          
          // If we move to review or done, the backend auto-stops the timer.
          // Or if we move from done to another column, we need the server to render the Start button.
          // To ensure UI consistency without complex DOM manipulation, reload if changing columns.
          const oldStatus = card.getAttribute('data-status-val');
          if (oldStatus !== newStatus) {
             window.location.reload();
          }
        } catch (error) {
          console.error('[SYS.NET] Update failed', error);
          // Omitimos rollback visual para no complicar el script en el entorno actual
        }
      }
    });
  });
  } // end if canEdit

  // Check URL for issue parameter to auto-open
  window.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const issueId = urlParams.get('issue');
    if (issueId) {
      const card = document.getElementById(issueId);
      if (card) {
        // Find the specific card and simulate a click on its outer div
        (card as HTMLElement).click();
        
        // Remove from URL so reloads don't reopen it
        const newUrl = new URL(window.location.href);
        newUrl.searchParams.delete('issue');
        window.history.replaceState({}, '', newUrl.toString());
      }
    }
  });

  // Live Timer Update
  const updateTimers = () => {
    document.querySelectorAll('.active-timer-display').forEach(display => {
      const startStr = display.getAttribute('data-start-time');
      if (!startStr) return;
      
      let dateStr = startStr;
      if (!dateStr.endsWith('Z')) dateStr += 'Z';
      
      const started = new Date(dateStr).getTime();
      const now = Date.now();
      const sessionElapsed = Math.floor((now - started) / 1000);
      
      if (sessionElapsed < 0) return;
      
      const loggedHours = parseFloat(display.getAttribute('data-logged-hours') || '0');
      const totalElapsedSeconds = sessionElapsed + Math.floor(loggedHours * 3600);
      
      const h = Math.floor(totalElapsedSeconds / 3600);
      const m = Math.floor((totalElapsedSeconds % 3600) / 60);
      const s = totalElapsedSeconds % 60;
      
      const textEl = display.querySelector('.timer-text');
      if (textEl) {
        textEl.textContent = `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
      }
    });
  };
  setInterval(updateTimers, 1000);
  updateTimers();

  // Start Timer Logic
  document.querySelectorAll('.btn-start-timer').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const issueId = btn.getAttribute('data-issue-id');
      if (!issueId) return;
      
      btn.innerHTML = '<span class="animate-pulse">Starting...</span>';
      
      try {
        const response = await fetch(`/api/issues/${issueId}/timer`, { method: 'POST' });
        const data = await response.json();
        
        if (data.success) {
          if (data.stopped_previous) {
            if (window.showToast) window.showToast(`Auto-stopped previous timer on ${data.stopped_details.issueId.substring(0,8).toUpperCase()} and logged ${data.stopped_details.hours}h.`, false);
          }
          
          const card = btn.closest('.issue-card');
          const currentStatus = card?.closest('.board-column')?.getAttribute('data-status');
          
          if (currentStatus !== 'in_progress') {
             await fetch(`/api/issues/${issueId}/move`, {
               method: 'PATCH',
               headers: { 'Content-Type': 'application/json' },
               body: JSON.stringify({ status: 'in_progress', position: 0, workspaceId })
             });
          }
          window.location.reload();
        } else {
          if (window.showToast) window.showToast('Error: ' + data.message, true);
          btn.innerHTML = 'Start';
        }
      } catch (err) {
        console.error(err);
        btn.innerHTML = 'Start';
      }
    });
  });

  // Stop Timer Logic
  document.querySelectorAll('.btn-stop-timer').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const issueId = btn.getAttribute('data-issue-id');
      if (!issueId) return;
      
      const originalHtml = btn.innerHTML;
      btn.innerHTML = '<span>Stopping...</span>';
      
      try {
        const response = await fetch(`/api/issues/${issueId}/timer`, { method: 'DELETE' });
        const data = await response.json();
        
        if (data.success) {
          window.location.reload();
        } else {
          if (window.showToast) window.showToast('Error: ' + data.message, true);
          btn.innerHTML = originalHtml;
        }
      } catch (err) {
        console.error(err);
        btn.innerHTML = originalHtml;
      }
    });
  });
</script>
