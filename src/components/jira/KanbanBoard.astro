---
import BoardColumn from './BoardColumn.astro';
import IssueCard from './IssueCard.astro';
import IssueDetailsModal from './IssueDetailsModal.astro';
import LabelChip from '../labels/LabelChip.astro';
import { claveConteo, cursorDe } from '../../lib/tablero';
import type { Funciones } from '../../lib/funcionesEspacio';
import { sumarDiasIso } from '../../lib/fechas';
import type { Grupo } from '../../lib/tablero';

interface Props {
  issues: any[];
  workspaceId: string;
  sprints?: any[];
  currentSprintId?: string | null;
  workspaceMembers?: any[];
  userRole?: string;
  /** Total real por columna (o por `carril|columna`), para avisar de lo que no se pinta. */
  statusCounts?: Record<string, number>;
  /** Catálogo de etiquetas del espacio, para el selector del modal y los carriles. */
  labels?: Array<{ id: string; name: string; color: string }>;
  /** Tipos de ticket del espacio. Ya no son tres fijos. */
  issueTypes?: Array<{ id: string; key: string; name: string; color: string; isBuiltin: boolean }>;
  sysTag?: string;
  funciones?: Funciones;
  /** Un carril por etiqueta. */
  agrupar?: boolean;
  /** La etiqueta por la que se filtra, para que «ver más» respete el filtro. */
  filtroEtiqueta?: string | null;
  /** Prioridad, vencimiento y responsable, como parámetros de URL: «ver más» los respeta. */
  filtrosUrl?: string;
  /** Tablero de columnas, o las vistas por fecha. */
  vista?: 'tablero' | 'hoy' | 'proximos';
  grupos?: Grupo[];
  /** `AAAA-MM-DD` en la zona de quien mira. */
  hoy?: string;
  dias?: number;
}

import { useTranslations } from '../../i18n/ui';
const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);

const {
  issues, workspaceId, sprints = [], currentSprintId = null, workspaceMembers = [], userRole = 'viewer',
  statusCounts = {}, labels = [], issueTypes = [], sysTag = '',
  funciones = { sprints: false, tiempo: false, puntos: false }, agrupar = false, filtroEtiqueta = null,
  vista = 'tablero', grupos = [], hoy = '', dias = 14, filtrosUrl = '',
} = Astro.props;

/**
 * «Próximos» pinta **todos** los días del intervalo, también los vacíos: un
 * día sin tareas tiene que estar ahí para poder soltarle una encima.
 */
const diasProximos = vista === 'proximos'
  ? Array.from({ length: dias }, (_, i) => {
      const fecha = sumarDiasIso(hoy, i);
      return { clave: fecha, fecha, tarjetas: grupos.find((g) => g.clave === fecha)?.tarjetas ?? [] };
    })
  : [];
// Mayúscula solo en la primera letra: «Lunes, 19 oct». La clase `capitalize`
// la ponía en cada palabra y salía «19 Oct», que en español no se escribe.
const nombreDia = (iso: string) => {
  const texto = new Date(`${iso}T12:00:00Z`).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', { weekday: 'long', day: 'numeric', month: 'short', timeZone: 'UTC' });
  return texto.charAt(0).toLocaleUpperCase(lang) + texto.slice(1);
};
const masDias = (() => {
  const u = new URL(Astro.url);
  u.searchParams.set('dias', String(dias + 14));
  return `${u.pathname}${u.search}`;
})();

// Por clave, para no recorrer la lista una vez por tarjeta.
const tiposPorClave = new Map(issueTypes.map((t) => [t.key, t]));
const canEdit = userRole === 'owner' || userRole === 'editor';

const columns = [
  { id: 'todo', title: t('status.todo'), corto: t('status.short.todo') },
  { id: 'in_progress', title: t('status.in_progress'), corto: t('status.short.in_progress') },
  { id: 'review', title: t('status.review'), corto: t('status.short.review') },
  { id: 'done', title: t('status.done'), corto: t('status.short.done') }
];

/**
 * El estado que se ve al abrir el tablero en un teléfono.
 *
 * `todo` y no «el primero que tenga algo»: el tablero tiene que abrirse
 * siempre en el mismo sitio, o el conmutador salta solo entre visitas y deja
 * de servir como punto de referencia.
 */
const ESTADO_INICIAL = 'todo';

/**
 * Los carriles.
 *
 * Sin agrupar hay uno solo, sin cabecera (`null`). Agrupado, uno por etiqueta
 * con tareas —en el orden del catálogo— y «Sin etiqueta» al final. Un carril
 * vacío no se pinta: con una etiqueta por asignatura, las de asignaturas ya
 * terminadas llenarían la pantalla de cajas vacías.
 */
const conteoCarril = (carril: string) =>
  columns.reduce((n, c) => n + (statusCounts[claveConteo(c.id, carril)] ?? 0), 0);
const carriles: Array<{ id: string | null; nombre?: string; color?: string; total?: number }> = agrupar
  ? [
      ...labels.filter((l) => conteoCarril(l.id) > 0).map((l) => ({ id: l.id, nombre: l.name, color: l.color, total: conteoCarril(l.id) })),
      ...(conteoCarril('') > 0 ? [{ id: '', nombre: t('board.no_label'), total: conteoCarril('') }] : []),
    ]
  : [{ id: null }];

const enCarril = (carril: string | null, estado: string) =>
  issues.filter((i) => i.status === estado && (carril === null || (i.carril ?? '') === carril));
const totalDe = (carril: string | null, estado: string) =>
  statusCounts[claveConteo(estado, carril)] ?? enCarril(carril, estado).length;

// El conmutador de móvil cuenta por estado. Agrupado, una tarea con dos
// etiquetas se cuenta dos veces: es lo que se ve en pantalla.
const totalEstado = (estado: string) => carriles.reduce((n, c) => n + totalDe(c.id, estado), 0);
---
<div class="h-full flex flex-col relative">
  {/*
    El conmutador de estado.

    En escritorio las cuatro columnas se ven de un vistazo y el encabezado de
    cada una lleva su cuenta. En un teléfono no cabe ninguna de las dos cosas,
    así que la información se traslada aquí: qué estados hay, cuál se está
    mirando y cuánto hay en cada uno, en una fila.
  */}
  {vista === 'tablero' && (
  <div class="sm:hidden shrink-0 mb-3 grid grid-cols-4 gap-1 p-1 bg-forge-panel border border-forge-border rounded-xl" role="tablist" aria-label={t('board.status_filter')}>
    {columns.map((col) => (
      <button
        type="button"
        role="tab"
        class:list={[
          'filtro-estado flex items-center justify-center gap-1 px-0.5 rounded-lg text-xs font-semibold transition-colors min-w-0',
          col.id === ESTADO_INICIAL ? 'bg-forge-primary text-forge-on-accent' : 'text-forge-muted',
        ]}
        data-estado={col.id}
        aria-selected={col.id === ESTADO_INICIAL ? 'true' : 'false'}
      >
        <span class="truncate">{col.corto}</span>
        <span class="font-mono shrink-0">{totalEstado(col.id)}</span>
      </button>
    ))}
  </div>
  )}

  <div
    class:list={['kanban-container h-full pb-4', agrupar || vista !== 'tablero' ? 'flex flex-col gap-4 overflow-y-auto' : 'flex gap-4 overflow-x-auto']}
    data-vista={vista}
    data-t-moved-day={t('view.moved_day')}
    data-t-move-day-error={t('view.move_error')}
    data-workspace={workspaceId}
    data-sys-tag={sysTag}
    data-can-edit={canEdit.toString()}
    data-tiempo={funciones.tiempo ? 'true' : 'false'}
    data-agrupar={agrupar ? 'true' : 'false'}
    data-label={filtroEtiqueta ?? ''}
    data-filtros={filtrosUrl}
    data-sprint={funciones.sprints ? (currentSprintId ?? 'backlog') : ''}
    data-t-timer-start={t('card.timer_start')}
    data-t-timer-starting={t('card.timer_starting')}
    data-t-timer-stopping={t('card.timer_stopping')}
    data-t-timer-autostopped={t('card.timer_autostopped')}
    data-t-completed={t('card.completed_toast')}
    data-t-completed-timer={t('card.completed_timer_toast')}
    data-t-complete-error={t('card.complete_error')}
    data-t-next-created={t('repeat.next_created')}
    data-t-undo={t('board.undo')}
    data-t-lane-only={t('board.lane_drop_only')}
  >
    {/* «Hoy»: vencidas y de hoy. «Próximos»: un bloque por día. Las tarjetas
        son las mismas del tablero, así que abrirlas y completarlas funciona
        igual. */}
    {vista === 'hoy' && (grupos.length === 0
      ? <p class="text-sm text-forge-muted py-10 text-center">{t('view.nothing_today')}</p>
      : grupos.map((g) => (
        <section class="vista-grupo" data-grupo={g.clave}>
          <h2 class:list={['text-sm font-bold mb-2', g.clave === 'vencidas' ? 'text-forge-error' : 'text-forge-text']}>
            {g.clave === 'vencidas' ? t('view.overdue') : t('view.today')} <span class="font-mono text-forge-muted font-normal">{g.tarjetas.length}</span>
          </h2>
          <div class="grid gap-x-4 sm:grid-cols-2 xl:grid-cols-3">
            {g.tarjetas.map((issue) => <IssueCard issue={issue} canEdit={canEdit} tipo={tiposPorClave.get(issue.type) ?? null} funciones={funciones} />)}
          </div>
        </section>
      )))}
    {vista === 'proximos' && (
      <>
        {diasProximos.map((d) => (
          <section class="dia-proximos rounded-xl border border-forge-border/40 p-3 transition-colors" data-fecha={d.fecha}>
            <h2 class:list={['text-sm font-bold mb-2', d.fecha === hoy ? 'text-forge-accent-text' : 'text-forge-text']}>
              {nombreDia(d.fecha)} <span class="font-mono text-forge-muted font-normal">{d.tarjetas.length || ''}</span>
            </h2>
            {d.tarjetas.length === 0
              ? <p class="text-xs text-forge-muted">{t('view.empty_day')}</p>
              : <div class="grid gap-x-4 sm:grid-cols-2 xl:grid-cols-3">
                  {d.tarjetas.map((issue) => <IssueCard issue={issue} canEdit={canEdit} tipo={tiposPorClave.get(issue.type) ?? null} funciones={funciones} />)}
                </div>}
          </section>
        ))}
        <a href={masDias} class="self-center text-sm font-bold text-forge-accent-text hover:underline underline-offset-2 py-2">{t('view.more_days')}</a>
      </>
    )}

    {vista === 'tablero' && carriles.map((carril) => {
      const columnas = (
        <div class:list={['flex gap-4', agrupar ? 'overflow-x-auto pb-1 carril-columnas' : 'h-full w-full']}>
          {columns.map((col) => {
            const tarjetas = enCarril(carril.id, col.id);
            const total = totalDe(carril.id, col.id);
            const ultima = tarjetas[tarjetas.length - 1];
            return (
              <BoardColumn
                title={col.title}
                status={col.id}
                total={total}
                shown={tarjetas.length}
                carril={carril.id}
                activaEnMovil={col.id === ESTADO_INICIAL}
                verMas={col.id === 'done' && total > tarjetas.length && ultima ? { cursor: cursorDe(ultima) } : null}
              >
                {tarjetas.map((issue) => (
                  <IssueCard issue={issue} canEdit={canEdit} tipo={tiposPorClave.get(issue.type) ?? null} funciones={funciones} carril={carril.id} />
                ))}
              </BoardColumn>
            );
          })}
        </div>
      );
      return carril.id === null ? columnas : (
        /* `<details>` y no un acordeón hecho a mano: se pliega con teclado y
           lector de pantalla sin escribir nada, y abierto por defecto. */
        <details open class="carril shrink-0 bg-forge-panel/30 border border-forge-border/40 rounded-xl p-3" data-carril={carril.id}>
          <summary class="flex items-center gap-2 cursor-pointer select-none mb-3 font-semibold text-sm text-forge-text">
            {carril.color ? <LabelChip name={carril.nombre!} color={carril.color} /> : <span class="text-forge-muted">{carril.nombre}</span>}
            <span class="font-mono text-xs text-forge-muted">{carril.total}</span>
          </summary>
          {columnas}
        </details>
      );
    })}
  </div>

  {vista === 'tablero' && issues.length === 0 && (
    <div class="tablero-vacio absolute inset-0 z-10 flex flex-col items-center justify-center p-8 text-center bg-forge-bg/60 backdrop-blur-sm max-md:backdrop-blur-none rounded-xl border border-forge-border/30 m-4 shadow-xl">
      <div class="w-20 h-20 bg-forge-panel rounded-full border border-forge-border shadow-lg flex items-center justify-center mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-forge-accent-text" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line><path d="M13 8h4"></path><path d="M13 12h2"></path></svg>
      </div>
      <h3 class="text-xl font-black text-forge-text mb-2">{t('about.kanban.empty_title')}</h3>
      <p class="text-forge-muted max-w-md mx-auto mb-8 text-sm">{t('about.kanban.empty_desc')}</p>
      {canEdit && (
        <>
          {/* El atajo de teclado solo donde hay teclado: en un teléfono
              señala una tecla que no existe. */}
          <div class="hidden sm:flex items-center gap-2 px-4 py-2 bg-forge-panel border border-forge-border rounded-lg shadow-sm text-sm text-forge-muted font-medium">
            {t('about.kanban.empty_cta_1')} <kbd class="px-2 py-1 bg-forge-bg border border-forge-border shadow-sm rounded text-[10px] text-forge-text font-mono font-bold mx-1">C</kbd> {t('about.kanban.empty_cta_2')}
          </div>
          <p class="sm:hidden px-4 py-2 bg-forge-panel border border-forge-border rounded-lg shadow-sm text-sm text-forge-muted font-medium text-center">
            {t('about.kanban.empty_cta_movil')}
          </p>
        </>
      )}
    </div>
  )}
</div>

{/* Un solo menú de «mover a sprint» para todas las tarjetas: pintar uno por
    tarjeta serían cien menús iguales en el HTML. */}
{funciones.sprints && canEdit && (
  <div id="menu-sprint-tarjeta" role="menu" aria-label={t('card.move_sprint')}
    data-t-moved={t('card.moved_to')} data-t-error={t('card.move_sprint_error')} data-t-see={t('quick.see')}
    class="hidden fixed z-[60] min-w-[12rem] bg-forge-panel border border-forge-border rounded-xl shadow-xl py-1">
    {[{ name: t('board.backlog'), id: 'backlog' }, ...sprints.filter((s: any) => s.status !== 'completed')].map((s: any) => (
      <button type="button" role="menuitem" class="sprint-destino block w-full text-left px-3.5 py-2 text-sm text-forge-text hover:bg-forge-bg hover:text-forge-accent-text" data-sprint={s.id} data-nombre={s.name}>{s.name}</button>
    ))}
  </div>
)}

<IssueDetailsModal sprints={sprints} currentSprintId={currentSprintId} workspaceMembers={workspaceMembers} labels={labels} issueTypes={issueTypes} sysTag={sysTag} canManageTypes={userRole === 'owner'} funciones={funciones} />

<script>
  /**
   * El tablero, con los eventos **delegados** en el contenedor.
   *
   * Antes cada tarjeta recibía sus oyentes al cargar (`cards.forEach`). Las
   * que llegan después —«ver más» en Hecho— no los tenían: se veían, pero no
   * se abrían al pulsarlas ni se podían arrastrar. Con un oyente en el
   * contenedor, cualquier tarjeta que esté dentro funciona, llegue cuando llegue.
   */
  const container = document.querySelector<HTMLElement>('.kanban-container');
  const canEdit = container?.dataset.canEdit === 'true';
  const workspaceId = container?.dataset.workspace;
  const sysTag = container?.dataset.sysTag || window.location.pathname.split('/')[2];
  const texto = (clave: string) => container?.getAttribute(`data-t-${clave}`) || '';

  const tarjetaDe = (el: EventTarget | null) => (el as HTMLElement | null)?.closest?.<HTMLElement>('.issue-card') ?? null;
  const columnaDe = (el: Element | null) => el?.closest<HTMLElement>('.board-column') ?? null;
  const columnas = () => Array.from(document.querySelectorAll<HTMLElement>('.board-column'));

  /**
   * El conmutador de estado, en móvil.
   *
   * Enseña una columna —en todos los carriles— y esconde las otras con
   * `max-sm:hidden`, la misma clase con la que el servidor pinta el estado
   * inicial: lo que hace el JavaScript es exactamente lo que ya venía en el HTML.
   */
  const filtros = Array.from(document.querySelectorAll<HTMLButtonElement>('.filtro-estado'));
  filtros.forEach((boton) => {
    boton.addEventListener('click', () => {
      const estado = boton.dataset.estado;
      if (!estado) return;
      filtros.forEach((otro) => {
        const activo = otro === boton;
        otro.classList.toggle('bg-forge-primary', activo);
        otro.classList.toggle('text-forge-on-accent', activo);
        otro.classList.toggle('text-forge-muted', !activo);
        otro.setAttribute('aria-selected', String(activo));
      });
      columnas().forEach((columna) => columna.classList.toggle('max-sm:hidden', columna.dataset.status !== estado));
    });
  });

  /**
   * Los contadores de columna.
   *
   * El tablero no pinta todas las tarjetas, así que recontar el DOM escribiría
   * «10» sobre una columna de 214. Se parte del total del servidor y se le suma
   * la diferencia entre lo que hay ahora y lo que había al cargar.
   */
  const updateCounts = () => {
    columnas().forEach((col) => {
      const shownNow = col.querySelectorAll('.issue-card').length;
      const total = Number(col.dataset.total ?? shownNow);
      const shownAtLoad = Number(col.dataset.shown ?? shownNow);
      const badge = col.querySelector('.issue-count');
      if (badge) badge.textContent = String(total - shownAtLoad + shownNow);
    });
  };
  updateCounts();

  async function mover(issueId: string, status: string, position: number) {
    const res = await fetch(`/api/issues/${issueId}/move`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status, position, workspaceId }),
    });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    return res.json().catch(() => ({})) as Promise<{ recurrencia?: { creada?: { id: string; due_date: string } } }>;
  }

  /**
   * Mover una tarea desde el desplegable de su tarjeta (móvil).
   *
   * La posición es la del final de la columna destino: colocarla en un punto
   * exacto es lo que hace el arrastre, y en móvil no hay forma de expresar
   * «entre estas dos».
   */
  document.addEventListener('change', async (e) => {
    const select = (e.target as HTMLElement)?.closest?.<HTMLSelectElement>('.mover-issue');
    if (!select) return;
    const issueId = select.dataset.issueId;
    const nuevo = select.value;
    if (!issueId || !nuevo) return;

    const carril = columnaDe(select)?.dataset.carril;
    const destino = columnas().find((c) => c.dataset.status === nuevo && c.dataset.carril === carril);
    const ultimas = destino?.querySelectorAll<HTMLElement>('.issue-card');
    const ultima = ultimas?.[ultimas.length - 1];
    const posicion = ultima ? Number(ultima.dataset.position || 0) + 100000 : 100000;

    select.disabled = true;
    try {
      await mover(issueId, nuevo, posicion);
      // Recargar: las cuentas, el total y la barra de tiempo cambian con ella.
      window.location.reload();
    } catch (err) {
      console.error('mover issue:', err);
      window.showToast?.(window.forgeMsg?.errGenerico || '', true);
      select.disabled = false;
    }
  });

  /**
   * Completar con un clic.
   *
   * La tarjeta salta arriba de Hecho sin recargar —completar tiene que sentirse
   * instantáneo— y el aviso ofrece deshacer, que la devuelve a su columna y su
   * posición. Si tenía el cronómetro en marcha, completar lo para y registra las
   * horas (lo hace `move`); deshacer **no** las borra, porque es trabajo hecho,
   * y el aviso lo dice.
   */
  async function completar(card: HTMLElement) {
    const issueId = card.dataset.issueId!;
    const estadoAntes = columnaDe(card)?.dataset.status || card.dataset.status || 'todo';
    const posicionAntes = Number(card.dataset.position || 0);
    const habiaCronometro = !!card.querySelector('.active-timer-display');

    let respuesta: Awaited<ReturnType<typeof mover>> = {};
    try {
      respuesta = await mover(issueId, 'done', posicionAntes);
    } catch (err) {
      console.error('completar:', err);
      window.showToast?.(texto('complete-error'), true);
      return;
    }

    // Todas las copias de la tarjeta: con carriles puede haber más de una.
    document.querySelectorAll<HTMLElement>(`.issue-card[data-issue-id="${CSS.escape(issueId)}"]`).forEach((copia) => {
      copia.dataset.status = 'done';
      copia.querySelector('.btn-completar')?.remove();
      copia.querySelector('.card-timer')?.remove();
      const sel = copia.querySelector<HTMLSelectElement>('.mover-issue');
      if (sel) sel.value = 'done';
      const carril = columnaDe(copia)?.dataset.carril;
      const hecho = columnas().find((c) => c.dataset.status === 'done' && c.dataset.carril === carril);
      const contenido = hecho?.querySelector('.column-content');
      if (contenido) {
        const primera = contenido.querySelector('.issue-card');
        if (primera) contenido.insertBefore(copia, primera);
        else contenido.appendChild(copia);
      } else {
        copia.remove();
      }
    });
    updateCounts();

    // Si se repite, el aviso dice cuándo queda la siguiente.
    const siguiente = respuesta.recurrencia?.creada?.due_date;
    const mensaje = siguiente
      ? texto('next-created').replace('{fecha}', new Date(`${siguiente}T12:00:00Z`).toLocaleDateString(document.documentElement.lang === 'es' ? 'es-ES' : 'en-US', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' }))
      : habiaCronometro ? texto('completed-timer') : texto('completed');
    window.showToast?.(mensaje, false, {
      accion: texto('undo'),
      alPulsar: async () => {
        try {
          await mover(issueId, estadoAntes, posicionAntes);
          window.location.reload();
        } catch (err) {
          console.error('deshacer completar:', err);
          window.showToast?.(texto('complete-error'), true);
        }
      },
    });
  }

  /**
   * «Ver más» en Hecho: las siguientes, desde un parcial que pinta las mismas
   * tarjetas que el servidor. Con los eventos delegados, funcionan sin más.
   */
  async function verMas(boton: HTMLButtonElement) {
    const columna = columnaDe(boton);
    if (!columna) return;
    const params = new URLSearchParams(container?.dataset.filtros || '');
    params.set('despues', boton.dataset.cursor || '');
    if (container?.dataset.label) params.set('label', container.dataset.label);
    if (container?.dataset.sprint) params.set('sprint', container.dataset.sprint);
    if (container?.dataset.agrupar === 'true') {
      params.set('group', 'label');
      params.set('carril', columna.dataset.carril ?? '');
    }
    const textoAntes = boton.textContent;
    boton.disabled = true;
    boton.textContent = boton.dataset.tCargando || '';
    try {
      const res = await fetch(`/w/${sysTag}/board/hechas?${params}`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const plantilla = document.createElement('template');
      plantilla.innerHTML = await res.text();
      const meta = plantilla.content.querySelector<HTMLElement>('[data-hechas-meta]');
      const nuevas = Array.from(plantilla.content.querySelectorAll<HTMLElement>('.issue-card'));
      nuevas.forEach((nueva) => boton.before(nueva));
      // Las que llegan cuentan como pintadas: el contador sigue diciendo el total.
      columna.dataset.shown = String(Number(columna.dataset.shown || 0) + nuevas.length);
      updateCounts();
      const total = Number(columna.dataset.total || 0);
      const pintadas = columna.querySelectorAll('.issue-card').length;
      if (meta?.dataset.hayMas === 'true' && meta.dataset.cursor) {
        boton.dataset.cursor = meta.dataset.cursor;
        boton.textContent = (boton.dataset.tPlantilla || '').replace('{n}', String(Math.max(0, total - pintadas)));
        boton.disabled = false;
      } else {
        boton.remove();
      }
    } catch (err) {
      console.error('ver más:', err);
      boton.textContent = textoAntes;
      boton.disabled = false;
      window.showToast?.(window.forgeMsg?.errGenerico || '', true);
    }
  }

  /** Abrir el panel de una tarea con lo que lleva su tarjeta. */
  function abrirTarea(card: HTMLElement) {
    const issueId = card.dataset.issueId!;
    const modal = document.getElementById('issue-details-modal');
    const titleEl = document.getElementById('modal-issue-title') as HTMLInputElement | null;
    const idEl = document.getElementById('modal-issue-id');
    const descEl = document.getElementById('modal-issue-desc') as HTMLTextAreaElement | null;
    if (!modal || !titleEl || !idEl || !descEl) {
      window.showToast?.(window.forgeMsg?.errGenerico || '', true);
      return;
    }

    idEl.textContent = issueId.substring(0, 8).toUpperCase();
    idEl.setAttribute('data-full-id', issueId);
    titleEl.value = card.querySelector('h4')?.textContent || '';
    descEl.value = card.dataset.description || '';

    const pointsEl = document.getElementById('modal-issue-points') as HTMLInputElement | null;
    if (pointsEl) pointsEl.value = card.dataset.points || '0';
    const sprintEl = document.getElementById('modal-issue-sprint') as HTMLSelectElement | null;
    if (sprintEl) sprintEl.value = card.dataset.sprintId || 'backlog';
    const prioridadEl = document.getElementById('modal-issue-priority') as HTMLSelectElement | null;
    if (prioridadEl) {
      // `lowest` no está entre las cuatro opciones: se enseña como baja.
      prioridadEl.value = card.dataset.priority === 'lowest' ? 'low' : (card.dataset.priority || 'medium');
      prioridadEl.dispatchEvent(new Event('prioridad-sincronizar'));
    }
    const horaEl = document.getElementById('modal-issue-due-time') as HTMLInputElement | null;
    if (horaEl) horaEl.value = card.dataset.dueTime || '';

    // Las etiquetas, los archivos y los apuntes los pinta el propio modal.
    const w = window as any;
    w.forgeLabelsOpen?.(issueId);
    w.forgeDriveFilesOpen?.(issueId);
    w.forgeApuntesOpen?.(issueId);
    w.forgeSubtareasOpen?.(issueId);

    // La clave viaja en un `data-*` de la insignia: sacarla de su texto fallaba
    // con la interfaz en español y con tipos propios.
    const clave = card.querySelector('.issue-type-badge')?.getAttribute('data-type-key');
    const typeEl = document.getElementById('modal-issue-type') as HTMLSelectElement | null;
    if (typeEl && clave) {
      // Un tipo borrado ya no está en la lista. Se añade como opción suelta
      // para no cambiárselo por accidente al guardar otra cosa.
      if (!Array.from(typeEl.options).some((o) => o.value === clave)) {
        const suelta = document.createElement('option');
        suelta.value = clave;
        suelta.textContent = clave;
        typeEl.appendChild(suelta);
      }
      typeEl.value = clave;
      typeEl.dispatchEvent(new Event('tipo-sincronizar'));
    }

    const assigneeSelect = document.getElementById('modal-issue-assignee') as HTMLSelectElement | null;
    const reporterSelect = document.getElementById('modal-issue-reporter') as HTMLSelectElement | null;
    if (assigneeSelect) assigneeSelect.value = card.dataset.assigneeId || '';
    if (reporterSelect) reporterSelect.value = card.dataset.reporterId || 'system';

    // La repetición, después de la fecha: «el mismo día» se lee de la entrega.
    const repEl = document.getElementById('modal-issue-repeat') as HTMLSelectElement | null;
    const fechaOculta = document.getElementById('modal-issue-due-date') as HTMLInputElement | null;
    if (fechaOculta) fechaOculta.value = card.dataset.dueDate || '';
    const trabajoOculto = document.getElementById('modal-issue-planned-date') as HTMLInputElement | null;
    if (trabajoOculto) trabajoOculto.value = card.dataset.plannedDate || '';
    if (repEl) {
      repEl.dataset.regla = card.dataset.recurrence || '';
      repEl.dispatchEvent(new Event('repeticion-sincronizar'));
    }
    const recEl = document.getElementById('modal-issue-remind') as HTMLSelectElement | null;
    if (recEl) {
      recEl.dataset.minutos = card.dataset.reminder || '';
      recEl.dispatchEvent(new Event('recordar-sincronizar'));
    }

    w.loadIssueAttachments?.(issueId);
    // `refreshTimeTrackingUI` además rellena la fecha de entrega: se llama
    // siempre. Los registros de horas, solo si el espacio mide el tiempo.
    if (container?.dataset.tiempo === 'true') w.loadWorkLogs?.(issueId);
    w.refreshTimeTrackingUI?.(issueId);

    modal.classList.remove('translate-x-full');
    document.getElementById('issue-details-backdrop')?.classList.remove('hidden');
  }

  container?.addEventListener('click', (e) => {
    const objetivo = e.target as HTMLElement;
    const boton = objetivo.closest<HTMLButtonElement>('.ver-mas');
    if (boton) { verMas(boton); return; }

    const card = tarjetaDe(objetivo);
    if (!card) return;
    if (objetivo.closest('.btn-completar')) { completar(card); return; }
    // El desplegable de mover y los botones del cronómetro tienen su propio
    // trabajo: pulsarlos no abre la tarea (en móvil, el desplegable no llegaba
    // a desplegarse porque el panel se abría encima).
    if (objetivo.closest('.btn-mover-sprint')) { abrirMenuSprint(card, objetivo.closest<HTMLElement>('.btn-mover-sprint')!); return; }
    if (objetivo.closest('.mover-issue, .btn-start-timer, .btn-stop-timer')) return;
    try { abrirTarea(card); }
    catch (err) {
      console.error('abrir tarea:', err);
      window.showToast?.(window.forgeMsg?.errGenerico || '', true);
    }
  });

  // ── Mover a otro sprint ────────────────────────────────────────────────────
  const menuSprint = document.getElementById('menu-sprint-tarjeta');
  let tarjetaMenu: HTMLElement | null = null;
  let botonMenu: HTMLElement | null = null;
  const cerrarMenuSprint = (devolverFoco = false) => {
    menuSprint?.classList.add('hidden');
    botonMenu?.setAttribute('aria-expanded', 'false');
    if (devolverFoco) botonMenu?.focus();
    tarjetaMenu = null;
  };
  function abrirMenuSprint(card: HTMLElement, boton: HTMLElement) {
    if (!menuSprint) return;
    tarjetaMenu = card;
    botonMenu = boton;
    const actual = card.dataset.sprintId || 'backlog';
    menuSprint.querySelectorAll<HTMLElement>('.sprint-destino').forEach((b) => b.classList.toggle('hidden', b.dataset.sprint === actual));
    const caja = boton.getBoundingClientRect();
    menuSprint.classList.remove('hidden');
    const ancho = menuSprint.offsetWidth;
    menuSprint.style.top = `${Math.min(caja.bottom + 4, window.innerHeight - menuSprint.offsetHeight - 8)}px`;
    menuSprint.style.left = `${Math.max(8, Math.min(caja.right - ancho, window.innerWidth - ancho - 8))}px`;
    boton.setAttribute('aria-expanded', 'true');
    menuSprint.querySelector<HTMLElement>('.sprint-destino:not(.hidden)')?.focus();
  }
  menuSprint?.addEventListener('click', async (e) => {
    const destino = (e.target as HTMLElement).closest<HTMLElement>('.sprint-destino');
    const card = tarjetaMenu;
    if (!destino || !card) return;
    cerrarMenuSprint();
    const sprint = destino.dataset.sprint!;
    const issueId = card.dataset.issueId!;
    try {
      const res = await fetch(`/api/issues/${issueId}/move`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          sprint_id: sprint === 'backlog' ? null : sprint,
          status: columnaDe(card)?.dataset.status || card.dataset.status || 'todo',
          position: Number(card.dataset.position || 0),
          workspaceId,
        }),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      // Sale de la vista —el tablero enseña un sprint—, con aviso y enlace.
      document.querySelectorAll(`.issue-card[data-issue-id="${CSS.escape(issueId)}"]`).forEach((c) => c.remove());
      updateCounts();
      const m = menuSprint.dataset;
      window.showToast?.((m.tMoved || '').replace('{destino}', destino.dataset.nombre || ''), false, {
        accion: m.tSee || '',
        alPulsar: () => { window.location.href = `${window.location.pathname}?sprint=${encodeURIComponent(sprint)}&issue=${encodeURIComponent(issueId)}`; },
      });
    } catch (err) {
      console.error('mover de sprint:', err);
      window.showToast?.(menuSprint.dataset.tError || '', true);
    }
  });
  document.addEventListener('click', (e) => {
    if (!menuSprint || menuSprint.classList.contains('hidden')) return;
    if (!menuSprint.contains(e.target as Node) && !(e.target as HTMLElement).closest('.btn-mover-sprint')) cerrarMenuSprint();
  });
  document.addEventListener('keydown', (e) => {
    if (!menuSprint || menuSprint.classList.contains('hidden')) return;
    if (e.key === 'Escape') { e.preventDefault(); cerrarMenuSprint(true); return; }
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      const items = Array.from(menuSprint.querySelectorAll<HTMLElement>('.sprint-destino:not(.hidden)'));
      const i = items.indexOf(document.activeElement as HTMLElement);
      items[(i + (e.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length]?.focus();
    }
  });

  // Completar desde fuera del tablero (el aviso de «todas las subtareas hechas»).
  (window as any).forgeCompletarTarea = (issueId: string) => {
    const card = document.querySelector<HTMLElement>(`.issue-card[data-issue-id="${CSS.escape(issueId)}"]`);
    if (card && card.dataset.status !== 'done') completar(card);
  };

  // ── Arrastrar ──────────────────────────────────────────────────────────────
  let arrastrada: HTMLElement | null = null;

  function getDragAfterElement(content: Element, y: number) {
    const candidatas = [...content.querySelectorAll<HTMLElement>('.issue-card:not(.opacity-50)')];
    return candidatas.reduce((closest, child) => {
      const box = child.getBoundingClientRect();
      const offset = y - box.top - box.height / 2;
      return offset < 0 && offset > closest.offset ? { offset, element: child } : closest;
    }, { offset: Number.NEGATIVE_INFINITY, element: null as Element | null }).element;
  }

  /**
   * Con carriles, solo se suelta en el propio carril.
   *
   * Soltar en el carril de otra etiqueta podría querer decir «cámbiale la
   * etiqueta», pero también puede ser un arrastre que se pasó de largo; cambiar
   * etiquetas por accidente no se ve hasta mucho después. Se cambia editándola.
   */
  const mismoCarril = (col: HTMLElement) => !arrastrada || arrastrada.dataset.origenCarril === (col.dataset.carril ?? '');

  if (canEdit && container) {
    container.addEventListener('dragstart', (e: DragEvent) => {
      const card = tarjetaDe(e.target);
      if (!card || !e.dataTransfer) return;
      arrastrada = card;
      card.dataset.origenCarril = columnaDe(card)?.dataset.carril ?? '';
      card.dataset.statusVal = columnaDe(card)?.dataset.status || '';
      e.dataTransfer.setData('text/plain', card.id);
      e.dataTransfer.effectAllowed = 'move';
      card.classList.add('opacity-50');
    });

    container.addEventListener('dragend', () => {
      arrastrada?.classList.remove('opacity-50');
      arrastrada = null;
      columnas().forEach((c) => c.querySelector('.column-content')?.classList.remove('bg-forge-secondary/10'));
    });

    container.addEventListener('dragover', (e: DragEvent) => {
      const col = columnaDe(e.target as Element);
      if (!col || !arrastrada || !mismoCarril(col)) return;
      e.preventDefault();
      const content = col.querySelector('.column-content');
      if (!content) return;
      content.classList.add('bg-forge-secondary/10');
      const despues = getDragAfterElement(content, e.clientY);
      // Por encima del «ver más», nunca debajo.
      const pie = content.querySelector(':scope > .ver-mas, :scope > p');
      if (despues) content.insertBefore(arrastrada, despues);
      else if (pie) content.insertBefore(arrastrada, pie);
      else content.appendChild(arrastrada);
    });

    container.addEventListener('dragleave', (e: DragEvent) => {
      columnaDe(e.target as Element)?.querySelector('.column-content')?.classList.remove('bg-forge-secondary/10');
    });

    container.addEventListener('drop', async (e: DragEvent) => {
      const col = columnaDe(e.target as Element);
      const card = arrastrada;
      if (!col || !card) return;
      e.preventDefault();
      if (!mismoCarril(col)) {
        window.showToast?.(texto('lane-only'), true);
        return;
      }
      const content = col.querySelector('.column-content');
      const newStatus = col.dataset.status;
      if (!content || !newStatus) return;
      content.classList.remove('bg-forge-secondary/10');
      updateCounts();

      const siblings = [...content.querySelectorAll<HTMLElement>('.issue-card')];
      const i = siblings.indexOf(card);
      const pos = (el?: HTMLElement) => parseFloat(el?.dataset.position || '0');
      let newPosition: number;
      if (siblings.length === 1) newPosition = 100000;
      else if (i === 0) newPosition = (pos(siblings[1]) || 100000) / 2;
      else if (i === siblings.length - 1) newPosition = pos(siblings[i - 1]) + 100000;
      else newPosition = (pos(siblings[i - 1]) + pos(siblings[i + 1])) / 2;
      card.dataset.position = String(newPosition);

      try {
        await mover(card.dataset.issueId!, newStatus, newPosition);
        // Cambiar de columna recarga: entrar o salir de Hecho para el
        // cronómetro y cambia los botones que pinta el servidor.
        if (card.dataset.statusVal !== newStatus) window.location.reload();
      } catch (error) {
        console.error('[SYS.NET] Update failed', error);
        window.showToast?.(window.forgeMsg?.errGenerico || '', true);
      }
    });
  }

  /**
   * «Próximos»: arrastrar una tarea a otro día le cambia la fecha.
   *
   * Sin ratón o en móvil, la fecha se cambia en el panel de la tarea, que es
   * un campo normal.
   */
  if (canEdit && container?.dataset.vista === 'proximos') {
    const diaDe = (el: EventTarget | null) => (el as HTMLElement | null)?.closest?.<HTMLElement>('.dia-proximos') ?? null;
    container.addEventListener('dragover', (e: DragEvent) => {
      const dia = diaDe(e.target);
      if (!dia || !arrastrada) return;
      e.preventDefault();
      dia.classList.add('bg-forge-secondary/10');
    });
    container.addEventListener('dragleave', (e: DragEvent) => diaDe(e.target)?.classList.remove('bg-forge-secondary/10'));
    container.addEventListener('drop', async (e: DragEvent) => {
      const dia = diaDe(e.target);
      const card = arrastrada;
      if (!dia || !card) return;
      e.preventDefault();
      dia.classList.remove('bg-forge-secondary/10');
      if ((card.dataset.plannedDate || card.dataset.dueDate) === dia.dataset.fecha) return;
      try {
        // Arrastrar cambia el día en que se **hace**, nunca la entrega.
        const res = await fetch(`/api/issues/${card.dataset.issueId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ planned_date: dia.dataset.fecha }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        window.location.reload();
      } catch (err) {
        console.error('cambiar de día:', err);
        window.showToast?.(texto('move-day-error'), true);
      }
    });
  }

  // ?issue=<id> abre esa tarea al cargar (enlaces desde «Mis tareas»).
  (() => {
    const issueId = new URLSearchParams(window.location.search).get('issue');
    if (!issueId) return;
    const card = document.querySelector<HTMLElement>(`.issue-card[data-issue-id="${CSS.escape(issueId)}"]`);
    if (!card) return;
    abrirTarea(card);
    const newUrl = new URL(window.location.href);
    newUrl.searchParams.delete('issue');
    window.history.replaceState({}, '', newUrl.toString());
  })();

  // ── Cronómetro ─────────────────────────────────────────────────────────────
  const updateTimers = () => {
    document.querySelectorAll<HTMLElement>('.active-timer-display').forEach((display) => {
      const startStr = display.dataset.startTime;
      if (!startStr) return;
      const started = new Date(startStr.endsWith('Z') ? startStr : `${startStr.replace(' ', 'T')}Z`).getTime();
      const sessionElapsed = Math.floor((Date.now() - started) / 1000);
      if (sessionElapsed < 0) return;
      const total = sessionElapsed + Math.floor(parseFloat(display.dataset.loggedHours || '0') * 3600);
      const h = Math.floor(total / 3600), m = Math.floor((total % 3600) / 60), s = total % 60;
      const textEl = display.querySelector('.timer-text');
      if (textEl) textEl.textContent = [h, m, s].map((n) => String(n).padStart(2, '0')).join(':');
    });
  };
  if (document.querySelector('.active-timer-display')) {
    setInterval(updateTimers, 1000);
    updateTimers();
  }

  container?.addEventListener('click', async (e) => {
    const start = (e.target as HTMLElement).closest<HTMLButtonElement>('.btn-start-timer');
    const stop = (e.target as HTMLElement).closest<HTMLButtonElement>('.btn-stop-timer');
    const btn = start || stop;
    if (!btn) return;
    const issueId = btn.dataset.issueId;
    if (!issueId) return;
    const original = btn.innerHTML;
    btn.textContent = start ? texto('timer-starting') : texto('timer-stopping');
    try {
      const response = await fetch(`/api/issues/${issueId}/timer`, { method: start ? 'POST' : 'DELETE' });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.success) throw new Error(data.message || `HTTP ${response.status}`);
      if (start && data.stopped_previous) {
        window.showToast?.(texto('timer-autostopped')
          .replace('{id}', data.stopped_details.issueId.substring(0, 8).toUpperCase())
          .replace('{h}', String(data.stopped_details.hours)), false);
      }
      // Arrancar el cronómetro pasa la tarea a «En progreso».
      if (start && columnaDe(btn)?.dataset.status !== 'in_progress') {
        await mover(issueId, 'in_progress', 0);
      }
      window.location.reload();
    } catch (err) {
      console.error('cronómetro:', err);
      btn.innerHTML = original;
      window.showToast?.(window.forgeMsg?.errGenerico || '', true);
    }
  });
</script>
