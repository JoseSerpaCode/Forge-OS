---
import BoardColumn from './BoardColumn.astro';
import IssueCard from './IssueCard.astro';
import IssueDetailsModal from './IssueDetailsModal.astro';
import LabelChip from '../labels/LabelChip.astro';
import Vacio from '../ui/Vacio.astro';
import Figura from '../brand/Figura.astro';
import { claveConteo, cursorDe } from '../../lib/tablero';
import type { Funciones } from '../../lib/funcionesEspacio';
import { sumarDiasIso } from '../../lib/fechas';
import type { Grupo } from '../../lib/tablero';
import { ESTADOS, info as infoEstado } from '../../lib/status';

interface Props {
  issues: any[];
  workspaceId: string;
  sprints?: any[];
  currentSprintId?: string | null;
  workspaceMembers?: any[];
  /** Contactos sin cuenta de quien mira, para el desplegable de responsable. */
  contactos?: Array<{ id: string; name: string }>;
  userRole?: string;
  /** Total real por columna (o por `carril|columna`), para avisar de lo que no se pinta. */
  statusCounts?: Record<string, number>;
  /** Puntos por columna, con las mismas claves. Solo se pintan con puntos encendidos. */
  statusPoints?: Record<string, number>;
  /** Catálogo de etiquetas del espacio, para el selector del modal y los carriles. */
  labels?: Array<{ id: string; name: string; color: string }>;
  /** Tipos de ticket del espacio. Ya no son tres fijos. */
  issueTypes?: Array<{ id: string; key: string; name: string; color: string; isBuiltin: boolean }>;
  sysTag?: string;
  funciones?: Funciones;
  /** Un carril por etiqueta. */
  agrupar?: boolean;
  /** La etiqueta por la que se filtra, para que «ver más» respete el filtro. */
  filtroEtiqueta?: string | null;
  /** Prioridad, vencimiento y responsable, como parámetros de URL: «ver más» los respeta. */
  filtrosUrl?: string;
  /** Tablero de columnas, o las vistas por fecha. */
  vista?: 'tablero' | 'hoy' | 'proximos';
  grupos?: Grupo[];
  /** `AAAA-MM-DD` en la zona de quien mira. */
  hoy?: string;
  dias?: number;
}

import { useTranslations } from '../../i18n/ui';
const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);

const {
  issues, workspaceId, sprints = [], currentSprintId = null, workspaceMembers = [], contactos = [], userRole = 'viewer',
  statusCounts = {}, statusPoints = {}, labels = [], issueTypes = [], sysTag = '',
  funciones = { sprints: false, tiempo: false, puntos: false, automatizaciones: false, auditoria: false }, agrupar = false, filtroEtiqueta = null,
  vista = 'tablero', grupos = [], hoy = '', dias = 14, filtrosUrl = '',
} = Astro.props;

/**
 * «Próximos» pinta **todos** los días del intervalo, también los vacíos: un
 * día sin tareas tiene que estar ahí para poder soltarle una encima.
 */
const diasProximos = vista === 'proximos'
  ? Array.from({ length: dias }, (_, i) => {
      const fecha = sumarDiasIso(hoy, i);
      return { clave: fecha, fecha, tarjetas: grupos.find((g) => g.clave === fecha)?.tarjetas ?? [] };
    })
  : [];
// Mayúscula solo en la primera letra: «Lunes, 19 oct». La clase `capitalize`
// la ponía en cada palabra y salía «19 Oct», que en español no se escribe.
const nombreDia = (iso: string) => {
  const texto = new Date(`${iso}T12:00:00Z`).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', { weekday: 'long', day: 'numeric', month: 'short', timeZone: 'UTC' });
  return texto.charAt(0).toLocaleUpperCase(lang) + texto.slice(1);
};
const masDias = (() => {
  const u = new URL(Astro.url);
  u.searchParams.set('dias', String(dias + 14));
  return `${u.pathname}${u.search}`;
})();

// Por clave, para no recorrer la lista una vez por tarjeta.
const tiposPorClave = new Map(issueTypes.map((t) => [t.key, t]));
const sprintsAbiertos = sprints.filter((s: any) => s.status !== 'completed').map((s: any) => s.id as string);
const canEdit = userRole === 'owner' || userRole === 'editor';

const columns = [
  { id: 'todo', title: t('status.todo'), corto: t('status.short.todo') },
  { id: 'in_progress', title: t('status.in_progress'), corto: t('status.short.in_progress') },
  { id: 'review', title: t('status.review'), corto: t('status.short.review') },
  { id: 'done', title: t('status.done'), corto: t('status.short.done') }
];

/**
 * El estado que se ve al abrir el tablero en un teléfono.
 *
 * `todo` y no «el primero que tenga algo»: el tablero tiene que abrirse
 * siempre en el mismo sitio, o el conmutador salta solo entre visitas y deja
 * de servir como punto de referencia. La excepción es `?estado=`, que el propio
 * conmutador escribe en la dirección: recargar (o volver de una tarea) deja la
 * pestaña donde estaba.
 */
const estadoPedido = Astro.url.searchParams.get('estado') ?? '';
const ESTADO_INICIAL = (ESTADOS as readonly string[]).includes(estadoPedido) ? estadoPedido : 'todo';

/**
 * Los carriles.
 *
 * Sin agrupar hay uno solo, sin cabecera (`null`). Agrupado, uno por etiqueta
 * con tareas —en el orden del catálogo— y «Sin etiqueta» al final. Un carril
 * vacío no se pinta: con una etiqueta por asignatura, las de asignaturas ya
 * terminadas llenarían la pantalla de cajas vacías.
 */
const conteoCarril = (carril: string) =>
  columns.reduce((n, c) => n + (statusCounts[claveConteo(c.id, carril)] ?? 0), 0);
const carriles: Array<{ id: string | null; nombre?: string; color?: string; total?: number }> = agrupar
  ? [
      ...labels.filter((l) => conteoCarril(l.id) > 0).map((l) => ({ id: l.id, nombre: l.name, color: l.color, total: conteoCarril(l.id) })),
      ...(conteoCarril('') > 0 ? [{ id: '', nombre: t('board.no_label'), total: conteoCarril('') }] : []),
    ]
  : [{ id: null }];

const enCarril = (carril: string | null, estado: string) =>
  issues.filter((i) => i.status === estado && (carril === null || (i.carril ?? '') === carril));
const totalDe = (carril: string | null, estado: string) =>
  statusCounts[claveConteo(estado, carril)] ?? enCarril(carril, estado).length;

// El conmutador de móvil cuenta por estado. Agrupado, una tarea con dos
// etiquetas se cuenta dos veces: es lo que se ve en pantalla.
const totalEstado = (estado: string) => carriles.reduce((n, c) => n + totalDe(c.id, estado), 0);
---
<div class="h-full flex flex-col relative">
  {/*
    El conmutador de estado.

    En escritorio las cuatro columnas se ven de un vistazo y el encabezado de
    cada una lleva su cuenta. En un teléfono no cabe ninguna de las dos cosas,
    así que la información se traslada aquí: qué estados hay, cuál se está
    mirando y cuánto hay en cada uno, en una fila.

    Las pestañas son también donde se suelta una tarjeta que se arrastra con el
    dedo: siempre están a la vista, encima de la columna que se desplaza.
  */}
  {vista === 'tablero' && (
  <div class="pestanas-fijas sm:hidden shrink-0">
  <div class="pestanas-estado segmentado grid grid-cols-4 w-full" role="tablist" aria-label={t('board.status_filter')}>
    {columns.map((col) => (
      <button
        type="button"
        role="tab"
        class="filtro-estado !px-1 gap-1 min-w-0 text-xs"
        style={`--c:${infoEstado(col.id).color}`}
        data-estado={col.id}
        data-titulo={col.title}
        aria-selected={col.id === ESTADO_INICIAL ? 'true' : 'false'}
      >
        <span class="truncate">{col.corto}</span>
        <span class="wide shrink-0">{totalEstado(col.id)}</span>
      </button>
    ))}
  </div>
  </div>
  )}

  {/*
    Tablero vacío: un bloque encima de las columnas, no un aviso flotando
    sobre ellas (se pisaba con el «Nada por aquí» de cada columna, que en este
    caso tampoco se pinta: ver `data-vacio`).
  */}
  {vista === 'tablero' && issues.length === 0 && (
    <Vacio class="tablero-vacio shrink-0 mb-4" etiqueta={t('nav.board')} titulo={t('about.kanban.empty_title')} texto={t('about.kanban.empty_desc')}>
      <Fragment slot="escena">
        <div class="vacio-arco" style="--c: var(--forge-st-todo)">
          {t('status.todo')} · 0
          <Figura pose="pino" color="lila" alto={104} style="position: absolute; bottom: calc(100% - 4px); left: 50%; margin-left: -40px" />
        </div>
      </Fragment>
      {canEdit && (
        <>
          <button type="button" class="btn btn-primary" onclick="document.getElementById('btn-new-issue')?.click()">{t('board.new_issue')}</button>
          {/* El atajo solo donde hay teclado; en el teléfono basta el botón. */}
          <p class="hidden sm:block text-sm text-forge-muted">{t('about.kanban.empty_cta_1')} <kbd class="kbd mx-1">C</kbd> {t('about.kanban.empty_cta_2')}</p>
        </>
      )}
    </Vacio>
  )}

  <div
    class:list={['kanban-container h-full pb-4', agrupar || vista !== 'tablero' ? 'flex flex-col gap-4 overflow-y-auto' : 'overflow-auto']}
    data-vista={vista}
    data-vacio={vista === 'tablero' && issues.length === 0 ? 'true' : undefined}
    data-t-moved-day={t('view.moved_day')}
    data-t-move-day-error={t('view.move_error')}
    data-workspace={workspaceId}
    data-sys-tag={sysTag}
    data-can-edit={canEdit.toString()}
    data-tiempo={funciones.tiempo ? 'true' : 'false'}
    data-agrupar={agrupar ? 'true' : 'false'}
    data-label={filtroEtiqueta ?? ''}
    data-filtros={filtrosUrl}
    data-sprint={funciones.sprints ? (currentSprintId ?? 'backlog') : ''}
    data-t-timer-start={t('card.timer_start')}
    data-t-timer-starting={t('card.timer_starting')}
    data-t-timer-stopping={t('card.timer_stopping')}
    data-t-timer-autostopped={t('card.timer_autostopped')}
    data-t-completed={t('card.completed_toast')}
    data-t-completed-timer={t('card.completed_timer_toast')}
    data-t-complete-error={t('card.complete_error')}
    data-t-next-created={t('repeat.next_created')}
    data-t-undo={t('board.undo')}
    data-t-lane-only={t('board.lane_drop_only')}
    data-t-moved={t('card.moved_to')}
    data-t-see={t('quick.see')}
    data-t-move-sprint-error={t('card.move_sprint_error')}
  >
    {/* «Hoy»: vencidas y de hoy. «Próximos»: un bloque por día. Las tarjetas
        son las mismas del tablero, así que abrirlas y completarlas funciona
        igual. */}
    {vista === 'hoy' && (grupos.length === 0
      ? <p class="text-sm text-forge-muted py-10 text-center">{t('view.nothing_today')}</p>
      : grupos.map((g) => (
        <section class="vista-grupo" data-grupo={g.clave}>
          <h2 class:list={['section-title !text-xl mb-3 flex items-baseline gap-2.5', g.clave === 'vencidas' && '!text-forge-error']}>
            {g.clave === 'vencidas' ? t('view.overdue') : t('view.today')} <span class="wide text-sm text-forge-muted">{g.tarjetas.length}</span>
          </h2>
          <div class="grid gap-2.5 sm:grid-cols-2 xl:grid-cols-3">
            {g.tarjetas.map((issue) => <IssueCard issue={issue} canEdit={canEdit} tipo={tiposPorClave.get(issue.type) ?? null} funciones={funciones} sprintsAbiertos={sprintsAbiertos} />)}
          </div>
        </section>
      )))}
    {vista === 'proximos' && (
      <>
        {diasProximos.map((d) => (
          /* Un día vacío ocupa una línea: con catorce días por delante, los
             huecos no pueden pesar lo mismo que los días con trabajo. Sigue
             siendo zona donde soltar una tarjeta. */
          <section class:list={['dia-proximos border-t border-forge-border first:border-t-0', d.tarjetas.length ? 'pt-3 pb-2' : 'py-2']} data-fecha={d.fecha}>
            <h2 class:list={['flex items-baseline gap-2.5', d.tarjetas.length > 0 && 'mb-2.5']}>
              <span class:list={['text-lg font-extrabold narrow', d.fecha === hoy ? 'text-forge-accent-text' : 'text-forge-text']}>{nombreDia(d.fecha)}</span>
              {d.tarjetas.length > 0
                ? <span class="wide text-sm text-forge-muted">{d.tarjetas.length}</span>
                : <span class="text-sm font-normal text-forge-muted">{t('view.empty_day')}</span>}
            </h2>
            {d.tarjetas.length > 0 &&
              <div class="grid gap-2.5 sm:grid-cols-2 xl:grid-cols-3">
                  {d.tarjetas.map((issue) => <IssueCard issue={issue} canEdit={canEdit} tipo={tiposPorClave.get(issue.type) ?? null} funciones={funciones} sprintsAbiertos={sprintsAbiertos} />)}
                </div>}
          </section>
        ))}
        <a href={masDias} class="btn btn-secondary self-center">{t('view.more_days')}</a>
      </>
    )}

    {vista === 'tablero' && carriles.map((carril) => {
      const columnas = (
        <div class:list={['columnas-tablero flex sm:grid gap-3.5 items-start', agrupar ? 'overflow-x-auto pb-1 carril-columnas' : 'w-full']}>
          {columns.map((col) => {
            const tarjetas = enCarril(carril.id, col.id);
            const total = totalDe(carril.id, col.id);
            const ultima = tarjetas[tarjetas.length - 1];
            return (
              <BoardColumn
                title={col.title}
                status={col.id}
                total={total}
                shown={tarjetas.length}
                carril={carril.id}
                activaEnMovil={col.id === ESTADO_INICIAL}
                verMas={col.id === 'done' && total > tarjetas.length && ultima ? { cursor: cursorDe(ultima) } : null}
                puntos={funciones.puntos ? (statusPoints[claveConteo(col.id, carril.id)] ?? 0) : undefined}
                puntosMostrados={funciones.puntos ? tarjetas.reduce((n, i) => n + (Number(i.story_points) || 0), 0) : undefined}
              >
                {tarjetas.map((issue) => (
                  <IssueCard issue={issue} canEdit={canEdit} tipo={tiposPorClave.get(issue.type) ?? null} funciones={funciones} carril={carril.id} sprintsAbiertos={sprintsAbiertos} />
                ))}
              </BoardColumn>
            );
          })}
        </div>
      );
      return carril.id === null ? columnas : (
        /* `<details>` y no un acordeón hecho a mano: se pliega con teclado y
           lector de pantalla sin escribir nada, y abierto por defecto. */
        <details open class="carril shrink-0 border-t border-forge-border first:border-t-0 pt-3" data-carril={carril.id}>
          <summary class="flex items-center gap-2.5 cursor-pointer select-none mb-3">
            <span class="section-title !text-xl" style={carril.color ? `--c:${carril.color}` : undefined}>
              {carril.color && <span class="sw inline-block mr-2 align-middle" aria-hidden="true"></span>}{carril.nombre}
            </span>
            <span class="wide text-sm text-forge-muted">{carril.total}</span>
          </summary>
          {columnas}
        </details>
      );
    })}
  </div>
</div>

{/* Un solo menú de «mover a sprint» para todas las tarjetas: pintar uno por
    tarjeta serían cien menús iguales en el HTML. */}
{funciones.sprints && canEdit && (
  <div id="menu-sprint-tarjeta" role="menu" aria-label={t('card.move_sprint')}
    class="hidden menu fixed z-[60] min-w-[12rem]">
    {[{ name: t('board.backlog'), id: 'backlog' }, ...sprints.filter((s: any) => s.status !== 'completed')].map((s: any) => (
      <button type="button" role="menuitem" class="sprint-destino menu-item" data-sprint={s.id} data-nombre={s.name}>{s.name}</button>
    ))}
  </div>
)}

{/* Mover una tarea en el teléfono: estados grandes para el pulgar y, si el
    espacio usa sprints, a qué sprint. Una sola hoja para todas las tarjetas. */}
{vista === 'tablero' && canEdit && (
  <dialog id="hoja-mover" class="hoja" aria-labelledby="hoja-mover-titulo"
    data-t-moved={t('card.moved_to')} data-t-undo={t('board.undo')}>
    <div class="hoja-asa" aria-hidden="true"></div>
    <h2 id="hoja-mover-titulo" class="text-base font-bold text-forge-text mb-4 line-clamp-2"></h2>
    <p class="field-label mb-2">{t('board.move_status')}</p>
    <div class="grid grid-cols-2 gap-2">
      {columns.map((col) => (
        <button type="button" class="estado-destino btn btn-secondary !justify-start !h-12" data-estado={col.id} data-titulo={col.title} style={`--c:${infoEstado(col.id).color}`}>
          <span class="sw" aria-hidden="true"></span>{col.title}
        </button>
      ))}
    </div>
    {funciones.sprints && (
      <div class="hoja-sprints">
        <p class="field-label mt-5 mb-2">{t('modal.sprint')}</p>
        <div class="flex flex-col gap-1">
          {[{ name: t('board.backlog'), id: 'backlog' }, ...sprints.filter((s: any) => s.status !== 'completed')].map((s: any) => (
            <button type="button" class="sprint-destino-hoja btn btn-ghost !justify-start !h-11" data-sprint={s.id} data-nombre={s.name}>{s.name}</button>
          ))}
        </div>
      </div>
    )}
    <p class="hint mt-5">{t('board.move_hint')}</p>
  </dialog>
)}

{/* Varias tarjetas a la vez: la barra sale al pulsar «Seleccionar» en la
    barra del tablero. Cada acción usa los mismos endpoints que una tarjeta
    suelta —mover, etiquetar, borrar—, así que repeticiones, cronómetros,
    automatizaciones y permisos se aplican igual. */}
{canEdit && vista === 'tablero' && (
  <div id="barra-seleccion" class="barra-seleccion hidden" role="region" aria-label={t('sel.region')}
    data-t-count={t('sel.count')} data-t-count-one={t('sel.count_one')} data-t-none={t('sel.none')}
    data-t-working={t('sel.working')} data-t-confirm={t('sel.confirm_delete')} data-t-confirm-one={t('sel.confirm_delete_one')}
    data-t-moved={t('sel.done_moved')} data-t-deleted={t('sel.done_deleted')} data-t-labeled={t('sel.done_labeled')}
    data-t-failed={t('sel.failed')} data-t-delete={t('sel.delete')}>
    <span id="sel-cuenta" class="text-sm font-semibold" aria-live="polite"></span>
    {/* En el teléfono los menús cuelgan de la barra, no del botón: anclados al
        botón, el de la izquierda se salía de la pantalla. */}
    <div class="flex items-center gap-1.5 flex-wrap justify-end">
      <div class="relative max-md:static">
        <button type="button" id="sel-mover" class="sel-accion btn btn-secondary btn-sm" aria-haspopup="menu" aria-expanded="false" aria-controls="sel-menu-mover">
          {t('sel.move')}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
        </button>
        <div id="sel-menu-mover" role="menu" class="sel-menu menu hidden absolute bottom-full right-0 max-md:left-0 mb-2 min-w-[13rem] max-h-[55vh] overflow-y-auto">
          <p class="px-3 pt-1.5 pb-1 text-xs font-semibold text-forge-muted">{t('board.move_status')}</p>
          {columns.map((col) => (
            <button type="button" role="menuitem" class="sel-estado menu-item" data-estado={col.id} data-titulo={col.title} style={`--c:${infoEstado(col.id).color}`}>
              <span class="sw" aria-hidden="true"></span>{col.title}
            </button>
          ))}
          {funciones.sprints && (
            <>
              <div class="menu-sep"></div>
              <p class="px-3 pt-1.5 pb-1 text-xs font-semibold text-forge-muted">{t('modal.sprint')}</p>
              {[{ name: t('board.backlog'), id: 'backlog' }, ...sprints.filter((s: any) => s.status !== 'completed')].map((s: any) => (
                <button type="button" role="menuitem" class="sel-sprint menu-item" data-sprint={s.id} data-nombre={s.name}>{s.name}</button>
              ))}
            </>
          )}
        </div>
      </div>
      {labels.length > 0 && (
        <div class="relative max-md:static">
          <button type="button" id="sel-etiqueta" class="sel-accion btn btn-secondary btn-sm" aria-haspopup="menu" aria-expanded="false" aria-controls="sel-menu-etiqueta">
            {t('sel.label')}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
          </button>
          <div id="sel-menu-etiqueta" role="menu" class="sel-menu menu hidden absolute bottom-full right-0 max-md:left-0 mb-2 min-w-[13rem] max-h-[55vh] overflow-y-auto">
            {labels.map((l) => (
              <button type="button" role="menuitem" class="sel-etiqueta menu-item" data-id={l.id} data-nombre={l.name} style={`--c:${l.color}`}>
                <span class="sw" aria-hidden="true"></span><span class="truncate">{l.name}</span>
              </button>
            ))}
          </div>
        </div>
      )}
      <button type="button" id="sel-borrar" class="sel-accion btn btn-secondary btn-sm !text-forge-error">{t('sel.delete')}</button>
      <button type="button" id="sel-listo" class="btn btn-primary btn-sm">{t('sel.done')}</button>
    </div>
  </div>
)}

<IssueDetailsModal sprints={sprints} currentSprintId={currentSprintId} workspaceMembers={workspaceMembers} contactos={contactos} labels={labels} issueTypes={issueTypes} sysTag={sysTag} canManageTypes={userRole === 'owner'} funciones={funciones} />

<script>
  /**
   * El tablero, con los eventos **delegados** en el contenedor.
   *
   * Antes cada tarjeta recibía sus oyentes al cargar (`cards.forEach`). Las
   * que llegan después —«ver más» en Hecho— no los tenían: se veían, pero no
   * se abrían al pulsarlas ni se podían arrastrar. Con un oyente en el
   * contenedor, cualquier tarjeta que esté dentro funciona, llegue cuando llegue.
   */
  const container = document.querySelector<HTMLElement>('.kanban-container');
  const canEdit = container?.dataset.canEdit === 'true';
  const workspaceId = container?.dataset.workspace;
  const sysTag = container?.dataset.sysTag || window.location.pathname.split('/')[2];
  const texto = (clave: string) => container?.getAttribute(`data-t-${clave}`) || '';

  const tarjetaDe = (el: EventTarget | null) => (el as HTMLElement | null)?.closest?.<HTMLElement>('.issue-card') ?? null;
  const columnaDe = (el: Element | null) => el?.closest<HTMLElement>('.board-column') ?? null;
  const columnas = () => Array.from(document.querySelectorAll<HTMLElement>('.board-column'));

  /**
   * El conmutador de estado, en móvil.
   *
   * Enseña una columna —en todos los carriles— y esconde las otras con
   * `max-sm:hidden`, la misma clase con la que el servidor pinta el estado
   * inicial: lo que hace el JavaScript es exactamente lo que ya venía en el HTML.
   */
  const filtros = Array.from(document.querySelectorAll<HTMLButtonElement>('.filtro-estado'));
  const pestanas = document.querySelector<HTMLElement>('.pestanas-estado');
  const estadoVisible = () => filtros.find((f) => f.getAttribute('aria-selected') === 'true')?.dataset.estado || 'todo';
  function mostrarEstado(estado: string) {
    filtros.forEach((otro) => otro.setAttribute('aria-selected', String(otro.dataset.estado === estado)));
    columnas().forEach((columna) => columna.classList.toggle('max-sm:hidden', columna.dataset.status !== estado));
    // Si se había bajado por la columna anterior, la nueva empieza justo bajo
    // las pestañas fijas y no a media altura.
    const visible = columnas().find((c) => c.dataset.status === estado && c.getClientRects().length);
    const fijas = pestanas?.parentElement;
    const main = document.querySelector('main');
    if (visible && fijas && main) {
      const sobra = visible.getBoundingClientRect().top - fijas.getBoundingClientRect().bottom;
      if (sobra < 0) main.scrollTop += sobra;
    }
    // La pestaña viaja en la dirección: recargar, o volver de otra página, la
    // deja donde estaba (el servidor la lee de `?estado=`).
    const url = new URL(window.location.href);
    if (estado === 'todo') url.searchParams.delete('estado');
    else url.searchParams.set('estado', estado);
    window.history.replaceState(window.history.state, '', url);
  }
  filtros.forEach((boton) => {
    boton.addEventListener('click', () => {
      if (boton.dataset.estado) mostrarEstado(boton.dataset.estado);
    });
  });

  /**
   * Los contadores de columna.
   *
   * El tablero no pinta todas las tarjetas, así que recontar el DOM escribiría
   * «10» sobre una columna de 214. Se parte del total del servidor y se le suma
   * la diferencia entre lo que hay ahora y lo que había al cargar.
   */
  const puntosDe = (col: Element) => Array.from(col.querySelectorAll<HTMLElement>('.issue-card'))
    .reduce((n, c) => n + (Number(c.dataset.points) || 0), 0);
  const updateCounts = () => {
    columnas().forEach((col) => {
      const shownNow = col.querySelectorAll('.issue-card').length;
      const total = Number(col.dataset.total ?? shownNow);
      const shownAtLoad = Number(col.dataset.shown ?? shownNow);
      const badge = col.querySelector('.issue-count');
      if (badge) badge.textContent = String(total - shownAtLoad + shownNow);
      // Los puntos, con la misma cuenta: el total del servidor más lo que ha
      // cambiado entre las tarjetas pintadas.
      const pts = col.querySelector<HTMLElement>('.columna-pts');
      if (pts && col.dataset.puntos !== undefined) {
        col.dataset.puntosAhora = String(Number(col.dataset.puntos) - Number(col.dataset.puntosShown || 0) + puntosDe(col));
        pts.textContent = (pts.dataset.plantilla || '').replace('{n}', col.dataset.puntosAhora);
      }
    });
    // La cabecera («12 de 30 pts hechos»), salvo con carriles: ahí una tarea
    // con dos etiquetas está dos veces y la suma no valdría.
    const cabecera = document.getElementById('puntos-vista');
    if (cabecera && container?.dataset.agrupar !== 'true') {
      const suma = (estado?: string) => columnas()
        .filter((c) => !estado || c.dataset.status === estado)
        .reduce((n, c) => n + Number(c.dataset.puntosAhora || 0), 0);
      cabecera.textContent = (cabecera.dataset.plantilla || '').replace('{hechos}', String(suma('done'))).replace('{total}', String(suma()));
    }
    // Las pestañas del teléfono suman su estado en todos los carriles.
    filtros.forEach((f) => {
      const n = columnas()
        .filter((c) => c.dataset.status === f.dataset.estado)
        .reduce((suma, c) => suma + Number(c.querySelector('.issue-count')?.textContent || 0), 0);
      const cifra = f.querySelector('.wide');
      if (cifra) cifra.textContent = String(n);
    });
  };
  updateCounts();

  async function mover(issueId: string, status: string, position: number) {
    const res = await fetch(`/api/issues/${issueId}/move`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status, position, workspaceId }),
    });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    return res.json().catch(() => ({})) as Promise<{ recurrencia?: { creada?: { id: string; due_date: string } } }>;
  }

  /** El sitio donde poner una tarjeta en una columna: antes del pie, nunca debajo. */
  const pieDe = (contenido: Element) => contenido.querySelector(':scope > .ver-mas, :scope > p:not(.empty-state)');

  /**
   * La posición de una tarjeta según sus vecinas, después de colocarla.
   * Mitad entre las de al lado; arriba, la mitad de la primera; abajo, cien
   * mil más que la última.
   */
  function posicionEntre(contenido: Element, card: HTMLElement) {
    const hermanas = [...contenido.querySelectorAll<HTMLElement>('.issue-card')];
    const i = hermanas.indexOf(card);
    const pos = (el?: HTMLElement) => parseFloat(el?.dataset.position || '0');
    if (hermanas.length === 1) return 100000;
    if (i === 0) return (pos(hermanas[1]) || 100000) / 2;
    if (i === hermanas.length - 1) return pos(hermanas[i - 1]) + 100000;
    return (pos(hermanas[i - 1]) + pos(hermanas[i + 1])) / 2;
  }

  /**
   * Mover una tarea a otro estado sin arrastrarla por el tablero: desde la hoja
   * de mover o soltándola en una pestaña, en el teléfono.
   *
   * Va arriba de la columna destino: es lo que se acaba de mover y lo primero
   * que se ve al ir a mirarla. No recarga —la columna que se mira se queda
   * igual—, salvo cuando el servidor tiene que repintar la tarjeta: al salir
   * de Hecho vuelve el círculo de completar, y un cronómetro en marcha puede
   * pararse. A Hecho va por `completar()`, que ya sabe de repeticiones.
   */
  async function moverA(card: HTMLElement, estado: string) {
    const issueId = card.dataset.issueId!;
    const origen = columnaDe(card);
    const estadoAntes = origen?.dataset.status || card.dataset.status || 'todo';
    if (estado === estadoAntes) return;
    if (estado === 'done') { await completar(card); return; }

    const posicionAntes = Number(card.dataset.position || 0);
    const destinoDe = (copia: HTMLElement) =>
      columnas().find((c) => c.dataset.status === estado && c.dataset.carril === columnaDe(copia)?.dataset.carril);
    const primera = destinoDe(card)?.querySelector<HTMLElement>('.column-content .issue-card');
    const posicion = primera ? (Number(primera.dataset.position) || 100000) / 2 : 100000;

    try {
      await mover(issueId, estado, posicion);
    } catch (err) {
      console.error('mover:', err);
      window.showToast?.(window.forgeMsg?.errGenerico || '', true);
      return;
    }
    if (estadoAntes === 'done' || card.querySelector('.active-timer-display')) {
      window.location.reload();
      return;
    }

    document.querySelectorAll<HTMLElement>(`.issue-card[data-issue-id="${CSS.escape(issueId)}"]`).forEach((copia) => {
      const contenido = destinoDe(copia)?.querySelector('.column-content');
      if (!contenido) { copia.remove(); return; }
      copia.dataset.status = estado;
      copia.dataset.position = String(posicion);
      const arriba = contenido.querySelector('.issue-card') ?? pieDe(contenido);
      if (arriba) contenido.insertBefore(copia, arriba);
      else contenido.appendChild(copia);
    });
    updateCounts();

    const nombre = filtros.find((f) => f.dataset.estado === estado)?.dataset.titulo || estado;
    window.showToast?.(texto('moved').replace('{destino}', nombre), false, {
      accion: texto('undo'),
      alPulsar: async () => {
        try {
          await mover(issueId, estadoAntes, posicionAntes);
          window.location.reload();
        } catch (err) {
          console.error('deshacer mover:', err);
          window.showToast?.(window.forgeMsg?.errGenerico || '', true);
        }
      },
    });
  }

  /**
   * Completar con un clic.
   *
   * La tarjeta salta arriba de Hecho sin recargar —completar tiene que sentirse
   * instantáneo— y el aviso ofrece deshacer, que la devuelve a su columna y su
   * posición. Si tenía el cronómetro en marcha, completar lo para y registra las
   * horas (lo hace `move`); deshacer **no** las borra, porque es trabajo hecho,
   * y el aviso lo dice.
   */
  async function completar(card: HTMLElement) {
    const issueId = card.dataset.issueId!;
    const estadoAntes = columnaDe(card)?.dataset.status || card.dataset.status || 'todo';
    const posicionAntes = Number(card.dataset.position || 0);
    const habiaCronometro = !!card.querySelector('.active-timer-display');

    let respuesta: Awaited<ReturnType<typeof mover>> = {};
    try {
      respuesta = await mover(issueId, 'done', posicionAntes);
    } catch (err) {
      console.error('completar:', err);
      window.showToast?.(texto('complete-error'), true);
      return;
    }

    // Todas las copias de la tarjeta: con carriles puede haber más de una.
    document.querySelectorAll<HTMLElement>(`.issue-card[data-issue-id="${CSS.escape(issueId)}"]`).forEach((copia) => {
      copia.dataset.status = 'done';
      copia.querySelector('.btn-completar')?.remove();
      copia.querySelector('.card-timer')?.remove();
      const carril = columnaDe(copia)?.dataset.carril;
      const hecho = columnas().find((c) => c.dataset.status === 'done' && c.dataset.carril === carril);
      const contenido = hecho?.querySelector('.column-content');
      if (contenido) {
        const primera = contenido.querySelector('.issue-card');
        if (primera) contenido.insertBefore(copia, primera);
        else contenido.appendChild(copia);
      } else {
        copia.remove();
      }
    });
    updateCounts();

    // Si se repite, el aviso dice cuándo queda la siguiente.
    const siguiente = respuesta.recurrencia?.creada?.due_date;
    const mensaje = siguiente
      ? texto('next-created').replace('{fecha}', new Date(`${siguiente}T12:00:00Z`).toLocaleDateString(document.documentElement.lang === 'es' ? 'es-ES' : 'en-US', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' }))
      : habiaCronometro ? texto('completed-timer') : texto('completed');
    window.showToast?.(mensaje, false, {
      accion: texto('undo'),
      alPulsar: async () => {
        try {
          await mover(issueId, estadoAntes, posicionAntes);
          window.location.reload();
        } catch (err) {
          console.error('deshacer completar:', err);
          window.showToast?.(texto('complete-error'), true);
        }
      },
    });
  }

  /**
   * «Ver más» en Hecho: las siguientes, desde un parcial que pinta las mismas
   * tarjetas que el servidor. Con los eventos delegados, funcionan sin más.
   */
  async function verMas(boton: HTMLButtonElement) {
    const columna = columnaDe(boton);
    if (!columna) return;
    const params = new URLSearchParams(container?.dataset.filtros || '');
    params.set('despues', boton.dataset.cursor || '');
    if (container?.dataset.label) params.set('label', container.dataset.label);
    if (container?.dataset.sprint) params.set('sprint', container.dataset.sprint);
    if (container?.dataset.agrupar === 'true') {
      params.set('group', 'label');
      params.set('carril', columna.dataset.carril ?? '');
    }
    const textoAntes = boton.textContent;
    boton.disabled = true;
    boton.textContent = boton.dataset.tCargando || '';
    try {
      const res = await fetch(`/w/${sysTag}/board/hechas?${params}`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const plantilla = document.createElement('template');
      plantilla.innerHTML = await res.text();
      const meta = plantilla.content.querySelector<HTMLElement>('[data-hechas-meta]');
      const nuevas = Array.from(plantilla.content.querySelectorAll<HTMLElement>('.issue-card'));
      nuevas.forEach((nueva) => boton.before(nueva));
      // Las que llegan cuentan como pintadas: el contador sigue diciendo el total.
      columna.dataset.shown = String(Number(columna.dataset.shown || 0) + nuevas.length);
      if (columna.dataset.puntosShown !== undefined) {
        columna.dataset.puntosShown = String(Number(columna.dataset.puntosShown) + nuevas.reduce((n, c) => n + (Number(c.dataset.points) || 0), 0));
      }
      updateCounts();
      const total = Number(columna.dataset.total || 0);
      const pintadas = columna.querySelectorAll('.issue-card').length;
      if (meta?.dataset.hayMas === 'true' && meta.dataset.cursor) {
        boton.dataset.cursor = meta.dataset.cursor;
        boton.textContent = (boton.dataset.tPlantilla || '').replace('{n}', String(Math.max(0, total - pintadas)));
        boton.disabled = false;
      } else {
        boton.remove();
      }
    } catch (err) {
      console.error('ver más:', err);
      boton.textContent = textoAntes;
      boton.disabled = false;
      window.showToast?.(window.forgeMsg?.errGenerico || '', true);
    }
  }

  /** Abrir el panel de una tarea con lo que lleva su tarjeta. */
  function abrirTarea(card: HTMLElement) {
    const issueId = card.dataset.issueId!;
    const modal = document.getElementById('issue-details-modal');
    const titleEl = document.getElementById('modal-issue-title') as HTMLInputElement | null;
    const idEl = document.getElementById('modal-issue-id');
    const descEl = document.getElementById('modal-issue-desc') as HTMLTextAreaElement | null;
    if (!modal || !titleEl || !idEl || !descEl) {
      window.showToast?.(window.forgeMsg?.errGenerico || '', true);
      return;
    }

    idEl.textContent = issueId.substring(0, 8).toUpperCase();
    idEl.setAttribute('data-full-id', issueId);
    titleEl.value = card.querySelector('h4')?.textContent || '';
    descEl.value = card.dataset.description || '';

    const pointsEl = document.getElementById('modal-issue-points') as HTMLInputElement | null;
    if (pointsEl) pointsEl.value = card.dataset.points || '0';
    const sprintEl = document.getElementById('modal-issue-sprint') as HTMLSelectElement | null;
    if (sprintEl) sprintEl.value = card.dataset.sprintId || 'backlog';
    const prioridadEl = document.getElementById('modal-issue-priority') as HTMLSelectElement | null;
    if (prioridadEl) {
      // `lowest` no está entre las cuatro opciones: se enseña como baja.
      prioridadEl.value = card.dataset.priority === 'lowest' ? 'low' : (card.dataset.priority || 'medium');
      prioridadEl.dispatchEvent(new Event('prioridad-sincronizar'));
    }
    const horaEl = document.getElementById('modal-issue-due-time') as HTMLInputElement | null;
    if (horaEl) horaEl.value = card.dataset.dueTime || '';

    // Las etiquetas, los archivos y los apuntes los pinta el propio modal.
    const w = window as any;
    w.forgeLabelsOpen?.(issueId);
    w.forgeDriveFilesOpen?.(issueId);
    w.forgeApuntesOpen?.(issueId);
    w.forgeSubtareasOpen?.(issueId);

    // La clave viaja en un `data-*` de la insignia: sacarla de su texto fallaba
    // con la interfaz en español y con tipos propios.
    const clave = card.querySelector('.issue-type-badge')?.getAttribute('data-type-key');
    const typeEl = document.getElementById('modal-issue-type') as HTMLSelectElement | null;
    if (typeEl && clave) {
      // Un tipo borrado ya no está en la lista. Se añade como opción suelta
      // para no cambiárselo por accidente al guardar otra cosa.
      if (!Array.from(typeEl.options).some((o) => o.value === clave)) {
        const suelta = document.createElement('option');
        suelta.value = clave;
        suelta.textContent = clave;
        typeEl.appendChild(suelta);
      }
      typeEl.value = clave;
      typeEl.dispatchEvent(new Event('tipo-sincronizar'));
    }

    const assigneeSelect = document.getElementById('modal-issue-assignee') as HTMLSelectElement | null;
    const reporterSelect = document.getElementById('modal-issue-reporter') as HTMLSelectElement | null;
    // Persona o contacto: `data-responsable` lleva el valor del desplegable.
    if (assigneeSelect) assigneeSelect.value = card.dataset.responsable ?? card.dataset.assigneeId ?? '';
    if (reporterSelect) reporterSelect.value = card.dataset.reporterId || 'system';

    // La repetición, después de la fecha: «el mismo día» se lee de la entrega.
    const repEl = document.getElementById('modal-issue-repeat') as HTMLSelectElement | null;
    const fechaOculta = document.getElementById('modal-issue-due-date') as HTMLInputElement | null;
    if (fechaOculta) fechaOculta.value = card.dataset.dueDate || '';
    const trabajoOculto = document.getElementById('modal-issue-planned-date') as HTMLInputElement | null;
    if (trabajoOculto) trabajoOculto.value = card.dataset.plannedDate || '';
    if (repEl) {
      repEl.dataset.regla = card.dataset.recurrence || '';
      repEl.dispatchEvent(new Event('repeticion-sincronizar'));
    }
    const recEl = document.getElementById('modal-issue-remind') as HTMLSelectElement | null;
    if (recEl) {
      recEl.dataset.minutos = card.dataset.reminder || '';
      recEl.dispatchEvent(new Event('recordar-sincronizar'));
    }

    w.loadIssueAttachments?.(issueId);
    // `refreshTimeTrackingUI` además rellena la fecha de entrega: se llama
    // siempre. Los registros de horas, solo si el espacio mide el tiempo.
    if (container?.dataset.tiempo === 'true') w.loadWorkLogs?.(issueId);
    w.refreshTimeTrackingUI?.(issueId);

    modal.classList.remove('translate-x-full');
    document.getElementById('issue-details-backdrop')?.classList.remove('hidden');
  }

  container?.addEventListener('click', (e) => {
    const objetivo = e.target as HTMLElement;
    const boton = objetivo.closest<HTMLButtonElement>('.ver-mas');
    if (boton) { verMas(boton); return; }

    const card = tarjetaDe(objetivo);
    if (!card) return;
    if (objetivo.closest('.btn-completar')) { completar(card); return; }
    // Mover y los botones del cronómetro tienen su propio trabajo: pulsarlos
    // no abre la tarea.
    if (objetivo.closest('.btn-mover-sprint')) { abrirMenuSprint(card, objetivo.closest<HTMLElement>('.btn-mover-sprint')!); return; }
    if (objetivo.closest('.btn-mover-estado')) { abrirHojaMover(card); return; }
    if (objetivo.closest('.btn-start-timer, .btn-stop-timer')) return;
    try { abrirTarea(card); }
    catch (err) {
      console.error('abrir tarea:', err);
      window.showToast?.(window.forgeMsg?.errGenerico || '', true);
    }
  });

  // ── Mover a otro sprint ────────────────────────────────────────────────────
  const menuSprint = document.getElementById('menu-sprint-tarjeta');
  let tarjetaMenu: HTMLElement | null = null;
  let botonMenu: HTMLElement | null = null;
  const cerrarMenuSprint = (devolverFoco = false) => {
    menuSprint?.classList.add('hidden');
    botonMenu?.setAttribute('aria-expanded', 'false');
    if (devolverFoco) botonMenu?.focus();
    tarjetaMenu = null;
  };
  function abrirMenuSprint(card: HTMLElement, boton: HTMLElement) {
    if (!menuSprint) return;
    tarjetaMenu = card;
    botonMenu = boton;
    const actual = card.dataset.sprintId || 'backlog';
    menuSprint.querySelectorAll<HTMLElement>('.sprint-destino').forEach((b) => b.classList.toggle('hidden', b.dataset.sprint === actual));
    // Un menú sin opciones no se abre (el botón ya no sale en ese caso).
    if (!menuSprint.querySelector('.sprint-destino:not(.hidden)')) return;
    const caja = boton.getBoundingClientRect();
    menuSprint.classList.remove('hidden');
    const ancho = menuSprint.offsetWidth;
    menuSprint.style.top = `${Math.min(caja.bottom + 4, window.innerHeight - menuSprint.offsetHeight - 8)}px`;
    menuSprint.style.left = `${Math.max(8, Math.min(caja.right - ancho, window.innerWidth - ancho - 8))}px`;
    boton.setAttribute('aria-expanded', 'true');
    menuSprint.querySelector<HTMLElement>('.sprint-destino:not(.hidden)')?.focus();
  }
  menuSprint?.addEventListener('click', async (e) => {
    const destino = (e.target as HTMLElement).closest<HTMLElement>('.sprint-destino');
    const card = tarjetaMenu;
    if (!destino || !card) return;
    cerrarMenuSprint();
    await moverDeSprint(card, destino.dataset.sprint!, destino.dataset.nombre || '');
  });

  /** Mandar una tarea a otro sprint (o al backlog). Sale de la vista, con aviso y enlace. */
  async function moverDeSprint(card: HTMLElement, sprint: string, nombre: string) {
    const issueId = card.dataset.issueId!;
    try {
      const res = await fetch(`/api/issues/${issueId}/move`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          sprint_id: sprint === 'backlog' ? null : sprint,
          status: columnaDe(card)?.dataset.status || card.dataset.status || 'todo',
          position: Number(card.dataset.position || 0),
          workspaceId,
        }),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      // Sale de la vista —el tablero enseña un sprint—, con aviso y enlace.
      document.querySelectorAll(`.issue-card[data-issue-id="${CSS.escape(issueId)}"]`).forEach((c) => c.remove());
      updateCounts();
      window.showToast?.(texto('moved').replace('{destino}', nombre), false, {
        accion: texto('see'),
        alPulsar: () => { window.location.href = `${window.location.pathname}?sprint=${encodeURIComponent(sprint)}&issue=${encodeURIComponent(issueId)}`; },
      });
    } catch (err) {
      console.error('mover de sprint:', err);
      window.showToast?.(texto('move-sprint-error'), true);
    }
  }

  // ── Hoja de mover (teléfono) ───────────────────────────────────────────────
  const hoja = document.getElementById('hoja-mover') as HTMLDialogElement | null;
  let tarjetaHoja: HTMLElement | null = null;
  function abrirHojaMover(card: HTMLElement) {
    if (!hoja) return;
    tarjetaHoja = card;
    const titulo = hoja.querySelector('#hoja-mover-titulo');
    if (titulo) titulo.textContent = card.querySelector('h4')?.textContent || '';
    // Donde ya está, marcado y sin poder pulsarse.
    const estado = columnaDe(card)?.dataset.status || card.dataset.status || 'todo';
    hoja.querySelectorAll<HTMLButtonElement>('.estado-destino').forEach((b) => {
      const aqui = b.dataset.estado === estado;
      b.setAttribute('aria-pressed', String(aqui));
      b.disabled = aqui;
    });
    const sprint = card.dataset.sprintId || 'backlog';
    hoja.querySelectorAll<HTMLButtonElement>('.sprint-destino-hoja').forEach((b) => {
      const aqui = b.dataset.sprint === sprint;
      b.setAttribute('aria-pressed', String(aqui));
      b.disabled = aqui;
    });
    // Sin otro sprint al que ir, la sección no dice nada: fuera.
    hoja.querySelector('.hoja-sprints')?.classList.toggle('hidden', !hoja.querySelector('.sprint-destino-hoja:not(:disabled)'));
    hoja.showModal();
  }
  hoja?.addEventListener('click', async (e) => {
    // Tocar el velo cierra: el clic llega al propio `<dialog>`.
    if (e.target === hoja) { hoja.close(); return; }
    const card = tarjetaHoja;
    const objetivo = e.target as HTMLElement;
    const estado = objetivo.closest<HTMLButtonElement>('.estado-destino')?.dataset.estado;
    const sprint = objetivo.closest<HTMLButtonElement>('.sprint-destino-hoja');
    if (!card || (!estado && !sprint)) return;
    hoja.close();
    if (estado) await moverA(card, estado);
    else if (sprint?.dataset.sprint) await moverDeSprint(card, sprint.dataset.sprint, sprint.dataset.nombre || '');
  });
  document.addEventListener('click', (e) => {
    if (!menuSprint || menuSprint.classList.contains('hidden')) return;
    if (!menuSprint.contains(e.target as Node) && !(e.target as HTMLElement).closest('.btn-mover-sprint')) cerrarMenuSprint();
  });
  document.addEventListener('keydown', (e) => {
    if (!menuSprint || menuSprint.classList.contains('hidden')) return;
    if (e.key === 'Escape') { e.preventDefault(); cerrarMenuSprint(true); return; }
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      const items = Array.from(menuSprint.querySelectorAll<HTMLElement>('.sprint-destino:not(.hidden)'));
      const i = items.indexOf(document.activeElement as HTMLElement);
      items[(i + (e.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length]?.focus();
    }
  });

  // El panel cambia los puntos de una tarjeta: las sumas tienen que seguirle.
  (window as any).forgeActualizarCuentas = updateCounts;

  // Completar desde fuera del tablero (el aviso de «todas las subtareas hechas»).
  (window as any).forgeCompletarTarea = (issueId: string) => {
    const card = document.querySelector<HTMLElement>(`.issue-card[data-issue-id="${CSS.escape(issueId)}"]`);
    if (card && card.dataset.status !== 'done') completar(card);
  };

  // ── Arrastrar ──────────────────────────────────────────────────────────────
  let arrastrada: HTMLElement | null = null;

  function getDragAfterElement(content: Element, y: number) {
    const candidatas = [...content.querySelectorAll<HTMLElement>('.issue-card:not(.opacity-50):not(.hueco)')];
    return candidatas.reduce((closest, child) => {
      const box = child.getBoundingClientRect();
      const offset = y - box.top - box.height / 2;
      return offset < 0 && offset > closest.offset ? { offset, element: child } : closest;
    }, { offset: Number.NEGATIVE_INFINITY, element: null as Element | null }).element;
  }

  /**
   * Pone la tarjeta en la columna a la altura `y`. Debajo de la última va
   * antes del pie («ver más»). El pie se buscaba con `:scope > p`, y el primer
   * `<p>` de la columna es el aviso de vacía, que va **antes** de las
   * tarjetas: soltar por debajo de la última la mandaba arriba del todo.
   */
  function colocar(content: Element, card: HTMLElement, y: number) {
    const despues = getDragAfterElement(content, y);
    const pie = pieDe(content);
    if (despues) content.insertBefore(card, despues);
    else if (pie) content.insertBefore(card, pie);
    else content.appendChild(card);
  }

  /**
   * Con carriles, solo se suelta en el propio carril.
   *
   * Soltar en el carril de otra etiqueta podría querer decir «cámbiale la
   * etiqueta», pero también puede ser un arrastre que se pasó de largo; cambiar
   * etiquetas por accidente no se ve hasta mucho después. Se cambia editándola.
   */
  const mismoCarril = (col: HTMLElement) => !arrastrada || arrastrada.dataset.origenCarril === (col.dataset.carril ?? '');

  if (canEdit && container) {
    container.addEventListener('dragstart', (e: DragEvent) => {
      const card = tarjetaDe(e.target);
      if (!card || !e.dataTransfer) return;
      // Seleccionando, pulsar es elegir: nada se arrastra.
      if (container.classList.contains('seleccionando')) { e.preventDefault(); return; }
      arrastrada = card;
      card.dataset.origenCarril = columnaDe(card)?.dataset.carril ?? '';
      card.dataset.statusVal = columnaDe(card)?.dataset.status || '';
      e.dataTransfer.setData('text/plain', card.id);
      e.dataTransfer.effectAllowed = 'move';
      card.classList.add('opacity-50');
    });

    container.addEventListener('dragend', () => {
      arrastrada?.classList.remove('opacity-50');
      arrastrada = null;
      columnas().forEach((c) => c.querySelector('.column-content')?.classList.remove('soltar-aqui'));
    });

    container.addEventListener('dragover', (e: DragEvent) => {
      const col = columnaDe(e.target as Element);
      if (!col || !arrastrada || !mismoCarril(col)) return;
      e.preventDefault();
      const content = col.querySelector('.column-content');
      if (!content) return;
      content.classList.add('soltar-aqui');
      colocar(content, arrastrada, e.clientY);
    });

    container.addEventListener('dragleave', (e: DragEvent) => {
      columnaDe(e.target as Element)?.querySelector('.column-content')?.classList.remove('soltar-aqui');
    });

    container.addEventListener('drop', async (e: DragEvent) => {
      const col = columnaDe(e.target as Element);
      const card = arrastrada;
      if (!col || !card) return;
      e.preventDefault();
      if (!mismoCarril(col)) {
        window.showToast?.(texto('lane-only'), true);
        return;
      }
      const content = col.querySelector('.column-content');
      const newStatus = col.dataset.status;
      if (!content || !newStatus) return;
      content.classList.remove('soltar-aqui');
      updateCounts();

      const newPosition = posicionEntre(content, card);
      card.dataset.position = String(newPosition);

      try {
        await mover(card.dataset.issueId!, newStatus, newPosition);
        // Cambiar de columna recarga: entrar o salir de Hecho para el
        // cronómetro y cambia los botones que pinta el servidor.
        if (card.dataset.statusVal !== newStatus) window.location.reload();
      } catch (error) {
        console.error('[SYS.NET] Update failed', error);
        window.showToast?.(window.forgeMsg?.errGenerico || '', true);
      }
    });
  }

  /**
   * Arrastrar con el dedo, en el teléfono.
   *
   * El arrastre de arriba es HTML5 y no sirve con el dedo. Aquí: mantener
   * pulsada una tarjeta la levanta (una copia sigue al dedo y la original
   * queda como hueco). Soltarla en una pestaña de estado la mueve a ese estado;
   * soltarla dentro de su columna la reordena. Cerca del borde de arriba o de
   * abajo, la columna se desplaza sola.
   *
   * La espera es lo que separa levantar de desplazar: si el dedo se mueve
   * antes de que pase, es que se estaba desplazando la lista y no pasa nada.
   *
   * Y con la lista quieta, deslizar a los lados cambia de pestaña.
   */
  if (container && pestanas) {
    const ESPERA_MS = 380;
    const TOLERANCIA_PX = 10;
    let pulsada: { card: HTMLElement; x: number; y: number; temporizador: number } | null = null;
    let arrastre: {
      card: HTMLElement; fantasma: HTMLElement; columna: HTMLElement | null; dx: number; dy: number;
      estado: string; padre: Node; siguiente: Node | null; destino: string | null; desplazable: HTMLElement | null;
    } | null = null;
    let toque = { x: 0, y: 0 };
    let inicio: { x: number; y: number; t: number } | null = null;
    let huboArrastre = false;
    let animacion = 0;

    const pestanasVisibles = () => pestanas.getClientRects().length > 0;
    const desplazableDe = (el: HTMLElement) => {
      for (let p = el.parentElement; p; p = p.parentElement) {
        const oy = getComputedStyle(p).overflowY;
        if ((oy === 'auto' || oy === 'scroll') && p.scrollHeight > p.clientHeight) return p;
      }
      return null;
    };
    const restaurarArrastrable = (card: HTMLElement) => card.setAttribute('draggable', canEdit ? 'true' : 'false');
    const cancelarPulsacion = () => {
      if (!pulsada) return;
      window.clearTimeout(pulsada.temporizador);
      restaurarArrastrable(pulsada.card);
      pulsada = null;
    };

    function levantar() {
      if (!pulsada) return;
      const card = pulsada.card;
      pulsada = null;
      const caja = card.getBoundingClientRect();
      const fantasma = card.cloneNode(true) as HTMLElement;
      fantasma.removeAttribute('id');
      fantasma.classList.remove('issue-card');
      fantasma.classList.add('tarjeta-fantasma', 'is-dragging');
      fantasma.setAttribute('aria-hidden', 'true');
      // Más estrecha que la tarjeta y **debajo** del dedo: si la copia
      // conservara el punto de agarre, taparía la pestaña sobre la que se
      // está soltando y no se vería cuál es.
      const ancho = Math.min(caja.width, 260);
      fantasma.style.width = `${ancho}px`;
      document.body.appendChild(fantasma);
      card.classList.add('hueco');
      arrastre = {
        card, fantasma, columna: columnaDe(card), dx: Math.min(40, ancho / 4), dy: -24,
        estado: columnaDe(card)?.dataset.status || 'todo', padre: card.parentNode!, siguiente: card.nextSibling,
        destino: null, desplazable: desplazableDe(card),
      };
      huboArrastre = true;
      seguirDedo();
      pestanas!.classList.add('arrastrando');
      navigator.vibrate?.(12);
      animacion = requestAnimationFrame(desplazarSolo);
    }

    function seguirDedo() {
      const a = arrastre;
      if (!a) return;
      const ancho = a.fantasma.offsetWidth;
      a.fantasma.style.left = `${Math.max(8, Math.min(toque.x - a.dx, window.innerWidth - ancho - 8))}px`;
      a.fantasma.style.top = `${toque.y - a.dy}px`;
      // La copia no recibe el puntero, así que debajo está lo que hay de verdad.
      const debajo = document.elementFromPoint(toque.x, toque.y) as HTMLElement | null;
      const pestana = debajo?.closest<HTMLElement>('.filtro-estado') ?? null;
      a.destino = pestana && pestana.dataset.estado !== a.estado ? pestana.dataset.estado ?? null : null;
      filtros.forEach((f) => f.classList.toggle('destino', f.dataset.estado === a.destino));
      // Reordenar solo dentro de su columna, y no en Hecho, que va por fecha.
      const contenido = a.columna?.querySelector('.column-content');
      if (!pestana && contenido && a.estado !== 'done' && debajo && a.columna?.contains(debajo)) {
        colocar(contenido, a.card, toque.y);
      }
    }

    function desplazarSolo() {
      const a = arrastre;
      if (!a) return;
      const caja = a.desplazable?.getBoundingClientRect();
      if (a.desplazable && caja) {
        const MARGEN = 72;
        // La franja de arriba empieza **debajo** de las pestañas: encima de
        // ellas se está eligiendo dónde soltar, no pidiendo que se desplace.
        const arriba = Math.max(caja.top, pestanas!.getBoundingClientRect().bottom);
        let v = 0;
        if (toque.y >= arriba && toque.y < arriba + MARGEN) v = -(arriba + MARGEN - toque.y) / 4;
        else if (toque.y > caja.bottom - MARGEN) v = (toque.y - (caja.bottom - MARGEN)) / 4;
        if (v) { a.desplazable.scrollTop += v; seguirDedo(); }
      }
      animacion = requestAnimationFrame(desplazarSolo);
    }

    async function soltar(cancelado: boolean) {
      cancelAnimationFrame(animacion);
      const a = arrastre;
      arrastre = null;
      if (!a) return;
      a.fantasma.remove();
      a.card.classList.remove('hueco');
      restaurarArrastrable(a.card);
      pestanas!.classList.remove('arrastrando');
      filtros.forEach((f) => f.classList.remove('destino'));
      const devolver = () => a.padre.insertBefore(a.card, a.siguiente);

      if (cancelado) { devolver(); return; }
      if (a.destino) { devolver(); await moverA(a.card, a.destino); return; }
      if (a.card.parentNode === a.padre && a.card.nextSibling === a.siguiente) return;
      const contenido = a.card.parentElement;
      if (!contenido) return;
      const posicion = posicionEntre(contenido, a.card);
      try {
        await mover(a.card.dataset.issueId!, a.estado, posicion);
        a.card.dataset.position = String(posicion);
      } catch (err) {
        console.error('reordenar:', err);
        devolver();
        window.showToast?.(window.forgeMsg?.errGenerico || '', true);
      }
    }

    container.addEventListener('touchstart', (e: TouchEvent) => {
      huboArrastre = false;
      const dedo = e.touches[0];
      if (e.touches.length !== 1 || !dedo || !pestanasVisibles()) { cancelarPulsacion(); inicio = null; return; }
      toque = { x: dedo.clientX, y: dedo.clientY };
      inicio = { x: dedo.clientX, y: dedo.clientY, t: Date.now() };
      const objetivo = e.target as HTMLElement;
      const card = canEdit && container.dataset.vista === 'tablero' && !container.classList.contains('seleccionando') ? tarjetaDe(objetivo) : null;
      if (!card || objetivo.closest('button, a, select, input, textarea')) return;
      // El arrastre nativo también arranca con el dedo en Chrome para Android
      // y competiría con este.
      card.setAttribute('draggable', 'false');
      pulsada = { card, x: dedo.clientX, y: dedo.clientY, temporizador: window.setTimeout(levantar, ESPERA_MS) };
    }, { passive: true });

    // No pasivo: con una tarjeta levantada, el dedo no desplaza la página.
    container.addEventListener('touchmove', (e: TouchEvent) => {
      const dedo = e.touches[0];
      if (!dedo) return;
      toque = { x: dedo.clientX, y: dedo.clientY };
      if (arrastre) { e.preventDefault(); seguirDedo(); return; }
      if (pulsada && Math.hypot(dedo.clientX - pulsada.x, dedo.clientY - pulsada.y) > TOLERANCIA_PX) cancelarPulsacion();
    }, { passive: false });

    container.addEventListener('touchend', (e: TouchEvent) => {
      cancelarPulsacion();
      if (arrastre) {
        // Sin esto, soltar dispararía el clic que abre la tarea.
        e.preventDefault();
        soltar(false);
        return;
      }
      // Deslizar a los lados: la pestaña siguiente o la anterior.
      const dedo = e.changedTouches[0];
      if (!inicio || !dedo || huboArrastre || container.dataset.vista !== 'tablero') return;
      const dx = dedo.clientX - inicio.x;
      const dy = dedo.clientY - inicio.y;
      if (Math.abs(dx) < 70 || Math.abs(dy) > Math.abs(dx) * 0.5 || Date.now() - inicio.t > 700) return;
      const orden = filtros.map((f) => f.dataset.estado!);
      const siguiente = orden[orden.indexOf(estadoVisible()) + (dx < 0 ? 1 : -1)];
      if (siguiente) mostrarEstado(siguiente);
    }, { passive: false });

    container.addEventListener('touchcancel', () => {
      cancelarPulsacion();
      if (arrastre) soltar(true);
    });
    // Mantener pulsado no abre el menú del sistema.
    container.addEventListener('contextmenu', (e) => { if (pulsada || arrastre) e.preventDefault(); });
  }

  /**
   * «Próximos»: arrastrar una tarea a otro día le cambia la fecha.
   *
   * Sin ratón o en móvil, la fecha se cambia en el panel de la tarea, que es
   * un campo normal.
   */
  if (canEdit && container?.dataset.vista === 'proximos') {
    const diaDe = (el: EventTarget | null) => (el as HTMLElement | null)?.closest?.<HTMLElement>('.dia-proximos') ?? null;
    container.addEventListener('dragover', (e: DragEvent) => {
      const dia = diaDe(e.target);
      if (!dia || !arrastrada) return;
      e.preventDefault();
      dia.classList.add('soltar-aqui');
    });
    container.addEventListener('dragleave', (e: DragEvent) => diaDe(e.target)?.classList.remove('soltar-aqui'));
    container.addEventListener('drop', async (e: DragEvent) => {
      const dia = diaDe(e.target);
      const card = arrastrada;
      if (!dia || !card) return;
      e.preventDefault();
      dia.classList.remove('soltar-aqui');
      if ((card.dataset.plannedDate || card.dataset.dueDate) === dia.dataset.fecha) return;
      try {
        // Arrastrar cambia el día en que se **hace**, nunca la entrega.
        const res = await fetch(`/api/issues/${card.dataset.issueId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ planned_date: dia.dataset.fecha }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        window.location.reload();
      } catch (err) {
        console.error('cambiar de día:', err);
        window.showToast?.(texto('move-day-error'), true);
      }
    });
  }

  // ?issue=<id> abre esa tarea al cargar (enlaces desde «Mis tareas»).
  (() => {
    const issueId = new URLSearchParams(window.location.search).get('issue');
    if (!issueId) return;
    const card = document.querySelector<HTMLElement>(`.issue-card[data-issue-id="${CSS.escape(issueId)}"]`);
    if (!card) return;
    abrirTarea(card);
    const newUrl = new URL(window.location.href);
    newUrl.searchParams.delete('issue');
    window.history.replaceState({}, '', newUrl.toString());
  })();

  // ── Cronómetro ─────────────────────────────────────────────────────────────
  const updateTimers = () => {
    document.querySelectorAll<HTMLElement>('.active-timer-display').forEach((display) => {
      const startStr = display.dataset.startTime;
      if (!startStr) return;
      const started = new Date(startStr.endsWith('Z') ? startStr : `${startStr.replace(' ', 'T')}Z`).getTime();
      const sessionElapsed = Math.floor((Date.now() - started) / 1000);
      if (sessionElapsed < 0) return;
      const total = sessionElapsed + Math.floor(parseFloat(display.dataset.loggedHours || '0') * 3600);
      const h = Math.floor(total / 3600), m = Math.floor((total % 3600) / 60), s = total % 60;
      const textEl = display.querySelector('.timer-text');
      if (textEl) textEl.textContent = [h, m, s].map((n) => String(n).padStart(2, '0')).join(':');
    });
  };
  if (document.querySelector('.active-timer-display')) {
    setInterval(updateTimers, 1000);
    updateTimers();
  }

  container?.addEventListener('click', async (e) => {
    const start = (e.target as HTMLElement).closest<HTMLButtonElement>('.btn-start-timer');
    const stop = (e.target as HTMLElement).closest<HTMLButtonElement>('.btn-stop-timer');
    const btn = start || stop;
    if (!btn) return;
    const issueId = btn.dataset.issueId;
    if (!issueId) return;
    const original = btn.innerHTML;
    btn.textContent = start ? texto('timer-starting') : texto('timer-stopping');
    try {
      const response = await fetch(`/api/issues/${issueId}/timer`, { method: start ? 'POST' : 'DELETE' });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.success) throw new Error(data.message || `HTTP ${response.status}`);
      if (start && data.stopped_previous) {
        window.showToast?.(texto('timer-autostopped')
          .replace('{id}', data.stopped_details.issueId.substring(0, 8).toUpperCase())
          .replace('{h}', String(data.stopped_details.hours)), false);
      }
      // Arrancar el cronómetro pasa la tarea a «En progreso».
      if (start && columnaDe(btn)?.dataset.status !== 'in_progress') {
        await mover(issueId, 'in_progress', 0);
      }
      window.location.reload();
    } catch (err) {
      console.error('cronómetro:', err);
      btn.innerHTML = original;
      window.showToast?.(window.forgeMsg?.errGenerico || '', true);
    }
  });

  // ── Seleccionar varias ─────────────────────────────────────────────────────
  //
  // Pulsar una tarjeta la elige en vez de abrirla; Mayús+clic elige el tramo
  // desde la anterior, dentro de la misma columna. Una tarea con dos etiquetas
  // sale dos veces con carriles: se elige por id, así que las dos copias van
  // juntas.
  const barraSeleccion = document.getElementById('barra-seleccion');
  const botonSeleccionar = document.getElementById('btn-seleccionar');
  if (barraSeleccion && botonSeleccionar && container) montarSeleccion(barraSeleccion, botonSeleccionar, container);
  function montarSeleccion(barra: HTMLElement, btnSeleccionar: HTMLElement, container: HTMLElement) {
    const b = barra.dataset;
    const elegidas = new Set<string>();
    let anterior: HTMLElement | null = null;
    let trabajando = false;
    const activo = () => container.classList.contains('seleccionando');
    const copiasDe = (id: string) => Array.from(document.querySelectorAll<HTMLElement>(`.issue-card[data-issue-id="${CSS.escape(id)}"]`));
    const tituloDe = (id: string) => copiasDe(id)[0]?.querySelector('h4')?.textContent?.trim() || id;
    const menus = Array.from(barra.querySelectorAll<HTMLElement>('.sel-menu'));
    const cerrarMenus = () => {
      menus.forEach((m) => m.classList.add('hidden'));
      barra.querySelectorAll('[aria-haspopup="menu"]').forEach((x) => x.setAttribute('aria-expanded', 'false'));
    };

    function pintar() {
      document.querySelectorAll<HTMLElement>('.issue-card').forEach((c) => {
        c.classList.toggle('elegida', elegidas.has(c.dataset.issueId!));
      });
      const n = elegidas.size;
      const cuenta = document.getElementById('sel-cuenta')!;
      if (!trabajando) cuenta.textContent = n === 0 ? (b.tNone || '') : n === 1 ? (b.tCountOne || '') : (b.tCount || '').replace('{n}', String(n));
      barra.querySelectorAll<HTMLButtonElement>('.sel-accion').forEach((x) => { x.disabled = n === 0 || trabajando; });
    }
    function entrar() {
      container.classList.add('seleccionando');
      btnSeleccionar.setAttribute('aria-pressed', 'true');
      barra.classList.remove('hidden');
      pintar();
    }
    function salir() {
      elegidas.clear();
      anterior = null;
      container.classList.remove('seleccionando');
      btnSeleccionar.setAttribute('aria-pressed', 'false');
      barra.classList.add('hidden');
      cerrarMenus();
      pintar();
    }
    btnSeleccionar.addEventListener('click', () => (activo() ? salir() : entrar()));
    document.getElementById('sel-listo')?.addEventListener('click', salir);
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !activo() || trabajando) return;
      // Escape en la confirmación de borrar cancela esa ventana, no la selección.
      if (document.querySelector('dialog[open]')) return;
      if (menus.some((m) => !m.classList.contains('hidden'))) cerrarMenus();
      else salir();
    });

    // En captura: seleccionando, nada de la tarjeta (completar, mover, abrir)
    // recibe el clic.
    container.addEventListener('click', (e) => {
      if (!activo()) return;
      const card = tarjetaDe(e.target);
      if (!card) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      if (trabajando) return;
      const id = card.dataset.issueId!;
      const columna = columnaDe(card);
      if (e.shiftKey && anterior && columna && columnaDe(anterior) === columna) {
        const lista = Array.from(columna.querySelectorAll<HTMLElement>('.issue-card'));
        const [desde, hasta] = [lista.indexOf(anterior), lista.indexOf(card)].sort((x, y) => x - y);
        lista.slice(desde, hasta + 1).forEach((c) => elegidas.add(c.dataset.issueId!));
      } else if (elegidas.has(id)) {
        elegidas.delete(id);
      } else {
        elegidas.add(id);
      }
      anterior = card;
      pintar();
    }, true);

    // Los menús de la barra se abren hacia arriba.
    barra.querySelectorAll<HTMLButtonElement>('[aria-haspopup="menu"]').forEach((boton) => {
      boton.addEventListener('click', (e) => {
        e.stopPropagation();
        const menu = document.getElementById(boton.getAttribute('aria-controls') || '');
        const abierto = menu && !menu.classList.contains('hidden');
        cerrarMenus();
        if (menu && !abierto) {
          menu.classList.remove('hidden');
          boton.setAttribute('aria-expanded', 'true');
          menu.querySelector<HTMLElement>('[role="menuitem"]')?.focus();
        }
      });
    });
    document.addEventListener('click', (e) => { if (!barra.contains(e.target as Node)) cerrarMenus(); });

    /**
     * Hace lo mismo con cada elegida, de cuatro en cuatro, y recarga con un
     * aviso: muchas tarjetas cambian de sitio a la vez, y el servidor sabe
     * pintarlas mejor que retocarlas aquí una por una.
     */
    async function enLote(paraCada: (id: string, i: number) => Promise<Response> | null, mensaje: (n: number) => string) {
      cerrarMenus();
      const ids = [...elegidas];
      const fallidas: string[] = [];
      let hechas = 0;
      let i = 0;
      trabajando = true;
      pintar();
      const cuenta = document.getElementById('sel-cuenta')!;
      const avanzar = () => { cuenta.textContent = (b.tWorking || '').replace('{n}', String(hechas)).replace('{total}', String(ids.length)); };
      avanzar();
      const trabajador = async () => {
        while (i < ids.length) {
          const indice = i++;
          const id = ids[indice];
          try {
            const peticion = paraCada(id, indice);
            if (peticion) {
              const res = await peticion;
              if (!res.ok) throw new Error(`HTTP ${res.status}`);
            }
          } catch (err) {
            console.error('selección:', id, err);
            fallidas.push(tituloDe(id));
          }
          hechas++;
          avanzar();
        }
      };
      await Promise.all(Array.from({ length: Math.min(4, ids.length) }, trabajador));
      const bien = ids.length - fallidas.length;
      const aviso = fallidas.length
        ? `${bien ? `${mensaje(bien)} ` : ''}${(b.tFailed || '').replace('{lista}', fallidas.join(', '))}`
        : mensaje(bien);
      try { sessionStorage.setItem('forge_aviso', JSON.stringify({ texto: aviso, error: fallidas.length > 0 })); } catch { /* sin almacenamiento */ }
      window.location.reload();
    }

    const json = { 'Content-Type': 'application/json' };

    // Mover a un estado: al final de esa columna, en el orden en que se eligieron.
    barra.querySelectorAll<HTMLButtonElement>('.sel-estado').forEach((boton) => boton.addEventListener('click', () => {
      const estado = boton.dataset.estado!;
      const destino = columnas().filter((c) => c.dataset.status === estado);
      const base = Math.max(0, ...destino.flatMap((c) => Array.from(c.querySelectorAll<HTMLElement>('.issue-card')).map((x) => Number(x.dataset.position) || 0)));
      enLote((id, i) => {
        const copia = copiasDe(id)[0];
        if ((columnaDe(copia)?.dataset.status || copia?.dataset.status) === estado) return null;
        return fetch(`/api/issues/${id}/move`, { method: 'PATCH', headers: json, body: JSON.stringify({ status: estado, position: base + 100000 * (i + 1), workspaceId }) });
      }, (n) => (b.tMoved || '').replace('{destino}', boton.dataset.titulo || '').replace('{n}', String(n)));
    }));

    // Mover a un sprint: mismo estado y misma posición.
    barra.querySelectorAll<HTMLButtonElement>('.sel-sprint').forEach((boton) => boton.addEventListener('click', () => {
      const sprint = boton.dataset.sprint!;
      enLote((id) => {
        const copia = copiasDe(id)[0];
        if ((copia?.dataset.sprintId || 'backlog') === sprint) return null;
        return fetch(`/api/issues/${id}/move`, {
          method: 'PATCH',
          headers: json,
          body: JSON.stringify({
            sprint_id: sprint === 'backlog' ? null : sprint,
            status: columnaDe(copia)?.dataset.status || copia?.dataset.status || 'todo',
            position: Number(copia?.dataset.position || 0),
            workspaceId,
          }),
        });
      }, (n) => (b.tMoved || '').replace('{destino}', boton.dataset.nombre || '').replace('{n}', String(n)));
    }));

    // Poner una etiqueta: se suma a las que ya tengan.
    barra.querySelectorAll<HTMLButtonElement>('.sel-etiqueta').forEach((boton) => boton.addEventListener('click', () => {
      enLote((id) => fetch(`/api/w/${sysTag}/labels/assign`, {
        method: 'POST', headers: json, body: JSON.stringify({ label_id: boton.dataset.id, entity_type: 'issue', entity_id: id }),
      }), (n) => (b.tLabeled || '').replace('{etiqueta}', boton.dataset.nombre || '').replace('{n}', String(n)));
    }));

    // Borrar, con confirmación que dice cuántas.
    document.getElementById('sel-borrar')?.addEventListener('click', () => {
      const n = elegidas.size;
      if (!n) return;
      const pregunta = n === 1 ? (b.tConfirmOne || '') : (b.tConfirm || '').replace('{n}', String(n));
      window.forgeConfirm?.(pregunta, () => {
        enLote((id) => fetch(`/api/issues/${id}`, { method: 'DELETE' }), (hechas) => (b.tDeleted || '').replace('{n}', String(hechas)));
      }, b.tDelete);
    });
  }

  // El tablero ya responde a los clics. Lo leen las pruebas: con la máquina
  // cargada, pulsar antes de que el script termine no hace nada y la prueba
  // fallaba por eso, no por el tablero.
  document.body.dataset.tableroListo = 'true';
</script>
