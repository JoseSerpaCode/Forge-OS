    box-shadow: var(--forge-shadow-float);
    z-index: 40;
    visibility: hidden;
  }
  .note-floating-menu button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 30px;
    height: 30px;
    padding: 0 6px;
    border-radius: 6px;
    color: var(--forge-text);
  }
  .note-floating-menu button:hover { background: var(--forge-bg); }
  .note-floating-menu button[aria-pressed='true'] { background: var(--forge-bg); color: var(--forge-accent-text); }
  .note-floating-menu .note-table-btn { font-size: 12px; white-space: nowrap; }
  #note-table-menu { flex-wrap: wrap; max-width: min(92vw, 640px); }

  /* ── Menú «/» ─────────────────────────────────────────────────────────── */
  /* `@alguien`. Texto en `accent-text`, que es el naranja que pasa AA; el
     fondo lleva el color, no el texto (sin opacidad en el texto). */
  .note-mention {
    color: var(--forge-accent-text);
    font-weight: 600;
    border-radius: 4px;
    padding: 0 2px;
    background: color-mix(in srgb, var(--forge-accent-text) 10%, transparent);
    white-space: nowrap;
  }
  .note-slash-menu {
    width: 240px;
    max-height: 320px;
    overflow-y: auto;
    padding: 4px;
    background: var(--forge-panel);
    border: 1px solid var(--forge-border-strong);
    border-radius: 14px;
    box-shadow: var(--forge-shadow-float);
    z-index: 50;
  }
  .note-slash-item {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 7px 10px;
    border-radius: 10px;
    font-size: 14px;
    color: var(--forge-text);
    text-align: left;
  }
  .note-slash-item[aria-selected='true'],
  .note-slash-item:hover { background: var(--forge-bg); }
  .note-slash-item kbd { font-family: var(--forge-mono); font-size: 11px; color: var(--forge-muted); }
  .note-slash-empty { padding: 6px 8px; font-size: 14px; color: var(--forge-muted); }

  /* El asa vive en el margen izquierdo del editor; en escritorio se le hace
     sitio, en móvil no hace falta porque no se muestra. */
  @media (hover: hover) {
    .note-editor { padding-left: 28px; margin-left: -28px; }
  }
</style>
