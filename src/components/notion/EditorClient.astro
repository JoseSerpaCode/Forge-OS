---
import { useTranslations } from '../../i18n/ui';
import LabelPicker from '../labels/LabelPicker.astro';
import { loadNote } from '../../lib/notes/content';
import { tonoDe, esFotoReal } from '../../lib/tonos';
import { iniciales } from '../../lib/responsables';
import db from '../../lib/db';
import { listar as listarContactos } from '../../lib/contactos';

interface Props {
  pageId: string;
  initialTitle: string;
  initialContent: string;
  canEdit: boolean;
  authorName?: string;
  authorAvatar?: string;
  updatedAt?: string;
  createdAt?: string;
  parentTitle?: string | null;
  parentId?: string | null;
  sysTag: string;
  labels?: Array<{ id: string; name: string; color: string }>;
  labelCatalog?: Array<{ id: string; name: string; color: string }>;
}
const { pageId, initialTitle, initialContent, canEdit, authorName, authorAvatar, updatedAt, parentTitle, parentId, sysTag, labels = [], labelCatalog = [] } = Astro.props;

const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);

// La nota llega ya convertida a Tiptap aunque en la base siga en formato de
// Editor.js: la conversión es la misma que usa el script de migración.
const nota = loadNote(initialContent);

// Si al convertir una nota vieja se queda algún bloque por el camino, la nota
// se enseña pero **no se guarda**: el primer autoguardado sobrescribiría el
// original y esos bloques se perderían para siempre.
const legacyDropped = nota.ok && nota.legacy ? nota.dropped : [];
const bloquearGuardado = !nota.ok || legacyDropped.length > 0;
const avisoCarga = !nota.ok
  ? t('kb.load_failed')
  : legacyDropped.length
    ? t('kb.legacy_dropped').replace('{list}', legacyDropped.join(', '))
    : '';

const textos = {
  placeholder: t('kb.editor.placeholder'),
  aria: t('kb.editor.aria'),
  drag: t('kb.editor.drag'),
  'slash.text': t('kb.slash.text'), 'slash.h1': t('kb.slash.h1'), 'slash.h2': t('kb.slash.h2'), 'slash.h3': t('kb.slash.h3'),
  'slash.bullet': t('kb.slash.bullet'), 'slash.ordered': t('kb.slash.ordered'), 'slash.task': t('kb.slash.task'),
  'slash.quote': t('kb.slash.quote'), 'slash.code': t('kb.slash.code'), 'slash.table': t('kb.slash.table'),
  'slash.divider': t('kb.slash.divider'), 'slash.empty': t('kb.slash.empty'),
  'link.invalid': t('kb.fmt.link_invalid'),
  'status.unsaved': t('kb.status.unsaved'), 'status.saving': t('kb.status.saving'), 'status.saved': t('kb.saved'),
  'status.error': t('kb.status.error'), 'status.not_saved': t('kb.status.not_saved'),
  'status.saved_dropped': t('kb.status.saved_dropped'), 'dropped_toast': t('kb.dropped_toast'),
  'delete_confirm': t('kb.delete_confirm'), 'delete_error': t('kb.delete_error'),
  'mention.empty': t('contacts.mention_empty'), 'mention.contact': t('contacts.mention_contact'), 'mention.member': t('contacts.mention_member'),
};

// A quién se puede mencionar con «@»: los miembros del espacio y tus
// contactos. Los contactos de los demás no: son de su libreta.
const yo = Astro.locals.user;
const personas = canEdit && yo
  ? [
      ...(db.prepare(`
        SELECT u.id, u.username FROM workspace_members wm
        JOIN users u ON u.id = wm.user_id
        JOIN workspaces w ON w.id = wm.workspace_id
        WHERE w.sys_tag = ? ORDER BY u.username COLLATE NOCASE
      `).all(sysTag) as Array<{ id: string; username: string }>).map((m) => ({ id: m.id, nombre: m.username, tipo: 'usuario' as const })),
      ...(yo.is_guest ? [] : listarContactos(yo.id)).map((c) => ({ id: c.id, nombre: c.name, tipo: 'contacto' as const })),
    ]
  : [];

const marcas = [
  { mark: 'bold', label: t('kb.fmt.bold'), icon: '<path d="M6 4h8a4 4 0 0 1 0 8H6z"/><path d="M6 12h9a4 4 0 0 1 0 8H6z"/>' },
  { mark: 'italic', label: t('kb.fmt.italic'), icon: '<line x1="19" y1="4" x2="10" y2="4"/><line x1="14" y1="20" x2="5" y2="20"/><line x1="15" y1="4" x2="9" y2="20"/>' },
  { mark: 'underline', label: t('kb.fmt.underline'), icon: '<path d="M6 4v6a6 6 0 0 0 12 0V4"/><line x1="4" y1="20" x2="20" y2="20"/>' },
  { mark: 'strike', label: t('kb.fmt.strike'), icon: '<path d="M16 4H9a3 3 0 0 0-2.83 4"/><path d="M14 12a4 4 0 0 1 0 8H6"/><line x1="4" y1="12" x2="20" y2="12"/>' },
  { mark: 'highlight', label: t('kb.fmt.highlight'), icon: '<path d="m9 11-6 6v3h9l3-3"/><path d="m22 12-4.6 4.6a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8L14 4"/>' },
  { mark: 'code', label: t('kb.fmt.code'), icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>' },
];

const accionesTabla = [
  { id: 'row-add', label: t('kb.table.row_add') },
  { id: 'col-add', label: t('kb.table.col_add') },
  { id: 'header', label: t('kb.table.header') },
  { id: 'row-del', label: t('kb.table.row_del') },
  { id: 'col-del', label: t('kb.table.col_del') },
  { id: 'table-del', label: t('kb.table.del') },
];

// Date formatter
function formatDate(dateStr: string | undefined) {
  if (!dateStr) return '';
  // SQLite CURRENT_TIMESTAMP is UTC: "YYYY-MM-DD HH:MM:SS"
  const safeStr = dateStr.includes('Z') ? dateStr : dateStr.replace(' ', 'T') + 'Z';
  const date = new Date(safeStr);
  
  const now = new Date();
  const diffMs = now.getTime() - date.getTime();
  const diffMins = Math.floor(diffMs / 60000);
  
  if (diffMins < 1) return t('date.just_now');
  if (diffMins < 60) return `${diffMins} ${t('date.min_ago')}`;
  if (diffMins < 120) return t('date.hour_ago');
  
  const isToday = date.toDateString() === now.toDateString();
  // El formato de hora sigue al idioma: «3:47 PM» en inglés, «15:47» en español.
  const localeFecha = lang === 'es' ? 'es-ES' : 'en-US';
  const timeStr = date.toLocaleTimeString(localeFecha, { hour: 'numeric', minute: '2-digit' });

  if (isToday) return `${t('date.today_at')} ${timeStr}`;
  
  const yesterday = new Date(now);
  yesterday.setDate(now.getDate() - 1);
  if (date.toDateString() === yesterday.toDateString()) return `${t('date.yesterday_at')} ${timeStr}`;
  
  return date.toLocaleDateString(localeFecha, { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<div class="flex-1 min-w-0 flex flex-col h-full bg-forge-bg overflow-y-auto">
  {/* En móvil el contenido usa el ancho entero: 64 px de padding lateral sobre
    360 son casi un quinto de la pantalla. */}
  {/* Medida de lectura de 68 caracteres (docs/rediseno/notas.html): más ancho
      cansa al leer; el resto de la columna queda en blanco a propósito. */}
  <div class="max-w-[68ch] w-full px-4 sm:px-10 py-6 sm:py-8 flex flex-col min-h-full">
    
    <!-- Breadcrumbs -->
    {parentTitle && (
      <nav class="text-sm text-forge-muted mb-3 flex items-center gap-2" aria-label={t('a11y.breadcrumbs')}>
        <a href={`/w/${sysTag}/p/${parentId}`} class="hover:text-forge-text hover:underline underline-offset-2">{parentTitle}</a>
        <span class="text-forge-border-strong" aria-hidden="true">/</span>
        <span class="text-forge-text truncate" aria-current="page">{initialTitle || t('kb.untitled')}</span>
      </nav>
    )}

    {/* El índice se abre desde aquí, no desde un botón flotante.

        Flotando chocaba con todo: abajo quedaba fuera del área visible por el
        `100vh` del armazón, y arriba se comía el título de la página. Dos
        intentos, dos colisiones — la señal de que el sitio equivocado era
        «flotando», no «arriba» o «abajo».

        En la fila del título no se superpone a nada, y queda a la izquierda del
        título igual que el árbol está a la izquierda del texto en escritorio. */}
    <!-- Title & Delete -->
    <div class="flex items-center justify-between gap-2 mb-4 group relative">
      <button
        type="button"
        id="btn-open-tree"
        aria-controls="page-tree-aside"
        aria-expanded="false"
        class="md:hidden shrink-0 btn btn-secondary btn-icon"
        aria-label={t('kb.open_tree')}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
      </button>
      <input type="text" id="editor-title" aria-label={t('a11y.page_title')} 
        value={initialTitle}
        readonly={!canEdit}
        class="page-title !text-[clamp(2rem,3.6vw,3.25rem)] bg-transparent focus:outline-none border-b-2 border-transparent focus:border-forge-text w-full pb-1"
        placeholder={t('kb.untitled')} autocomplete="off" />
      {/*
        Borrar la página estaba **fuera de la pantalla y solo con el ratón
        encima**: `-right-12` la sacaba del viewport en móvil, y `opacity-0
        group-hover` la hacía inalcanzable en táctil, donde no hay hover.
        Dentro del flujo y siempre visible en móvil; en escritorio se mantiene
        el comportamiento discreto de aparecer al acercarse.
      */}
      {canEdit && (
        <button id="btn-delete-page" class="shrink-0 btn btn-ghost btn-icon hover:!text-forge-error sm:opacity-0 sm:group-hover:opacity-100 sm:focus:opacity-100" title={t('kb.delete_page')} aria-label={t('kb.delete_page')}>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
        </button>
      )}
    </div>

    <!-- Metadata Bar -->
    <div class="flex items-center flex-wrap gap-2.5 mb-7 pb-4 border-b border-forge-border text-sm text-forge-muted">
      <span class="avatar" style={`--c:${tonoDe(authorName)}`} aria-hidden="true">{esFotoReal(authorAvatar) ? <img src={authorAvatar} alt="" loading="lazy" decoding="async" /> : iniciales(authorName || '?')}</span>
      <div class="flex items-center gap-1.5">
        <span><b class="text-forge-text font-semibold">{authorName || '—'}</b></span>
        <span aria-hidden="true">·</span>
        <span>{t('kb.updated')} {formatDate(updatedAt)}</span>
        {initialContent === 'null' || !initialContent || initialContent === '{}' ? (
          <>
            <span aria-hidden="true">·</span>
            <span class="chip">{t('kb.draft')}</span>
          </>
        ) : null}
      </div>
      <div class="ml-auto flex items-center gap-1">
        {/* El guardado, siempre en el mismo sitio: a la derecha de la cabecera
            de la nota. Abajo a la derecha flotaba sobre el texto. */}
        <span id="save-status" class="text-sm text-forge-muted mr-1" aria-live="polite">{t('kb.saved')}</span>
        {/*
          Los atajos del editor se esconden en móvil.

          El panel se abría solo con el ratón encima —inalcanzable en táctil— y
          lo que lista son **atajos de teclado**, que en un teléfono no aplican.
          Hacerlo pulsable sería ofrecer una ayuda que no ayuda; esconderlo deja
          sitio para lo que sí se usa.
        */}
        <div class="relative group hidden md:block">
          <button class="btn btn-ghost btn-icon btn-sm" aria-label={t('kb.editor_tips')}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
          </button>
          
          <div class="menu absolute right-0 top-full mt-2 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible z-50 !p-3 text-sm text-forge-text pointer-events-none">
            <h4 class="font-bold mb-2 pb-1.5 border-b border-forge-border">{t('kb.shortcuts')}</h4>
            <ul class="space-y-2 text-forge-muted">
              {/* Solo los atajos que el navegador cede.

                  Estaban aquí «Ctrl K» para enlace y «Ctrl B/I/U» para
                  estilos, y de esos el navegador se queda dos: `Ctrl+K` va a
                  su barra de búsqueda y `Ctrl+U` abre «ver código fuente».
                  Ningún `preventDefault()` de la página los recupera de forma
                  fiable, así que el panel prometía algo que no pasa — peor que
                  no listarlo, porque quien lo prueba cree que la app falla.

                  Los cinco textos estaban además escritos en inglés a mano;
                  solo el título pasaba por el diccionario. */}
              <li class="flex justify-between items-center gap-2"><span>{t('kb.sc.slash')}</span> <span class="kbd">/</span></li>
              <li class="flex justify-between items-center gap-2"><span>{t('kb.sc.markdown')}</span> <span class="kbd whitespace-nowrap">1. - [] # &gt;</span></li>
              <li class="flex justify-between items-center gap-2"><span>{t('kb.sc.move')}</span> <span class="text-xs">{t('kb.sc.drag')} <span class="kbd">⋮⋮</span></span></li>
              <li class="flex justify-between items-center gap-2"><span>{t('kb.sc.undo')}</span> <span class="kbd whitespace-nowrap">Ctrl Z / Y</span></li>
              <li class="flex justify-between items-center gap-2"><span>{t('kb.sc.styles')}</span> <span class="kbd whitespace-nowrap">Ctrl B / I</span></li>
            </ul>
          </div>
        </div>

        <button id="btn-share-page" class="btn btn-ghost btn-sm" title={t('kb.copy_link')}>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
          {t('kb.share')}
        </button>
      </div>
    </div>

    {/* Etiquetas de la página. Las mismas del espacio que llevan los tickets:
        es lo que permite cruzar los apuntes de «Parcial 2» con las tareas de
        «Parcial 2». Se ven aunque no se pueda editar. */}
    {(canEdit || labels.length > 0) && (
      <div class="-mt-3 mb-7">
        <LabelPicker
          sysTag={sysTag}
          entityType="page"
          entityId={pageId}
          initial={labels}
          catalog={labelCatalog}
          canEdit={canEdit}
        />
      </div>
    )}

    {avisoCarga && (
      <p role="alert" class="mb-6 rounded-[14px] border border-forge-error px-4 py-3 text-sm text-forge-text">{avisoCarga}</p>
    )}

    {/* El editor. `page-editor` es el nombre de siempre: lo buscan los tests
        de móvil. El documento viaja ya en el formato de Tiptap. */}
    <div
      id="page-editor"
      class="flex-1 text-forge-text relative note-editor"
      data-page-id={pageId}
      data-initial-doc={nota.ok ? JSON.stringify(nota.doc) : ''}
      data-can-edit={canEdit.toString()}
      data-block-save={bloquearGuardado.toString()}
      data-texts={JSON.stringify(textos)}
      data-personas={JSON.stringify(personas)}
    ></div>

    {canEdit && (
      <>
        {/* Menú de formato: aparece al seleccionar texto. Lo coloca Tiptap. */}
        <div id="note-format-menu" class="note-floating-menu" role="toolbar" aria-label={t('kb.fmt.toolbar')}>
          <div data-buttons class="flex items-center gap-0.5">
            {marcas.map((m) => (
              <button type="button" data-mark={m.mark} aria-pressed="false" aria-label={m.label} title={m.label}>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={m.icon} />
              </button>
            ))}
            <span class="w-px h-5 bg-forge-border mx-1" aria-hidden="true"></span>
            <button type="button" data-action="link" data-mark="link" aria-pressed="false" aria-label={t('kb.fmt.link')} title={t('kb.fmt.link')}>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </button>
          </div>
          <form data-link-form class="hidden">
            <input data-link-input type="text" inputmode="url" autocomplete="off" aria-label={t('kb.fmt.link')} placeholder={t('kb.fmt.link_placeholder')} class="campo !w-64 !h-8" />
          </form>
        </div>

        <div id="note-table-menu" class="note-floating-menu" role="toolbar" aria-label={t('kb.table.toolbar')}>
          {accionesTabla.map((a) => (
            <button type="button" data-table={a.id} class="note-table-btn">{a.label}</button>
          ))}
        </div>
      </>
    )}

  </div>
</div>

<script>
  import { createNoteEditor } from './editor/createNoteEditor';
  import { serializeNote } from '../../lib/notes/content';

  const editorDiv = document.getElementById('page-editor');
  const titleInput = document.getElementById('editor-title') as HTMLInputElement | null;
  const statusSpan = document.getElementById('save-status');

  if (editorDiv) {
    const pageId = editorDiv.dataset.pageId;
    const canEdit = editorDiv.dataset.canEdit === 'true';
    const t: Record<string, string> = JSON.parse(editorDiv.dataset.texts || '{}');
    const setStatus = (key: string) => {
      if (statusSpan) statusSpan.textContent = t[key] ?? '';
    };

    // Si el contenido guardado no se puede leer, **no se edita**.
    //
    // Con Editor.js se caía a un documento vacío y se seguía adelante: la
    // primera tecla —incluso en el título— disparaba el autoguardado y
    // sobrescribía el documento entero con nada. Un documento ilegible es
    // recuperable; uno sobrescrito, no. Lo mismo para una nota vieja que al
    // convertirse ha perdido bloques: el servidor lo marca en `data-block-save`.
    const blockSave = editorDiv.dataset.blockSave === 'true';
    let doc: any = { type: 'doc', content: [{ type: 'paragraph' }] };
    try {
      if (editorDiv.dataset.initialDoc) doc = JSON.parse(editorDiv.dataset.initialDoc);
    } catch (e) {
      console.error('Failed to parse initial content', e);
    }

    let saveTimeout: ReturnType<typeof setTimeout> | undefined;

    const editor = createNoteEditor({
      element: editorDiv,
      content: doc,
      editable: canEdit,
      t,
      formatMenu: document.getElementById('note-format-menu'),
      tableMenu: document.getElementById('note-table-menu'),
      personas: JSON.parse(editorDiv.dataset.personas || '[]'),
      onUpdate: () => debounceSave(),
    });
    // Para los tests e2e.
    (window as any).__editorInstance = editor;

    async function save() {
      if (!canEdit) return;

      if (blockSave) {
        setStatus('status.not_saved');
        return;
      }

      setStatus('status.saving');
      try {
        const res = await fetch(`/api/pages/${pageId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title: titleInput?.value?.trim() || 'Untitled',
            content_json: serializeNote(editor.getJSON() as any),
          }),
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.error || 'Save failed');
        }

        // El servidor dice qué bloques ha descartado. Decir «Guardado» cuando
        // se ha perdido algo es exactamente cómo desaparecían las tablas sin
        // que nadie se enterara hasta recargar.
        const body = await res.json().catch(() => ({}));
        if (Array.isArray(body.dropped) && body.dropped.length) {
          setStatus('status.saved_dropped');
          window.showToast?.(t.dropped_toast + body.dropped.join(', '), true);
          return;
        }

        setStatus('status.saved');
      } catch (e: any) {
        setStatus('status.error');
        window.showToast?.(`${t['status.error']}: ${e.message}`, true);
      }
    }

    function debounceSave() {
      if (!canEdit) return;
      setStatus(blockSave ? 'status.not_saved' : 'status.unsaved');
      clearTimeout(saveTimeout);
      saveTimeout = setTimeout(save, 1000);
    }

    titleInput?.addEventListener('input', debounceSave);

    // Enter en el título baja al texto, como en cualquier editor de notas.
    titleInput?.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter' && !ev.isComposing) {
        ev.preventDefault();
        editor.commands.focus('start');
      }
    });

    // Cerrar la pestaña con cambios a medio guardar los perdería.
    window.addEventListener('beforeunload', (ev) => {
      if (saveTimeout && statusSpan?.textContent === t['status.unsaved'] && !blockSave) {
        ev.preventDefault();
      }
    });

    document.getElementById('btn-delete-page')?.addEventListener('click', () => {
      // `window.forgeConfirm`, no el `confirm()` del navegador.
      //
      // Con el nativo, el navegador ofrece «impedir que esta página cree más
      // diálogos» a partir del segundo; si alguien acepta, `confirm()` empieza
      // a devolver `false` al instante y el botón deja de hacer nada **sin
      // decir nada**. Eso es lo que se vio en producción: pulsar borrar una y
      // otra vez sin efecto aparente.
      window.forgeConfirm?.(t.delete_confirm, async () => {
        const res = await fetch(`/api/pages/${pageId}`, { method: 'DELETE' });

        if (!res.ok) {
          // Sin volcar el cuerpo de la respuesta: no significa nada para quien
          // lo lee y puede traer detalles internos.
          window.showToast?.(t.delete_error, true);
          return;
        }

        // Salir de aquí **siempre**. Antes esto dependía de que la URL casara
        // con un patrón; si no casaba, la página quedaba borrada y el navegador
        // se quedaba en su dirección, que ya no existe.
        clearTimeout(saveTimeout);
        saveTimeout = undefined;
        const m = window.location.pathname.match(/^\/w\/([^/]+)/);
        window.location.href = m ? `/w/${m[1]}/p` : '/';
      });
    });

    document.getElementById('btn-share-page')?.addEventListener('click', () => {
      const url = new URL(window.location.href);
      navigator.clipboard.writeText(url.toString()).then(() => {
        if (window.showToast) window.showToast('Link copied to clipboard!');
      });
    });
  }
</script>

<style is:global>
  /* ── El documento ───────────────────────────────────────────────────────
     Tipografía de `prose`, con los ajustes que necesita un editor: menos aire
     entre bloques que en un artículo, y los párrafos vacíos con altura —son
     las líneas en blanco que se dejan a propósito y antes desaparecían—. */
  .note-content {
    min-height: 40vh;
    padding-bottom: 6rem;
    color: var(--forge-text);
    caret-color: var(--forge-accent-primary);
    font-size: 1rem;
    line-height: 1.65;
  }
  .note-content h1 { font-size: 1.625rem; font-weight: 800; font-stretch: 75%; line-height: 1.1; }
  .note-content h2 { font-size: 1.25rem; font-weight: 700; }
  .note-content h3 { font-size: 1rem; font-weight: 700; }
  .note-content ul:not([data-type='taskList']) { list-style: square; }
  .note-content li::marker { color: var(--forge-accent-primary); }
  .note-content p { margin: 0.25em 0; min-height: 1.6em; }
  .note-content :where(h1, h2, h3) { margin-top: 1.2em; margin-bottom: 0.2em; color: var(--forge-text); }
  .note-content :where(ul, ol) { margin: 0; padding-left: 1.5em; }
  .note-content li { margin: 0.15em 0; }
  .note-content li > p { margin: 0; }
  .note-content blockquote {
    border-left: 3px solid var(--forge-border-strong);
    background: transparent;
    padding: 0.5em 1em;
    margin: 0.75em 0;
    font-style: normal;
    color: var(--forge-text);
  }
  .note-content blockquote p::before,
  .note-content blockquote p::after { content: none; }
  .note-content hr { border-color: var(--forge-border); margin: 1.5em 0; }
  .note-content a { color: var(--forge-accent-text); text-decoration: underline; cursor: text; }

  /* Resaltado: tinte del naranja con el texto en tinta. Blanco sobre el
     naranja de relleno no llega a 4,5:1. */
  .note-content mark {
    background-color: color-mix(in srgb, var(--forge-accent-primary) 28%, transparent);
    color: var(--forge-text);
    padding: 0.1rem 0.2rem;
    border-radius: 3px;
  }

  /* El plugin de typography inserta comillas invertidas alrededor de <code>.
     Con el chip ya delimitado por fondo y borde, sobran. */
  .note-content :where(code)::before,
  .note-content :where(code)::after { content: none !important; }
  .note-content :not(pre) > code {
    color: var(--forge-text);
    background-color: var(--forge-surface-2);
    border: 0;
    padding: 0.05rem 0.3rem;
    border-radius: 6px;
    font-size: 0.86em;
    font-weight: 400;
    font-family: var(--forge-mono);
  }
  .note-content pre {
    background: var(--forge-surface-2);
    color: var(--forge-text);
    border: 0;
    border-left: 3px solid var(--forge-border-strong);
    border-radius: 0;
    padding: 0.75em 0.875em;
    font-size: 0.8125rem;
    line-height: 1.6;
    font-family: var(--forge-mono);
  }
  .note-content pre code { background: none; border: 0; padding: 0; color: inherit; }

  /* Listas de tareas: la casilla a la izquierda y el texto tachado al marcar. */
  .note-content ul[data-type='taskList'] { list-style: none; padding-left: 0.25em; }
  .note-content ul[data-type='taskList'] li { display: flex; align-items: flex-start; gap: 0.5em; }
  .note-content ul[data-type='taskList'] li > label { flex: none; margin-top: 0.3em; user-select: none; }
  .note-content ul[data-type='taskList'] li > div { flex: 1; min-width: 0; }
  .note-content ul[data-type='taskList'] input[type='checkbox'] {
    width: 1em; height: 1em;
    accent-color: var(--forge-accent-primary);
    cursor: pointer;
  }
  .note-content ul[data-type='taskList'] li[data-checked='true'] > div { text-decoration: line-through; color: var(--forge-muted); }

  /* Tablas, con la paleta del tema. Las de Editor.js traían la suya, clara, y
     en tema oscuro quedaban a 1.17:1 de contraste. */
  .note-content table { border-collapse: collapse; width: 100%; margin: 0.75em 0; table-layout: fixed; }
  .note-content :where(td, th) {
    border: 1px solid var(--forge-border);
    padding: 0.4em 0.6em;
    vertical-align: top;
    color: var(--forge-text);
  }
  .note-content th { background: var(--forge-surface-2); font-weight: 650; text-align: left; }
  .note-content .selectedCell { background: color-mix(in srgb, var(--forge-accent-primary) 15%, transparent); }

  /* Texto de ayuda de la línea vacía. Va con el color atenuado del tema, sin
     opacidad: bajarla lo sacaría del umbral de contraste. */
  .note-content p.is-editor-empty:first-child::before,
  .note-content .is-empty::before {
    content: attr(data-placeholder);
    color: var(--forge-muted);
    float: left;
    height: 0;
    pointer-events: none;
  }

  .note-content .ProseMirror-selectednode { outline: 2px solid var(--forge-accent-primary); outline-offset: 2px; border-radius: 4px; }
  /* La selección con el color de acento y texto blanco, como antes: con un
     fondo translúcido el texto quedaba por debajo del contraste exigido. */
  .note-content ::selection,
  .note-content *::selection {
    background-color: var(--forge-accent-primary);
    color: var(--forge-on-accent);
  }

  /* Línea que marca dónde caerá un bloque al soltarlo. */
  .ProseMirror-dropcursor { background: var(--forge-accent-primary); }

  /* ── Asa de arrastre ──────────────────────────────────────────────────── */
  .note-drag-handle {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 22px;
    margin-top: -3px;
    border-radius: 4px;
    color: var(--forge-muted);
    cursor: grab;
    visibility: hidden;
    z-index: 10;
  }
  .note-drag-handle.is-visible { visibility: visible; }
  .note-drag-handle:hover { background: var(--forge-panel); color: var(--forge-text); }
  .note-drag-handle:active { cursor: grabbing; }
  /* Sin ratón no hay hover que la enseñe ni arrastre que hacer. */
  @media (hover: none) { .note-drag-handle { display: none; } }

  /* ── Menús flotantes ─────────────────────────────────────────────────────
     Los coloca Tiptap; empiezan escondidos para que no parpadeen al cargar. */
  /* `width: max-content` y `position: absolute` desde el principio: Tiptap
     los pone él, pero **después** de calcular la posición, así que en el
     primer cálculo el menú medía lo que su contenedor y salía descentrado. */
  .note-floating-menu {
    position: absolute;
    width: max-content;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    background: var(--forge-panel);
