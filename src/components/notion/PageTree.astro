---
import { useTranslations } from '../../i18n/ui';
import db from '../../lib/db';
import PageTreeItem from './PageTreeItem.astro';
import { checkWorkspaceAccess } from '../../lib/guard';
import { paginasDeEspacio } from '../../lib/consultas';

interface Props {
  workspaceId: string;
  sysTag: string;
  currentPageId?: string;
}

const { workspaceId, sysTag, currentPageId } = Astro.props;
const user = Astro.locals.user!;
const t = useTranslations(Astro.locals.lang || 'en');
if (!user) return new Response('Unauthorized', { status: 401 });

// Check access (viewer minimum)
const access = checkWorkspaceAccess(user.id, user.is_sysadmin, workspaceId, 'viewer');
if (!access.granted) return new Response(access.error, { status: 403 });

// One single query for the whole tree
const pages = paginasDeEspacio(workspaceId);

const childrenMap = new Map<string, any[]>();
const rootPages: any[] = [];

for (const p of pages) {
  if (!p.parent_page_id) {
    rootPages.push(p);
  } else {
    if (!childrenMap.has(p.parent_page_id)) childrenMap.set(p.parent_page_id, []);
    childrenMap.get(p.parent_page_id)!.push(p);
  }
}
// Mover y crear exigen ser editor; el servidor lo comprueba igualmente.
const canEdit = checkWorkspaceAccess(user.id, user.is_sysadmin, workspaceId, 'editor').granted;

// Todas las notas en orden de árbol, con su profundidad, para el desplegable
// de «Mover a…». Con tope de profundidad por si la base trajera un ciclo.
const enOrden: Array<{ id: string; title: string; depth: number }> = [];
const recorrer = (lista: any[], depth: number) => {
  if (depth > 50) return;
  for (const p of lista) {
    enOrden.push({ id: p.id, title: p.title, depth });
    recorrer(childrenMap.get(p.id) || [], depth + 1);
  }
};
recorrer(rootPages, 0);

const textosArbol = {
  move_error: t('kb.tree.move_error'),
  move_cycle: t('kb.tree.move_cycle'),
};
---

{/*
  En móvil el árbol es un **cajón**, no una columna.

  Era un `w-64` con `m-4`: 288 px fijos que en una pantalla de 360 dejaban 72
  para el editor, y menos su propio padding, **ocho píxeles de área de
  escritura**. La base de conocimiento estaba, literalmente, inutilizable en un
  teléfono.

  Fuera de pantalla por defecto y superpuesto al abrirse, en vez de empujar el
  contenido: el editor necesita el ancho entero, y en un móvil no se lee el
  índice y el texto a la vez.
*/}
<aside
  id="page-tree-aside"
  data-workspace-id={workspaceId}
  data-can-edit={canEdit.toString()}
  data-texts={JSON.stringify(textosArbol)}
  class="fixed md:relative inset-y-0 left-0 z-40 w-72 md:w-64 max-w-[85vw] bg-forge-bg max-md:bg-forge-panel border-r border-forge-border flex flex-col h-full md:shrink-0 -translate-x-full md:translate-x-0 transition-transform md:transition-all duration-300"
>
  {/* Árbol sin caja (docs/rediseno/notas.html): una columna con su línea a
      la derecha, filas en píldora y la abierta en un tinte. */}
  <div class="px-3 pt-4 pb-2 flex items-center justify-between">
    <h2 class="text-base font-extrabold narrow text-forge-text pl-1.5 transition-opacity duration-300" id="page-tree-title">
      <a href={`/w/${sysTag}/p`} class="hover:underline underline-offset-2">{t('sidebar.knowledge')}</a>
    </h2>
    <div class="flex items-center gap-0.5">
      <button id="btn-new-root-page" class="btn btn-ghost btn-sm" title={t('kb.new_page')} aria-label={t('kb.new_page')}>
        <span class="max-md:hidden" aria-hidden="true">{t('kb.new_short')}</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
      </button>
      <button id="btn-toggle-tree" class="btn btn-ghost btn-icon btn-sm" title={t('kb.tree.collapse')} aria-label={t('kb.tree.collapse')}>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><path d="M9 3v18"/></svg>
      </button>
    </div>
  </div>
  
  <div class="flex-1 overflow-y-auto px-2 pb-4">
    <ul id="page-tree-root" class="space-y-px">
      {rootPages.length === 0 ? (
        <li class="px-3 py-4 text-sm text-forge-muted">{t('kb.no_pages')}</li>
      ) : (
        rootPages.map(page => (
          <PageTreeItem page={page} childrenMap={childrenMap} currentPageId={currentPageId} sys_tag={sysTag} canEdit={canEdit} t={t} />
        ))
      )}
    </ul>
  </div>
</aside>

{/* Cierra el cajón al pulsar fuera. Sin esto, en un móvil hay que acertar con
    el botón para volver al texto. */}
<div id="page-tree-backdrop" class="fixed inset-0 bg-[var(--forge-scrim)] z-30 hidden md:hidden"></div>

{/* «Mover a…»: la forma de mover una nota sin arrastrar, con teclado o en un
    teléfono. Va al final del destino elegido; para colocarla en un sitio
    concreto entre sus hermanas está el arrastre. */}
{canEdit && (
  <dialog id="move-page-dialog" class="ventana !p-0">
    <form method="dialog" id="move-page-form" class="p-5 flex flex-col gap-4">
      <h2 class="ventana-titulo !mb-0" id="move-page-title">{t('kb.tree.move')}</h2>
      <label class="field">
        <span class="field-label">{t('kb.tree.move_to')}</span>
        <select id="move-page-target" class="campo">
          <option value="">{t('kb.tree.move_root')}</option>
          {enOrden.map((p) => (
            <option value={p.id}>{'\u00a0\u00a0'.repeat(p.depth + 1) + p.title}</option>
          ))}
        </select>
      </label>
      <div class="flex justify-end gap-2">
        <button type="button" id="move-page-cancel" class="btn btn-ghost">{t('kb.tree.cancel')}</button>
        <button type="submit" id="move-page-submit" class="btn btn-primary">{t('kb.tree.move_submit')}</button>
      </div>
    </form>
  </dialog>
)}

{/* El botón que abre este cajón vive en la fila del título del editor
    (`EditorClient.astro`), no aquí. Estuvo flotando y chocó con el contenido
    las dos veces que se intentó — abajo se salía de la pantalla, arriba tapaba
    el título. El manejador sigue aquí abajo porque el cajón es de este
    componente; lo busca por id. */}

<script>
  const asideArbol = document.getElementById('page-tree-aside');
  const raizArbol = document.getElementById('page-tree-root');
  const espacioId = asideArbol?.dataset.workspaceId ?? '';
  const puedeEditar = asideArbol?.dataset.canEdit === 'true';
  const textosArbol: Record<string, string> = JSON.parse(asideArbol?.dataset.texts || '{}');

  /**
   * Qué carpetas están abiertas, recordado entre páginas.
   *
   * Cada nota es una página entera, así que el árbol se pintaba de cero en
   * cada clic y se cerraba todo lo que se hubiera abierto: para repasar varias
   * notas de una carpeta había que volver a abrirla cada vez.
   *
   * Va en `localStorage` por espacio: es una preferencia de esta persona en
   * este navegador, no algo que tenga que saber el servidor. Si el
   * almacenamiento no está disponible (modo privado estricto), el árbol
   * funciona igual, solo que sin memoria.
   */
  const CLAVE_ABIERTAS = `forge:arbol-abierto:${espacioId}`;
  const leerAbiertas = (): Set<string> => {
    try {
      return new Set(JSON.parse(localStorage.getItem(CLAVE_ABIERTAS) || '[]'));
    } catch {
      return new Set();
    }
  };
  const abiertas = leerAbiertas();
  const guardarAbiertas = () => {
    try {
      localStorage.setItem(CLAVE_ABIERTAS, JSON.stringify([...abiertas]));
    } catch {}
  };

  const abrirCarpeta = (li: Element, abrir: boolean) => {
    li.classList.toggle('expanded', abrir);
    li.querySelector(':scope > ul')?.classList.toggle('hidden', !abrir);
    li.querySelector(':scope > div .tree-toggle')?.setAttribute('aria-expanded', String(abrir));
  };

  // Lo recordado, más la nota actual y todo lo que hay por encima: al entrar
  // en una nota se ven sus subpáginas y dónde está.
  raizArbol?.querySelectorAll<HTMLElement>('li.tree-item').forEach((li) => {
    if (abiertas.has(li.dataset.pageId ?? '')) abrirCarpeta(li, true);
  });
  const actual = raizArbol?.querySelector('a[aria-current="page"]')?.closest('li.tree-item');
  for (let li: Element | null | undefined = actual; li; li = li.parentElement?.closest('li.tree-item')) {
    abrirCarpeta(li, true);
    abiertas.add((li as HTMLElement).dataset.pageId ?? '');
  }
  guardarAbiertas();

  raizArbol?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.tree-toggle');
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();
    const li = btn.closest<HTMLElement>('li.tree-item');
    if (!li) return;
    const abrir = !li.classList.contains('expanded');
    abrirCarpeta(li, abrir);
    const id = li.dataset.pageId ?? '';
    if (abrir) abiertas.add(id);
    else abiertas.delete(id);
    guardarAbiertas();
  });

  /** Pide al servidor mover la nota y recarga el árbol. */
  async function mover(paginaId: string, padreId: string | null, indice: number) {
    const res = await fetch(`/api/pages/${paginaId}/move`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ parent_id: padreId, index: indice }),
    });
    if (!res.ok) {
      const cuerpo = await res.json().catch(() => ({}));
      window.showToast?.(cuerpo.error === 'cycle' ? textosArbol.move_cycle : textosArbol.move_error, true);
      return;
    }
    // Que el destino quede abierto: es donde se va a mirar a continuación.
    if (padreId) {
      abiertas.add(padreId);
      guardarAbiertas();
    }
    window.location.reload();
  }

  /** Las hermanas de un `li`, sin contar la que se está moviendo. */
  const hermanasDe = (li: Element, sin: string) =>
    [...(li.parentElement?.children ?? [])].filter(
      (h) => h.matches('li.tree-item') && (h as HTMLElement).dataset.pageId !== sin
    ) as HTMLElement[];

  /**
   * Arrastrar en el árbol.
   *
   * Tres zonas en cada fila: el cuarto de arriba la coloca **antes**, el de
   * abajo **después** y el centro la mete **dentro** como subpágina. Soltar
   * una nota sobre sí misma o sobre algo que cuelga de ella no hace nada; el
   * servidor lo rechazaría igual.
   */
  if (puedeEditar && raizArbol) {
    let arrastrada: HTMLElement | null = null;
    type Zona = 'antes' | 'despues' | 'dentro';
    let destino: { li: HTMLElement; zona: Zona } | null = null;

    const limpiar = () => {
      raizArbol.querySelectorAll('.drop-antes, .drop-despues, .drop-dentro').forEach((el) =>
        el.classList.remove('drop-antes', 'drop-despues', 'drop-dentro')
      );
    };

    raizArbol.addEventListener('dragstart', (e) => {
      const fila = (e.target as HTMLElement).closest('.tree-row');
      const li = fila?.closest<HTMLElement>('li.tree-item');
      if (!fila || !li || !e.dataTransfer) return;
      arrastrada = li;
      e.dataTransfer.effectAllowed = 'move';
      e.dataTransfer.setData('text/plain', li.dataset.pageId ?? '');
      li.classList.add('is-dragging');
    });

    raizArbol.addEventListener('dragover', (e) => {
      if (!arrastrada) return;
      const fila = (e.target as HTMLElement).closest<HTMLElement>('.tree-row');
      const li = fila?.closest<HTMLElement>('li.tree-item');
      limpiar();
      destino = null;
      // Sobre sí misma o sobre una de sus subpáginas: no se puede soltar.
      if (!fila || !li || arrastrada.contains(li)) return;

      e.preventDefault();
      if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
      const caja = fila.getBoundingClientRect();
      const y = (e.clientY - caja.top) / caja.height;
      const zona: Zona = y < 0.25 ? 'antes' : y > 0.75 ? 'despues' : 'dentro';
      fila.classList.add(`drop-${zona}`);
      destino = { li, zona };
    });

    raizArbol.addEventListener('drop', (e) => {
      e.preventDefault();
      const quien = arrastrada;
      const donde = destino;
      limpiar();
      if (!quien || !donde) return;
      const id = quien.dataset.pageId ?? '';

      if (donde.zona === 'dentro') {
        // Al final de sus subpáginas; el servidor ajusta el índice.
        mover(id, donde.li.dataset.pageId ?? null, Number.MAX_SAFE_INTEGER);
        return;
      }
      const padre = donde.li.dataset.parentId || null;
      const hermanas = hermanasDe(donde.li, id);
      const i = hermanas.indexOf(donde.li);
      mover(id, padre, donde.zona === 'antes' ? i : i + 1);
    });

    raizArbol.addEventListener('dragend', () => {
      arrastrada?.classList.remove('is-dragging');
      arrastrada = null;
      destino = null;
      limpiar();
    });
  }

  /**
   * «Mover a…»: el mismo movimiento sin arrastrar. Se desactivan en la lista la
   * propia nota y lo que cuelga de ella, que son los destinos imposibles.
   */
  (() => {
    const dialogo = document.getElementById('move-page-dialog') as HTMLDialogElement | null;
    const lista = document.getElementById('move-page-target') as HTMLSelectElement | null;
    const titulo = document.getElementById('move-page-title');
    const formulario = document.getElementById('move-page-form') as HTMLFormElement | null;
    if (!dialogo || !lista || !formulario || !raizArbol) return;
    const tituloBase = titulo?.textContent ?? '';
    let moviendo: string | null = null;

    raizArbol.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('.move-tree-page-btn');
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();
      const li = btn.closest<HTMLElement>('li.tree-item');
      if (!li) return;
      moviendo = li.dataset.pageId ?? null;

      const imposibles = new Set(
        [li, ...li.querySelectorAll<HTMLElement>('li.tree-item')].map((x) => x.dataset.pageId)
      );
      for (const op of lista.options) op.disabled = imposibles.has(op.value);
      // Preseleccionar donde está ahora, para que «Mover» sin tocar nada no
      // la mande a otra parte.
      lista.value = li.dataset.parentId ?? '';
      if (titulo) {
        const nombre = li.querySelector(':scope > div .tree-title')?.textContent?.trim() ?? '';
        titulo.textContent = `${tituloBase}: ${nombre}`;
      }
      dialogo.showModal();
      lista.focus();
    });

    document.getElementById('move-page-cancel')?.addEventListener('click', () => dialogo.close());

    formulario.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!moviendo) return;
      dialogo.close();
      const li = raizArbol.querySelector<HTMLElement>(`li.tree-item[data-page-id="${CSS.escape(moviendo)}"]`);
      // Mismo sitio que ya tenía: no hay nada que mover. Sin esto, aceptar el
      // diálogo sin cambiar nada la mandaba al final de su nivel.
      if ((li?.dataset.parentId ?? '') === lista.value) return;
      mover(moviendo, lista.value || null, Number.MAX_SAFE_INTEGER);
    });
  })();

  // Create page logic
  async function createPage(parentId: string | null) {
    const sysTagMatch = window.location.pathname.match(/^\/w\/([^/]+)/);
    const sysTag = sysTagMatch ? sysTagMatch[1] : '';
    
    // We need the workspace UUID. We can get it from the dataset.
    const aside = document.getElementById('page-tree-aside');
    const workspaceId = aside?.getAttribute('data-workspace-id');

    const res = await fetch('/api/pages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ title: 'Untitled', parent_page_id: parentId, workspace_id: workspaceId })
    });
    if (res.ok) {
      const data = await res.json();
      // Wait for sysTag from URL
      const sysTagMatch = window.location.pathname.match(/^\/w\/([^/]+)/);
      const sysTag = sysTagMatch ? sysTagMatch[1] : '';
      if (sysTag) {
        window.location.href = `/w/${sysTag}/p/${data.id}`;
      }
    } else {
      console.error('crear página:', await res.text());
      window.showToast?.(window.forgeMsg?.errCrearPagina || '', true);
    }
  }

  document.getElementById('btn-new-root-page')?.addEventListener('click', () => createPage(null));
  
  document.querySelectorAll('.add-child-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const parentId = btn.getAttribute('data-parent-id');
      if (parentId) createPage(parentId);
    });
  });

  document.querySelectorAll('.delete-tree-page-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const id = btn.getAttribute('data-id');
      if (!id) return;
      
      // @ts-ignore
      window.forgeConfirm(window.forgeMsg?.confirmarBorrarPagina || '', async () => {
        const res = await fetch(`/api/pages/${id}`, { method: 'DELETE' });
        if (res.ok) {
          // Check if we are currently on the deleted page
          const sysTagMatch = window.location.pathname.match(/^\/w\/([^/]+)/);
          const sysTag = sysTagMatch ? sysTagMatch[1] : '';
          if (window.location.pathname.includes(`/p/${id}`)) {
            window.location.href = `/w/${sysTag}/p`;
          } else {
            window.location.reload();
          }
        } else {
          // @ts-ignore
          console.error('borrar página:', await res.text());
          window.showToast?.(window.forgeMsg?.errBorrarPagina || '', true);
        }
      });
    });
  });

  /**
   * El cajón en móvil.
   *
   * El colapso de escritorio —de 256 px a 64— no sirve aquí: 64 px siguen
   * siendo un quinto de la pantalla para algo que solo se mira al cambiar de
   * página. En móvil el árbol está fuera y se trae encima cuando hace falta.
   */
  (() => {
    const cajon = document.getElementById('page-tree-aside');
    const fondo = document.getElementById('page-tree-backdrop');
    const abrir = document.getElementById('btn-open-tree');
    if (!cajon || !fondo || !abrir) return;

    const mostrar = (si: boolean) => {
      cajon.classList.toggle('-translate-x-full', !si);
      fondo.classList.toggle('hidden', !si);
      abrir.setAttribute('aria-expanded', String(si));
      // Con el cajón abierto, el fondo no debe poder desplazarse: es lo que
      // hace que al cerrarlo se haya perdido el sitio donde se estaba leyendo.
      document.body.style.overflow = si ? 'hidden' : '';
    };

    abrir.addEventListener('click', () => mostrar(true));
    fondo.addEventListener('click', () => mostrar(false));

    // Escape cierra, como cualquier otra cosa que se superpone.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !fondo.classList.contains('hidden')) mostrar(false);
    });

    // Al elegir una página el cajón sobra: lo siguiente es leerla.
    cajon.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) mostrar(false);
    });
  })();

  // Toggle PageTree Sidebar logic
  const toggleBtn = document.getElementById('btn-toggle-tree');
  const aside = document.getElementById('page-tree-aside');
  const title = document.getElementById('page-tree-title');
  const newRootBtn = document.getElementById('btn-new-root-page');
  const treeRoot = document.getElementById('page-tree-root');

  let isCollapsed = false;
  toggleBtn?.addEventListener('click', () => {
    // En móvil este botón cierra el cajón, no lo encoge: un árbol de 64 px no
    // es útil, es un trozo de pantalla ocupado.
    if (window.matchMedia('(max-width: 767px)').matches) {
      aside?.classList.add('-translate-x-full');
      document.getElementById('page-tree-backdrop')?.classList.add('hidden');
      document.body.style.overflow = '';
      return;
    }

    isCollapsed = !isCollapsed;
    if (isCollapsed) {
      aside?.classList.remove('w-64');
      aside?.classList.add('w-16');
      title?.classList.add('opacity-0', 'pointer-events-none', 'w-0', 'overflow-hidden');
      if (newRootBtn) newRootBtn.style.display = 'none';
      if (treeRoot) treeRoot.style.display = 'none';
      toggleBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>';
    } else {
      aside?.classList.remove('w-16');
      aside?.classList.add('w-64');
      title?.classList.remove('opacity-0', 'pointer-events-none', 'w-0', 'overflow-hidden');
      if (newRootBtn) newRootBtn.style.display = 'flex';
      if (treeRoot) treeRoot.style.display = 'block';
      toggleBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>';
    }
  });
</script>

<style>
  /* Dónde caerá la nota al soltarla: una línea antes o después de la fila,
     o la fila entera resaltada si va dentro. Color de acento a pleno, sin
     opacidad, como el resto de indicadores. */
  :global(.tree-row.drop-antes) { box-shadow: inset 0 2px 0 var(--forge-text); }
  :global(.tree-row.drop-despues) { box-shadow: inset 0 -2px 0 var(--forge-text); }
  :global(.tree-row.drop-dentro) { outline: 2px dashed var(--forge-text); outline-offset: -2px; }
  :global(li.tree-item.is-dragging > .tree-row) { opacity: 0.5; }
  :global(.tree-row[draggable='true']) { cursor: grab; }
</style>
