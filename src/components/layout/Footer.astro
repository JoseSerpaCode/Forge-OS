---
import { useTranslations } from '../../i18n/ui';
import pkg from '../../../package.json';
const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);
// Leída de package.json: escrita a mano se queda obsoleta en la siguiente release.
const version = pkg.version;
---
<footer class="mt-auto shrink-0 w-full border-t border-forge-border/40 relative overflow-hidden">
  <!-- Subtle gradient accent line at the top -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-forge-primary to-transparent opacity-40"></div>

  <div class="max-w-[1440px] mx-auto px-6 pt-14 pb-8">
    <div class="flex flex-col lg:flex-row justify-between gap-12 mb-12">
      <!-- Brand block -->
      <div class="lg:max-w-xs space-y-5">
        <a href="/" class="inline-flex items-center gap-3 group cursor-pointer">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-forge-secondary to-forge-primary flex items-center justify-center font-black text-white text-lg shadow-[0_0_15px_rgba(255,93,0,0.3)] group-hover:scale-105 group-hover:shadow-[0_0_20px_rgba(255,93,0,0.5)] transition-all">
            F
          </div>
          <span class="text-2xl font-black text-forge-text tracking-tight group-hover:text-forge-accent-text transition-colors">Forge</span>
        </a>
        <p class="text-sm text-forge-muted leading-relaxed">
          {t('footer.description')}
        </p>
        <!-- Open Source badge -->
        <a href="https://github.com/JoseSerpaCode/Forge-js" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-forge-border/50 text-xs text-forge-muted hover:text-forge-text hover:border-forge-primary/40 transition-all group/badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover/badge:text-forge-primary transition-colors"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          <span>MIT License</span>
          <span class="text-forge-muted">·</span>
          <span>v{version}</span>
        </a>
      </div>
      
      <!-- Link columns -->
      <div class="grid grid-cols-3 gap-12 lg:gap-20 w-full lg:w-auto">
        <div>
          <h3 class="font-semibold text-forge-text mb-5 text-xs uppercase tracking-wider">{t('footer.opensource')}</h3>
          <ul class="space-y-3">
            <li><a href="https://github.com/JoseSerpaCode/Forge-js#readme" target="_blank" rel="noopener noreferrer" class="footer-link">{t('footer.opensource.readme')}</a></li>
            <li><a href="https://github.com/JoseSerpaCode/Forge-js/issues" target="_blank" rel="noopener noreferrer" class="footer-link">{t('footer.opensource.issues')}</a></li>
            <li><a href="https://github.com/JoseSerpaCode/Forge-js/releases" target="_blank" rel="noopener noreferrer" class="footer-link">{t('footer.opensource.releases')}</a></li>
          </ul>
        </div>

        <div>
          <h3 class="font-semibold text-forge-text mb-5 text-xs uppercase tracking-wider">{t('footer.resources')}</h3>
          <ul class="space-y-3">
            <li><a href="https://github.com/JoseSerpaCode/Forge-js/commits/main" target="_blank" rel="noopener noreferrer" class="footer-link">{t('footer.resources.changelog')}</a></li>
            <li><a href="https://github.com/JoseSerpaCode/Forge-js#tech-stack" target="_blank" rel="noopener noreferrer" class="footer-link">{t('footer.resources.techstack')}</a></li>
          </ul>
        </div>

        <div>
          <h3 class="font-semibold text-forge-text mb-5 text-xs uppercase tracking-wider">{t('footer.legal')}</h3>
          <ul class="space-y-3">
            <li><a href="https://github.com/JoseSerpaCode/Forge-js/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="footer-link">{t('footer.legal.license')}</a></li>
            <li><a href="https://github.com/JoseSerpaCode/Forge-js/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer" class="footer-link">{t('footer.legal.contributing')}</a></li>
            <li><a href="https://github.com/JoseSerpaCode/Forge-js/security" target="_blank" rel="noopener noreferrer" class="footer-link">{t('footer.legal.security')}</a></li>
          </ul>
        </div>
      </div>
    </div>
    
    <!-- Bottom bar -->
    <div class="pt-6 border-t border-forge-border/20 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-forge-muted">
        {t('footer.built_by')}
      </p>
      <div class="flex items-center gap-3">
        <a href="https://github.com/JoseSerpaCode/Forge-js" target="_blank" rel="noopener noreferrer" class="text-forge-muted hover:text-forge-primary transition-colors" title="GitHub Repository">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        </a>
        <a href="mailto:joseserpamedinaxd@gmail.com" class="text-forge-muted hover:text-forge-primary transition-colors" title="Contact Email">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    font-size: 0.8125rem;
    color: var(--forge-muted);
    transition: color 0.2s, transform 0.2s;
    display: inline-block;
  }
  .footer-link:hover {
    color: var(--forge-text);
    transform: translateX(3px);
  }
</style>
