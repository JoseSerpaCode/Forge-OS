---
/**
 * Pie de la aplicación, el de «Taller» (`site-foot` en la maqueta): una sola
 * línea. Antes eran tres columnas de enlaces con títulos en mayúsculas y una
 * línea de degradado, debajo de cada pantalla de trabajo; aquí solo tiene que
 * decir qué versión corre y dónde está el código.
 */
import Logo from '../brand/Logo.astro';
import { useTranslations } from '../../i18n/ui';
import pkg from '../../../package.json';
const t = useTranslations(Astro.locals.lang || 'en');
const REPO = 'https://github.com/JoseSerpaCode/Forge-OS';
---
<footer class="mt-auto shrink-0 w-full border-t border-forge-border">
  <div class="max-w-[1440px] mx-auto px-6 py-5 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-forge-muted">
    <Logo href="/" size="sm" />
    <span>{t('pie.licencia')}</span>
    <nav aria-label={t('foot.nav')} class="flex flex-wrap gap-x-5 gap-y-2">
      {/* Estando dentro no había forma de volver a la portada: `/` sirve el
          hub en cuanto hay sesión. Este enlace la abre igualmente. */}
      <a href="/welcome" class="pie-enlace">{t('pie.portada')}</a>
      <a href={REPO} target="_blank" rel="noopener noreferrer" class="pie-enlace">{t('pie.codigo')}</a>
      <a href={`${REPO}/blob/main/CHANGELOG.md`} target="_blank" rel="noopener noreferrer" class="pie-enlace">{t('pie.cambios')}</a>
      <a href={`${REPO}/issues`} target="_blank" rel="noopener noreferrer" class="pie-enlace">{t('pie.avisar')}</a>
    </nav>
    <span class="ml-auto font-mono text-xs">v{pkg.version}</span>
  </div>
</footer>

<style>
  .pie-enlace { color: var(--forge-muted); }
  .pie-enlace:hover { color: var(--forge-text); text-decoration: underline; }
</style>
