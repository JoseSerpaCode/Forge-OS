---
// src/components/dashboard/TaskTable.astro
/**
 * `tipos` resuelve la clave que guarda cada ticket a su nombre y su color.
 *
 * La columna `issues.type` guarda una clave (`task`, `incidencia`). Aquí se
 * pintaba tal cual —`{task.type || 'task'}`— así que salía «task» en minúscula
 * sin traducir, y un tipo propio salía con su clave interna en vez de con el
 * nombre que le puso el equipo.
 *
 * Lo resuelve quien llama, no este componente: en el hub las tareas vienen de
 * varios espacios y cada uno tiene sus tipos, así que la búsqueda es por
 * espacio. `lib/issueTypes.mapaPorClave()` existía justamente para esto y no la
 * usaba nadie.
 */
interface Props {
  tasks: any[];
  sys_tag?: string;
  emptyMessage?: string;
  tipos?: Map<string, { key: string; name: string; color: string; isBuiltin: boolean }>;
  /** Etiquetas por id de ticket. Se leen en lote fuera, no una por fila. */
  etiquetas?: Map<string, Array<{ id: string; name: string; color: string }>>;
}
const { tasks, sys_tag, emptyMessage, tipos, etiquetas } = Astro.props as Props;

import { useTranslations } from '../../i18n/ui';
import { nombreVisible } from '../../lib/issueTypes';
import { fecha } from '../../lib/fechas';
import LabelChip from '../labels/LabelChip.astro';
const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);

const tipoDe = (task: any) => tipos?.get(`${task.workspace_id ?? ''}:${task.type}`) ?? tipos?.get(task.type) ?? null;

import { info as infoEstado } from '../../lib/status';
---

<div class="task-table-container overflow-x-auto w-full">
  <table class="tabla whitespace-nowrap">
    <thead>
      <tr>
        <th class="cursor-pointer hover:text-forge-text sort-header select-none" data-sort="type">{t('table.type')} <span class="sort-indicator inline-block w-3"></span></th>
        <th class="cursor-pointer hover:text-forge-text sort-header select-none" data-sort="name">{t('table.name')} <span class="sort-indicator inline-block w-3"></span></th>
        <th class="cursor-pointer hover:text-forge-text sort-header select-none" data-sort="date">{t('table.due_date')} <span class="sort-indicator inline-block w-3"></span></th>
        <th class="cursor-pointer hover:text-forge-text sort-header select-none" data-sort="status">{t('table.status')} <span class="sort-indicator inline-block w-3"></span></th>
      </tr>
    </thead>
    <tbody class="task-table-body">
      {(!tasks || tasks.length === 0) ? (
        <tr>
          <td colspan="4" class="!py-8 text-center text-forge-muted">
            <p>{emptyMessage || t('dashboard.no_tasks')}</p>
          </td>
        </tr>
      ) : (
        tasks.map((task: any) => {
          const href = task.sys_tag 
            ? `/w/${task.sys_tag}/board?sprint=${task.sprint_id || 'backlog'}&issue=${task.id}` 
            : `/w/${sys_tag}/board?sprint=${task.sprint_id || 'backlog'}&issue=${task.id}`;
          
          return (
            <tr class="group cursor-pointer task-row" data-href={href} data-type={task.type || 'task'} data-name={task.title} data-date={task.due_date || ''} data-status={task.status}>
              <td class="w-28">
                {(() => {
                  const ti = tipoDe(task);
                  // El nombre de un tipo de fábrica se traduce; el de uno propio
                  // no, porque lo escribió alguien. Sin tipo resuelto se enseña
                  // la clave, que es fea pero es información.
                  const nombre = ti
                    ? nombreVisible(ti, t)
                    : (task.type || 'task');
                  return (
                    <span class="tarjeta-meta">
                      {ti && <span class="sw" style={`--c:${ti.color}`} aria-hidden="true"></span>}
                      {nombre}
                    </span>
                  );
                })()}
              </td>
              <td class="titulo max-w-[18rem] truncate">
                <a href={href} class="text-forge-text block truncate group-hover:underline underline-offset-2" onclick="event.stopPropagation();">
                  {task.title}
                </a>
                {/* Las etiquetas, debajo del título.

                    Van aquí y no en una columna propia porque la tabla ya
                    tiene cuatro y en el hub compiten con el nombre, que es lo
                    que se lee. Es el mismo sitio que ocupan en la tarjeta del
                    tablero, así que la misma tarea se reconoce igual en los
                    dos sitios. */}
                {etiquetas?.get(task.id)?.length ? (
                  <div class="flex flex-wrap gap-1 mt-1">
                    {etiquetas.get(task.id)!.map((e) => <LabelChip name={e.name} color={e.color} size="sm" />)}
                  </div>
                ) : null}
              </td>
              <td class="due">
                {task.due_date ? fecha(task.due_date, lang) : '—'}
              </td>
              <td class="w-32">
                <span class="estado-chip" style={`--c:${infoEstado(task.status).color}`}>
                  {/*
                    Sin `|| respaldo`: `useTranslations` devuelve **la clave**
                    cuando no la encuentra, y una clave es una cadena no vacía,
                    así que el respaldo no entraba nunca y lo que se veía era
                    `status.review`. Ahora la clave tiene que existir, y hay una
                    prueba que lo comprueba enumerando las columnas del tablero.
                  */}
                  {t(infoEstado(task.status).i18n)}
                </span>
              </td>
            </tr>
          );
        })
      )}
    </tbody>
  </table>
</div>

<script>
  document.querySelectorAll('.task-table-container').forEach(container => {
    const headers = container.querySelectorAll('.sort-header');
    const tbody = container.querySelector('.task-table-body');
    if (!tbody) return;

    let currentSort = { column: '', asc: true };

    headers.forEach(header => {
      header.addEventListener('click', () => {
        const column = header.getAttribute('data-sort');
        if (!column) return;

        if (currentSort.column === column) {
          currentSort.asc = !currentSort.asc;
        } else {
          currentSort.column = column;
          currentSort.asc = true;
        }

        // Update indicators
        headers.forEach(h => {
          const indicator = h.querySelector('.sort-indicator');
          if (indicator) indicator.textContent = '';
        });
        const currentIndicator = header.querySelector('.sort-indicator');
        if (currentIndicator) {
          currentIndicator.textContent = currentSort.asc ? '▲' : '▼';
        }

        const rows = Array.from(tbody.querySelectorAll('.task-row'));
        
        rows.sort((a, b) => {
          let valA = a.getAttribute(`data-${column}`) || '';
          let valB = b.getAttribute(`data-${column}`) || '';

          if (column === 'date') {
            const timeA = valA ? new Date(valA).getTime() : 0;
            const timeB = valB ? new Date(valB).getTime() : 0;
            return currentSort.asc ? timeA - timeB : timeB - timeA;
          }

          valA = valA.toLowerCase();
          valB = valB.toLowerCase();

          if (valA < valB) return currentSort.asc ? -1 : 1;
          if (valA > valB) return currentSort.asc ? 1 : -1;
          return 0;
        });

        rows.forEach(row => tbody.appendChild(row));
      });
    });

    // Row click navigation
    const rows = container.querySelectorAll('.task-row');
    rows.forEach(row => {
      row.addEventListener('click', (e) => {
        // @ts-ignore
        if (e.target.tagName.toLowerCase() !== 'a') {
          const href = row.getAttribute('data-href');
          if (href) window.location.href = href;
        }
      });
    });
  });
</script>
