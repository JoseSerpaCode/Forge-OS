---
// src/components/dashboard/TaskTable.astro
/**
 * `tipos` resuelve la clave que guarda cada ticket a su nombre y su color.
 *
 * La columna `issues.type` guarda una clave (`task`, `incidencia`). Aquí se
 * pintaba tal cual —`{task.type || 'task'}`— así que salía «task» en minúscula
 * sin traducir, y un tipo propio salía con su clave interna en vez de con el
 * nombre que le puso el equipo.
 *
 * Lo resuelve quien llama, no este componente: en el hub las tareas vienen de
 * varios espacios y cada uno tiene sus tipos, así que la búsqueda es por
 * espacio. `lib/issueTypes.mapaPorClave()` existía justamente para esto y no la
 * usaba nadie.
 */
interface Props {
  tasks: any[];
  sys_tag?: string;
  emptyMessage?: string;
  tipos?: Map<string, { key: string; name: string; color: string; isBuiltin: boolean }>;
}
const { tasks, sys_tag, emptyMessage, tipos } = Astro.props as Props;

import { useTranslations } from '../../i18n/ui';
import { fecha } from '../../lib/fechas';
const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);

const tipoDe = (task: any) => tipos?.get(`${task.workspace_id ?? ''}:${task.type}`) ?? tipos?.get(task.type) ?? null;

const statusColor: Record<string, string> = {
  todo: 'bg-forge-muted/20 text-forge-muted',
  'in-progress': 'bg-forge-info/20 text-forge-info',
  'in_progress': 'bg-forge-info/20 text-forge-info',
  review: 'bg-yellow-500/20 text-forge-warning',
  done: 'bg-green-500/20 text-forge-success',
  blocked: 'bg-red-500/20 text-forge-error',
};
---

<div class="task-table-container overflow-x-auto w-full">
  <table class="w-full text-left text-sm whitespace-nowrap table-auto border-collapse">
    <thead>
      <tr class="border-b border-forge-border text-forge-muted text-xs uppercase bg-forge-panel">
        <th class="p-3 font-bold cursor-pointer hover:text-forge-text transition-colors sort-header select-none" data-sort="type">{t('table.type')} <span class="sort-indicator inline-block w-3 text-forge-accent-text"></span></th>
        <th class="p-3 font-bold cursor-pointer hover:text-forge-text transition-colors sort-header select-none" data-sort="name">{t('table.name')} <span class="sort-indicator inline-block w-3 text-forge-accent-text"></span></th>
        <th class="p-3 font-bold cursor-pointer hover:text-forge-text transition-colors sort-header select-none" data-sort="date">{t('table.due_date')} <span class="sort-indicator inline-block w-3 text-forge-accent-text"></span></th>
        <th class="p-3 font-bold cursor-pointer hover:text-forge-text transition-colors sort-header select-none" data-sort="status">{t('table.status')} <span class="sort-indicator inline-block w-3 text-forge-accent-text"></span></th>
      </tr>
    </thead>
    <tbody class="task-table-body divide-y divide-forge-border">
      {(!tasks || tasks.length === 0) ? (
        <tr>
          <td colspan="4" class="p-8 text-center text-forge-muted">
            <p>{emptyMessage || t('dashboard.no_tasks')}</p>
          </td>
        </tr>
      ) : (
        tasks.map((task: any) => {
          const href = task.sys_tag 
            ? `/w/${task.sys_tag}/board?sprint=${task.sprint_id || 'backlog'}&issue=${task.id}` 
            : `/w/${sys_tag}/board?sprint=${task.sprint_id || 'backlog'}&issue=${task.id}`;
          
          return (
            <tr class="hover:bg-forge-bg transition-colors group cursor-pointer task-row" data-href={href} data-type={task.type || 'task'} data-name={task.title} data-date={task.due_date || ''} data-status={task.status}>
              <td class="p-3 w-24">
                {(() => {
                  const ti = tipoDe(task);
                  // El nombre de un tipo de fábrica se traduce; el de uno propio
                  // no, porque lo escribió alguien. Sin tipo resuelto se enseña
                  // la clave, que es fea pero es información.
                  const nombre = ti
                    ? (ti.isBuiltin ? (t(`type.${ti.key}` as any) || ti.name) : ti.name)
                    : (task.type || 'task');
                  return (
                    <span
                      class="text-[10px] uppercase font-bold px-2 py-1 rounded border bg-forge-bg text-forge-muted shadow-sm inline-flex items-center gap-1.5"
                      style={ti ? `border-color: ${ti.color}55` : undefined}
                    >
                      {ti && <span class="w-1.5 h-1.5 rounded-full shrink-0" style={`background:${ti.color}`} aria-hidden="true"></span>}
                      {nombre}
                    </span>
                  );
                })()}
              </td>
              <td class="p-3 max-w-[250px] truncate">
                <a href={href} class="text-forge-text font-medium group-hover:text-forge-accent-text transition-colors block truncate" onclick="event.stopPropagation();">
                  {task.title}
                </a>
                <div class="text-[10px] text-forge-muted font-mono truncate mt-0.5">
                  {(task.sys_tag || sys_tag) ? `${task.sys_tag || sys_tag}-${task.id.substring(0,8)}` : task.id.substring(0,8)}
                </div>
              </td>
              <td class="p-3 text-xs text-forge-muted whitespace-nowrap">
                {task.due_date ? fecha(task.due_date, lang) : '—'}
              </td>
              <td class="p-3 w-28">
                <span class={`text-[10px] font-bold px-2 py-1 rounded-full whitespace-nowrap ${statusColor[task.status] || 'bg-forge-muted/20 text-forge-muted'}`}>
                  {/*
                    Sin `|| respaldo`: `useTranslations` devuelve **la clave**
                    cuando no la encuentra, y una clave es una cadena no vacía,
                    así que el respaldo no entraba nunca y lo que se veía era
                    `status.review`. Ahora la clave tiene que existir, y hay una
                    prueba que lo comprueba enumerando las columnas del tablero.
                  */}
                  {t(`status.${task.status?.replace('-', '_') || 'todo'}` as any)}
                </span>
              </td>
            </tr>
          );
        })
      )}
    </tbody>
  </table>
</div>

<script>
  document.querySelectorAll('.task-table-container').forEach(container => {
    const headers = container.querySelectorAll('.sort-header');
    const tbody = container.querySelector('.task-table-body');
    if (!tbody) return;

    let currentSort = { column: '', asc: true };

    headers.forEach(header => {
      header.addEventListener('click', () => {
        const column = header.getAttribute('data-sort');
        if (!column) return;

        if (currentSort.column === column) {
          currentSort.asc = !currentSort.asc;
        } else {
          currentSort.column = column;
          currentSort.asc = true;
        }

        // Update indicators
        headers.forEach(h => {
          const indicator = h.querySelector('.sort-indicator');
          if (indicator) indicator.textContent = '';
        });
        const currentIndicator = header.querySelector('.sort-indicator');
        if (currentIndicator) {
          currentIndicator.textContent = currentSort.asc ? '▲' : '▼';
        }

        const rows = Array.from(tbody.querySelectorAll('.task-row'));
        
        rows.sort((a, b) => {
          let valA = a.getAttribute(`data-${column}`) || '';
          let valB = b.getAttribute(`data-${column}`) || '';

          if (column === 'date') {
            const timeA = valA ? new Date(valA).getTime() : 0;
            const timeB = valB ? new Date(valB).getTime() : 0;
            return currentSort.asc ? timeA - timeB : timeB - timeA;
          }

          valA = valA.toLowerCase();
          valB = valB.toLowerCase();

          if (valA < valB) return currentSort.asc ? -1 : 1;
          if (valA > valB) return currentSort.asc ? 1 : -1;
          return 0;
        });

        rows.forEach(row => tbody.appendChild(row));
      });
    });

    // Row click navigation
    const rows = container.querySelectorAll('.task-row');
    rows.forEach(row => {
      row.addEventListener('click', (e) => {
        // @ts-ignore
        if (e.target.tagName.toLowerCase() !== 'a') {
          const href = row.getAttribute('data-href');
          if (href) window.location.href = href;
        }
      });
    });
  });
</script>
