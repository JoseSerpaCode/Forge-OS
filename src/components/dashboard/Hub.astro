---
import WorkspaceIcon from '../brand/WorkspaceIcon.astro';
import { mapaPorClave } from '../../lib/issueTypes';
import { nombreDeRol } from '../../lib/roles';
import { deVarias } from '../../lib/labels';
import { vencida } from '../../lib/fechas';
import { espaciosDelHub, tareasPendientes } from '../../lib/consultas';
// src/pages/index.astro
import MainLayout from '../../layouts/MainLayout.astro';
import db from '../../lib/db';
import { useTranslations } from '../../i18n/ui';
import TaskTable from './TaskTable.astro';

const user = Astro.locals.user!;
// Amigos y solicitudes, solo si la cuenta los tiene encendidos (migración 52).
const socialOn = !user?.is_guest && user?.social_enabled === 1;
const lang = Astro.locals.lang || 'en';
// El callback del proveedor marca así las vueltas que han acabado creando una
// cuenta. Sin esto, quien acaba de borrar la suya y vuelve a pulsar «GitHub»
// aterriza en un hub vacío sin saber que está en una cuenta distinta.
const proveedorNuevaCuenta = Astro.url.searchParams.get('cuenta_nueva');
const t = useTranslations(lang);

const workspaces = espaciosDelHub(user.id, user.is_sysadmin === 1);

// 2. Obtener Tareas Asignadas a mí (My Tasks)
/**
 * Lo que tengo pendiente, y **de qué espacio es cada cosa**.
 *
 * Antes eran diez filas seguidas ordenadas por lo último tocado, con los
 * espacios mezclados y sin decir de cuál era cada una. Con dos espacios ya
 * costaba; con cinco, la lista dejaba de servir para decidir qué hacer, que es
 * lo único para lo que está.
 *
 * Tres cambios, y los tres importan:
 *
 *  - **Se agrupan por espacio**, con la cuenta de cada uno.
 *  - **Ordenan por urgencia**, no por lo último tocado: lo que vence antes va
 *    primero, y lo que no tiene fecha va al final. Ordenar por `updated_at`
 *    subía justo lo que se acababa de mirar, que es lo que menos falta hace
 *    ver.
 *  - **Lo vencido se cuenta aparte**, porque es lo que hay que mirar hoy.
 *
 * El tope sigue existiendo —esto es un resumen, no la lista de tareas— pero se
 * dice cuántas quedan fuera en vez de cortar en silencio.
 */
const TOPE_PENDIENTES = 12;

const pendientes = tareasPendientes(user.id);

const totalPendientes = pendientes.length;
const myTasks = pendientes.slice(0, TOPE_PENDIENTES);
const pendientesOcultas = totalPendientes - myTasks.length;

// Agrupadas, conservando el orden de urgencia dentro de cada espacio.
const porEspacio = new Map<string, { sysTag: string; nombre: string; icono: string | null; tareas: any[] }>();
for (const tarea of myTasks) {
  let grupo = porEspacio.get(tarea.workspace_id);
  if (!grupo) {
    grupo = { sysTag: tarea.sys_tag, nombre: tarea.workspace_name, icono: tarea.workspace_icon, tareas: [] };
    porEspacio.set(tarea.workspace_id, grupo);
  }
  grupo.tareas.push(tarea);
}
const gruposPendientes = [...porEspacio.values()];

/**
 * Los tipos de cada espacio, indexados por `espacio:clave`.
 *
 * El hub mezcla tareas de varios espacios y cada uno tiene sus propios tipos,
 * así que «incidencia» puede ser roja en uno y no existir en otro. Se consulta
 * una vez por espacio con tareas, no una por tarea.
 */
/**
 * Las etiquetas de las tareas pendientes.
 *
 * No salían por ninguna parte: ni la consulta las traía ni la tabla tenía
 * dónde ponerlas, así que la misma tarea enseñaba sus etiquetas en el tablero
 * y ninguna en el hub — que es justo donde se mira para decidir qué tocar.
 *
 * Se leen con `deVarias()`, el mismo lector en lote que usa el tablero: una
 * consulta para todas en vez de una por fila.
 */
const etiquetasPendientes = deVarias('issue', pendientes.map((t) => t.id));

const tiposPendientes = new Map<string, { key: string; name: string; color: string; isBuiltin: boolean }>();
for (const wsId of new Set(myTasks.map((t) => t.workspace_id))) {
  for (const [clave, tipo] of mapaPorClave(wsId)) tiposPendientes.set(`${wsId}:${clave}`, tipo);
}

/**
 * Vencidas, con el helper y no a mano.
 *
 * Aquí había un `new Date().toISOString().slice(0, 10)`, que da el día en
 * **UTC**. `lib/fechas.ts` documenta justo este caso en el comentario de
 * `hoyLocal()`: en Bogotá, entre las siete de la tarde y medianoche, el
 * servidor ya cree que es mañana y marca como vencido lo que vence hoy. Se
 * veía como una tarea vencida que no lo estaba, cada tarde.
 *
 * `vencida()` existía desde entonces y `IssueCard.astro` ya la usa; este
 * contador reimplementó la comparación por su cuenta y se trajo el fallo de
 * vuelta.
 */
const vencidas = pendientes.filter((tarea) => vencida(tarea.due_date)).length;

// Tareas abiertas de cada espacio, en una consulta: es la columna «Abiertas»
// de la tabla de espacios (docs/rediseno/inicio.html).
const abiertasPorEspacio = new Map(
  (db.prepare(`
    SELECT workspace_id AS id, COUNT(*) AS n FROM issues
    WHERE status != 'done' AND parent_issue_id IS NULL
      AND workspace_id IN (${workspaces.map(() => '?').join(',') || "''"})
    GROUP BY workspace_id
  `).all(...workspaces.map((w) => w.id)) as Array<{ id: string; n: number }>).map((r) => [r.id, r.n])
);
---

<MainLayout title={t('hub.title')}>
  {/* Inicio (fase 3 del rediseño): lo pendiente en todos tus espacios, sin
      saludo ni banners. Si hay algo que invitar a hacer, se dice en concreto. */}
  <div class="max-w-[70rem] pb-12">
    <header class="page-head">
      <div class="min-w-0">
        <h1 class="page-title">{t('hub.title')}</h1>
        <p class="page-sub">{workspaces.length === 1 ? t('hub.sub_one') : t('hub.sub_n').replace('{n}', String(workspaces.length))}</p>
      </div>
      <button type="button" class="btn btn-secondary" onclick="document.getElementById('new-ws-modal').showModal()">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        {t('hub.banner_create_ws')}
      </button>
    </header>

    {proveedorNuevaCuenta && (
      <div class="panel !border-forge-border-strong px-4 py-3 mb-6" role="status">
        <p class="font-semibold text-forge-text">{t('hub.new_account.title')}</p>
        <p class="text-sm text-forge-muted mt-1 max-w-2xl">{t('hub.new_account.body')}</p>
      </div>
    )}

    <section class="mb-8">
      <div class="flex flex-wrap items-baseline gap-3 mb-3">
        <h2 class="section-title">{t('hub.pending_tasks')}</h2>
        {vencidas > 0 && (
          <span class="chip" style="--c:var(--forge-error)"><span class="sw" aria-hidden="true"></span>{vencidas === 1 ? t('hub.overdue_one') : t('hub.overdue').replace('{n}', String(vencidas))}</span>
        )}
      </div>

      {gruposPendientes.length === 0 ? (
        <p class="panel px-4 py-6 text-center text-forge-muted text-sm">{t('dashboard.no_tasks')}</p>
      ) : (
        <div class="space-y-4">
          {gruposPendientes.map((g) => (
            <section class="panel overflow-hidden" aria-label={g.nombre}>
              {/* Qué espacio es, y su tablero: desde aquí se decide qué hacer,
                  y lo siguiente es ir a hacerlo. */}
              <div class="panel-cabeza">
                <h3 class="text-base font-bold"><a href={`/w/${g.sysTag}/board`} class="hover:underline underline-offset-2">{g.nombre}</a></h3>
                <span class="text-sm text-forge-muted">{g.tareas.length === 1 ? t('hub.one_task') : t('hub.n_tasks').replace('{n}', String(g.tareas.length))}</span>
              </div>
              <div class="overflow-x-auto">
                <TaskTable tasks={g.tareas} sys_tag={g.sysTag} tipos={tiposPendientes} etiquetas={etiquetasPendientes} />
              </div>
            </section>
          ))}
          {pendientesOcultas > 0 && (
            <p class="hint text-center py-1">
              {pendientesOcultas === 1 ? t('hub.more_one') : t('hub.more_n').replace('{n}', String(pendientesOcultas))}
            </p>
          )}
        </div>
      )}
    </section>

    <section class="mb-8">
      <div class="flex items-baseline justify-between gap-3 mb-3">
        <h2 class="section-title">{t('hub.workspaces')}</h2>
        <a href="/settings#workspace-memberships" class="enlace">{t('hub.manage_members')}</a>
      </div>
      {workspaces.length === 0 ? (
        <p class="panel px-4 py-6 text-center text-sm text-forge-muted">{t('hub.no_workspaces')}</p>
      ) : (
        <div class="panel overflow-x-auto">
          <table class="tabla">
            <thead>
              <tr>
                <th>{t('hub.col_workspace')}</th>
                <th>{t('hub.col_tag')}</th>
                <th>{t('hub.col_role')}</th>
                <th class="num">{t('hub.col_people')}</th>
                <th class="num">{t('hub.col_open')}</th>
                <th><span class="sr-only">{t('hub.col_actions')}</span></th>
              </tr>
            </thead>
            <tbody>
              {workspaces.map((ws) => (
                <tr class="group">
                  <td class="titulo">
                    <a href={`/w/${ws.sys_tag}`} class="flex items-center gap-2.5 hover:underline underline-offset-2">
                      <span class="w-6 h-6 rounded-[7px] border border-forge-border bg-forge-panel overflow-hidden flex items-center justify-center shrink-0 text-xs" aria-hidden="true">
                        <WorkspaceIcon icon={ws.icon} name={ws.name} />
                      </span>
                      <span class="truncate max-w-[18rem]">{ws.name}</span>
                    </a>
                  </td>
                  <td class="text-forge-muted">#{ws.sys_tag}</td>
                  <td>{ws.role ? nombreDeRol(ws.role, lang) : ''}</td>
                  <td class="num">{ws.totalMembers}</td>
                  <td class="num">{abiertasPorEspacio.get(ws.id) ?? 0}</td>
                  <td class="w-0 whitespace-nowrap">
                    {(ws.role === 'owner' || ws.role === 'sysadmin') && (
                      <span class="flex justify-end gap-0.5 opacity-0 group-hover:opacity-100 focus-within:opacity-100">
                        <a href={`/w/${ws.sys_tag}/settings`} class="btn btn-ghost btn-icon btn-sm" title={t('hub.ws_settings')} aria-label={`${t('hub.ws_settings')}: ${ws.name}`}>
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                        </a>
                        <button type="button" class="btn-delete-ws btn btn-ghost btn-icon btn-sm !text-forge-error" data-id={ws.id} title={t('hub.delete_ws')} aria-label={`${t('hub.delete_ws')}: ${ws.name}`}>
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                        </button>
                      </span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    {/* Lo social, solo si está encendido (migración 52), y en una línea que
        dice qué hacer en vez de un banner que vende. */}
    {socialOn && (
      <p class="panel px-4 py-3 flex flex-wrap items-center justify-between gap-3 text-sm">
        <span class="text-forge-muted">{t('hub.people_hint')}</span>
        <a href="/people" class="btn btn-secondary btn-sm">{t('friends.title')}</a>
      </p>
    )}
  </div>

  <dialog id="new-ws-modal"
    data-t-help={t('err.sys_tag')}
    data-t-error={t('err.sys_tag')}
    data-t-taken={t('err.ws_tag_taken')}
    data-t-creating={t('hub.creating')}
    data-t-fields={t('err.fill_fields')}
    class="ventana">
    <h2 class="ventana-titulo">{t('hub.create_workspace').replace('+', '').trim()}</h2>
    <div class="mb-4">
      <label for="ws-name" class="block field-label mb-1.5">{t('modal.title')}</label>
      <input type="text" id="ws-name" class="campo" placeholder={t('hub.ws_name_ph')}>
    </div>
    <div class="mb-4">
      <label for="ws-tag" class="block field-label mb-1.5">{t('hub.ws_tag')}</label>
      <input type="text" id="ws-tag" class="campo" placeholder={t('hub.ws_tag_ph')}>
      {/* Doble uso: la ayuda de siempre y, cuando el valor no vale, el error
          en rojo aquí mismo. Un aviso flotante en la esquina opuesta de la
          pantalla obliga a mirar a otro lado para saber qué campo está mal, y
          se va solo antes de que dé tiempo a corregirlo. */}
      <p id="ws-tag-help" class="hint mt-1.5" aria-live="polite">{t('err.sys_tag')}</p>
    </div>
    <div class="ventana-pie">
      <button type="button" class="btn btn-ghost" onclick="document.getElementById('new-ws-modal').close()">{t('modal.cancel')}</button>
      <button type="button" id="btn-save-ws" class="btn btn-primary">{t('modal.create')}</button>
    </div>
  </dialog>

  <script>
    const modal = document.getElementById('new-ws-modal') as HTMLDialogElement;
    const btnSave = document.getElementById('btn-save-ws');
    const nameInput = document.getElementById('ws-name') as HTMLInputElement;
    const tagInput = document.getElementById('ws-tag') as HTMLInputElement;

    // Los dos botones que abren este diálogo lo hacen con un `onclick` en el
    // marcado. Aquí había un `getElementById('btn-create-ws-modal')` que no
    // existe en ninguna parte, con su `?.addEventListener` detrás: código
    // muerto que parecía ser quien abría el modal.

    const ayuda = document.getElementById('ws-tag-help');
    const txtAyudaTag = modal?.dataset.tHelp || '';
    const txtErrorTag = modal?.dataset.tError || '';
    const txtTagOcupado = modal?.dataset.tTaken || '';
    const txtCreando = modal?.dataset.tCreating || '...';
    const txtFaltanCampos = modal?.dataset.tFields || '';
    const aTag = (v: string) => v.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

    // ¿Ha tocado la persona el tag a mano? Mientras no lo haga, sigue al
    // título; en cuanto lo edita, deja de pisársele.
    //
    // Antes esto se adivinaba comparando el tag con el slug del nombre **menos
    // su última letra**, para detectar «esto es lo que generé en la pulsación
    // anterior». Solo acertaba escribiendo letra a letra y al final del campo:
    // al pegar texto, al borrar o al editar por el medio, la comparación
    // fallaba y el tag se quedaba congelado con lo primero que se hubiera
    // escrito, sin manera de volver a engancharlo.
    let tagEditadoAMano = false;
    tagInput?.addEventListener('input', () => {
      tagEditadoAMano = true;
      validarTag();
    });

    nameInput?.addEventListener('input', () => {
      if (!tagEditadoAMano) {
        tagInput.value = aTag(nameInput.value);
        validarTag();
      }
    });

    function validarTag() {
      if (!ayuda) return true;
      const v = tagInput.value;
      const vale = v === '' || /^[a-z0-9]+(-[a-z0-9]+)*$/.test(v);
      ayuda.textContent = vale ? txtAyudaTag : txtErrorTag;
      ayuda.className = vale
        ? 'hint mt-1.5'
        : 'hint mt-1.5 !text-forge-error font-semibold';
      tagInput.classList.toggle('border-forge-error', !vale);
      return vale;
    }

    btnSave?.addEventListener('click', async () => {
      if (!nameInput.value || !tagInput.value) {
        // @ts-ignore
        return window.showToast(txtFaltanCampos, true);
      }
      // El formato se comprueba aquí antes de salir a la red: el error se ve
      // junto al campo en vez de volver del servidor como un aviso suelto.
      if (!validarTag()) {
        tagInput.focus();
        return;
      }

      // El texto original se guarda en vez de escribirse a mano: antes se
      // reponía con la palabra «Create» fija, así que tras un error el botón
      // se quedaba en inglés en medio de una pantalla en español.
      const textoOriginal = btnSave.textContent;
      btnSave.textContent = txtCreando;
      btnSave.setAttribute('disabled', 'true');

      const res = await fetch('/api/workspaces', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: nameInput.value, sys_tag: tagInput.value })
      });

      if (res.ok) {
        window.location.reload();
      } else {
        // El servidor puede rechazar por formato o porque el tag ya existe.
        // Ambos son cosas del campo, así que se cuentan en el campo.
        const cuerpo = await res.text();
        if (ayuda) {
          ayuda.textContent = res.status === 409 ? txtTagOcupado : txtErrorTag;
          ayuda.className = 'hint mt-1.5 !text-forge-error font-semibold';
          tagInput.classList.add('border-forge-error');
          tagInput.focus();
        } else {
          // @ts-ignore
          window.showToast(cuerpo, true);
        }
        btnSave.textContent = textoOriginal;
        btnSave.removeAttribute('disabled');
      }
    });

    // Delete Workspace
    document.querySelectorAll('.btn-delete-ws').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
        // @ts-ignore
        window.forgeConfirm(window.forgeMsg?.confirmarBorrarEspacio || '', async () => {
          const res = await fetch(`/api/workspaces/${id}`, { method: 'DELETE' });
          if (res.ok) {
            window.location.reload();
          } else {
            // @ts-ignore
            console.error('borrar espacio:', await res.text());
            window.showToast?.(window.forgeMsg?.errBorrarEspacio || '', true);
          }
        });
      });
    });
  </script>
</MainLayout>
