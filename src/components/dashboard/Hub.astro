---
import Logo from '../brand/Logo.astro';
import WorkspaceIcon from '../brand/WorkspaceIcon.astro';
import { mapaPorClave } from '../../lib/issueTypes';
import { nombreDeRol } from '../../lib/roles';
// src/pages/index.astro
import MainLayout from '../../layouts/MainLayout.astro';
import db from '../../lib/db';
import { useTranslations } from '../../i18n/ui';
import TaskTable from './TaskTable.astro';

const user = Astro.locals.user!;
const lang = Astro.locals.lang || 'en';
// El callback del proveedor marca así las vueltas que han acabado creando una
// cuenta. Sin esto, quien acaba de borrar la suya y vuelve a pulsar «GitHub»
// aterriza en un hub vacío sin saber que está en una cuenta distinta.
const proveedorNuevaCuenta = Astro.url.searchParams.get('cuenta_nueva');
const t = useTranslations(lang);

// La rama de sysadmin lee todos los espacios de la instancia. Va acotada: el
// hub es una portada, no un panel de administración, y sin tope el coste de
// abrirlo crece con el producto entero. Los 100 más recientes son de sobra para
// lo que esta pantalla hace; enumerarlos todos es trabajo de una vista de
// administración, que no existe todavía.
const workspacesQuery = user.is_sysadmin === 1 
  ? `SELECT w.id, w.name, w.sys_tag, w.icon, 'sysadmin' as role,
      (SELECT json_group_array(json_object('id', u.id, 'username', u.username, 'avatar_url', u.avatar_url))
       FROM (SELECT u2.id, u2.username, u2.avatar_url FROM workspace_members wm JOIN users u2 ON wm.user_id = u2.id WHERE wm.workspace_id = w.id LIMIT 5) u) as members_json,
      (SELECT COUNT(*) FROM workspace_members WHERE workspace_id = w.id) as totalMembers
     FROM workspaces w WHERE w.sys_tag NOT LIKE 'guest-%'
     ORDER BY w.created_at DESC LIMIT 100`
  : `SELECT w.id, w.name, w.sys_tag, w.icon, wm.ws_role as role,
      (SELECT json_group_array(json_object('id', u.id, 'username', u.username, 'avatar_url', u.avatar_url))
       FROM (SELECT u2.id, u2.username, u2.avatar_url FROM workspace_members wm2 JOIN users u2 ON wm2.user_id = u2.id WHERE wm2.workspace_id = w.id LIMIT 5) u) as members_json,
      (SELECT COUNT(*) FROM workspace_members WHERE workspace_id = w.id) as totalMembers
     FROM workspaces w JOIN workspace_members wm ON w.id = wm.workspace_id WHERE wm.user_id = ?`;

const workspaces = user.is_sysadmin === 1 ? db.prepare(workspacesQuery).all() as any[] : db.prepare(workspacesQuery).all(user.id) as any[];

for (const ws of workspaces) {
  ws.members = JSON.parse(ws.members_json || '[]');
}

// 2. Obtener Tareas Asignadas a mí (My Tasks)
/**
 * Lo que tengo pendiente, y **de qué espacio es cada cosa**.
 *
 * Antes eran diez filas seguidas ordenadas por lo último tocado, con los
 * espacios mezclados y sin decir de cuál era cada una. Con dos espacios ya
 * costaba; con cinco, la lista dejaba de servir para decidir qué hacer, que es
 * lo único para lo que está.
 *
 * Tres cambios, y los tres importan:
 *
 *  - **Se agrupan por espacio**, con la cuenta de cada uno.
 *  - **Ordenan por urgencia**, no por lo último tocado: lo que vence antes va
 *    primero, y lo que no tiene fecha va al final. Ordenar por `updated_at`
 *    subía justo lo que se acababa de mirar, que es lo que menos falta hace
 *    ver.
 *  - **Lo vencido se cuenta aparte**, porque es lo que hay que mirar hoy.
 *
 * El tope sigue existiendo —esto es un resumen, no la lista de tareas— pero se
 * dice cuántas quedan fuera en vez de cortar en silencio.
 */
const TOPE_PENDIENTES = 12;

const pendientes = db.prepare(`
  SELECT i.id, i.title, i.status, i.sprint_id, i.type, i.due_date, i.priority,
         w.sys_tag, w.id AS workspace_id, w.icon AS workspace_icon, w.name AS workspace_name
  FROM issues i
  JOIN workspaces w ON i.workspace_id = w.id
  WHERE i.assignee_id = ? AND i.status != 'done'
  ORDER BY
    i.due_date IS NULL ASC,
    i.due_date ASC,
    CASE i.priority WHEN 'highest' THEN 0 WHEN 'high' THEN 1 WHEN 'medium' THEN 2 WHEN 'low' THEN 3 WHEN 'lowest' THEN 4 ELSE 2 END ASC,
    i.updated_at DESC
`).all(user.id) as any[];

const totalPendientes = pendientes.length;
const myTasks = pendientes.slice(0, TOPE_PENDIENTES);
const pendientesOcultas = totalPendientes - myTasks.length;

// Agrupadas, conservando el orden de urgencia dentro de cada espacio.
const porEspacio = new Map<string, { sysTag: string; nombre: string; icono: string | null; tareas: any[] }>();
for (const tarea of myTasks) {
  let grupo = porEspacio.get(tarea.workspace_id);
  if (!grupo) {
    grupo = { sysTag: tarea.sys_tag, nombre: tarea.workspace_name, icono: tarea.workspace_icon, tareas: [] };
    porEspacio.set(tarea.workspace_id, grupo);
  }
  grupo.tareas.push(tarea);
}
const gruposPendientes = [...porEspacio.values()];

/**
 * Los tipos de cada espacio, indexados por `espacio:clave`.
 *
 * El hub mezcla tareas de varios espacios y cada uno tiene sus propios tipos,
 * así que «incidencia» puede ser roja en uno y no existir en otro. Se consulta
 * una vez por espacio con tareas, no una por tarea.
 */
const tiposPendientes = new Map<string, { key: string; name: string; color: string; isBuiltin: boolean }>();
for (const wsId of new Set(myTasks.map((t) => t.workspace_id))) {
  for (const [clave, tipo] of mapaPorClave(wsId)) tiposPendientes.set(`${wsId}:${clave}`, tipo);
}

// Vencidas: comparando solo la fecha, no la hora. Una entrega «de hoy» no está
// vencida a las nueve de la mañana.
const hoy = new Date().toISOString().slice(0, 10);
const vencidas = pendientes.filter((tarea) => tarea.due_date && String(tarea.due_date).slice(0, 10) < hoy).length;
---

<MainLayout title={t('hub.title')}>
  <main class="space-y-8 max-w-5xl mx-auto pb-12">
    {proveedorNuevaCuenta && (
      <div class="rounded-xl border border-forge-accent-primary/50 bg-forge-accent-primary/10 p-4 sm:p-5" role="status">
        <p class="font-bold text-forge-text">{t('hub.new_account.title')}</p>
        <p class="text-sm text-forge-muted mt-1.5 max-w-2xl">{t('hub.new_account.body')}</p>
      </div>
    )}
    <header class="mb-8 flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-extrabold text-forge-text mb-2 tracking-tight">{t('hub.title')}</h1>
        <p class="text-forge-muted font-medium text-sm">{t('hub.welcome').replace('{user}', user.username)}</p>
      </div>
    </header>
    
    <div class="space-y-8 mb-10">

                <section>
          <div class="flex justify-between items-end mb-4 border-b border-forge-border pb-2">
            <div class="flex items-center gap-2">
              <h2 class="text-xl font-bold text-forge-text">{t('hub.workspaces')}</h2>
              <a href="/settings#workspace-memberships" class="text-forge-muted hover:text-forge-accent-text transition-colors" title={t('hub.manage_members')}>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
              </a>
            </div>
            <!-- Redundant Create button removed from here to reduce clutter -->
          </div>
          
          <div class="max-h-[400px] overflow-y-auto custom-scrollbar pr-2">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {workspaces.map(ws => (
                <div data-href={`/w/${ws.sys_tag}/board`} onclick="if(!event.defaultPrevented) window.location.href=this.getAttribute('data-href')" class="block bg-forge-panel border border-forge-border p-5 rounded-xl hover:border-forge-secondary hover:shadow-[0_4px_20px_rgba(0,229,255,0.1)] transition-all group flex flex-col h-full cursor-pointer relative">
                  <div class="flex items-start justify-between mb-6 gap-2">
                    {/*
                      `min-w-0` en **todos** los eslabones de la cadena flex.
                      El `truncate` del título ya estaba, y aun así un nombre
                      largo desbordaba la tarjeta: por defecto un elemento flex
                      no encoge por debajo de su contenido, así que basta con
                      que un contenedor intermedio no lo lleve para que el
                      recorte del hijo no sirva de nada.
                    */}
                    <div class="flex items-center gap-3 min-w-0">
                      <div class="w-10 h-10 rounded-lg bg-forge-bg border border-forge-border flex items-center justify-center text-forge-accent-text font-black text-lg shadow-sm shrink-0 overflow-hidden">
                        <WorkspaceIcon icon={ws.icon} name={ws.name} />
                      </div>
                      <div class="min-w-0">
                        <h3 class="font-bold text-forge-text group-hover:text-forge-accent-text transition-colors text-base truncate">{ws.name}</h3>
                        <p class="text-xs text-forge-muted font-mono mt-0.5 truncate">#{ws.sys_tag}</p>
                      </div>
                    </div>
                    
                    <div class="shrink-0 ml-2">
                      {ws.role && <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-forge-bg border border-forge-border text-forge-muted tracking-wider uppercase">{nombreDeRol(ws.role, lang)}</span>}
                    </div>
                  </div>
                  
                  <div class="mt-auto pt-4 border-t border-forge-border/50 flex justify-between items-center h-8 relative">
                    <div class="flex items-center gap-1.5">
                      {ws.members.map((member: any) => (
                        <img src={member.avatar_url || '/default-avatar.svg'} class="w-6 h-6 rounded-full border border-forge-border bg-forge-bg object-cover shrink-0 relative z-10" title={member.username} alt={member.username} loading="lazy" decoding="async" />
                      ))}
                      {ws.totalMembers > 5 && (
                        <div class="w-6 h-6 rounded-full border border-forge-border bg-forge-bg flex items-center justify-center text-[8px] font-bold text-forge-muted shrink-0 relative z-10" title={`+${ws.totalMembers - 5} more`}>
                          +{ws.totalMembers - 5}
                        </div>
                      )}
                    </div>
                    
                    <div class="opacity-0 group-hover:opacity-100 transition-opacity absolute right-0 bg-forge-panel pl-2 flex gap-1 z-20">
                      {(ws.role === 'owner' || ws.role === 'sysadmin') && (
                        <>
                          <a href={`/w/${ws.sys_tag}/settings`} onclick="event.preventDefault(); event.stopPropagation(); window.location.href=this.href" class="text-xs text-forge-muted hover:text-forge-accent-text hover:bg-forge-secondary/10 px-2 py-1.5 rounded transition-colors flex items-center gap-1 cursor-pointer pointer-events-auto" title={t('hub.ws_settings')}>
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                          </a>
                          <button class="btn-delete-ws text-xs text-forge-muted hover:text-forge-error hover:bg-red-500/10 px-2 py-1.5 rounded transition-colors flex items-center gap-1 cursor-pointer pointer-events-auto" data-id={ws.id} title={t('hub.delete_ws')} onclick="event.preventDefault(); event.stopPropagation();">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                          </button>
                        </>
                      )}
                    </div>
                  </div>
                </div>
              ))}

              <!-- Dotted New Workspace Card -->
              <button type="button" onclick="document.getElementById('new-ws-modal').showModal()" class="flex flex-col items-center justify-center h-full min-h-[140px] border-2 border-dashed border-forge-border/60 hover:border-forge-secondary/50 rounded-xl hover:bg-forge-secondary/5 transition-all text-forge-muted hover:text-forge-accent-text group">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-2 group-hover:scale-110 transition-transform"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span class="font-medium text-sm">{t('hub.banner_create_ws')}</span>
              </button>

              {workspaces.length === 0 && (
                <div class="col-span-full py-10 flex flex-col items-center justify-center text-center relative overflow-hidden border border-dashed border-forge-border rounded-lg bg-forge-panel/30">
                  <!-- Constellation nodes -->
                  <div class="absolute inset-0 opacity-20 pointer-events-none" style="background-image: radial-gradient(circle at 20% 30%, var(--forge-muted) 2px, transparent 2px), radial-gradient(circle at 80% 40%, var(--forge-muted) 2px, transparent 2px), radial-gradient(circle at 50% 80%, var(--forge-muted) 2px, transparent 2px); background-size: 100% 100%;">
                    <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none"><path d="M 20 30 L 80 40 L 50 80 Z" fill="none" stroke="currentColor" class="text-forge-muted" stroke-dasharray="2,2" stroke-width="0.5" /></svg>
                  </div>
                  <p class="text-forge-text relative z-10">{t('hub.no_workspaces')}</p>
                </div>
              )}
            </div>
          </div>
        </section>
        
        <!-- Pending Tasks Section -->
        <section>
          <div class="flex flex-wrap items-center justify-between gap-3 mb-4 border-b border-forge-border pb-2">
            <h2 class="text-xl font-bold text-forge-text">{t('hub.pending_tasks')}</h2>
            {vencidas > 0 && (
              <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-forge-error/10 text-forge-error border border-forge-error/30">
                {vencidas === 1 ? t('hub.overdue_one') : t('hub.overdue').replace('{n}', String(vencidas))}
              </span>
            )}
          </div>

          {gruposPendientes.length === 0 ? (
            <div class="bg-forge-panel border border-forge-border rounded-lg p-8 text-center text-forge-muted text-sm">
              {t('dashboard.no_tasks')}
            </div>
          ) : (
            <div class="space-y-4 max-h-[420px] overflow-y-auto custom-scrollbar pr-1">
              {gruposPendientes.map((g) => (
                <div class="bg-forge-panel border border-forge-border rounded-lg overflow-hidden">
                  {/* Qué espacio es, y un enlace a su tablero: desde aquí se
                      decide qué hacer, y lo siguiente es ir a hacerlo. */}
                  <a href={`/w/${g.sysTag}/board`} class="flex items-center gap-2.5 px-4 py-2.5 border-b border-forge-border bg-forge-bg/40 hover:bg-forge-bg transition-colors group">
                    <span class="w-6 h-6 rounded-md border border-forge-border bg-forge-bg overflow-hidden flex items-center justify-center shrink-0 text-[11px]">
                      <WorkspaceIcon icon={g.icono} name={g.nombre} />
                    </span>
                    <span class="text-sm font-bold text-forge-text truncate group-hover:text-forge-accent-text transition-colors">{g.nombre}</span>
                    <span class="text-xs text-forge-muted shrink-0">
                      {g.tareas.length === 1 ? t('hub.one_task') : t('hub.n_tasks').replace('{n}', String(g.tareas.length))}
                    </span>
                  </a>
                  <TaskTable tasks={g.tareas} sys_tag={g.sysTag} tipos={tiposPendientes} />
                </div>
              ))}

              {pendientesOcultas > 0 && (
                <p class="text-xs text-forge-muted text-center py-2">
                  {pendientesOcultas === 1
                    ? t('hub.more_one')
                    : t('hub.more_n').replace('{n}', String(pendientesOcultas))}
                </p>
              )}
            </div>
          )}
        </section>
      
    </div>

    <!-- Welcome / Collaboration Banner -->
    <div class="mb-10 bg-gradient-to-r from-forge-secondary/10 via-forge-primary/5 to-forge-bg border border-forge-secondary/20 rounded-2xl p-8 relative overflow-hidden group shadow-lg">
      <div class="absolute right-0 top-0 w-64 h-64 bg-forge-secondary/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4 group-hover:bg-forge-secondary/20 transition-colors"></div>
      
      <div class="relative z-10 flex flex-col md:flex-row gap-6 items-start md:items-center justify-between">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-black text-forge-text mb-3 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-forge-accent-text"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            {t('hub.banner_title')}
          </h2>
          <p class="text-forge-text/80 text-sm leading-relaxed mb-6 font-medium" set:html={t('hub.banner_desc')} />
          <div class="flex flex-wrap items-center gap-3">
            <button onclick="document.getElementById('new-ws-modal').showModal()" class="bg-forge-secondary text-white font-bold py-2.5 px-6 rounded-xl shadow-lg shadow-forge-secondary/30 hover:shadow-forge-secondary/50 hover:-translate-y-0.5 active:scale-95 transition-all text-sm flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              {t('hub.banner_create_ws')}
            </button>
            <button onclick="event.stopPropagation(); const s = document.getElementById('global-search'); s.value='/u '; s.focus(); s.dispatchEvent(new Event('input'));" class="bg-forge-panel text-forge-text border border-forge-border font-bold py-2.5 px-6 rounded-xl shadow-sm hover:border-forge-secondary/50 hover:bg-forge-bg transition-all text-sm flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              {t('hub.banner_find_people')}
            </button>
          </div>
        </div>
        <div class="hidden lg:flex items-center justify-center shrink-0 w-48 h-48 relative">
          <!-- Fun visual decoration for collaboration -->
          <div class="absolute inset-0 border-2 border-dashed border-forge-secondary/30 rounded-full animate-[spin_20s_linear_infinite]"></div>
          <div class="absolute w-12 h-12 bg-forge-bg border-2 border-forge-border rounded-full flex items-center justify-center -top-3 left-1/2 -translate-x-1/2 z-10 shadow-lg shadow-forge-secondary/20 text-forge-accent-text">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          </div>
          <div class="absolute w-12 h-12 bg-forge-bg border-2 border-forge-border rounded-full flex items-center justify-center bottom-2 left-0 z-10 shadow-lg text-forge-info">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </div>
          <div class="absolute w-12 h-12 bg-forge-bg border-2 border-forge-border rounded-full flex items-center justify-center bottom-2 right-0 z-10 shadow-lg text-forge-success">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          </div>
          <div class="rotate-12 relative z-0">
            <Logo size="xl" wordmark={false} />
          </div>
        </div>
      </div>
    </div>

  </main>

  <dialog id="new-ws-modal"
    data-t-help={t('err.sys_tag')}
    data-t-error={t('err.sys_tag')}
    data-t-taken={t('err.ws_tag_taken')}
    data-t-creating={t('hub.creating')}
    data-t-fields={t('err.fill_fields')}
    class="bg-forge-panel border border-forge-border rounded-lg p-6 w-full max-w-[400px] text-forge-text shadow-xl backdrop:bg-black/50">
    <h2 class="text-xl font-bold mb-4">{t('hub.create_workspace').replace('+', '').trim()}</h2>
    <div class="mb-4">
      <label for="ws-name" class="block text-xs uppercase tracking-wider text-forge-muted mb-1">{t('modal.title') || 'Name'}</label>
      <input type="text" id="ws-name" class="w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:border-forge-secondary focus:outline-none" placeholder={t('hub.ws_name_ph')}>
    </div>
    <div class="mb-4">
      <label for="ws-tag" class="block text-xs uppercase tracking-wider text-forge-muted mb-1">{t('hub.ws_tag')}</label>
      <input type="text" id="ws-tag" class="w-full bg-forge-bg border border-forge-border rounded p-2 text-forge-text focus:border-forge-secondary focus:outline-none" placeholder="e.g. project-orion">
      {/* Doble uso: la ayuda de siempre y, cuando el valor no vale, el error
          en rojo aquí mismo. Un aviso flotante en la esquina opuesta de la
          pantalla obliga a mirar a otro lado para saber qué campo está mal, y
          se va solo antes de que dé tiempo a corregirlo. */}
      <p id="ws-tag-help" class="text-[10px] text-forge-muted mt-1" aria-live="polite">{t('err.sys_tag')}</p>
    </div>
    <div class="flex justify-end gap-3 mt-6">
      <button type="button" class="px-4 py-2 text-forge-muted hover:text-forge-text" onclick="document.getElementById('new-ws-modal').close()">{t('modal.cancel') || 'Cancel'}</button>
      <button type="button" id="btn-save-ws" class="bg-forge-primary text-forge-on-accent px-4 py-2 rounded font-bold hover:opacity-90 transition-opacity">{t('modal.create') || 'Create'}</button>
    </div>
  </dialog>

  <script>
    const modal = document.getElementById('new-ws-modal') as HTMLDialogElement;
    const btnSave = document.getElementById('btn-save-ws');
    const nameInput = document.getElementById('ws-name') as HTMLInputElement;
    const tagInput = document.getElementById('ws-tag') as HTMLInputElement;

    // Los dos botones que abren este diálogo lo hacen con un `onclick` en el
    // marcado. Aquí había un `getElementById('btn-create-ws-modal')` que no
    // existe en ninguna parte, con su `?.addEventListener` detrás: código
    // muerto que parecía ser quien abría el modal.

    const ayuda = document.getElementById('ws-tag-help');
    const txtAyudaTag = modal?.dataset.tHelp || '';
    const txtErrorTag = modal?.dataset.tError || '';
    const txtTagOcupado = modal?.dataset.tTaken || '';
    const txtCreando = modal?.dataset.tCreating || '...';
    const txtFaltanCampos = modal?.dataset.tFields || '';
    const aTag = (v: string) => v.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

    // ¿Ha tocado la persona el tag a mano? Mientras no lo haga, sigue al
    // título; en cuanto lo edita, deja de pisársele.
    //
    // Antes esto se adivinaba comparando el tag con el slug del nombre **menos
    // su última letra**, para detectar «esto es lo que generé en la pulsación
    // anterior». Solo acertaba escribiendo letra a letra y al final del campo:
    // al pegar texto, al borrar o al editar por el medio, la comparación
    // fallaba y el tag se quedaba congelado con lo primero que se hubiera
    // escrito, sin manera de volver a engancharlo.
    let tagEditadoAMano = false;
    tagInput?.addEventListener('input', () => {
      tagEditadoAMano = true;
      validarTag();
    });

    nameInput?.addEventListener('input', () => {
      if (!tagEditadoAMano) {
        tagInput.value = aTag(nameInput.value);
        validarTag();
      }
    });

    function validarTag() {
      if (!ayuda) return true;
      const v = tagInput.value;
      const vale = v === '' || /^[a-z0-9]+(-[a-z0-9]+)*$/.test(v);
      ayuda.textContent = vale ? txtAyudaTag : txtErrorTag;
      ayuda.className = vale
        ? 'text-[10px] text-forge-muted mt-1'
        : 'text-[10px] text-forge-error mt-1 font-semibold';
      tagInput.classList.toggle('border-forge-error', !vale);
      return vale;
    }

    btnSave?.addEventListener('click', async () => {
      if (!nameInput.value || !tagInput.value) {
        // @ts-ignore
        return window.showToast(txtFaltanCampos, true);
      }
      // El formato se comprueba aquí antes de salir a la red: el error se ve
      // junto al campo en vez de volver del servidor como un aviso suelto.
      if (!validarTag()) {
        tagInput.focus();
        return;
      }

      // El texto original se guarda en vez de escribirse a mano: antes se
      // reponía con la palabra «Create» fija, así que tras un error el botón
      // se quedaba en inglés en medio de una pantalla en español.
      const textoOriginal = btnSave.textContent;
      btnSave.textContent = txtCreando;
      btnSave.setAttribute('disabled', 'true');

      const res = await fetch('/api/workspaces', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: nameInput.value, sys_tag: tagInput.value })
      });

      if (res.ok) {
        window.location.reload();
      } else {
        // El servidor puede rechazar por formato o porque el tag ya existe.
        // Ambos son cosas del campo, así que se cuentan en el campo.
        const cuerpo = await res.text();
        if (ayuda) {
          ayuda.textContent = res.status === 409 ? txtTagOcupado : txtErrorTag;
          ayuda.className = 'text-[10px] text-forge-error mt-1 font-semibold';
          tagInput.classList.add('border-forge-error');
          tagInput.focus();
        } else {
          // @ts-ignore
          window.showToast(cuerpo, true);
        }
        btnSave.textContent = textoOriginal;
        btnSave.removeAttribute('disabled');
      }
    });

    // Delete Workspace
    document.querySelectorAll('.btn-delete-ws').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
        // @ts-ignore
        window.forgeConfirm(document.querySelector('[data-t-delete-workspace]')?.dataset.tDeleteWorkspace || '', async () => {
          const res = await fetch(`/api/workspaces/${id}`, { method: 'DELETE' });
          if (res.ok) {
            window.location.reload();
          } else {
            // @ts-ignore
            window.showToast('Failed to delete: ' + await res.text(), true);
          }
        });
      });
    });
  </script>
</MainLayout>
