---
/**
 * Conmutador de tema para las páginas públicas.
 *
 * La aplicación ya tiene uno en `TopBar.astro`, pero aquel guarda la
 * preferencia en la base de datos además de en `localStorage`, y aquí no hay
 * sesión donde guardarla. Este se queda en `localStorage`, con la **misma
 * clave** (`forge_theme`), así que la elección viaja: quien pone la portada en
 * oscuro y luego entra, encuentra la aplicación en oscuro.
 *
 * El estado inicial lo pinta el servidor en `data-theme`, y el script en línea
 * del `<head>` de `PublicLayout` lo corrige antes del primer fotograma. Aquí
 * solo se alterna.
 */
import { useTranslations } from '../../i18n/ui';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const t = useTranslations(Astro.locals.lang || 'en');
---

<button
  type="button"
  class:list={['ts', className]}
  id="public-theme-toggle"
  title={t('a11y.toggle_theme')}
  aria-label={t('a11y.toggle_theme')}
>
  {/* Los dos iconos van en el marcado y se muestran por CSS según el tema. Con
      uno solo habría que dibujarlo en JavaScript, y hasta que corriera se
      vería el icono equivocado. */}
  <svg class="ts-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <svg class="ts-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
</button>

<style>
  .ts {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 44px de zona pulsable: por debajo de eso falla el dedo en móvil. */
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.5rem;
    border: 1px solid var(--forge-border);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--forge-muted);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .ts:hover {
    color: var(--forge-text);
    border-color: var(--forge-muted);
  }

  /* En claro se ofrece la luna (lo que vas a activar); en oscuro, el sol. */
  .ts-moon { display: none; }
  :global([data-theme='dark']) .ts-moon { display: block; }
  :global([data-theme='dark']) .ts-sun { display: none; }
</style>

<script>
  const boton = document.getElementById('public-theme-toggle');
  boton?.addEventListener('click', () => {
    const actual = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
    const nuevo = actual === 'dark' ? 'light' : 'dark';

    document.documentElement.setAttribute('data-theme', nuevo);
    try {
      localStorage.setItem('forge_theme', nuevo);
    } catch (e) {
      /* Sin almacenamiento el cambio vale para esta página y ya. */
    }

    // La barra del navegador móvil se queda del color anterior si no se toca.
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', nuevo === 'dark' ? '#0D0B0A' : '#F8F6F0');
  });
</script>
