---
/**
 * Conmutador de idioma para las páginas públicas.
 *
 * El que existía vivía en `TopBar.astro` y en `settings.astro`, los dos detrás
 * de una sesión. Un visitante nuevo —el único que todavía no ha decidido nada—
 * no tenía ninguna forma de cambiar de idioma.
 *
 * Va como `<form>` y no como enlace porque `/api/lang` escribe una cookie: eso
 * es un POST, no una navegación que un prefetch del navegador pueda disparar
 * por su cuenta.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const lang = Astro.locals.lang || 'en';

// Se vuelve a la misma página, no a la portada: cambiar de idioma en el
// registro y aparecer en la raíz sería perder lo que se estuviera haciendo.
const currentPath = Astro.url.pathname + Astro.url.search;
---

<form method="POST" action="/api/lang" class:list={['ls', className]}>
  <input type="hidden" name="current_path" value={currentPath} />
  <input type="hidden" name="lang" value={lang === 'es' ? 'en' : 'es'} />
  {/* Sin bandera: un idioma no es un país, y el emoji de bandera sale como
      dos letras sueltas en Windows. */}
  <button type="submit" class="btn btn-ghost btn-sm" aria-label={lang === 'es' ? 'Switch to English' : 'Cambiar a español'}>
    {lang === 'es' ? 'EN' : 'ES'}
  </button>
</form>
