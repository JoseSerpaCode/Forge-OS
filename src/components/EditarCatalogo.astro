---
/**
 * Nombre y color de una etiqueta o un tipo de tarea, en una sola ventana.
 *
 * La usan los ajustes del espacio (editar) y el alta de tareas (crear sin
 * salir del formulario). Se abre con `window.forgeEditarCatalogo({...})`; quien
 * la abre decide qué se guarda y devuelve el error que enseñar, o `null`.
 *
 * Antes la etiqueta se editaba en la propia fila con un botón que decía
 * «Renombrar» —y cambiaba también el color, sin que se adivinara— y el tipo
 * solo se renombraba, con el `prompt()` del navegador.
 */
import { useTranslations } from '../i18n/ui';
import { COLORES } from '../lib/labels';
const t = useTranslations(Astro.locals.lang || 'en');
---
<dialog id="editar-catalogo" class="ventana" aria-labelledby="editar-catalogo-titulo" data-t-save={t('labels.save')}>
  <h2 id="editar-catalogo-titulo" class="ventana-titulo"></h2>
  <form id="editar-catalogo-form" novalidate>
    <label id="editar-catalogo-rotulo" class="block field-label mb-1.5" for="editar-catalogo-nombre"></label>
    <input type="text" id="editar-catalogo-nombre" class="campo" autocomplete="off" />
    <fieldset class="mt-4">
      <legend class="block field-label mb-1.5">{t('labels.color')}</legend>
      <div id="editar-catalogo-colores" class="flex flex-wrap gap-1.5">
        {COLORES.map((c) => (
          <button type="button" class="color-opt w-8 h-8 rounded-lg border-2 border-transparent transition-all focus:outline-none focus:ring-2 focus:ring-forge-focus aria-pressed:border-forge-text"
            style={`background-color:${c}`} data-color={c} aria-label={c} aria-pressed="false"></button>
        ))}
      </div>
    </fieldset>
    <p id="editar-catalogo-error" class="hidden mt-3 text-sm text-forge-error" role="alert"></p>
    <div class="ventana-pie">
      <button type="button" id="editar-catalogo-cancelar" class="btn btn-ghost">{t('modal.cancel')}</button>
      <button type="submit" id="editar-catalogo-guardar" class="btn btn-primary">{t('labels.save')}</button>
    </div>
  </form>
</dialog>

<script>
  const dlg = document.getElementById('editar-catalogo') as HTMLDialogElement | null;
  const form = document.getElementById('editar-catalogo-form') as HTMLFormElement | null;
  const campo = document.getElementById('editar-catalogo-nombre') as HTMLInputElement | null;
  const paleta = document.getElementById('editar-catalogo-colores');
  const error = document.getElementById('editar-catalogo-error');
  const guardarBtn = document.getElementById('editar-catalogo-guardar') as HTMLButtonElement | null;
  if (dlg && form && campo && paleta && error && guardarBtn) {
    let actual: EdicionCatalogo | null = null;
    const marcar = (color: string) => paleta.querySelectorAll<HTMLElement>('.color-opt').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.color === color)));

    paleta.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('.color-opt');
      if (b?.dataset.color) marcar(b.dataset.color);
    });
    document.getElementById('editar-catalogo-cancelar')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!actual || guardarBtn.disabled) return;
      const color = paleta.querySelector<HTMLElement>('.color-opt[aria-pressed="true"]')?.dataset.color;
      guardarBtn.disabled = true;
      const fallo = await actual.guardar(campo.value.trim(), color).finally(() => { guardarBtn.disabled = false; });
      if (fallo === null) { dlg.close(); return; }
      error.textContent = fallo;
      error.classList.remove('hidden');
    });

    window.forgeEditarCatalogo = (edicion) => {
      actual = edicion;
      document.getElementById('editar-catalogo-titulo')!.textContent = edicion.titulo;
      document.getElementById('editar-catalogo-rotulo')!.textContent = edicion.rotulo;
      guardarBtn.textContent = edicion.boton || dlg.dataset.tSave || '';
      campo.value = edicion.nombre;
      campo.maxLength = edicion.maximo;
      marcar(edicion.color);
      error.classList.add('hidden');
      dlg.showModal();
      campo.select();
    };
  }
</script>
