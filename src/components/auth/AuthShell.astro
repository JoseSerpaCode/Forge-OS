---
/**
 * Armazón común de login y registro.
 *
 * Las dos páginas eran 125 líneas cada una con el 80% repetido, y cada arreglo
 * había que hacerlo dos veces —de hecho una tenía `text-white` y la otra
 * `text-forge-text`, que es exactamente lo que pasa cuando se duplica—. Aquí
 * queda la estructura y el panel de marca; cada página aporta solo su
 * formulario.
 */
import { useTranslations } from '../../i18n/ui';
import OAuthButtons from './OAuthButtons.astro';
import ThemeSwitch from '../i18n/ThemeSwitch.astro';
import { FIGURAS } from '../landing/figuras';
import '../../styles/portada.css';
import LangSwitch from '../i18n/LangSwitch.astro';

interface Props {
  /** Título grande sobre el formulario. */
  heading: string;
  /** Frase bajo el título. */
  sub: string;
  /** Cambia el lema y la escena del panel de marca. */
  modo?: 'login' | 'register';
}

const { heading, sub, modo = 'login' } = Astro.props;
const lang = Astro.locals.lang || 'en';
const t = useTranslations(lang);
const reg = modo === 'register';
const LOGO = '<svg viewBox="0 0 64 64" width="26" height="26" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M6 59V53H10V27A22 22 0 0 1 54 27V53H58V59ZM21 53V32A11 11 0 0 1 43 32V53Z"/><path fill="var(--brand-orange)" d="M21 53V45A11 8 0 0 1 43 45V53Z"/></svg>';
---

{/*
  Acceso y registro de «Taller» (docs/rediseno/acceso.html y registro.html):
  panel de marca en tinta con la escena de la fragua, y el formulario en
  columna. En móvil el panel se esconde entero: en 390 px le robaría la
  pantalla al formulario, que es a lo que se viene.
*/}
<div class="portada">
<div class="auth">
  <aside class="auth-brand" aria-hidden="true">
    <a href="/" class="brand" style="color:var(--brand-paper)" tabindex="-1"><Fragment set:html={LOGO} /><span class="brand-word">Forge OS</span></a>
    <div class="auth-copy">
      <p class="claim">{reg ? t('auth.side.reg_claim') : t('auth.side.claim')} <span class="claim-wide">{reg ? t('auth.side.reg_claim_wide') : t('auth.side.claim_wide')}</span></p>
      <ul class="auth-facts">
        <li>{reg ? t('auth.side.reg_p1') : t('auth.side.p1')}</li>
        <li>{reg ? t('auth.side.reg_p2') : t('auth.side.p2')}</li>
        <li>{reg ? t('auth.side.reg_p3') : t('auth.side.p3')}</li>
      </ul>
    </div>
    <div class="auth-scene"><Fragment set:html={reg ? FIGURAS.escena_registro : FIGURAS.escena_acceso} /></div>
  </aside>

  <main class="auth-form">
    <div class="au-col">
      <a href="/" class="link au-back">← {t('auth.back')}</a>
      <div>
        <h1 class="page-title">{heading}</h1>
        <p class="page-sub">{sub}</p>
      </div>

      {/* Para explicar por qué se ha llegado aquí, cuando no ha sido por
          voluntad propia — el caso del límite de invitados. */}
      <slot name="notice" />

      {/* Los proveedores van primero: para quien ya tiene cuenta de Google o de
          GitHub es un clic frente a recordar una contraseña. */}
      <OAuthButtons />

      <div class="divider">{t('auth.email')}</div>

      <slot />

      <div class="divider">{t('auth.or')}</div>

      {/*
        La tercera salida, la misma que ofrece la portada. Es un `form` y no un
        enlace porque `/api/auth/guest` crea una cuenta: eso es un POST, no una
        navegación que un prefetch del navegador pueda disparar sola.
      */}
      <form method="POST" action="/api/auth/guest" class="au-invitado">
        <button type="submit" class="btn btn-secondary au-ancho">{t('auth.try')}</button>
      </form>
      <p class="hint">{t('auth.try.caveat')}</p>

      <p class="au-swap"><slot name="swap" /></p>
    </div>

    {/*
      Idioma y tema van **después** del formulario en el DOM, aunque se vean
      arriba a la derecha. Si el de idioma fuera el primer formulario de la
      página, su botón sería el primer `submit`: pulsar Enter en un campo
      enviaba /api/lang en vez de entrar. Rompió 34 pruebas de una vez.
    */}
    <div class="au-ajustes"><LangSwitch /><ThemeSwitch /></div>
  </main>
</div>
</div>

<style>
  .auth-form { position: relative; }
  .au-col { width: min(380px, 100%); display: flex; flex-direction: column; gap: 16px; }
  .au-back { align-self: flex-start; font-size: var(--forge-t-13, 0.8125rem); }
  .au-ajustes { position: absolute; top: 24px; right: 24px; display: flex; gap: 6px; align-items: center; }
  .au-invitado { display: contents; }
  .au-ancho { justify-content: center; width: 100%; }
  .au-swap { font-size: 0.8125rem; }
  @media (max-width: 52rem) {
    .portada :global(.auth) { grid-template-columns: minmax(0, 1fr); }
    .portada :global(.auth-brand) { display: none; }
    .auth-form { padding-top: 72px; }
  }
</style>
