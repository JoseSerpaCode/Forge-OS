---
/**
 * La marca, en un solo sitio: «Fragua».
 *
 * La boca de una fragua sobre su hogar, con las brasas encendidas dentro. Es
 * el sitio donde se trabaja, lo mismo que un espacio de Forge. Las cuatro
 * propuestas y por qué se eligió esta están en `docs/rediseno/logo.html`.
 *
 * - El **arco** va en el color del texto: tinta sobre papel, papel sobre
 *   grafito. Por eso es `currentColor`.
 * - Las **brasas** van siempre en el naranja de marca `#E8590C`, fijo, sin
 *   pasar por los tokens del tema: la marca no cambia con el tema.
 * - Sin cuadrado, sin gradiente, sin halo. El cuadrado de tinta es solo del
 *   icono de aplicación (`public/forge-icon.svg`).
 *
 * El trazado es el mismo que el de `public/forge-icon.svg`. Si cambias uno,
 * cambia el otro. Va en línea para que herede el color y no dependa de una
 * petición aparte.
 */
interface Props {
  /** Tamaño del símbolo. El nombre acompaña en proporción. */
  size?: 'sm' | 'md' | 'lg' | 'xl';
  /** Mostrar el nombre junto al símbolo. */
  wordmark?: boolean;
  /** Envolver en un enlace a la portada. */
  href?: string;
  class?: string;
}

const { size = 'md', wordmark = true, href, class: className = '' } = Astro.props;

const PX = { sm: 22, md: 28, lg: 36, xl: 72 } as const;
const px = PX[size];

const Tag = href ? 'a' : 'span';
---

<Tag
  {...href ? { href } : {}}
  class:list={['brand', `brand-${size}`, className]}
  aria-label={wordmark ? undefined : 'Forge OS'}
>
  <svg class="brand-mark" width={px} height={px} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <path fill="currentColor" fill-rule="evenodd" d="M6 59V53H10V27A22 22 0 0 1 54 27V53H58V59ZM21 53V32A11 11 0 0 1 43 32V53Z" />
    <path fill="#E8590C" d="M21 53V45A11 8 0 0 1 43 45V53Z" />
  </svg>

  {/* «Forge OS», siempre así, nunca «FORGE OS». */}
  {wordmark && <span class="brand-word">Forge OS</span>}
</Tag>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--forge-text);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .brand-mark { flex: none; }

  .brand-sm .brand-word { font-size: 0.9rem; }
  .brand-md .brand-word { font-size: 1.05rem; }
  .brand-lg .brand-word { font-size: 1.35rem; }
  .brand-xl { gap: 1rem; }
  .brand-xl .brand-word { font-size: 2rem; }
</style>
