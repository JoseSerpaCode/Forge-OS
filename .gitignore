# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
*.db
*.db-*
*.db.bak
cookies.txt
.data/

# Scripts de usar y tirar (auditorías, capturas, sondeos). Se escriben en la
# raíz para tener node_modules a mano y no deben acabar en el repositorio.
*.tmp.mjs
*.tmp.ts

# Cachés que npm crea en el HOME del usuario de servicio, que en la VM es el
# propio directorio de la aplicación. No son del proyecto, pero ensucian
# `git status` justo cuando se está desplegando y hay que mirarlo.
.cache/
.npm/
.config/
